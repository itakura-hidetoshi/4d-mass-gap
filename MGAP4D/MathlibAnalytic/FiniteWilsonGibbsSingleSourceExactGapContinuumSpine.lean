import MGAP4D.MathlibAnalytic.FiniteWilsonGibbsSingleSourceExactGapOSLimitAssembly
import MGAP4D.MathlibAnalytic.EuclideanYangMillsMeasureExactGapConstructionSpine

namespace MGAP4D
namespace MathlibAnalytic

open MeasureTheory

noncomputable section

/-!
A concrete finite-Wilson entry point to the dependency-reduced exact-gap
continuum construction spine.

The finite-volume approximation is generated by
`FiniteWilsonOSAutomaticApproximationFamily`.  The continuum measure package is
generated by the explicit single-source projective-limit construction together
with the exact-gap OS limit-transfer data.  Projective consistency, compact
tightness, projective-limit existence, continuum-law identification,
probability normalization, gauge-group compactness/nontriviality, and the five
OS measure properties are theorem-generated.

The genuinely open construction inputs retained here are the interacting-limit
statement and the two Schwinger-function construction/limit statements, together
with the measure-to-OS/Wightman and exact-gap reconstruction bridges.
-/

/-- Concrete assembly data joining one finite Wilson source, its exact-gap OS
continuum limit, and the reduced exact-gap reconstruction bridge. -/
structure FiniteWilsonGibbsSingleSourceExactGapContinuumAssembly
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    (R : FiniteWilsonGibbsSingleSourceProjectiveRealization W)
    [∀ x, Fintype (R.fieldValue x)]
    [∀ x, Countable (R.fieldValue x)]
    [∀ x, DiscreteMeasurableSpace (R.fieldValue x)] where
  limitData : FiniteWilsonGibbsSingleSourceExactGapOSLimitData R
  measureBridge : EuclideanYangMillsMeasureToOSWightmanBridge
  measureBridge_identified :
    measureBridge.measure =
      (R.explicitOSContinuumConstruction
        (R.automaticOSLimitTransferData limitData.toAutomaticData)).toMeasurePackage
  definitionBridge : OSWightmanExactGapDefinitionBridge
  definitionBridge_uses_measure_axioms :
    definitionBridge.spine.axioms = measureBridge.axioms
  interactingContinuumLimitConstructed : Prop
  interactingContinuumLimitConstructed_proof :
    interactingContinuumLimitConstructed
  gaugeInvariantSchwingerFunctionsConstructed : Prop
  gaugeInvariantSchwingerFunctionsConstructed_proof :
    gaugeInvariantSchwingerFunctionsConstructed
  schwingerFunctionsAreContinuumLimits : Prop
  schwingerFunctionsAreContinuumLimits_proof :
    schwingerFunctionsAreContinuumLimits

/-- The theorem-generated explicit continuum construction carried by the
assembly. -/
noncomputable def
    FiniteWilsonGibbsSingleSourceExactGapContinuumAssembly.continuumConstruction
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    {R : FiniteWilsonGibbsSingleSourceProjectiveRealization W}
    [∀ x, Fintype (R.fieldValue x)]
    [∀ x, Countable (R.fieldValue x)]
    [∀ x, DiscreteMeasurableSpace (R.fieldValue x)]
    (A : FiniteWilsonGibbsSingleSourceExactGapContinuumAssembly R) :=
  R.explicitOSContinuumConstruction
    (R.automaticOSLimitTransferData A.limitData.toAutomaticData)

/-- The assembly's Euclidean measure package is generated from the explicit
single-source Wilson continuum law. -/
noncomputable def
    FiniteWilsonGibbsSingleSourceExactGapContinuumAssembly.measurePackage
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    {R : FiniteWilsonGibbsSingleSourceProjectiveRealization W}
    [∀ x, Fintype (R.fieldValue x)]
    [∀ x, Countable (R.fieldValue x)]
    [∀ x, DiscreteMeasurableSpace (R.fieldValue x)]
    (A : FiniteWilsonGibbsSingleSourceExactGapContinuumAssembly R) :
    EuclideanYangMillsMeasurePackage :=
  A.continuumConstruction.toMeasurePackage

/-- The generated continuum measure package satisfies the full OS/Wightman
measure-side readiness predicate. -/
theorem FiniteWilsonGibbsSingleSourceExactGapContinuumAssembly.measurePackageReady
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    {R : FiniteWilsonGibbsSingleSourceProjectiveRealization W}
    [∀ x, Fintype (R.fieldValue x)]
    [∀ x, Countable (R.fieldValue x)]
    [∀ x, DiscreteMeasurableSpace (R.fieldValue x)]
    (A : FiniteWilsonGibbsSingleSourceExactGapContinuumAssembly R) :
    A.measurePackage.ready := by
  exact finite_wilson_single_source_exact_gap_os_limit_ready R A.limitData

/-- The supplied measure bridge is ready because its measure is the generated
exact-gap Wilson continuum package. -/
theorem FiniteWilsonGibbsSingleSourceExactGapContinuumAssembly.measureBridgeReady
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    {R : FiniteWilsonGibbsSingleSourceProjectiveRealization W}
    [∀ x, Fintype (R.fieldValue x)]
    [∀ x, Countable (R.fieldValue x)]
    [∀ x, DiscreteMeasurableSpace (R.fieldValue x)]
    (A : FiniteWilsonGibbsSingleSourceExactGapContinuumAssembly R) :
    A.measureBridge.measure.ready := by
  rw [A.measureBridge_identified]
  exact A.measurePackageReady

/-- Convert the concrete finite-Wilson assembly to the dependency-reduced
continuum construction spine introduced after the exact-gap reconstruction
reduction.

Only the three explicitly retained frontier propositions are copied.  All other
finite-volume, projective-limit, compact-tightness, measure, gauge-group, and OS
properties are filled by existing theorems. -/
noncomputable def
    FiniteWilsonGibbsSingleSourceExactGapContinuumAssembly.toExactGapConstructionSpine
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    {R : FiniteWilsonGibbsSingleSourceProjectiveRealization W}
    [∀ x, Fintype (R.fieldValue x)]
    [∀ x, Countable (R.fieldValue x)]
    [∀ x, DiscreteMeasurableSpace (R.fieldValue x)]
    (A : FiniteWilsonGibbsSingleSourceExactGapContinuumAssembly R) :
    EuclideanYangMillsContinuumMeasureExactGapConstructionSpine := by
  letI : ∀ x, TopologicalSpace (R.fieldValue x) :=
    fun _ => ⊥
  letI : ∀ x, DiscreteTopology (R.fieldValue x) :=
    fun _ => ⟨rfl⟩
  letI : ∀ x, BorelSpace (R.fieldValue x) :=
    fun _ => by infer_instance
  letI : ∀ x, PolishSpace (R.fieldValue x) :=
    fun _ => by infer_instance
  letI : ∀ x,
      TopologicalSpace
        (R.toProjectiveRealization.toProjectiveCylinderFamily.fieldValue x) :=
    fun x => by
      change TopologicalSpace (R.fieldValue x)
      infer_instance
  letI : ∀ x,
      OpensMeasurableSpace
        (R.toProjectiveRealization.toProjectiveCylinderFamily.fieldValue x) :=
    fun x => by
      change OpensMeasurableSpace (R.fieldValue x)
      infer_instance
  letI : ∀ x,
      SecondCountableTopology
        (R.toProjectiveRealization.toProjectiveCylinderFamily.fieldValue x) :=
    fun x => by
      change SecondCountableTopology (R.fieldValue x)
      infer_instance
  exact
    { finiteVolume := W.toFiniteVolumeApproximation
      measurePackage := A.measurePackage
      bridge := A.measureBridge
      definitionBridge := A.definitionBridge
      measurePackage_identified := A.measureBridge_identified
      bridge_uses_reduced_axioms := A.definitionBridge_uses_measure_axioms
      projectiveConsistency :=
        IsProjectiveMeasureFamily
          R.toProjectiveRealization.toProjectiveCylinderFamily.finiteMarginal
      projectiveConsistency_proof :=
        R.toProjectiveRealization.toProjectiveCylinderFamily.projective
      tightness :=
        Nonempty
          (EuclideanYangMillsCompactTightnessData
            R.toProjectiveRealization.toProjectiveCylinderFamily)
      tightness_proof := ⟨R.finiteDiscreteCompactTightnessData⟩
      weakLimitExists :=
        Nonempty
          (EuclideanYangMillsProjectiveLimitMeasure
            R.toProjectiveRealization.toProjectiveCylinderFamily)
      weakLimitExists_proof := ⟨R.projectiveLimitMeasure⟩
      continuumMeasureIdentified :=
        A.continuumConstruction.limit.continuumMeasure = R.continuumMeasure
      continuumMeasureIdentified_proof := rfl
      continuumFourDimensionalYangMillsMeasureConstructed :=
        IsProbabilityMeasure A.continuumConstruction.limit.continuumMeasure
      continuumFourDimensionalYangMillsMeasureConstructed_proof :=
        euclidean_yang_mills_projective_limit_probability
          A.continuumConstruction.limit
      nontrivialCompactGaugeGroupConstructed :=
        CompactSpace A.continuumConstruction.gaugeGroup ∧
          Nontrivial A.continuumConstruction.gaugeGroup
      nontrivialCompactGaugeGroupConstructed_proof :=
        ⟨inferInstance, inferInstance⟩
      interactingContinuumLimitConstructed :=
        A.interactingContinuumLimitConstructed
      interactingContinuumLimitConstructed_proof :=
        A.interactingContinuumLimitConstructed_proof
      gaugeInvariantSchwingerFunctionsConstructed :=
        A.gaugeInvariantSchwingerFunctionsConstructed
      gaugeInvariantSchwingerFunctionsConstructed_proof :=
        A.gaugeInvariantSchwingerFunctionsConstructed_proof
      schwingerFunctionsAreContinuumLimits :=
        A.schwingerFunctionsAreContinuumLimits
      schwingerFunctionsAreContinuumLimits_proof :=
        A.schwingerFunctionsAreContinuumLimits_proof
      reflectionPositivityPassesToLimit :=
        A.continuumConstruction.reflectionPositive_proof
      euclideanInvariancePassesToLimit :=
        A.continuumConstruction.euclideanInvariant_proof
      symmetryPassesToLimit :=
        A.continuumConstruction.symmetric_proof
      clusterPropertyPassesToLimit :=
        A.continuumConstruction.clusterProperty_proof
      regularityPassesToLimit :=
        A.continuumConstruction.regularity_proof
      gaugeGroupCompactTheorem := by
        change CompactSpace A.continuumConstruction.gaugeGroup
        infer_instance
      gaugeGroupNontrivialTheorem := by
        change Nontrivial A.continuumConstruction.gaugeGroup
        infer_instance }

/-- The conversion uses the actual finite Wilson approximation generated from
`W`. -/
theorem FiniteWilsonGibbsSingleSourceExactGapContinuumAssembly.toExactGapConstructionSpine_finiteVolume
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    {R : FiniteWilsonGibbsSingleSourceProjectiveRealization W}
    [∀ x, Fintype (R.fieldValue x)]
    [∀ x, Countable (R.fieldValue x)]
    [∀ x, DiscreteMeasurableSpace (R.fieldValue x)]
    (A : FiniteWilsonGibbsSingleSourceExactGapContinuumAssembly R) :
    A.toExactGapConstructionSpine.finiteVolume =
      W.toFiniteVolumeApproximation := by
  rfl

/-- The conversion uses the explicit single-source projective-limit continuum
measure package. -/
theorem FiniteWilsonGibbsSingleSourceExactGapContinuumAssembly.toExactGapConstructionSpine_measurePackage
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    {R : FiniteWilsonGibbsSingleSourceProjectiveRealization W}
    [∀ x, Fintype (R.fieldValue x)]
    [∀ x, Countable (R.fieldValue x)]
    [∀ x, DiscreteMeasurableSpace (R.fieldValue x)]
    (A : FiniteWilsonGibbsSingleSourceExactGapContinuumAssembly R) :
    A.toExactGapConstructionSpine.measurePackage = A.measurePackage := by
  rfl

/-- The converted continuum measure is exactly the explicit Wilson pushforward
law. -/
theorem FiniteWilsonGibbsSingleSourceExactGapContinuumAssembly.continuumMeasure_eq_explicit
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    {R : FiniteWilsonGibbsSingleSourceProjectiveRealization W}
    [∀ x, Fintype (R.fieldValue x)]
    [∀ x, Countable (R.fieldValue x)]
    [∀ x, DiscreteMeasurableSpace (R.fieldValue x)]
    (A : FiniteWilsonGibbsSingleSourceExactGapContinuumAssembly R) :
    A.continuumConstruction.limit.continuumMeasure = R.continuumMeasure := by
  rfl

end

end MathlibAnalytic
end MGAP4D
