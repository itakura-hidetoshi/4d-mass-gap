noncomputable section

local instance boundaryMarginalNeZero (H : ℕ) :
    NeZero (PeriodicHypercubicEvenSideLength H) := ⟨by
  simp [PeriodicHypercubicEvenSideLength]⟩

local instance boundaryMarginalTopologicalGroup (N : ℕ) :
    IsTopologicalGroup (Matrix.specialUnitaryGroup (Fin N) ℂ) :=
  specialUnitaryGroupIsTopologicalGroup N

local instance boundaryMarginalCompactSpace (N : ℕ) :
    CompactSpace (Matrix.specialUnitaryGroup (Fin N) ℂ) :=
  specialUnitaryGroupCompactSpace N

local instance boundaryMarginalSecondCountable (N : ℕ) :
    SecondCountableTopology (Matrix.specialUnitaryGroup (Fin N) ℂ) :=
  specialUnitaryGroupSecondCountableTopology N

local instance boundaryMarginalMeasurableSpace (N : ℕ) :
    MeasurableSpace (Matrix.specialUnitaryGroup (Fin N) ℂ) :=
  specialUnitaryGroupMeasurableSpace N

local instance boundaryMarginalBorelSpace (N : ℕ) :
    BorelSpace (Matrix.specialUnitaryGroup (Fin N) ℂ) :=
  specialUnitaryGroupBorelSpace N

local instance boundaryMarginalBoundarySFinite (H N : ℕ) :
    SFinite (periodicHypercubicEvenBoundaryHaarMeasure H N) := by
  unfold periodicHypercubicEvenBoundaryHaarMeasure
  infer_instance

local instance boundaryMarginalOpenHalfSFinite (H N : ℕ) :
    SFinite (periodicHypercubicEvenOpenHalfHaarMeasure H N) := by
  unfold periodicHypercubicEvenOpenHalfHaarMeasure
  infer_instance

/-- Density of the finite Wilson Gibbs boundary marginal with respect to the
reflection-fixed boundary Haar law. -/
noncomputable def periodicHypercubicEvenBoundaryMarginalDensity
    (H N : ℕ) (hN : 0 < N)
    [Nontrivial (Matrix.specialUnitaryGroup (Fin N) ℂ)]
    (beta : ℝ) (hbeta : 0 ≤ beta)
    (b : PeriodicHypercubicEvenSpecialUnitaryBoundaryConfiguration H N) : ℝ≥0∞ :=
  ENNReal.ofReal
    (periodicHypercubicEvenBoundaryVacuumMoment
      H N hN beta hbeta b ^ 2)

/-- The interacting boundary marginal measure generated by the finite Wilson
Gibbs law. -/
noncomputable def periodicHypercubicEvenBoundaryMarginalMeasure
    (H N : ℕ) (hN : 0 < N)
    [Nontrivial (Matrix.specialUnitaryGroup (Fin N) ℂ)]
    (beta : ℝ) (hbeta : 0 ≤ beta) :
    Measure (PeriodicHypercubicEvenSpecialUnitaryBoundaryConfiguration H N) :=
  (periodicHypercubicEvenBoundaryHaarMeasure H N).withDensity
    (periodicHypercubicEvenBoundaryMarginalDensity
      H N hN beta hbeta)

/-- The boundary marginal density is measurable. -/
theorem periodicHypercubicEvenBoundaryMarginalDensity_measurable
    (H N : ℕ) (hN : 0 < N)
    [Nontrivial (Matrix.specialUnitaryGroup (Fin N) ℂ)]
    (beta : ℝ) (hbeta : 0 ≤ beta) :
    Measurable
      (periodicHypercubicEvenBoundaryMarginalDensity
        H N hN beta hbeta) := by
  unfold periodicHypercubicEvenBoundaryMarginalDensity
  exact ENNReal.measurable_ofReal.comp
    ((periodicHypercubicEvenBoundaryVacuumMoment_measurable
      H N hN beta hbeta).pow_const 2)

/-- The real boundary-fibered Gibbs density is integrable on each pair of open
halves. -/
theorem periodicHypercubicEvenBoundaryFiberedGibbsDensity_toReal_fiber_integrable
    (H N : ℕ) (hN : 0 < N)
    [Nontrivial (Matrix.specialUnitaryGroup (Fin N) ℂ)]
    (beta : ℝ) (hbeta : 0 ≤ beta)
    (b : PeriodicHypercubicEvenSpecialUnitaryBoundaryConfiguration H N) :
    Integrable
      (fun z :
          PeriodicHypercubicEvenSpecialUnitaryOpenHalfConfiguration H N ×
            PeriodicHypercubicEvenSpecialUnitaryOpenHalfConfiguration H N =>
        (periodicHypercubicEvenSpecialUnitaryBoundaryFiberedGibbsDensity
          H N hN beta hbeta (b, z)).toReal)
      ((periodicHypercubicEvenOpenHalfHaarMeasure H N).prod
        (periodicHypercubicEvenOpenHalfHaarMeasure H N)) := by
  let one : BoundedContinuousFunction
      (PeriodicHypercubicEvenSpecialUnitaryOpenHalfConfiguration H N) ℝ := 1
  have h :=
    (periodicHypercubicEvenWilsonGibbsReflectionTransportData_of_boundedContinuous
      H N hN beta hbeta one).fiberKernelIntegrable b
  have heq :
      (fun z :
          PeriodicHypercubicEvenSpecialUnitaryOpenHalfConfiguration H N ×
            PeriodicHypercubicEvenSpecialUnitaryOpenHalfConfiguration H N =>
        periodicHypercubicEvenBoundaryWeightedReflectedObservable
          H N hN beta hbeta one (b, z)) =
      fun z =>
        (periodicHypercubicEvenSpecialUnitaryBoundaryFiberedGibbsDensity
          H N hN beta hbeta (b, z)).toReal := by
    funext z
    simp [one, periodicHypercubicEvenBoundaryWeightedReflectedObservable,
      periodicHypercubicEvenBoundaryReflectedObservable]
  rwa [heq] at h

/-- The real integral of the finite Wilson Gibbs density over both open halves
is exactly the squared boundary vacuum moment. -/
theorem periodicHypercubicEvenBoundaryFiberedGibbsDensity_pairIntegral_eq_vacuumMoment_sq
    (H N : ℕ) (hN : 0 < N)
    [Nontrivial (Matrix.specialUnitaryGroup (Fin N) ℂ)]
    (beta : ℝ) (hbeta : 0 ≤ beta)
    (b : PeriodicHypercubicEvenSpecialUnitaryBoundaryConfiguration H N) :
    (∫ z,
      (periodicHypercubicEvenSpecialUnitaryBoundaryFiberedGibbsDensity
        H N hN beta hbeta (b, z)).toReal
      ∂((periodicHypercubicEvenOpenHalfHaarMeasure H N).prod
        (periodicHypercubicEvenOpenHalfHaarMeasure H N))) =
      periodicHypercubicEvenBoundaryVacuumMoment
        H N hN beta hbeta b ^ 2 := by
  rw [MeasureTheory.integral_prod _
    (periodicHypercubicEvenBoundaryFiberedGibbsDensity_toReal_fiber_integrable
      H N hN beta hbeta b)]
  exact
    periodicHypercubicEvenBoundaryFiberedGibbsDensity_integral_eq_vacuumMoment_sq
      H N hN beta hbeta b

/-- The fiberwise `lintegral` of the boundary-coordinate Gibbs density is the
square of the OS boundary vacuum wavefunction. -/
theorem periodicHypercubicEvenBoundaryFiberedGibbsDensity_fiberLIntegral_eq_marginalDensity
    (H N : ℕ) (hN : 0 < N)
    [Nontrivial (Matrix.specialUnitaryGroup (Fin N) ℂ)]
    (beta : ℝ) (hbeta : 0 ≤ beta)
    (b : PeriodicHypercubicEvenSpecialUnitaryBoundaryConfiguration H N) :
    (∫⁻ z,
      periodicHypercubicEvenSpecialUnitaryBoundaryFiberedGibbsDensity
        H N hN beta hbeta (b, z)
      ∂((periodicHypercubicEvenOpenHalfHaarMeasure H N).prod
        (periodicHypercubicEvenOpenHalfHaarMeasure H N))) =
      periodicHypercubicEvenBoundaryMarginalDensity
        H N hN beta hbeta b := by
  let rho := fun z :
      PeriodicHypercubicEvenSpecialUnitaryOpenHalfConfiguration H N ×
        PeriodicHypercubicEvenSpecialUnitaryOpenHalfConfiguration H N =>
    periodicHypercubicEvenSpecialUnitaryBoundaryFiberedGibbsDensity
      H N hN beta hbeta (b, z)
  have hint : Integrable (fun z => (rho z).toReal)
      ((periodicHypercubicEvenOpenHalfHaarMeasure H N).prod
        (periodicHypercubicEvenOpenHalfHaarMeasure H N)) := by
    simpa [rho] using
      periodicHypercubicEvenBoundaryFiberedGibbsDensity_toReal_fiber_integrable
        H N hN beta hbeta b
  have hnonneg :
      0 ≤ᵐ[((periodicHypercubicEvenOpenHalfHaarMeasure H N).prod
        (periodicHypercubicEvenOpenHalfHaarMeasure H N))],
        fun z => (rho z).toReal :=
    Filter.Eventually.of_forall fun z => ENNReal.toReal_nonneg
  calc
    (∫⁻ z, rho z
      ∂((periodicHypercubicEvenOpenHalfHaarMeasure H N).prod
        (periodicHypercubicEvenOpenHalfHaarMeasure H N))) =
        ∫⁻ z, ENNReal.ofReal ((rho z).toReal)
          ∂((periodicHypercubicEvenOpenHalfHaarMeasure H N).prod
            (periodicHypercubicEvenOpenHalfHaarMeasure H N)) := by
      apply lintegral_congr
      intro z
      rw [ENNReal.ofReal_toReal]
      simp [rho,
        periodicHypercubicEvenSpecialUnitaryBoundaryFiberedGibbsDensity,
        ContinuousCompactOrientedGaugeWilsonSystem.boundaryFiberedGibbsDensity]
    _ = ENNReal.ofReal
        (∫ z, (rho z).toReal
          ∂((periodicHypercubicEvenOpenHalfHaarMeasure H N).prod
            (periodicHypercubicEvenOpenHalfHaarMeasure H N))) := by
      exact (ofReal_integral_eq_lintegral_ofReal hint hnonneg).symm
    _ = periodicHypercubicEvenBoundaryMarginalDensity
        H N hN beta hbeta b := by
      unfold periodicHypercubicEvenBoundaryMarginalDensity
      congr 1
      simpa [rho] using
        periodicHypercubicEvenBoundaryFiberedGibbsDensity_pairIntegral_eq_vacuumMoment_sq
          H N hN beta hbeta b

/-- The exact boundary pushforward of the finite Wilson Gibbs measure is the
boundary Haar law weighted by the squared OS boundary vacuum moment. -/
theorem periodicHypercubicEvenSpecialUnitary_map_boundaryRestriction_gibbsMeasure
    (H N : ℕ) (hN : 0 < N)
    [Nontrivial (Matrix.specialUnitaryGroup (Fin N) ℂ)]
    (beta : ℝ) (hbeta : 0 ≤ beta) :
    Measure.map
      (periodicHypercubicEvenEdgeOrbitPartition H).boundaryRestriction
      (periodicHypercubicSpecialUnitaryWilsonSystem
        (PeriodicHypercubicEvenSideLength H) N hN beta hbeta).gibbsMeasure =
      periodicHypercubicEvenBoundaryMarginalMeasure
        H N hN beta hbeta := by
  let Gauge := Matrix.specialUnitaryGroup (Fin N) ℂ
  let P := periodicHypercubicEvenEdgeOrbitPartition H
  let C := periodicHypercubicSpecialUnitaryWilsonSystem
    (PeriodicHypercubicEvenSideLength H) N hN beta hbeta
  let boundaryMeasure := periodicHypercubicEvenBoundaryHaarMeasure H N
  let halfMeasure := periodicHypercubicEvenOpenHalfHaarMeasure H N
  let density := periodicHypercubicEvenSpecialUnitaryBoundaryFiberedGibbsDensity
    H N hN beta hbeta
  have hcoordinates : Measurable (P.boundaryFiberedCoordinates Gauge) :=
    P.boundaryFiberedCoordinates_measurable Gauge
  have hMap :
      Measure.map (P.boundaryFiberedCoordinates Gauge) C.gibbsMeasure =
        (boundaryMeasure.prod (halfMeasure.prod halfMeasure)).withDensity density := by
    simpa [P, C, boundaryMeasure, halfMeasure, density,
      periodicHypercubicEvenBoundaryHaarMeasure,
      periodicHypercubicEvenOpenHalfHaarMeasure] using
      (periodicHypercubicEvenSpecialUnitary_map_boundaryFiberedCoordinates_gibbsMeasure
        H N hN beta hbeta)
  calc
    Measure.map P.boundaryRestriction C.gibbsMeasure =
        Measure.map (Prod.fst ∘ P.boundaryFiberedCoordinates Gauge)
          C.gibbsMeasure := by rfl
    _ = Measure.map Prod.fst
        (Measure.map (P.boundaryFiberedCoordinates Gauge) C.gibbsMeasure) := by
      exact (Measure.map_map measurable_fst hcoordinates).symm
    _ = Measure.map Prod.fst
        ((boundaryMeasure.prod (halfMeasure.prod halfMeasure)).withDensity density) := by
      rw [hMap]
    _ = boundaryMeasure.withDensity
        (fun b => ∫⁻ z, density (b, z) ∂(halfMeasure.prod halfMeasure)) := by
      exact measure_map_fst_prod_withDensity
        boundaryMeasure (halfMeasure.prod halfMeasure) density
        (periodicHypercubicEvenSpecialUnitaryBoundaryFiberedGibbsDensity_measurable
          H N hN beta hbeta)
    _ = periodicHypercubicEvenBoundaryMarginalMeasure
        H N hN beta hbeta := by
      unfold periodicHypercubicEvenBoundaryMarginalMeasure
      congr 1
      funext b
      simpa [density, halfMeasure] using
        periodicHypercubicEvenBoundaryFiberedGibbsDensity_fiberLIntegral_eq_marginalDensity
          H N hN beta hbeta b

/-- Boundary restriction is measure-preserving from the finite Wilson Gibbs law
to its interacting boundary marginal. -/
noncomputable def periodicHypercubicEvenSpecialUnitaryBoundaryRestrictionMeasurePreserving
    (H N : ℕ) (hN : 0 < N)
    [Nontrivial (Matrix.specialUnitaryGroup (Fin N) ℂ)]
    (beta : ℝ) (hbeta : 0 ≤ beta) :
    MeasurePreserving
      (periodicHypercubicEvenEdgeOrbitPartition H).boundaryRestriction
      (periodicHypercubicSpecialUnitaryWilsonSystem
        (PeriodicHypercubicEvenSideLength H) N hN beta hbeta).gibbsMeasure
      (periodicHypercubicEvenBoundaryMarginalMeasure
        H N hN beta hbeta) where
  measurable :=
    measurable_fst.comp
      ((periodicHypercubicEvenEdgeOrbitPartition H).boundaryFiberedCoordinates_measurable
        (Matrix.specialUnitaryGroup (Fin N) ℂ))
  map_eq :=
    periodicHypercubicEvenSpecialUnitary_map_boundaryRestriction_gibbsMeasure
      H N hN beta hbeta

end

end MathlibAnalytic
