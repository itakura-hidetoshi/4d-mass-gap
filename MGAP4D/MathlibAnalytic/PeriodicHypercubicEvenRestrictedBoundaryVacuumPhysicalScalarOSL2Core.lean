/-- Canonically regard a bounded continuous scalar observable as a vector in
the reflection-positive OS core of the boundary-vacuum scalar subtheory. -/
noncomputable def periodicHypercubicEvenRestrictedBoundaryVacuumScalarOSCarrier
    (H : ℕ → ℕ)
    (N : ℕ) (hN : 0 < N)
    [Nontrivial (Matrix.specialUnitaryGroup (Fin N) ℂ)]
    (beta : ℕ → ℝ) (hbeta : ∀ n, 0 ≤ beta n)
    (latticeSpacing : ℕ → ℝ)
    (latticeSpacing_pos : ∀ n, 0 < latticeSpacing n)
    (latticeSpacing_tendsto_zero :
      Tendsto latticeSpacing atTop (nhds 0))
    (physicalVolume : ℕ → ℝ)
    (physicalVolume_tendsto_atTop :
      Tendsto physicalVolume atTop atTop)
    (L : PhysicalFourDimensionalYangMillsProkhorovSubsequenceLimit
      (periodicHypercubicEvenRestrictedBoundaryVacuumPhysicalEmbedding
        H N hN beta hbeta
        latticeSpacing latticeSpacing_pos latticeSpacing_tendsto_zero
        physicalVolume physicalVolume_tendsto_atTop).toLatticeEmbedding)
    (O : BoundedContinuousFunction ℝ ℝ) :
    (periodicHypercubicEvenRestrictedBoundaryVacuumScalarOSPreHilbertData
      H N hN beta hbeta
      latticeSpacing latticeSpacing_pos latticeSpacing_tendsto_zero
      physicalVolume physicalVolume_tendsto_atTop L).Carrier where
  observable := O
  gaugeInvariant :=
    (periodicHypercubicEvenRestrictedBoundaryVacuumGaugeInvariantObservable
      H N hN beta hbeta
      latticeSpacing latticeSpacing_pos latticeSpacing_tendsto_zero
      physicalVolume physicalVolume_tendsto_atTop L O).property
  positiveTime := by
    simp [periodicHypercubicEvenRestrictedBoundaryVacuumScalarOSReflectionData]

@[simp]
theorem periodicHypercubicEvenRestrictedBoundaryVacuumScalarOSCarrier_observable
    (H : ℕ → ℕ)
    (N : ℕ) (hN : 0 < N)
    [Nontrivial (Matrix.specialUnitaryGroup (Fin N) ℂ)]
    (beta : ℕ → ℝ) (hbeta : ∀ n, 0 ≤ beta n)
    (latticeSpacing : ℕ → ℝ)
    (latticeSpacing_pos : ∀ n, 0 < latticeSpacing n)
    (latticeSpacing_tendsto_zero :
      Tendsto latticeSpacing atTop (nhds 0))
    (physicalVolume : ℕ → ℝ)
    (physicalVolume_tendsto_atTop :
      Tendsto physicalVolume atTop atTop)
    (L : PhysicalFourDimensionalYangMillsProkhorovSubsequenceLimit
      (periodicHypercubicEvenRestrictedBoundaryVacuumPhysicalEmbedding
        H N hN beta hbeta
        latticeSpacing latticeSpacing_pos latticeSpacing_tendsto_zero
        physicalVolume physicalVolume_tendsto_atTop).toLatticeEmbedding)
    (O : BoundedContinuousFunction ℝ ℝ) :
    (periodicHypercubicEvenRestrictedBoundaryVacuumScalarOSCarrier
      H N hN beta hbeta
      latticeSpacing latticeSpacing_pos latticeSpacing_tendsto_zero
      physicalVolume physicalVolume_tendsto_atTop L O).observable = O :=
  rfl

/-- The OS inner product on canonical scalar core vectors is exactly the
`L²(μ∞)` pairing generated by the same Prokhorov continuum law.

No new Hilbert-space measure or completion is introduced: this identifies the
already constructed OS pre-inner product with the continuum probability law. -/
theorem periodicHypercubicEvenRestrictedBoundaryVacuumScalarOS_inner_eq_integral_mul
    (H : ℕ → ℕ)
    (N : ℕ) (hN : 0 < N)
    [Nontrivial (Matrix.specialUnitaryGroup (Fin N) ℂ)]
    (beta : ℕ → ℝ) (hbeta : ∀ n, 0 ≤ beta n)
    (latticeSpacing : ℕ → ℝ)
    (latticeSpacing_pos : ∀ n, 0 < latticeSpacing n)
    (latticeSpacing_tendsto_zero :
      Tendsto latticeSpacing atTop (nhds 0))
    (physicalVolume : ℕ → ℝ)
    (physicalVolume_tendsto_atTop :
      Tendsto physicalVolume atTop atTop)
    (L : PhysicalFourDimensionalYangMillsProkhorovSubsequenceLimit
      (periodicHypercubicEvenRestrictedBoundaryVacuumPhysicalEmbedding
        H N hN beta hbeta
        latticeSpacing latticeSpacing_pos latticeSpacing_tendsto_zero
        physicalVolume physicalVolume_tendsto_atTop).toLatticeEmbedding)
    (O₁ O₂ : BoundedContinuousFunction ℝ ℝ) :
    inner ℝ
        (periodicHypercubicEvenRestrictedBoundaryVacuumScalarOSCarrier
          H N hN beta hbeta
          latticeSpacing latticeSpacing_pos latticeSpacing_tendsto_zero
          physicalVolume physicalVolume_tendsto_atTop L O₁)
        (periodicHypercubicEvenRestrictedBoundaryVacuumScalarOSCarrier
          H N hN beta hbeta
          latticeSpacing latticeSpacing_pos latticeSpacing_tendsto_zero
          physicalVolume physicalVolume_tendsto_atTop L O₂) =
      ∫ x, O₁ x * O₂ x ∂ProbabilityMeasure.toMeasure L.continuumMeasure := by
  let P := periodicHypercubicEvenRestrictedBoundaryVacuumScalarOSPreHilbertData
    H N hN beta hbeta
    latticeSpacing latticeSpacing_pos latticeSpacing_tendsto_zero
    physicalVolume physicalVolume_tendsto_atTop L
  change inner ℝ
      (periodicHypercubicEvenRestrictedBoundaryVacuumScalarOSCarrier
        H N hN beta hbeta
        latticeSpacing latticeSpacing_pos latticeSpacing_tendsto_zero
        physicalVolume physicalVolume_tendsto_atTop L O₁)
      (periodicHypercubicEvenRestrictedBoundaryVacuumScalarOSCarrier
        H N hN beta hbeta
        latticeSpacing latticeSpacing_pos latticeSpacing_tendsto_zero
        physicalVolume physicalVolume_tendsto_atTop L O₂) = _
  rw [P.inner_eq_osBilinForm]
  rw [PhysicalYangMillsGaugeInvariantOSReflectionData.osBilinForm_apply]
  rw [physicalYangMillsContinuumGaugeInvariantWeakStarState_apply]
  rfl

/-- Consequently, the square of the OS seminorm on a canonical scalar core
vector is exactly its continuum second moment. -/
theorem periodicHypercubicEvenRestrictedBoundaryVacuumScalarOS_norm_sq_eq_integral_sq
    (H : ℕ → ℕ)
    (N : ℕ) (hN : 0 < N)
    [Nontrivial (Matrix.specialUnitaryGroup (Fin N) ℂ)]
    (beta : ℕ → ℝ) (hbeta : ∀ n, 0 ≤ beta n)
    (latticeSpacing : ℕ → ℝ)
    (latticeSpacing_pos : ∀ n, 0 < latticeSpacing n)
    (latticeSpacing_tendsto_zero :
      Tendsto latticeSpacing atTop (nhds 0))
    (physicalVolume : ℕ → ℝ)
    (physicalVolume_tendsto_atTop :
      Tendsto physicalVolume atTop atTop)
    (L : PhysicalFourDimensionalYangMillsProkhorovSubsequenceLimit
      (periodicHypercubicEvenRestrictedBoundaryVacuumPhysicalEmbedding
        H N hN beta hbeta
        latticeSpacing latticeSpacing_pos latticeSpacing_tendsto_zero
        physicalVolume physicalVolume_tendsto_atTop).toLatticeEmbedding)
    (O : BoundedContinuousFunction ℝ ℝ) :
    ‖periodicHypercubicEvenRestrictedBoundaryVacuumScalarOSCarrier
        H N hN beta hbeta
        latticeSpacing latticeSpacing_pos latticeSpacing_tendsto_zero
        physicalVolume physicalVolume_tendsto_atTop L O‖ ^ 2 =
      ∫ x, O x * O x ∂ProbabilityMeasure.toMeasure L.continuumMeasure := by
  rw [← real_inner_self_eq_norm_sq]
  exact
    periodicHypercubicEvenRestrictedBoundaryVacuumScalarOS_inner_eq_integral_mul
      H N hN beta hbeta
      latticeSpacing latticeSpacing_pos latticeSpacing_tendsto_zero
      physicalVolume physicalVolume_tendsto_atTop L O O

/-- The OS null-space criterion on the canonical scalar core is literal
vanishing of the continuum second moment. -/
theorem periodicHypercubicEvenRestrictedBoundaryVacuumScalarOS_mem_null_iff_integral_sq_eq_zero
    (H : ℕ → ℕ)
    (N : ℕ) (hN : 0 < N)
    [Nontrivial (Matrix.specialUnitaryGroup (Fin N) ℂ)]
    (beta : ℕ → ℝ) (hbeta : ∀ n, 0 ≤ beta n)
    (latticeSpacing : ℕ → ℝ)
    (latticeSpacing_pos : ∀ n, 0 < latticeSpacing n)
    (latticeSpacing_tendsto_zero :
      Tendsto latticeSpacing atTop (nhds 0))
    (physicalVolume : ℕ → ℝ)
    (physicalVolume_tendsto_atTop :
      Tendsto physicalVolume atTop atTop)
    (L : PhysicalFourDimensionalYangMillsProkhorovSubsequenceLimit
      (periodicHypercubicEvenRestrictedBoundaryVacuumPhysicalEmbedding
        H N hN beta hbeta
        latticeSpacing latticeSpacing_pos latticeSpacing_tendsto_zero
        physicalVolume physicalVolume_tendsto_atTop).toLatticeEmbedding)
    (O : BoundedContinuousFunction ℝ ℝ) :
    let P := periodicHypercubicEvenRestrictedBoundaryVacuumScalarOSPreHilbertData
      H N hN beta hbeta
      latticeSpacing latticeSpacing_pos latticeSpacing_tendsto_zero
      physicalVolume physicalVolume_tendsto_atTop L
    periodicHypercubicEvenRestrictedBoundaryVacuumScalarOSCarrier
        H N hN beta hbeta
        latticeSpacing latticeSpacing_pos latticeSpacing_tendsto_zero
        physicalVolume physicalVolume_tendsto_atTop L O ∈ P.nullSubmodule ↔
      ∫ x, O x * O x ∂ProbabilityMeasure.toMeasure L.continuumMeasure = 0 := by
  dsimp only
  rw [PhysicalYangMillsGaugeInvariantOSReflectionData.OSPreHilbertData.mem_nullSubmodule]
  constructor
  · intro hnorm
    rw [← periodicHypercubicEvenRestrictedBoundaryVacuumScalarOS_norm_sq_eq_integral_sq
      H N hN beta hbeta
      latticeSpacing latticeSpacing_pos latticeSpacing_tendsto_zero
      physicalVolume physicalVolume_tendsto_atTop L O]
    rw [hnorm]
    simp
  · intro hIntegral
    have hsq :
        ‖periodicHypercubicEvenRestrictedBoundaryVacuumScalarOSCarrier
            H N hN beta hbeta
            latticeSpacing latticeSpacing_pos latticeSpacing_tendsto_zero
            physicalVolume physicalVolume_tendsto_atTop L O‖ ^ 2 = 0 := by
      rw [periodicHypercubicEvenRestrictedBoundaryVacuumScalarOS_norm_sq_eq_integral_sq
        H N hN beta hbeta
        latticeSpacing latticeSpacing_pos latticeSpacing_tendsto_zero
        physicalVolume physicalVolume_tendsto_atTop L O]
      exact hIntegral
    nlinarith [norm_nonneg
      (periodicHypercubicEvenRestrictedBoundaryVacuumScalarOSCarrier
        H N hN beta hbeta
        latticeSpacing latticeSpacing_pos latticeSpacing_tendsto_zero
        physicalVolume physicalVolume_tendsto_atTop L O)]

end

