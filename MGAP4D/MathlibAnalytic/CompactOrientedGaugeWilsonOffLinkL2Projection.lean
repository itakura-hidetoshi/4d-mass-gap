import MGAP4D.MathlibAnalytic.ContinuousCompactOrientedGaugeWilsonHeatBathJointIntegralSymmetry
import Mathlib.MeasureTheory.Function.ConditionalExpectation.CondexpL2

namespace MGAP4D
namespace MathlibAnalytic

open MeasureTheory
open scoped ENNReal

noncomputable section

/-- Restrict a physical-link configuration to all links except one selected
link. -/
def CompactOrientedGaugeWilsonSystem.offLinkRestriction
    (L : CompactOrientedGaugeWilsonSystem)
    (target : L.geometry.Edge) :
    L.Configuration → L.OffLinkConfiguration target :=
  fun A e => A e.1

/-- Restriction to all off-link coordinates is measurable. -/
theorem measurable_compact_oriented_offLinkRestriction
    (L : CompactOrientedGaugeWilsonSystem)
    (target : L.geometry.Edge) :
    Measurable (L.offLinkRestriction target) := by
  refine measurable_pi_lambda _ ?_
  intro e
  exact measurable_pi_apply e.1

/-- The sub-sigma-algebra generated by all physical links except one selected
link. -/
@[reducible] def CompactOrientedGaugeWilsonSystem.offLinkMeasurableSpace
    (L : CompactOrientedGaugeWilsonSystem)
    (target : L.geometry.Edge) :
    MeasurableSpace L.Configuration :=
  MeasurableSpace.comap (L.offLinkRestriction target) inferInstance

/-- The off-link sigma-algebra is a sub-sigma-algebra of the ambient finite
product Borel structure. -/
theorem compact_oriented_offLinkMeasurableSpace_le
    (L : CompactOrientedGaugeWilsonSystem)
    (target : L.geometry.Edge) :
    L.offLinkMeasurableSpace target ≤
      (inferInstance : MeasurableSpace L.Configuration) := by
  unfold CompactOrientedGaugeWilsonSystem.offLinkMeasurableSpace
  exact measurable_compact_oriented_offLinkRestriction L target

/-- Native compact-group one-link heat-bath projection on the genuine Gibbs
`L²` space, defined as conditional expectation onto the off-link sigma-algebra. -/
noncomputable def
    ContinuousCompactOrientedGaugeWilsonSystem.singleLinkHeatBathProjectionL2
    (C : ContinuousCompactOrientedGaugeWilsonSystem)
    (target : C.base.geometry.Edge) :
    Lp ℝ 2 C.gibbsMeasure →L[ℝ] Lp ℝ 2 C.gibbsMeasure :=
  (Submodule.subtypeL
      (lpMeas ℝ ℝ (C.base.offLinkMeasurableSpace target)
        2 C.gibbsMeasure)).comp
    (condExpL2 ℝ ℝ
      (compact_oriented_offLinkMeasurableSpace_le C.base target))

@[simp] theorem continuous_compact_oriented_singleLinkHeatBathProjectionL2_apply
    (C : ContinuousCompactOrientedGaugeWilsonSystem)
    (target : C.base.geometry.Edge)
    (f : Lp ℝ 2 C.gibbsMeasure) :
    C.singleLinkHeatBathProjectionL2 target f =
      (condExpL2 ℝ ℝ
        (compact_oriented_offLinkMeasurableSpace_le C.base target) f :
          Lp ℝ 2 C.gibbsMeasure) :=
  rfl

/-- The native compact-group one-link `L²` heat-bath projection is a
contraction. -/
theorem continuous_compact_oriented_singleLinkHeatBathProjectionL2_norm_le
    (C : ContinuousCompactOrientedGaugeWilsonSystem)
    (target : C.base.geometry.Edge)
    (f : Lp ℝ 2 C.gibbsMeasure) :
    ‖C.singleLinkHeatBathProjectionL2 target f‖ ≤ ‖f‖ := by
  rw [continuous_compact_oriented_singleLinkHeatBathProjectionL2_apply]
  exact norm_condExpL2_coe_le
    (compact_oriented_offLinkMeasurableSpace_le C.base target) f

/-- The native compact-group one-link `L²` heat-bath projection is
self-adjoint. -/
theorem continuous_compact_oriented_singleLinkHeatBathProjectionL2_inner_symm
    (C : ContinuousCompactOrientedGaugeWilsonSystem)
    (target : C.base.geometry.Edge)
    (f g : Lp ℝ 2 C.gibbsMeasure) :
    inner ℝ (C.singleLinkHeatBathProjectionL2 target f) g =
      inner ℝ f (C.singleLinkHeatBathProjectionL2 target g) := by
  rw [continuous_compact_oriented_singleLinkHeatBathProjectionL2_apply,
    continuous_compact_oriented_singleLinkHeatBathProjectionL2_apply]
  exact inner_condExpL2_left_eq_right
    (compact_oriented_offLinkMeasurableSpace_le C.base target)

end

end MathlibAnalytic
end MGAP4D
