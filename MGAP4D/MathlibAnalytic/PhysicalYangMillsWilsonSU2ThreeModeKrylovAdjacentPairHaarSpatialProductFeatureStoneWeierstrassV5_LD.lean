import MGAP4D.MathlibAnalytic.PhysicalYangMillsWilsonSU2ThreeModeKrylovAdjacentPairHaarOriginalPhysicalSourceLeftLinkFactorizationV5_LC
import MGAP4D.MathlibAnalytic.PhysicalYangMillsWilsonSU2ThreeModeKrylovAdjacentPairHaarSU2FeatureStoneWeierstrassV5_KK
import Mathlib.Topology.ContinuousMap.StoneWeierstrass
import Mathlib.Tactic

/-!
# P4-Q2-LD — genuine entire spatial SU(2)-link product coordinate density

LC reduces original centered-spatial-Wilson two-context GI
nondegeneracy to a concrete, original finite-volume Wilson transfer
nonvanishing witness. KK previously proves the eight real coordinate
functions of ONE actual SU(2) link generate a uniformly dense
subalgebra of C(SU(2),R).

Here we work instead on the ACTUAL full finite spatial configuration
space Cfg_H = Link_H -> SU(2). For every real spatial link e and
SU(2) matrix-real coordinate q, construct the literal continuous
coordinate A |-> Phi(A(e))[q]. Their finite-dimensional spatial
product-feature map is injective because SU(2) realification is
injective link by link (KJ). Hence the real algebra generated by ALL
true spatial link matrix entries separates configurations. Mathlib
Stone-Weierstrass proves it is dense in C(Cfg_H,R), including
arbitrary uniform approximation of actual continuous spatial
Wilson observables.

This is a direct formal mathematical input for the still-open FULL
finite-volume Wilson transfer kernel completeness. We do NOT infer
strict positivity/injectivity of the spatial product Wilson
exponential kernel from mere coordinate density here. The
necessary all-degree positive homogeneous-energy and physical
transfer bridge remain explicit subsequent proof obligations.

No independent-Haar posterior, synthetic rank source, sorry/admit,
new axiom, H1-C3 or continuum Yang-Mills mass gap claim.
-/

namespace MGAP4D
namespace MathlibAnalytic
open MeasureTheory
open scoped ENNReal Topology InnerProductSpace
noncomputable section
set_option maxHeartbeats 3900000
set_option synthInstance.maxHeartbeats 1050000

local instance p4Q2LD_topologicalGroup :
    IsTopologicalGroup (Matrix.specialUnitaryGroup (Fin 2) ℂ) :=
  specialUnitaryGroupIsTopologicalGroup 2
local instance p4Q2LD_compactSpace :
    CompactSpace (Matrix.specialUnitaryGroup (Fin 2) ℂ) :=
  specialUnitaryGroupCompactSpace 2
local instance p4Q2LD_secondCountable :
    SecondCountableTopology (Matrix.specialUnitaryGroup (Fin 2) ℂ) :=
  specialUnitaryGroupSecondCountableTopology 2
local instance p4Q2LD_measurableSpace :
    MeasurableSpace (Matrix.specialUnitaryGroup (Fin 2) ℂ) :=
  specialUnitaryGroupMeasurableSpace 2
local instance p4Q2LD_borelSpace :
    BorelSpace (Matrix.specialUnitaryGroup (Fin 2) ℂ) :=
  specialUnitaryGroupBorelSpace 2

namespace GroundStatePosteriorJoint
section SpatialProduct
variable (H : ℕ)
local notation "Gauge" => Matrix.specialUnitaryGroup (Fin 2) ℂ
local notation "Cfg" => PeriodicHypercubicEvenSpecialUnitarySpatialSliceConfiguration H 2
local notation "Link" => PeriodicHypercubicEvenSpatialSliceLink H
local notation "Coord" => ((Fin 2 × Fin 2) × Bool)
local notation "Phi" => specialUnitaryMatrixRealFeature 2
local notation "ProductCoord" => (Link × Coord)
local notation "ProductFeature" => EuclideanSpace ℝ ProductCoord

local instance p4Q2LD_linkFintype : Fintype Link :=
  Fintype.ofFinite _

/-- Continuous evaluation of one REAL matrix coordinate on one
physical spatial link. It uses KK's genuine SU(2) coordinate, not
an auxiliary polynomial test space. -/
noncomputable def p4Q2LD_originalSpatialLinkRealCoordinate
    (e : Link) (q : Coord) : C(Cfg, ℝ) :=
  (p4Q2KK_originalSU2MatrixRealCoordinate q).comp
    ⟨(fun A : Cfg => A e), continuous_apply e⟩

@[simp] theorem p4Q2LD_originalSpatialLinkRealCoordinate_apply
    (e : Link) (q : Coord) (A : Cfg) :
    p4Q2LD_originalSpatialLinkRealCoordinate H e q A =
      Phi (A e) q := by
  rfl

/-- Full actual spatial realification, indexed by each actual link
and each real/imaginary SU(2) matrix coordinate. -/
noncomputable def p4Q2LD_originalSpatialMatrixRealFeature
    (A : Cfg) : ProductFeature :=
  WithLp.toLp 2 (fun p : ProductCoord => Phi (A p.1) p.2)

@[simp] theorem p4Q2LD_originalSpatialMatrixRealFeature_apply
    (A : Cfg) (e : Link) (q : Coord) :
    p4Q2LD_originalSpatialMatrixRealFeature H A (e,q) =
      Phi (A e) q := by
  rfl

/-- No spatial-link information is lost by the actual FINITE
product SU(2) real matrix feature: equality in the real coordinate
space implies pointwise equality of all original gauge links. -/
theorem p4Q2LD_originalSpatialMatrixRealFeature_injective :
    Function.Injective (p4Q2LD_originalSpatialMatrixRealFeature H) := by
  intro A B hAB
  funext e
  apply p4Q2KJ_specialUnitaryMatrixRealFeature_injective 2
  ext q
  have hq := congrArg
    (fun v : ProductFeature => v (e,q)) hAB
  exact hq

/-- Genuine full finite-lattice spatial matrix coordinate algebra,
generated by real and imaginary entries of EVERY true SU(2) link. -/
noncomputable def p4Q2LD_originalSpatialMatrixCoordinateAlgebra :
    Subalgebra ℝ C(Cfg, ℝ) :=
  Algebra.adjoin ℝ
    (Set.range (fun p : ProductCoord =>
      p4Q2LD_originalSpatialLinkRealCoordinate H p.1 p.2))

/-- Every two distinct true spatial SU(2) configurations are
separated by one original real matrix entry of some real link. -/
theorem p4Q2LD_originalSpatialMatrixCoordinateAlgebra_separatesPoints :
    (p4Q2LD_originalSpatialMatrixCoordinateAlgebra H).SeparatesPoints := by
  intro A B hne
  have hFeatures :
      p4Q2LD_originalSpatialMatrixRealFeature H A ≠
        p4Q2LD_originalSpatialMatrixRealFeature H B := by
    intro hEq
    exact hne
      (p4Q2LD_originalSpatialMatrixRealFeature_injective H hEq)
  have hCoord : ∃ p : ProductCoord,
      p4Q2LD_originalSpatialMatrixRealFeature H A p ≠
        p4Q2LD_originalSpatialMatrixRealFeature H B p := by
    by_contra hn
    push Not at hn
    apply hFeatures
    ext p
    exact hn p
  obtain ⟨⟨e,q⟩, hq⟩ := hCoord
  refine ⟨(p4Q2LD_originalSpatialLinkRealCoordinate H e q : Cfg → ℝ), ?_, ?_⟩
  · refine ⟨p4Q2LD_originalSpatialLinkRealCoordinate H e q, ?_, rfl⟩
    change p4Q2LD_originalSpatialLinkRealCoordinate H e q ∈
      Algebra.adjoin ℝ
        (Set.range (fun p : ProductCoord =>
          p4Q2LD_originalSpatialLinkRealCoordinate H p.1 p.2))
    exact Algebra.mem_adjoin_of_mem (Set.mem_range_self (e,q))
  · simpa only [p4Q2LD_originalSpatialLinkRealCoordinate_apply,
      p4Q2LD_originalSpatialMatrixRealFeature_apply] using hq

/-- Pinned mathlib Stone-Weierstrass: all genuine original spatial
SU(2)-link matrix coordinates generate a uniformly DENSE real
subalgebra of continuous functions on the ENTIRE spatial slice. -/
theorem p4Q2LD_originalSpatialMatrixCoordinateAlgebra_closure_eq_top :
    (p4Q2LD_originalSpatialMatrixCoordinateAlgebra H).topologicalClosure = ⊤ :=
  ContinuousMap.subalgebra_topologicalClosure_eq_top_of_separatesPoints
    (p4Q2LD_originalSpatialMatrixCoordinateAlgebra H)
    (p4Q2LD_originalSpatialMatrixCoordinateAlgebra_separatesPoints H)

/-- Explicit uniform polynomial-coordinate approximation of EVERY
genuine continuous spatial observable, including the ACTUAL Wilson
spatial plaquette action and its centered variants. -/
theorem p4Q2LD_originalSpatialCoordinatePolynomial_approximate
    (f : C(Cfg, ℝ)) (ε : ℝ) (hε : 0 < ε) :
    ∃ g : p4Q2LD_originalSpatialMatrixCoordinateAlgebra H,
      ‖(g : C(Cfg, ℝ)) - f‖ < ε :=
  ContinuousMap.exists_mem_subalgebra_near_continuousMap_of_separatesPoints
    (p4Q2LD_originalSpatialMatrixCoordinateAlgebra H)
    (p4Q2LD_originalSpatialMatrixCoordinateAlgebra_separatesPoints H)
    f ε hε

end SpatialProduct
end GroundStatePosteriorJoint
end
end MathlibAnalytic
end MGAP4D

