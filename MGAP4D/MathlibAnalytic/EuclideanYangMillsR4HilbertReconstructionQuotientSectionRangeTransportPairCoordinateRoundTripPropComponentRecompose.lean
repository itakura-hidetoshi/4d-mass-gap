/-- Recompose the named quotient-generated coordinate round-trip proposition from its components. -/
theorem quotientPairCoordinateRoundTripProp_recompose_from_components (q : quotientCarrier I) :
    quotientPairCoordinateRoundTripProp I TR q := by
  exact ⟨
    quotientPairCoordinateRoundTripProp_inverse_component I TR q,
    quotientPairCoordinateRoundTripProp_forward_component I TR q⟩

/-- Recompose the named range-generated coordinate round-trip proposition from its components. -/
theorem rangePairCoordinateRoundTripProp_recompose_from_components (x : selectedSectionRangeCarrier I X) :
    rangePairCoordinateRoundTripProp I TR x := by
  exact ⟨
    rangePairCoordinateRoundTripProp_forward_component I TR x,
    rangePairCoordinateRoundTripProp_inverse_component I TR x⟩

