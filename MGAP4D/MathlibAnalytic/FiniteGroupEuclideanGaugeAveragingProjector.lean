import MGAP4D.MathlibAnalytic.FiniteOSGramKernelEuclideanTransfer
import Mathlib.Tactic

namespace MGAP4D
namespace MathlibAnalytic

open scoped BigOperators InnerProduct

noncomputable section

/-- The permutation equivalence generated by one element of a group action. -/
def finiteMulActionEquiv
    (G α : Type) [Group G] [MulAction G α]
    (g : G) : α ≃ α where
  toFun := fun x => g • x
  invFun := fun x => g⁻¹ • x
  left_inv := by
    intro x
    simp
  right_inv := by
    intro x
    simp

/-- Right multiplication in a finite group, used to reindex gauge averages. -/
def finiteGroupActionRightMulEquiv
    (G : Type) [Group G]
    (a : G) : G ≃ G where
  toFun := fun g => g * a
  invFun := fun g => g * a⁻¹
  left_inv := by
    intro g
    simp [mul_assoc]
  right_inv := by
    intro g
    simp [mul_assoc]

/-- Pullback representation of a finite group action on the standard Euclidean
function Hilbert space. -/
noncomputable def finiteMulActionPullbackLinearMap
    (G α : Type) [Group G] [Fintype α] [MulAction G α]
    (g : G) :
    FiniteBoundaryHilbert α →ₗ[ℝ] FiniteBoundaryHilbert α where
  toFun f := WithLp.toLp 2 fun x : α => f (g⁻¹ • x)
  map_add' f h := by
    ext x
    rfl
  map_smul' c f := by
    ext x
    rfl

/-- The finite-dimensional pullback representation is automatically
continuous. -/
noncomputable def finiteMulActionPullbackOperator
    (G α : Type) [Group G] [Fintype α] [MulAction G α]
    (g : G) :
    FiniteBoundaryHilbert α →L[ℝ] FiniteBoundaryHilbert α :=
  LinearMap.toContinuousLinearMap
    (finiteMulActionPullbackLinearMap G α g)

@[simp] theorem finiteMulActionPullbackOperator_apply
    (G α : Type) [Group G] [Fintype α] [MulAction G α]
    (g : G)
    (f : FiniteBoundaryHilbert α)
    (x : α) :
    finiteMulActionPullbackOperator G α g f x = f (g⁻¹ • x) :=
  rfl

/-- Identity gauge transformation acts as the identity operator. -/
theorem finiteMulActionPullbackOperator_one
    (G α : Type) [Group G] [Fintype α] [MulAction G α] :
    finiteMulActionPullbackOperator G α (1 : G) = 1 := by
  ext f x
  simp

/-- Pullbacks form a genuine representation of the gauge group. -/
theorem finiteMulActionPullbackOperator_mul
    (G α : Type) [Group G] [Fintype α] [MulAction G α]
    (g h : G) :
    finiteMulActionPullbackOperator G α (g * h) =
      (finiteMulActionPullbackOperator G α g).comp
        (finiteMulActionPullbackOperator G α h) := by
  ext f x
  simp [mul_smul]

/-- Every gauge pullback preserves the real Hilbert inner product. -/
theorem finiteMulActionPullbackOperator_inner
    (G α : Type) [Group G] [Fintype α] [MulAction G α]
    (g : G)
    (f h : FiniteBoundaryHilbert α) :
    inner ℝ
        (finiteMulActionPullbackOperator G α g f)
        (finiteMulActionPullbackOperator G α g h) =
      inner ℝ f h := by
  classical
  rw [PiLp.inner_apply, PiLp.inner_apply]
  refine Fintype.sum_equiv (finiteMulActionEquiv G α g⁻¹) _ _ ?_
  intro x
  simp [finiteMulActionEquiv]

/-- Gauge pullbacks are isometries. -/
theorem finiteMulActionPullbackOperator_norm
    (G α : Type) [Group G] [Fintype α] [MulAction G α]
    (g : G)
    (f : FiniteBoundaryHilbert α) :
    ‖finiteMulActionPullbackOperator G α g f‖ = ‖f‖ := by
  have hsquare :
      ‖finiteMulActionPullbackOperator G α g f‖ ^ 2 = ‖f‖ ^ 2 := by
    simpa [real_inner_self_eq_norm_sq] using
      finiteMulActionPullbackOperator_inner G α g f f
  exact (sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)).mp hsquare

/-- Pointwise finite-group average on the Euclidean boundary Hilbert space. -/
noncomputable def finiteGroupAveragingLinearMap
    (G α : Type) [Group G] [Fintype G] [Fintype α] [MulAction G α] :
    FiniteBoundaryHilbert α →ₗ[ℝ] FiniteBoundaryHilbert α where
  toFun f := WithLp.toLp 2 fun x : α =>
    (Fintype.card G : ℝ)⁻¹ * ∑ g : G, f (g • x)
  map_add' f h := by
    ext x
    change
      (Fintype.card G : ℝ)⁻¹ *
          (∑ g : G, (f (g • x) + h (g • x))) =
        (Fintype.card G : ℝ)⁻¹ * ∑ g : G, f (g • x) +
          (Fintype.card G : ℝ)⁻¹ * ∑ g : G, h (g • x)
    rw [Finset.sum_add_distrib]
    ring
  map_smul' c f := by
    ext x
    change
      (Fintype.card G : ℝ)⁻¹ *
          (∑ g : G, c * f (g • x)) =
        c * ((Fintype.card G : ℝ)⁻¹ * ∑ g : G, f (g • x))
    rw [← Finset.mul_sum]
    ring

/-- Continuous finite gauge average. -/
noncomputable def finiteGroupAveragingProjector
    (G α : Type) [Group G] [Fintype G] [Fintype α] [MulAction G α] :
    FiniteBoundaryHilbert α →L[ℝ] FiniteBoundaryHilbert α :=
  LinearMap.toContinuousLinearMap
    (finiteGroupAveragingLinearMap G α)

@[simp] theorem finiteGroupAveragingProjector_apply
    (G α : Type) [Group G] [Fintype G] [Fintype α] [MulAction G α]
    (f : FiniteBoundaryHilbert α)
    (x : α) :
    finiteGroupAveragingProjector G α f x =
      (Fintype.card G : ℝ)⁻¹ * ∑ g : G, f (g • x) :=
  rfl

/-- Gauge-invariant Euclidean boundary vectors. -/
def finiteGroupInvariantSubmodule
    (G α : Type) [Group G] [Fintype α] [MulAction G α] :
    Submodule ℝ (FiniteBoundaryHilbert α) where
  carrier := {f | ∀ g : G, ∀ x : α, f (g • x) = f x}
  zero_mem' := by
    intro g x
    rfl
  add_mem' := by
    intro f h hf hh g x
    change f (g • x) + h (g • x) = f x + h x
    rw [hf g x, hh g x]
  smul_mem' := by
    intro c f hf g x
    change c * f (g • x) = c * f x
    rw [hf g x]

/-- The finite gauge average is gauge invariant. -/
theorem finiteGroupAveragingProjector_mem_invariant
    (G α : Type) [Group G] [Fintype G] [Fintype α] [MulAction G α]
    (f : FiniteBoundaryHilbert α) :
    finiteGroupAveragingProjector G α f ∈
      finiteGroupInvariantSubmodule G α := by
  classical
  intro a x
  change
    (Fintype.card G : ℝ)⁻¹ * ∑ g : G, f (g • (a • x)) =
      (Fintype.card G : ℝ)⁻¹ * ∑ g : G, f (g • x)
  congr 1
  refine Fintype.sum_equiv (finiteGroupActionRightMulEquiv G a) _ _ ?_
  intro g
  change f (g • (a • x)) = f ((g * a) • x)
  rw [mul_smul]

/-- Gauge averaging fixes every invariant vector. -/
theorem finiteGroupAveragingProjector_eq_self_of_mem
    (G α : Type) [Group G] [Fintype G] [Fintype α] [MulAction G α]
    (f : FiniteBoundaryHilbert α)
    (hf : f ∈ finiteGroupInvariantSubmodule G α) :
    finiteGroupAveragingProjector G α f = f := by
  classical
  have hcard : (Fintype.card G : ℝ) ≠ 0 := by
    exact_mod_cast Fintype.card_ne_zero
  ext x
  change
    (Fintype.card G : ℝ)⁻¹ * ∑ g : G, f (g • x) = f x
  simp_rw [hf]
  simp [hcard]

/-- The finite gauge average is idempotent. -/
theorem finiteGroupAveragingProjector_idempotent
    (G α : Type) [Group G] [Fintype G] [Fintype α] [MulAction G α] :
    (finiteGroupAveragingProjector G α).comp
        (finiteGroupAveragingProjector G α) =
      finiteGroupAveragingProjector G α := by
  apply ContinuousLinearMap.ext
  intro f
  change
    finiteGroupAveragingProjector G α
        (finiteGroupAveragingProjector G α f) =
      finiteGroupAveragingProjector G α f
  exact finiteGroupAveragingProjector_eq_self_of_mem G α _
    (finiteGroupAveragingProjector_mem_invariant G α f)

/-- Reindexing one acted coordinate against an invariant test vector leaves the
finite inner-product sum unchanged. -/
theorem finiteMulAction_sum_against_invariant
    (G α : Type) [Group G] [Fintype α] [MulAction G α]
    (f h : FiniteBoundaryHilbert α)
    (hh : h ∈ finiteGroupInvariantSubmodule G α)
    (g : G) :
    (∑ x : α, h x * f (g • x)) =
      ∑ x : α, h x * f x := by
  classical
  refine Fintype.sum_equiv (finiteMulActionEquiv G α g) _ _ ?_
  intro x
  change h x * f (g • x) = h (g • x) * f (g • x)
  rw [hh g x]

/-- Gauge averaging preserves pairing with every invariant vector. -/
theorem finiteGroupAveragingProjector_inner_invariant
    (G α : Type) [Group G] [Fintype G] [Fintype α] [MulAction G α]
    (f h : FiniteBoundaryHilbert α)
    (hh : h ∈ finiteGroupInvariantSubmodule G α) :
    inner ℝ (finiteGroupAveragingProjector G α f) h =
      inner ℝ f h := by
  classical
  have hcard : (Fintype.card G : ℝ) ≠ 0 := by
    exact_mod_cast Fintype.card_ne_zero
  rw [PiLp.inner_apply, PiLp.inner_apply]
  change
    (∑ x : α,
      h x * ((Fintype.card G : ℝ)⁻¹ * ∑ g : G, f (g • x))) =
      ∑ x : α, h x * f x
  calc
    (∑ x : α,
      h x * ((Fintype.card G : ℝ)⁻¹ * ∑ g : G, f (g • x))) =
        ∑ x : α, ∑ g : G,
          (Fintype.card G : ℝ)⁻¹ * (h x * f (g • x)) := by
      apply Finset.sum_congr rfl
      intro x _hx
      rw [← mul_assoc, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro g _hg
      ring
    _ = ∑ g : G, ∑ x : α,
          (Fintype.card G : ℝ)⁻¹ * (h x * f (g • x)) := by
      rw [Finset.sum_comm]
    _ = ∑ g : G,
          (Fintype.card G : ℝ)⁻¹ *
            (∑ x : α, h x * f (g • x)) := by
      apply Finset.sum_congr rfl
      intro g _hg
      rw [Finset.mul_sum]
    _ = ∑ g : G,
          (Fintype.card G : ℝ)⁻¹ *
            (∑ x : α, h x * f x) := by
      apply Finset.sum_congr rfl
      intro g _hg
      rw [finiteMulAction_sum_against_invariant G α f h hh g]
    _ = ∑ x : α, h x * f x := by
      simp [hcard]

/-- The residual after gauge averaging is orthogonal to the invariant
subspace, so the average is the orthogonal projector onto that subspace. -/
theorem finiteGroupAveragingProjector_orthogonal
    (G α : Type) [Group G] [Fintype G] [Fintype α] [MulAction G α]
    (f : FiniteBoundaryHilbert α)
    (h : finiteGroupInvariantSubmodule G α) :
    inner ℝ (f - finiteGroupAveragingProjector G α f) h.1 = 0 := by
  rw [inner_sub_left,
    finiteGroupAveragingProjector_inner_invariant G α f h.1 h.2]
  exact sub_self _

/-- Public generic finite-group Euclidean gauge projection package. -/
theorem finiteGroupEuclideanGaugeAveragingProjectorPackage
    (G α : Type) [Group G] [Fintype G] [Fintype α] [MulAction G α] :
    ((finiteGroupAveragingProjector G α).comp
        (finiteGroupAveragingProjector G α) =
      finiteGroupAveragingProjector G α) ∧
    (∀ f : FiniteBoundaryHilbert α,
      finiteGroupAveragingProjector G α f ∈
        finiteGroupInvariantSubmodule G α) ∧
    (∀ f : FiniteBoundaryHilbert α,
      ∀ h : finiteGroupInvariantSubmodule G α,
      inner ℝ (f - finiteGroupAveragingProjector G α f) h.1 = 0) := by
  exact ⟨
    finiteGroupAveragingProjector_idempotent G α,
    finiteGroupAveragingProjector_mem_invariant G α,
    finiteGroupAveragingProjector_orthogonal G α⟩

end

