import MGAP4D.MathlibAnalytic.ConcreteAnalyticSpineL2R2CompletedUnitEigenpairGrowthCertificate

namespace MGAP4D
namespace MathlibAnalytic

open scoped ENNReal lp

noncomputable section

/-- Completed diagonal eigenpair graph carrier generated by the obstruction
unit probes.  This is not yet the full graph of a completed diagonal operator;
it is the eigenpair subgraph certified by the unit-growth construction. -/
def concreteL2R2CompletedDiagonalEigenpairGraphCarrier :
    Set ((lp (fun _ : ℕ => ℝ) 2) × (lp (fun _ : ℕ => ℝ) 2)) :=
  {p | ∃ k : ℕ,
    p = (concreteL2R2CompletedObstructionUnitInputProbe k,
      concreteL2R2CompletedObstructionUnitOutputProbe k)}

/-- Every obstruction-selected completed input/output pair belongs to the
completed diagonal eigenpair graph carrier. -/
theorem concrete_l2_r2_completed_obstruction_pair_mem_eigenpair_graph
    (k : ℕ) :
    (concreteL2R2CompletedObstructionUnitInputProbe k,
      concreteL2R2CompletedObstructionUnitOutputProbe k) ∈
        concreteL2R2CompletedDiagonalEigenpairGraphCarrier := by
  exact ⟨k, rfl⟩

/-- Points of the completed diagonal eigenpair graph carry the obstruction
input/output representation for some threshold. -/
theorem concrete_l2_r2_completed_eigenpair_graph_mem_elim
    {p : (lp (fun _ : ℕ => ℝ) 2) × (lp (fun _ : ℕ => ℝ) 2)}
    (hp : p ∈ concreteL2R2CompletedDiagonalEigenpairGraphCarrier) :
    ∃ k : ℕ,
      p.1 = concreteL2R2CompletedObstructionUnitInputProbe k ∧
      p.2 = concreteL2R2CompletedObstructionUnitOutputProbe k := by
  rcases hp with ⟨k, rfl⟩
  exact ⟨k, rfl, rfl⟩

/-- The completed diagonal eigenpair graph has unit input and arbitrarily large
certified output along the obstruction family. -/
def concreteL2R2CompletedDiagonalEigenpairGraphGrowthCertificate : Prop :=
  ∀ k : ℕ,
    ∃ p : (lp (fun _ : ℕ => ℝ) 2) × (lp (fun _ : ℕ => ℝ) 2),
      p ∈ concreteL2R2CompletedDiagonalEigenpairGraphCarrier ∧
      ‖p.1‖ = 1 ∧
      (k : ℝ) < ‖p.2‖

/-- The completed diagonal eigenpair graph growth certificate is proved from the
completed unit-vector growth layer. -/
theorem concrete_l2_r2_completed_diagonal_eigenpair_graph_growth_certificate :
    concreteL2R2CompletedDiagonalEigenpairGraphGrowthCertificate := by
  intro k
  refine ⟨
    (concreteL2R2CompletedObstructionUnitInputProbe k,
      concreteL2R2CompletedObstructionUnitOutputProbe k), ?_⟩
  exact ⟨
    concrete_l2_r2_completed_obstruction_pair_mem_eigenpair_graph k,
    concrete_l2_r2_completed_obstruction_unit_input_norm_eq_one k,
    concrete_l2_r2_completed_obstruction_unit_output_norm_gt_threshold k⟩

/-- Public theorem-entry predicate for the completed diagonal eigenpair graph
surface. -/
def concreteAnalyticSpineL2R2CompletedDiagonalEigenpairGraphSurfaceReady : Prop :=
  concreteAnalyticSpineL2R2CompletedUnitEigenpairGrowthCertificateReady ∧
  concreteL2R2CompletedDiagonalEigenpairGraphGrowthCertificate

/-- The completed diagonal eigenpair graph surface is ready. -/
theorem concrete_analytic_spine_l2_r2_completed_diagonal_eigenpair_graph_surface_ready :
    concreteAnalyticSpineL2R2CompletedDiagonalEigenpairGraphSurfaceReady := by
  exact ⟨
    concrete_analytic_spine_l2_r2_completed_unit_eigenpair_growth_certificate_ready,
    concrete_l2_r2_completed_diagonal_eigenpair_graph_growth_certificate⟩

end

end MathlibAnalytic
end MGAP4D
