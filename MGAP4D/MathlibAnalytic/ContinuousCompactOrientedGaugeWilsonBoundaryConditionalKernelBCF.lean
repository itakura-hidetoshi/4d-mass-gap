import MGAP4D.MathlibAnalytic.ContinuousCompactOrientedGaugeWilsonBoundaryConditionalFactorizationBCF
import Mathlib.Probability.Kernel.Composition.Prod
import Mathlib.Probability.Kernel.WithDensity
import Mathlib.Tactic

namespace MGAP4D
namespace MathlibAnalytic

open MeasureTheory ProbabilityTheory
open scoped ENNReal ProbabilityTheory

noncomputable section

/-- The normalized compact-Haar one-link conditional density written directly
as a function of the actual off-target boundary. -/
def ContinuousCompactOrientedGaugeWilsonSystem.singleLinkBoundaryConditionalDensity
    (C : ContinuousCompactOrientedGaugeWilsonSystem)
    (target : C.base.geometry.Edge)
    (boundary : C.OffTargetBoundary target)
    (g : C.base.Gauge) : ℝ≥0∞ :=
  C.singleLinkConditionalDensity target
    (C.offTargetBoundarySection target boundary) g

/-- The boundary-indexed conditional density is jointly measurable in the
boundary and the inserted compact-group value. -/
theorem measurable_compact_oriented_singleLinkBoundaryConditionalDensity_uncurry
    (C : ContinuousCompactOrientedGaugeWilsonSystem)
    (target : C.base.geometry.Edge) :
    Measurable (Function.uncurry
      (C.singleLinkBoundaryConditionalDensity target)) := by
  have hPair : Measurable
      (fun z : C.OffTargetBoundary target × C.base.Gauge =>
        (C.offTargetBoundarySection target z.1, z.2)) :=
    ((continuous_compact_oriented_offTargetBoundarySection_measurable
      C target).comp measurable_fst).prodMk measurable_snd
  simpa [Function.uncurry,
    ContinuousCompactOrientedGaugeWilsonSystem.singleLinkBoundaryConditionalDensity]
    using
      (measurable_compact_oriented_singleLinkConditionalDensity_uncurry
        C target).comp hPair

/-- Exact compact-Haar one-link conditional Markov kernel indexed by the
physical off-target boundary rather than a redundant full configuration. -/
noncomputable def
    ContinuousCompactOrientedGaugeWilsonSystem.singleLinkBoundaryConditionalKernel
    (C : ContinuousCompactOrientedGaugeWilsonSystem)
    (target : C.base.geometry.Edge) :
    Kernel (C.OffTargetBoundary target) C.base.Gauge :=
  Kernel.withDensity
    (Kernel.const (C.OffTargetBoundary target)
      (normalizedCompactHaar C.base.Gauge))
    (C.singleLinkBoundaryConditionalDensity target)

/-- Pointwise, the boundary conditional kernel is the exact boundary-indexed
conditional probability measure constructed previously. -/
theorem continuous_compact_oriented_singleLinkBoundaryConditionalKernel_apply
    (C : ContinuousCompactOrientedGaugeWilsonSystem)
    (target : C.base.geometry.Edge)
    (boundary : C.OffTargetBoundary target) :
    C.singleLinkBoundaryConditionalKernel target boundary =
      C.singleLinkBoundaryConditionalMeasure target boundary := by
  rw [ContinuousCompactOrientedGaugeWilsonSystem.singleLinkBoundaryConditionalKernel,
    Kernel.withDensity_apply _
      (measurable_compact_oriented_singleLinkBoundaryConditionalDensity_uncurry
        C target),
    Kernel.const_apply]
  unfold
    ContinuousCompactOrientedGaugeWilsonSystem.singleLinkBoundaryConditionalDensity
    ContinuousCompactOrientedGaugeWilsonSystem.singleLinkBoundaryConditionalMeasure
  exact
    (continuous_compact_oriented_singleLinkConditionalMeasure_eq_withDensity
      C (C.offTargetBoundarySection target boundary) target).symm

/-- The boundary-indexed exact conditional kernel is Markov. -/
instance continuousCompactOriented_singleLinkBoundaryConditionalKernel_isMarkov
    (C : ContinuousCompactOrientedGaugeWilsonSystem)
    (target : C.base.geometry.Edge) :
    IsMarkovKernel (C.singleLinkBoundaryConditionalKernel target) :=
  ⟨fun boundary => by
    rw [continuous_compact_oriented_singleLinkBoundaryConditionalKernel_apply]
    exact
      continuous_compact_oriented_singleLinkBoundaryConditionalMeasure_isProbabilityMeasure
        C target boundary⟩

/-- Two conditionally independent target-link samples generated by the same
measurable boundary conditional kernel. -/
noncomputable def
    ContinuousCompactOrientedGaugeWilsonSystem.singleLinkBoundaryConditionalPairKernel
    (C : ContinuousCompactOrientedGaugeWilsonSystem)
    (target : C.base.geometry.Edge) :
    Kernel (C.OffTargetBoundary target)
      (C.base.Gauge × C.base.Gauge) :=
  C.singleLinkBoundaryConditionalKernel target ×ₖ
    C.singleLinkBoundaryConditionalKernel target

/-- The boundary conditional-pair kernel is Markov. -/
instance continuousCompactOriented_singleLinkBoundaryConditionalPairKernel_isMarkov
    (C : ContinuousCompactOrientedGaugeWilsonSystem)
    (target : C.base.geometry.Edge) :
    IsMarkovKernel (C.singleLinkBoundaryConditionalPairKernel target) := by
  unfold
    ContinuousCompactOrientedGaugeWilsonSystem.singleLinkBoundaryConditionalPairKernel
  infer_instance

/-- Pointwise, the boundary conditional-pair kernel is exactly the product of
two independent copies of the native boundary conditional law. -/
theorem continuous_compact_oriented_singleLinkBoundaryConditionalPairKernel_apply
    (C : ContinuousCompactOrientedGaugeWilsonSystem)
    (target : C.base.geometry.Edge)
    (boundary : C.OffTargetBoundary target) :
    C.singleLinkBoundaryConditionalPairKernel target boundary =
      C.singleLinkBoundaryConditionalPairMeasure target boundary := by
  unfold
    ContinuousCompactOrientedGaugeWilsonSystem.singleLinkBoundaryConditionalPairKernel
    ContinuousCompactOrientedGaugeWilsonSystem.singleLinkBoundaryConditionalPairMeasure
  rw [Kernel.prod_apply,
    continuous_compact_oriented_singleLinkBoundaryConditionalKernel_apply,
    continuous_compact_oriented_singleLinkBoundaryConditionalKernel_apply]

/-- Markov kernel on the common boundary-target-pair carrier: retain the input
boundary and draw two conditionally independent exact target-link samples. -/
noncomputable def
    ContinuousCompactOrientedGaugeWilsonSystem.singleLinkBoundaryTargetPairKernel
    (C : ContinuousCompactOrientedGaugeWilsonSystem)
    (target : C.base.geometry.Edge) :
    Kernel (C.OffTargetBoundary target)
      (C.OffTargetBoundaryTargetPair target) :=
  Kernel.id ×ₖ C.singleLinkBoundaryConditionalPairKernel target

/-- The boundary-target-pair kernel is Markov. -/
instance continuousCompactOriented_singleLinkBoundaryTargetPairKernel_isMarkov
    (C : ContinuousCompactOrientedGaugeWilsonSystem)
    (target : C.base.geometry.Edge) :
    IsMarkovKernel (C.singleLinkBoundaryTargetPairKernel target) := by
  unfold
    ContinuousCompactOrientedGaugeWilsonSystem.singleLinkBoundaryTargetPairKernel
  infer_instance

/-- Pointwise, the measurable boundary-target-pair kernel recovers the fixed
boundary joint law from the preceding factorization layer. -/
theorem continuous_compact_oriented_singleLinkBoundaryTargetPairKernel_apply
    (C : ContinuousCompactOrientedGaugeWilsonSystem)
    (target : C.base.geometry.Edge)
    (boundary : C.OffTargetBoundary target) :
    C.singleLinkBoundaryTargetPairKernel target boundary =
      C.singleLinkBoundaryTargetPairMeasure target boundary := by
  unfold
    ContinuousCompactOrientedGaugeWilsonSystem.singleLinkBoundaryTargetPairKernel
    ContinuousCompactOrientedGaugeWilsonSystem.singleLinkBoundaryTargetPairMeasure
    ContinuousCompactOrientedGaugeWilsonSystem.offTargetBoundaryTargetPairBoundaryInsertMap
  rw [Kernel.prod_apply,
    continuous_compact_oriented_singleLinkBoundaryConditionalPairKernel_apply]
  simp

/-- The original configuration-indexed native joint kernel is the pullback of
the measurable boundary kernel along boundary restriction. -/
theorem continuous_compact_oriented_singleLinkHeatBathBoundaryTargetPairKernel_apply_eq_boundaryKernel
    (C : ContinuousCompactOrientedGaugeWilsonSystem)
    (target : C.base.geometry.Edge)
    (A : C.base.Configuration) :
    C.singleLinkHeatBathBoundaryTargetPairKernel target A =
      C.singleLinkBoundaryTargetPairKernel target
        (C.offTargetBoundaryMap target A) := by
  rw [continuous_compact_oriented_singleLinkHeatBathBoundaryTargetPairKernel_apply_eq_boundary,
    continuous_compact_oriented_singleLinkBoundaryTargetPairKernel_apply]

end

end MathlibAnalytic
end MGAP4D
