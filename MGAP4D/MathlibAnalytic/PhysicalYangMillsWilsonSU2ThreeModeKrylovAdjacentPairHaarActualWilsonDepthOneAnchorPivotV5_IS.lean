namespace GroundStatePosteriorJoint

/-- Every two-mode scalar detector annihilates its own anchored
determinant vector. This identity is algebraic and does not assume
physical source independence or a nonzero detector anchor. -/
theorem p4Q2IS_abstract_twoMode_pivot_null
    {E : Type*} [AddCommGroup E] [Module ℝ E]
    (D : E →ₗ[ℝ] ℝ) (u v : E) :
    D (D u • v - D v • u) = 0 := by
  simp only [map_sub, map_smul, smul_eq_mul]
  ring

/-- Under a nonzero original zero-mode scalar anchor, the full
one-context detector kernel is generated by precisely ONE two-mode
coefficient pivot. This is an equality of actual coefficients, not an
assumed separation of physical source and GI kernels. -/
theorem p4Q2IS_abstract_twoMode_kernel_spanned_by_pivot
    {E : Type*} [AddCommGroup E] [Module ℝ E]
    (D : E →ₗ[ℝ] ℝ) (u v : E)
    (hSpan : ∀ a : E, ∃ x y : ℝ, a = x • u + y • v)
    (hAnchor : D u ≠ 0) (a : E) (ha : D a = 0) :
    ∃ t : ℝ, a = t • (D u • v - D v • u) := by
  obtain ⟨x, y, hxy⟩ := hSpan a
  have hLinear : x * D u + y * D v = 0 := by
    have h := ha
    rw [hxy] at h
    simpa only [map_add, map_smul, smul_eq_mul] using h
  have hScalar : D u * x = -(y * D v) := by
    nlinarith [hLinear]
  have hPivot :
      D u • (x • u + y • v) = y • (D u • v - D v • u) := by
    calc
      D u • (x • u + y • v) =
          (D u * x) • u + (D u * y) • v := by
            rw [smul_add, smul_smul, smul_smul]
      _ = (-(y * D v)) • u + (y * D u) • v := by
            rw [hScalar, mul_comm (D u) y]
      _ = y • (D u • v - D v • u) := by
            simp only [smul_sub, smul_smul, neg_smul, sub_eq_add_neg]
            abel
  refine ⟨y / D u, ?_⟩
  calc
    a = x • u + y • v := hxy
    _ = (D u)⁻¹ • (D u • (x • u + y • v)) := by
      simp [smul_smul, hAnchor]
    _ = (D u)⁻¹ • (y • (D u • v - D v • u)) := by rw [hPivot]
    _ = (y / D u) • (D u • v - D v • u) := by
      simp only [smul_smul, div_eq_mul_inv]
      congr 1
      ring

/-- A TWO-MODE physical synthesis is separated by a complete GI detector
exactly when the zero-of-one-anchor pivot is either physically zero or
GI-visible somewhere else. Unlike bare rank equality, this isolates an
explicit physical coefficient obstruction constructed from a genuine
nonzero anchor. -/
theorem p4Q2IS_abstract_twoMode_pivot_separation
    {E F G : Type*}
    [AddCommGroup E] [Module ℝ E]
    [AddCommGroup F] [Module ℝ F]
    [AddCommGroup G] [Module ℝ G]
    (S : E →ₗ[ℝ] F) (Phi : E →ₗ[ℝ] G)
    (D : E →ₗ[ℝ] ℝ) (u v : E)
    (hSpan : ∀ a : E, ∃ x y : ℝ, a = x • u + y • v)
    (hLe : S.ker ≤ Phi.ker)
    (hEvaluate : ∀ a : E, Phi a = 0 → D a = 0)
    (hAnchor : D u ≠ 0) :
    S.ker = Phi.ker ↔
      S (D u • v - D v • u) = 0 ∨
      Phi (D u • v - D v • u) ≠ 0 := by
  let w : E := D u • v - D v • u
  constructor
  · intro hEq
    by_cases hPhi : Phi w = 0
    · left
      apply (LinearMap.mem_ker).mp
      rw [hEq]
      exact (LinearMap.mem_ker).mpr hPhi
    · exact Or.inr hPhi
  · intro hAlternative
    apply le_antisymm hLe
    intro a ha
    have hPhi : Phi a = 0 := (LinearMap.mem_ker).mp ha
    have hD : D a = 0 := hEvaluate a hPhi
    obtain ⟨t, ht⟩ :=
      p4Q2IS_abstract_twoMode_kernel_spanned_by_pivot
        D u v hSpan hAnchor a hD
    have ht' : a = t • w := ht
    apply (LinearMap.mem_ker).mpr
    rcases hAlternative with hSource | hVisible
    · calc
        S a = S (t • w) := congrArg S ht'
        _ = t • S w := map_smul S t w
        _ = 0 := by rw [hSource, smul_zero]
    · have hT : t • Phi w = 0 := by
        calc
          t • Phi w = Phi (t • w) := (map_smul Phi t w).symm
          _ = Phi a := congrArg Phi ht'.symm
          _ = 0 := hPhi
      have htZero : t = 0 := by
        by_contra htNotZero
        exact (smul_ne_zero htNotZero hVisible) hT
      rw [ht', htZero, zero_smul, map_zero]

/-- Selects the literal first nontrivial (depth-one) coefficient. -/
def p4Q2IS_depthOneCoefficient : Fin (1 + 1) → ℝ :=
  fun j => if j = 1 then 1 else 0

/-- Every genuine two-mode fine-right coefficient has exactly its
expected zero- and first-depth decomposition. -/
theorem p4Q2IS_depthOne_coeff_decompose (a : Fin (1 + 1) → ℝ) :
    ∃ x y : ℝ,
      a = x • p4Q2GX_rightZeroCoefficient 1 +
        y • p4Q2IS_depthOneCoefficient := by
  refine ⟨a 0, a 1, ?_⟩
  funext j
  fin_cases j <;>
    simp [p4Q2GX_rightZeroCoefficient, p4Q2IS_depthOneCoefficient,
      Pi.add_apply, Pi.smul_apply]

/-- Explicit depth-one coefficient pivot built from two literal
original Wilson GI modal values at a single fixed context. -/
noncomputable def p4Q2IS_depthOnePivot
    (D : (Fin (1 + 1) → ℝ) →ₗ[ℝ] ℝ) : Fin (1 + 1) → ℝ :=
  D (p4Q2GX_rightZeroCoefficient 1) • p4Q2IS_depthOneCoefficient -
    D p4Q2IS_depthOneCoefficient • p4Q2GX_rightZeroCoefficient 1

theorem p4Q2IS_depthOnePivot_anchor_null
    (D : (Fin (1 + 1) → ℝ) →ₗ[ℝ] ℝ) :
    D (p4Q2IS_depthOnePivot D) = 0 := by
  exact p4Q2IS_abstract_twoMode_pivot_null D
    (p4Q2GX_rightZeroCoefficient 1) p4Q2IS_depthOneCoefficient

/-- The pivot is a genuinely NONZERO signed coefficient whenever
the true zero-depth Wilson detector anchor is nonzero. The physical
synthesis of this coefficient may still vanish; no frame is assumed. -/
theorem p4Q2IS_depthOnePivot_ne_zero
    (D : (Fin (1 + 1) → ℝ) →ₗ[ℝ] ℝ)
    (hAnchor : D (p4Q2GX_rightZeroCoefficient 1) ≠ 0) :
    p4Q2IS_depthOnePivot D ≠ 0 := by
  intro hZero
  have hOne := congrArg (fun a : Fin (1 + 1) → ℝ => a 1) hZero
  have hAtOne :
      p4Q2IS_depthOnePivot D 1 =
        D (p4Q2GX_rightZeroCoefficient 1) := by
    simp [p4Q2IS_depthOnePivot, p4Q2IS_depthOneCoefficient,
      p4Q2GX_rightZeroCoefficient, Pi.sub_apply, Pi.smul_apply]
  have hAnchorZero : D (p4Q2GX_rightZeroCoefficient 1) = 0 := by
    simpa only [hAtOne, Pi.zero_apply] using hOne
  exact hAnchor hAnchorZero

section ActualRightDepthOne

variable {halfExtent : ℕ → ℕ} {beta : ℕ → ℝ}
variable {hbeta : ∀ n, 0 ≤ beta n}
variable (n : ℕ)

local notation "Hn" => halfExtent (n + 1)
local notation "Cfg" =>
  PeriodicHypercubicEvenSpecialUnitarySpatialSliceConfiguration Hn 2
local notation "Link" => PeriodicHypercubicEvenSpatialSliceLink Hn
local notation "Pair" => Cfg × Cfg
local notation "Coeff" => Fin (1 + 1) → ℝ
local notation "RightFactor" =>
  physicalYangMillsSU2AdjacentFinePairOrbitRightFactor
    (halfExtent := halfExtent) (beta := beta) (hbeta := hbeta)
local notation "PhysicalSource" =>
  p4Q2HJ_actualRightPhysicalSourceSynthesis
    (halfExtent := halfExtent) (beta := beta) (hbeta := hbeta) n 1
local notation "FullDetector" =>
  p4Q2HJ_actualRightGIContinuousDetector
    (halfExtent := halfExtent) (beta := beta) (hbeta := hbeta) n 1
local notation "Modal" =>
  p4Q2HF_actualRightGIModalLinear
    (halfExtent := halfExtent) (beta := beta) (hbeta := hbeta) n 1

/-- For every positive frozen beta and ANY nonnegative fine beta,
HY supplies a literal original Wilson context whose zero-depth response
is nonzero. At the first higher Krylov depth the unique anchored
coefficient pivot is nonzero and GI-null at this exact context.

Full TRUE physical source separation now reduces to an explicit
disjunction: either this physically synthesized pivot is zero in the
actual gauge-invariant Haar-L² Hilbert space, or the complete original
interacting-Wilson detector sees it elsewhere. The proof does not
choose which side holds for positive fine coupling. -/
theorem p4Q2IS_actualRightDepthOne_originalWilsonAnchorPivot_criterion
    (hFrozen : 0 < beta n) (right : Cfg) (e : Link) :
    ∃ z : Pair,
      Modal e z (p4Q2GX_rightZeroCoefficient 1) ≠ 0 ∧
      p4Q2IS_depthOnePivot (Modal e z) ≠ 0 ∧
      Modal e z (p4Q2IS_depthOnePivot (Modal e z)) = 0 ∧
      ((PhysicalSource).ker = (FullDetector).ker ↔
        PhysicalSource (p4Q2IS_depthOnePivot (Modal e z)) = 0 ∨
        FullDetector (p4Q2IS_depthOnePivot (Modal e z)) ≠ 0) := by
  obtain ⟨z, hAnchor⟩ : ∃ z : Pair,
      p4Q2GI_originalWilsonSignedSourceTwoPosteriorExpectationGap
        Hn (beta n) (hbeta n) (RightFactor n 0) e z ≠ 0 := by
    rcases (p4Q2HY_actualRightZeroDepth_originalWilsonGI_anchor_nonzero
      (halfExtent := halfExtent) (beta := beta) (hbeta := hbeta)
      n hFrozen right e) with hLeft | hPi
    · exact ⟨(originalWilsonExplicitIdentityBoundary Hn, right), hLeft⟩
    · exact ⟨(p4Q2FQ_originalSU2LeftPiRotationAtLink Hn e, right), hPi⟩
  have h0 : Modal e z (p4Q2GX_rightZeroCoefficient 1) ≠ 0 := by
    change p4Q2GY_modalTransferLinear 1
      (fun j : Fin (1 + 1) =>
        p4Q2GI_originalWilsonSignedSourceTwoPosteriorExpectationGap
          Hn (beta n) (hbeta n) (RightFactor n (j : ℕ)) e z)
      (p4Q2GX_rightZeroCoefficient 1) ≠ 0
    rw [p4Q2GY_modalTransferLinear_anchor]
    exact hAnchor
  have hLe : (PhysicalSource).ker ≤ (FullDetector).ker :=
    p4Q2HJ_actualRightSourceKernel_le_GIContinuousDetectorKernel
      (halfExtent := halfExtent) (beta := beta) (hbeta := hbeta) n 1
  have hEvaluate (a : Coeff) (ha : FullDetector a = 0) :
      Modal e z a = 0 := by
    have hAt : (FullDetector a e) z = 0 := by
      rw [ha]
      rfl
    exact hAt
  have hCriterion :=
    p4Q2IS_abstract_twoMode_pivot_separation
      PhysicalSource FullDetector (Modal e z)
      (p4Q2GX_rightZeroCoefficient 1) p4Q2IS_depthOneCoefficient
      p4Q2IS_depthOne_coeff_decompose hLe hEvaluate h0
  refine ⟨z, h0, p4Q2IS_depthOnePivot_ne_zero (Modal e z) h0,
    p4Q2IS_depthOnePivot_anchor_null (Modal e z), ?_⟩
  exact hCriterion

end ActualRightDepthOne
