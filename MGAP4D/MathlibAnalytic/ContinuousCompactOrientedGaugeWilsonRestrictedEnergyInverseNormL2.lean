import MGAP4D.MathlibAnalytic.ContinuousCompactOrientedGaugeWilsonRestrictedEnergyInverseL2

namespace MGAP4D
namespace MathlibAnalytic

open MeasureTheory

noncomputable section

/-- Explicit Dobrushin coercivity on the restricted excitation Hilbert space. -/
theorem continuous_compact_oriented_restrictedEnergy_gap
    (C : ContinuousCompactOrientedGaugeWilsonSystem)
    (D : ContinuousCompactOrientedGaugeWilsonDobrushinRandomScanRayleighCertificate C)
    (f : C.VacuumOrthogonalL2) :
    continuousCompactOrientedDobrushinHeatBathGap D.coefficient * ‖f‖ ^ 2 ≤
      inner ℝ (C.heatBathHamiltonianVacuumOrthogonalL2 f) f := by
  change
    continuousCompactOrientedDobrushinHeatBathGap D.coefficient *
        ‖(f : Lp ℝ 2 C.gibbsMeasure)‖ ^ 2 ≤
      inner ℝ
        (C.heatBathHamiltonianL2 (f : Lp ℝ 2 C.gibbsMeasure))
        (f : Lp ℝ 2 C.gibbsMeasure)
  exact
    continuous_compact_oriented_randomScanDobrushinHamiltonianL2_gap_on_vacuumOrthogonal
      C D (f : Lp ℝ 2 C.gibbsMeasure)
      ((continuous_compact_oriented_mem_vacuumOrthogonalL2_iff
        C (f : Lp ℝ 2 C.gibbsMeasure)).mp f.property)

/-- Sharp pointwise inverse estimate generated by the Dobrushin mass gap. -/
theorem continuous_compact_oriented_restrictedEnergyInverseL2_norm_bound
    (C : ContinuousCompactOrientedGaugeWilsonSystem)
    (D : ContinuousCompactOrientedGaugeWilsonDobrushinRandomScanRayleighCertificate C)
    (y : C.VacuumOrthogonalL2) :
    ‖C.restrictedEnergyInverseL2 D y‖ ≤
      (continuousCompactOrientedDobrushinHeatBathGap D.coefficient)⁻¹ * ‖y‖ := by
  let x : C.VacuumOrthogonalL2 := C.restrictedEnergyInverseL2 D y
  change
    ‖x‖ ≤
      (continuousCompactOrientedDobrushinHeatBathGap D.coefficient)⁻¹ * ‖y‖
  have hGapPos :
      0 < continuousCompactOrientedDobrushinHeatBathGap D.coefficient := by
    unfold continuousCompactOrientedDobrushinHeatBathGap
    exact sub_pos.mpr D.coefficient_lt_one
  by_cases hx : x = 0
  · simp [hx]
  have hxNorm : 0 < ‖x‖ := norm_pos_iff.mpr hx
  have hGap := continuous_compact_oriented_restrictedEnergy_gap C D x
  have hInverse : C.heatBathHamiltonianVacuumOrthogonalL2 x = y := by
    dsimp [x]
    exact continuous_compact_oriented_restrictedEnergy_apply_inverse C D y
  rw [hInverse] at hGap
  have hCS : inner ℝ y x ≤ ‖y‖ * ‖x‖ := real_inner_le_norm y x
  have hMul :
      continuousCompactOrientedDobrushinHeatBathGap D.coefficient * ‖x‖ ^ 2 ≤
        ‖y‖ * ‖x‖ := hGap.trans hCS
  have hLinear :
      continuousCompactOrientedDobrushinHeatBathGap D.coefficient * ‖x‖ ≤ ‖y‖ := by
    apply (mul_le_mul_right hxNorm).mp
    simpa [pow_two, mul_assoc] using hMul
  rw [inv_mul_eq_div]
  apply (le_div_iff₀ hGapPos).2
  simpa [mul_comm] using hLinear

/-- Operator-norm bound for the inverse restricted energy operator. -/
theorem continuous_compact_oriented_restrictedEnergyInverseL2_norm_le
    (C : ContinuousCompactOrientedGaugeWilsonSystem)
    (D : ContinuousCompactOrientedGaugeWilsonDobrushinRandomScanRayleighCertificate C) :
    ‖C.restrictedEnergyInverseL2 D‖ ≤
      (continuousCompactOrientedDobrushinHeatBathGap D.coefficient)⁻¹ := by
  apply ContinuousLinearMap.opNorm_le_bound
  · exact inv_nonneg.mpr (le_of_lt (by
      unfold continuousCompactOrientedDobrushinHeatBathGap
      exact sub_pos.mpr D.coefficient_lt_one))
  · exact continuous_compact_oriented_restrictedEnergyInverseL2_norm_bound C D

end

end MathlibAnalytic
end MGAP4D
