import MGAP4D.MathlibAnalytic.ConcreteAnalyticSpineL2MathlibTwoUnitLinearIndependenceIff

namespace MGAP4D
namespace MathlibAnalytic

open scoped ENNReal lp

noncomputable section

/-- The two-element coordinate-unit family generated by two distinct indices. -/
def concreteL2MathlibFinTwoUnitFamily (k n : ℕ) :
    Fin 2 → lp (fun _ : ℕ => ℝ) 2
  | 0 => concreteL2MathlibUnit k
  | 1 => concreteL2MathlibUnit n

/-- The first element of the two-element coordinate-unit family. -/
theorem concrete_l2_mathlib_fin_two_unit_family_zero (k n : ℕ) :
    concreteL2MathlibFinTwoUnitFamily k n 0 = concreteL2MathlibUnit k := by
  rfl

/-- The second element of the two-element coordinate-unit family. -/
theorem concrete_l2_mathlib_fin_two_unit_family_one (k n : ℕ) :
    concreteL2MathlibFinTwoUnitFamily k n 1 = concreteL2MathlibUnit n := by
  rfl

/-- Distinct indices give distinct entries in the two-element coordinate-unit
family. -/
theorem concrete_l2_mathlib_fin_two_unit_family_entries_ne
    {k n : ℕ} (hkn : k ≠ n) :
    concreteL2MathlibFinTwoUnitFamily k n 0 ≠
      concreteL2MathlibFinTwoUnitFamily k n 1 := by
  simpa [concreteL2MathlibFinTwoUnitFamily] using
    concrete_l2_mathlib_unit_ne_of_ne hkn

/-- The two-element coordinate-unit family is injective when the two indices are
distinct.

This is the first finite-family-shaped carrier lemma after the two-vector
linear-independence layer.  It stays deliberately below a general
`LinearIndependent` theorem. -/
theorem concrete_l2_mathlib_fin_two_unit_family_injective
    {k n : ℕ} (hkn : k ≠ n) :
    Function.Injective (concreteL2MathlibFinTwoUnitFamily k n) := by
  intro i j hij
  fin_cases i <;> fin_cases j
  · rfl
  · exfalso
    exact concrete_l2_mathlib_fin_two_unit_family_entries_ne hkn hij
  · exfalso
    exact concrete_l2_mathlib_fin_two_unit_family_entries_ne hkn hij.symm
  · rfl

/-- Each entry of the two-element coordinate-unit family is nonzero. -/
theorem concrete_l2_mathlib_fin_two_unit_family_ne_zero
    {k n : ℕ} (_hkn : k ≠ n) (i : Fin 2) :
    concreteL2MathlibFinTwoUnitFamily k n i ≠ 0 := by
  fin_cases i
  · simpa [concreteL2MathlibFinTwoUnitFamily] using
      concrete_l2_mathlib_unit_ne_zero k
  · simpa [concreteL2MathlibFinTwoUnitFamily] using
      concrete_l2_mathlib_unit_ne_zero n

/-- Each entry of the two-element coordinate-unit family has norm one. -/
theorem concrete_l2_mathlib_fin_two_unit_family_norm_eq_one
    (k n : ℕ) (i : Fin 2) :
    ‖concreteL2MathlibFinTwoUnitFamily k n i‖ = 1 := by
  fin_cases i
  · simpa [concreteL2MathlibFinTwoUnitFamily] using
      concrete_l2_mathlib_unit_norm_eq_one k
  · simpa [concreteL2MathlibFinTwoUnitFamily] using
      concrete_l2_mathlib_unit_norm_eq_one n

/-- Adapter predicate for the two-element coordinate-unit family layer. -/
def concreteL2MathlibFinTwoUnitFamilyAdapter : Prop :=
  ∀ {k n : ℕ}, k ≠ n →
    Function.Injective (concreteL2MathlibFinTwoUnitFamily k n) ∧
    (∀ i : Fin 2, concreteL2MathlibFinTwoUnitFamily k n i ≠ 0) ∧
    (∀ i : Fin 2, ‖concreteL2MathlibFinTwoUnitFamily k n i‖ = 1)

/-- Two-element coordinate-unit family adapter theorem. -/
theorem concrete_l2_mathlib_fin_two_unit_family_adapter_ready :
    concreteL2MathlibFinTwoUnitFamilyAdapter := by
  intro k n hkn
  exact ⟨
    concrete_l2_mathlib_fin_two_unit_family_injective hkn,
    concrete_l2_mathlib_fin_two_unit_family_ne_zero hkn,
    concrete_l2_mathlib_fin_two_unit_family_norm_eq_one k n⟩

/-- Surface for the `Fin 2` coordinate-unit family in Mathlib completed
`ℓ²(ℕ, ℝ)`.

This packages the two selected coordinate units as a finite family, proving
injectivity, nonzero entries, and norm-one entries.  It is the handoff shape for
later finite-family linear-independence work, while preserving the hard
boundaries: no general finite-family theorem, no basis theorem, no dense span,
no finite-support-domain equivalence, no unbounded-operator domain theorem, no
self-adjointness, no PVM, and no spectral atom claim. -/
structure ConcreteL2MathlibFinTwoUnitFamilySurface where
  twoUnitLinearIndependenceIffReady :
    concreteAnalyticSpineL2MathlibTwoUnitLinearIndependenceIffSurfaceReady
  finTwoFamilyAdapter : concreteL2MathlibFinTwoUnitFamilyAdapter
  boundaryNotGeneralFiniteFamilyLinearIndependence : Prop
  boundaryNotBasisTheorem : Prop
  boundaryNotDenseSpanTheorem : Prop
  boundaryNotFiniteSupportDomainEquivalence : Prop
  boundaryNotUnboundedOperatorDomainTheorem : Prop
  boundaryNotSelfAdjointness : Prop
  boundaryNotPVMConstruction : Prop
  boundaryNotSpectralAtomTheorem : Prop

/-- Concrete `Fin 2` coordinate-unit family surface. -/
def concreteL2MathlibFinTwoUnitFamilySurface :
    ConcreteL2MathlibFinTwoUnitFamilySurface :=
  { twoUnitLinearIndependenceIffReady :=
      concrete_analytic_spine_l2_mathlib_two_unit_linear_independence_iff_surface_ready
    finTwoFamilyAdapter := concrete_l2_mathlib_fin_two_unit_family_adapter_ready
    boundaryNotGeneralFiniteFamilyLinearIndependence := True
    boundaryNotBasisTheorem := True
    boundaryNotDenseSpanTheorem := True
    boundaryNotFiniteSupportDomainEquivalence := True
    boundaryNotUnboundedOperatorDomainTheorem := True
    boundaryNotSelfAdjointness := True
    boundaryNotPVMConstruction := True
    boundaryNotSpectralAtomTheorem := True }

/-- Readiness for the `Fin 2` coordinate-unit family surface. -/
def concreteAnalyticSpineL2MathlibFinTwoUnitFamilySurfaceReady : Prop :=
  concreteAnalyticSpineL2MathlibTwoUnitLinearIndependenceIffSurfaceReady ∧
  concreteL2MathlibFinTwoUnitFamilyAdapter ∧
  concreteL2MathlibFinTwoUnitFamilySurface.boundaryNotGeneralFiniteFamilyLinearIndependence ∧
  concreteL2MathlibFinTwoUnitFamilySurface.boundaryNotBasisTheorem ∧
  concreteL2MathlibFinTwoUnitFamilySurface.boundaryNotDenseSpanTheorem ∧
  concreteL2MathlibFinTwoUnitFamilySurface.boundaryNotFiniteSupportDomainEquivalence ∧
  concreteL2MathlibFinTwoUnitFamilySurface.boundaryNotUnboundedOperatorDomainTheorem ∧
  concreteL2MathlibFinTwoUnitFamilySurface.boundaryNotSelfAdjointness ∧
  concreteL2MathlibFinTwoUnitFamilySurface.boundaryNotPVMConstruction ∧
  concreteL2MathlibFinTwoUnitFamilySurface.boundaryNotSpectralAtomTheorem

/-- Readiness theorem for the `Fin 2` coordinate-unit family surface. -/
theorem concrete_analytic_spine_l2_mathlib_fin_two_unit_family_surface_ready :
    concreteAnalyticSpineL2MathlibFinTwoUnitFamilySurfaceReady := by
  unfold concreteAnalyticSpineL2MathlibFinTwoUnitFamilySurfaceReady
  exact And.intro
    concrete_analytic_spine_l2_mathlib_two_unit_linear_independence_iff_surface_ready <|
      And.intro concrete_l2_mathlib_fin_two_unit_family_adapter_ready <|
        And.intro trivial <| And.intro trivial <| And.intro trivial <|
          And.intro trivial <| And.intro trivial <| And.intro trivial <|
            And.intro trivial trivial

/-- Boundary marker for the `Fin 2` coordinate-unit family surface. -/
def concreteAnalyticSpineL2MathlibFinTwoUnitFamilyHardResidualBoundaryHeld : Prop :=
  concreteAnalyticSpineL2MathlibFinTwoUnitFamilySurfaceReady

/-- Boundary theorem for the `Fin 2` coordinate-unit family surface. -/
theorem concrete_analytic_spine_l2_mathlib_fin_two_unit_family_hard_residual_boundary_held :
    concreteAnalyticSpineL2MathlibFinTwoUnitFamilyHardResidualBoundaryHeld := by
  exact concrete_analytic_spine_l2_mathlib_fin_two_unit_family_surface_ready

end

end MathlibAnalytic
end MGAP4D
