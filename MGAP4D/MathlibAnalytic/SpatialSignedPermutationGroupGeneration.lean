import MGAP4D.MathlibAnalytic.SpatialSignedPermutationGroupCardinality
import Mathlib.GroupTheory.Perm.ClosureSwap
import Mathlib.Tactic

/-!
# Generation of the abstract three-dimensional signed permutation group

The preceding layers define the abstract signed-coordinate group

`SpatialSignedPermutationGroup = (Fin 3 → ℤˣ) ⋊ S₃`

and prove that it has exactly `48` elements.  This file proves that the three distinguished
symmetries already used by the concrete lattice construction generate the entire abstract group:

* the adjacent swap `(0 1)`;
* the adjacent swap `(1 2)`;
* reflection of coordinate `0`.

The proof is structural rather than a brute-force enumeration of 48 elements.  The two adjacent
swaps generate all of `S₃`; conjugating the first coordinate reflection by permutations gives the
three independent coordinate reflections; and every integer unit is `+1` or `-1`, so every sign
assignment is a product of those three reflections.  The semidirect-product decomposition then
places every abstract signed permutation in the generated subgroup.

This identifies the three concrete generator labels with a full abstract signed-coordinate symmetry
group.  It still does not construct the homomorphism to the finite gauge-configuration action,
assign a cubic irrep label, identify continuum spin, or make a spectral claim.
-/

namespace MGAP4D
namespace MathlibAnalytic

noncomputable section

/-- The two adjacent transpositions used to generate the abstract spatial permutation group. -/
def spatialAxisAdjacentSwapGeneratorSet : Set (Equiv.Perm (Fin 3)) :=
  {Equiv.swap (0 : Fin 3) 1, Equiv.swap (1 : Fin 3) 2}

/-- The three distinguished signed-coordinate generators. -/
def spatialSignedPermutationGeneratorSet : Set SpatialSignedPermutationGroup :=
  {spatialSignedPermutationSwap12,
    spatialSignedPermutationSwap23,
    spatialSignedPermutationReflect1}

/-- The subgroup generated by the two adjacent swaps and one independent coordinate reflection. -/
def spatialSignedPermutationGeneratedSubgroup : Subgroup SpatialSignedPermutationGroup :=
  Subgroup.closure spatialSignedPermutationGeneratorSet

/-- Canonical embedding of pure axis permutations into the semidirect product. -/
def spatialAxisPermutationEmbed :
    Equiv.Perm (Fin 3) →* SpatialSignedPermutationGroup :=
  SemidirectProduct.inr

/-- Canonical embedding of pure sign assignments into the semidirect product. -/
def spatialAxisSignEmbed :
    SpatialAxisSign →* SpatialSignedPermutationGroup :=
  SemidirectProduct.inl

@[simp]
theorem spatialAxisPermutationEmbed_swap12 :
    spatialAxisPermutationEmbed (Equiv.swap (0 : Fin 3) 1) =
      spatialSignedPermutationSwap12 :=
  rfl

@[simp]
theorem spatialAxisPermutationEmbed_swap23 :
    spatialAxisPermutationEmbed (Equiv.swap (1 : Fin 3) 2) =
      spatialSignedPermutationSwap23 :=
  rfl

@[simp]
theorem spatialAxisSignEmbed_reflect1 :
    spatialAxisSignEmbed spatialAxisReflect1Sign =
      spatialSignedPermutationReflect1 :=
  rfl

/-- The adjacent transpositions `(0 1)` and `(1 2)` generate every permutation of three axes. -/
theorem spatialAxisAdjacentSwapGenerator_closure_eq_top :
    Subgroup.closure spatialAxisAdjacentSwapGeneratorSet =
      (⊤ : Subgroup (Equiv.Perm (Fin 3))) := by
  have h01 :
      Equiv.swap (0 : Fin 3) 1 ∈
        Subgroup.closure spatialAxisAdjacentSwapGeneratorSet :=
    Subgroup.subset_closure (by simp [spatialAxisAdjacentSwapGeneratorSet])
  have h12 :
      Equiv.swap (1 : Fin 3) 2 ∈
        Subgroup.closure spatialAxisAdjacentSwapGeneratorSet :=
    Subgroup.subset_closure (by simp [spatialAxisAdjacentSwapGeneratorSet])
  have h02 :
      Equiv.swap (0 : Fin 3) 2 ∈
        Subgroup.closure spatialAxisAdjacentSwapGeneratorSet :=
    SubmonoidClass.swap_mem_trans
      (Subgroup.closure spatialAxisAdjacentSwapGeneratorSet) h01 h12
  have hAllSwaps :
      Subgroup.closure {σ : Equiv.Perm (Fin 3) | σ.IsSwap} ≤
        Subgroup.closure spatialAxisAdjacentSwapGeneratorSet := by
    apply Subgroup.closure_le.2
    intro σ hσ
    rcases hσ with ⟨x, y, hxy, rfl⟩
    fin_cases x <;> fin_cases y
    · exact (hxy rfl).elim
    · exact h01
    · exact h02
    · simpa [Equiv.swap_comm] using h01
    · exact (hxy rfl).elim
    · exact h12
    · simpa [Equiv.swap_comm] using h02
    · simpa [Equiv.swap_comm] using h12
    · exact (hxy rfl).elim
  apply top_unique
  intro σ _hσ
  exact hAllSwaps ((mem_closure_isSwap').2 (Set.toFinite _))

/-- Sign assignment reversing exactly one chosen spatial coordinate. -/
def spatialAxisSingleReflectionSign (i : Fin 3) : SpatialAxisSign :=
  fun j => if j = i then -1 else 1

@[simp]
theorem spatialAxisSingleReflectionSign_self (i : Fin 3) :
    spatialAxisSingleReflectionSign i i = -1 := by
  simp [spatialAxisSingleReflectionSign]

@[simp]
theorem spatialAxisSingleReflectionSign_of_ne
    {i j : Fin 3} (hji : j ≠ i) :
    spatialAxisSingleReflectionSign i j = 1 := by
  simp [spatialAxisSingleReflectionSign, hji]

/-- Reindexing the first-coordinate reflection by `swap 0 i` gives reflection of coordinate `i`. -/
theorem spatialAxisPermutationSignAction_swap_reflect1
    (i : Fin 3) :
    spatialAxisPermutationSignAction (Equiv.swap (0 : Fin 3) i)
        spatialAxisReflect1Sign =
      spatialAxisSingleReflectionSign i := by
  funext j
  fin_cases i <;> fin_cases j <;>
    simp [spatialAxisPermutationSignAction_apply,
      spatialAxisReflect1Sign, spatialAxisSingleReflectionSign]

/-- The three distinguished signed-coordinate generators generate the full abstract group. -/
theorem spatialSignedPermutationGeneratedSubgroup_eq_top :
    spatialSignedPermutationGeneratedSubgroup =
      (⊤ : Subgroup SpatialSignedPermutationGroup) := by
  let G := spatialSignedPermutationGeneratedSubgroup
  have hs12 : spatialSignedPermutationSwap12 ∈ G :=
    Subgroup.subset_closure (by
      simp [G, spatialSignedPermutationGeneratedSubgroup,
        spatialSignedPermutationGeneratorSet])
  have hs23 : spatialSignedPermutationSwap23 ∈ G :=
    Subgroup.subset_closure (by
      simp [G, spatialSignedPermutationGeneratedSubgroup,
        spatialSignedPermutationGeneratorSet])
  have hr1 : spatialSignedPermutationReflect1 ∈ G :=
    Subgroup.subset_closure (by
      simp [G, spatialSignedPermutationGeneratedSubgroup,
        spatialSignedPermutationGeneratorSet])

  have hperm :
      ∀ σ : Equiv.Perm (Fin 3), spatialAxisPermutationEmbed σ ∈ G := by
    intro σ
    let P : Equiv.Perm (Fin 3) → Prop :=
      fun τ => spatialAxisPermutationEmbed τ ∈ G
    have hσ : σ ∈ Subgroup.closure spatialAxisAdjacentSwapGeneratorSet := by
      rw [spatialAxisAdjacentSwapGenerator_closure_eq_top]
      simp
    have hgen : ∀ τ ∈ spatialAxisAdjacentSwapGeneratorSet, P τ := by
      intro τ hτ
      simp only [spatialAxisAdjacentSwapGeneratorSet, Set.mem_insert_iff,
        Set.mem_singleton_iff] at hτ
      rcases hτ with rfl | rfl
      · simpa [P] using hs12
      · simpa [P] using hs23
    have hone : P 1 := by
      simpa [P] using G.one_mem
    have hmul :
        ∀ x y,
          x ∈ Subgroup.closure spatialAxisAdjacentSwapGeneratorSet →
          y ∈ Subgroup.closure spatialAxisAdjacentSwapGeneratorSet →
          P x → P y → P (x * y) := by
      intro x y _hxmem _hymem hx hy
      simpa [P] using G.mul_mem hx hy
    have hinv :
        ∀ x,
          x ∈ Subgroup.closure spatialAxisAdjacentSwapGeneratorSet →
          P x → P x⁻¹ := by
      intro x _hxmem hx
      simpa [P] using G.inv_mem hx
    exact Subgroup.closure_induction hgen hone hmul hinv hσ

  have hr1Embed : spatialAxisSignEmbed spatialAxisReflect1Sign ∈ G := by
    simpa using hr1

  have hsingle :
      ∀ i : Fin 3, spatialAxisSignEmbed (spatialAxisSingleReflectionSign i) ∈ G := by
    intro i
    have hp := hperm (Equiv.swap (0 : Fin 3) i)
    have hconj :
        spatialAxisSignEmbed
            (spatialAxisPermutationSignAction (Equiv.swap (0 : Fin 3) i)
              spatialAxisReflect1Sign) =
          spatialAxisPermutationEmbed (Equiv.swap (0 : Fin 3) i) *
            spatialAxisSignEmbed spatialAxisReflect1Sign *
            (spatialAxisPermutationEmbed (Equiv.swap (0 : Fin 3) i))⁻¹ := by
      exact SemidirectProduct.inl_aut
        (Equiv.swap (0 : Fin 3) i) spatialAxisReflect1Sign
    have hc :
        spatialAxisSignEmbed
            (spatialAxisPermutationSignAction (Equiv.swap (0 : Fin 3) i)
              spatialAxisReflect1Sign) ∈ G := by
      rw [hconj]
      exact G.mul_mem (G.mul_mem hp hr1Embed) (G.inv_mem hp)
    rwa [spatialAxisPermutationSignAction_swap_reflect1] at hc

  have hsign : ∀ ε : SpatialAxisSign, spatialAxisSignEmbed ε ∈ G := by
    intro ε
    rcases Int.units_eq_one_or (ε 0) with h0 | h0 <;>
      rcases Int.units_eq_one_or (ε 1) with h1 | h1 <;>
      rcases Int.units_eq_one_or (ε 2) with h2 | h2
    · have hε : ε = 1 := by
        funext i
        fin_cases i <;> simp_all
      simpa [hε] using G.one_mem
    · have hε : ε = spatialAxisSingleReflectionSign 2 := by
        funext i
        fin_cases i <;> simp_all [spatialAxisSingleReflectionSign]
      simpa [hε] using hsingle (2 : Fin 3)
    · have hε : ε = spatialAxisSingleReflectionSign 1 := by
        funext i
        fin_cases i <;> simp_all [spatialAxisSingleReflectionSign]
      simpa [hε] using hsingle (1 : Fin 3)
    · have hε :
          ε = spatialAxisSingleReflectionSign 1 * spatialAxisSingleReflectionSign 2 := by
        funext i
        fin_cases i <;> simp_all [spatialAxisSingleReflectionSign]
      have hm := G.mul_mem (hsingle (1 : Fin 3)) (hsingle (2 : Fin 3))
      simpa [hε] using hm
    · have hε : ε = spatialAxisSingleReflectionSign 0 := by
        funext i
        fin_cases i <;> simp_all [spatialAxisSingleReflectionSign]
      simpa [hε] using hsingle (0 : Fin 3)
    · have hε :
          ε = spatialAxisSingleReflectionSign 0 * spatialAxisSingleReflectionSign 2 := by
        funext i
        fin_cases i <;> simp_all [spatialAxisSingleReflectionSign]
      have hm := G.mul_mem (hsingle (0 : Fin 3)) (hsingle (2 : Fin 3))
      simpa [hε] using hm
    · have hε :
          ε = spatialAxisSingleReflectionSign 0 * spatialAxisSingleReflectionSign 1 := by
        funext i
        fin_cases i <;> simp_all [spatialAxisSingleReflectionSign]
      have hm := G.mul_mem (hsingle (0 : Fin 3)) (hsingle (1 : Fin 3))
      simpa [hε] using hm
    · have hε :
          ε = (spatialAxisSingleReflectionSign 0 * spatialAxisSingleReflectionSign 1) *
            spatialAxisSingleReflectionSign 2 := by
        funext i
        fin_cases i <;> simp_all [spatialAxisSingleReflectionSign]
      have hm := G.mul_mem
        (G.mul_mem (hsingle (0 : Fin 3)) (hsingle (1 : Fin 3)))
        (hsingle (2 : Fin 3))
      simpa [hε] using hm

  apply top_unique
  intro x _hx
  have hl := hsign x.left
  have hr := hperm x.right
  have hm : spatialAxisSignEmbed x.left * spatialAxisPermutationEmbed x.right ∈ G :=
    G.mul_mem hl hr
  have hdecomp :
      spatialAxisSignEmbed x.left * spatialAxisPermutationEmbed x.right = x := by
    exact SemidirectProduct.inl_left_mul_inr_right x
  rwa [hdecomp] at hm

/-- In particular, the abstract global parity element lies in the three-generator subgroup. -/
theorem spatialSignedPermutationParity_mem_generated :
    spatialSignedPermutationParity ∈ spatialSignedPermutationGeneratedSubgroup := by
  rw [spatialSignedPermutationGeneratedSubgroup_eq_top]
  simp

end

end MathlibAnalytic
end MGAP4D
