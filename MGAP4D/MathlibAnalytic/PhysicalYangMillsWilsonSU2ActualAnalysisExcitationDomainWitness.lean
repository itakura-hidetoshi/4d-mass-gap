      actualAnalysisExcitationDomainWitnessTwoRankPositive beta hbeta Q.toWeakStarBridge hInvariant n).StronglyContinuousPhysicalSemigroup)
    (hSelf : IsSelfAdjoint T.closedRightHamiltonian) :
    T.PhysicalYangMillsExcitationDomainWitness := by
  let Pn := physical_yang_mills_evenPeriodicWilsonOS_approximating_preHilbertData
