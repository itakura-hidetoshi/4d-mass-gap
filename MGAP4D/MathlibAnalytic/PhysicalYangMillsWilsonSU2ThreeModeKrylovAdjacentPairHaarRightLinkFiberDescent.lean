/-!
# P4-F2: continuous full-support right-link fiber obstruction

A fourfold crossing under FOUR independent right and left boundaries
does NOT alone refute measurability under the retained right-link
sigma algebra.  The relevant coordinates instead have one common
left/off-target context and two independent TARGET variables.

First, prove a generic full-support product-measure fact: a continuous
real function which is a.e. measurable under the sigma algebra
generated by the context projection is pointwise constant along
the target fiber.  This uses two quasi-measure-preserving coordinate
maps, a common full-measure event, and open positive measure.

Second, prove that the canonical continuous representative of the
ORIGINAL SU(2) Wilson joint density violates this pointwise
fiber-constancy at the explicitly selected spatial link from PR #5295.
The actual right boundary is reconstructed from the existing canonical
target/off-target split.  It is never replaced by an artificial law.

The separate transport of retained measurability from the genuine
Wilson joint measure to Haar split coordinates is handled in the next
bridge; no unsupported assertion about the original posterior or a
volume-uniform bound is made here.
-/

namespace MGAP4D
namespace MathlibAnalytic

open MeasureTheory Filter
open scoped ENNReal InnerProductSpace InnerProduct BigOperators

noncomputable section

/-- A strongly measurable real function under the sigma algebra
generated by the first projection is literally constant on each
fiber, without any measure assumption. -/
theorem p4F2_comap_fst_stronglyMeasurable_fiber_const
    {X Y : Type*} [MeasurableSpace X] [MeasurableSpace Y]
    {g : X × Y → ℝ}
    (hg : StronglyMeasurable[
      MeasurableSpace.comap (Prod.fst : X × Y → X) inferInstance] g) :
    ∀ x : X, ∀ y₁ y₂ : Y, g (x, y₁) = g (x, y₂) := by
  intro x y₁ y₂
  have hm : Measurable[
      MeasurableSpace.comap (Prod.fst : X × Y → X) inferInstance] g :=
    hg.measurable
  have hs : MeasurableSet[
      MeasurableSpace.comap (Prod.fst : X × Y → X) inferInstance]
      {z : X × Y | g z = g (x, y₁)} := by
    exact hm (measurableSet_singleton (g (x, y₁)))
  obtain ⟨s, _hs, heq⟩ := hs
  have hx : x ∈ s := by
    have hmem : (x, y₁) ∈ {z : X × Y | g z = g (x, y₁)} := rfl
    rw [heq] at hmem
    exact hmem
  have hmem : (x, y₂) ∈ {z : X × Y | g z = g (x, y₁)} := by
    rw [heq]
    exact hx
  exact hmem

/-- Fubini/product-measure descent: for a full-support context law
and full-support target law, a CONTINUOUS function which is a.e.
retained-context strongly measurable is independent of the target
at every point.  No pointwise substitution from an L² class is made. -/
theorem p4F2_continuous_ae_retained_fiber_const
    {X Y : Type*}
    [TopologicalSpace X] [TopologicalSpace Y]
    [MeasurableSpace X] [MeasurableSpace Y]
    (μ : Measure X) (ν : Measure Y)
    [SFinite μ] [SFinite ν]
    [Measure.IsOpenPosMeasure μ] [Measure.IsOpenPosMeasure ν]
    (f : X × Y → ℝ) (hf : Continuous f)
    (hret : AEStronglyMeasurable[
      MeasurableSpace.comap (Prod.fst : X × Y → X) inferInstance]
      f (μ.prod ν)) :
    ∀ x : X, ∀ y₁ y₂ : Y, f (x, y₁) = f (x, y₂) := by
  obtain ⟨g, hg, hfg⟩ := hret
  have hconstant :
      ∀ x : X, ∀ y₁ y₂ : Y, g (x, y₁) = g (x, y₂) :=
    p4F2_comap_fst_stronglyMeasurable_fiber_const hg
  haveI : SFinite (μ.prod ν) := inferInstance
  haveI : Measure.IsOpenPosMeasure (μ.prod ν) :=
    Measure.prod.instIsOpenPosMeasure
  haveI : Measure.IsOpenPosMeasure ((μ.prod ν).prod ν) :=
    Measure.prod.instIsOpenPosMeasure
  have hfirst :
      (fun z : (X × Y) × Y => f z.1) =ᵐ[(μ.prod ν).prod ν]
        (fun z => g z.1) := by
    simpa only [Function.comp_def] using
      (Measure.quasiMeasurePreserving_fst (μ := μ.prod ν) (ν := ν)).ae_eq hfg
  have hother :
      (fun z : (X × Y) × Y => f (z.1.1, z.2)) =ᵐ[(μ.prod ν).prod ν]
        (fun z => g (z.1.1, z.2)) := by
    have hfst : Measure.QuasiMeasurePreserving
        (Prod.fst : X × Y → X) (μ.prod ν) μ :=
      Measure.quasiMeasurePreserving_fst
    have hid : Measure.QuasiMeasurePreserving (id : Y → Y) ν ν :=
      QuasiMeasurePreserving.id ν
    simpa only [Function.comp_def, Prod.map, id_eq] using
      (QuasiMeasurePreserving.prodMap hfst hid).ae_eq hfg
  have hae :
      (fun z : (X × Y) × Y => f z.1) =ᵐ[(μ.prod ν).prod ν]
        (fun z => f (z.1.1, z.2)) := by
    filter_upwards [hfirst, hother] with z h₁ h₂
    calc
      f z.1 = g z.1 := h₁
      _ = g (z.1.1, z.2) := hconstant _ _ _
      _ = f (z.1.1, z.2) := h₂.symm
  have hmap : Continuous
      (fun z : (X × Y) × Y => (z.1.1, z.2)) :=
    (continuous_fst.comp continuous_fst).prodMk continuous_snd
  have hpointwise :
      (fun z : (X × Y) × Y => f z.1) =
        (fun z => f (z.1.1, z.2)) :=
    eq_of_ae_eq hae (hf.comp continuous_fst) (hf.comp hmap)
  intro x y₁ y₂
  exact congrFun hpointwise ((x, y₁), y₂)

