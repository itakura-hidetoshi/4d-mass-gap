namespace GroundStatePosteriorJoint

/-- The ACTUAL continuous physical Wilson joint has essential
dependence on the selected right link even after fixing the ENTIRE
left boundary and the ENTIRE right off-target configuration.  The
two right boundaries differ only at this one link. -/
theorem originalWilsonContinuousPhysicalJoint_not_targetFiberConstant
    (H : ℕ) (beta : ℝ) (hbeta : 0 < beta) :
    ¬ ∀
      (A : PeriodicHypercubicEvenSpecialUnitarySpatialSliceConfiguration H 2)
      (off : PeriodicHypercubicEvenSpatialSliceOffTargetLink H
        (originalWilsonExplicitSpatialTargetLink H) →
        Matrix.specialUnitaryGroup (Fin 2) ℂ)
      (t₁ t₂ : PeriodicHypercubicEvenSpatialSliceTargetLink H
        (originalWilsonExplicitSpatialTargetLink H) →
        Matrix.specialUnitaryGroup (Fin 2) ℂ),
      originalWilsonContinuousPhysicalJointWeight H beta (le_of_lt hbeta)
        (A,
          (periodicHypercubicEvenSpatialSliceTargetOffTargetMeasurableEquiv
            (Gauge := Matrix.specialUnitaryGroup (Fin 2) ℂ)
            (originalWilsonExplicitSpatialTargetLink H)).symm (t₁, off)) =
      originalWilsonContinuousPhysicalJointWeight H beta (le_of_lt hbeta)
        (A,
          (periodicHypercubicEvenSpatialSliceTargetOffTargetMeasurableEquiv
            (Gauge := Matrix.specialUnitaryGroup (Fin 2) ℂ)
            (originalWilsonExplicitSpatialTargetLink H)).symm (t₂, off)) := by
  classical
  let e := originalWilsonExplicitSpatialTargetLink H
  let A := originalWilsonExplicitIdentityBoundary H
  let B := originalWilsonExplicitRotatedBoundary H
  let split :=
    periodicHypercubicEvenSpatialSliceTargetOffTargetMeasurableEquiv
      (Gauge := Matrix.specialUnitaryGroup (Fin 2) ℂ) e
  have hoff : (split B).2 = (split A).2 := by
    funext i
    change B i.1 = A i.1
    simp [B, originalWilsonExplicitRotatedBoundary,
      Function.update, i.property]
  have hA : split.symm ((split A).1, (split A).2) = A :=
    split.symm_apply_apply A
  have hB : split.symm ((split B).1, (split A).2) = B := by
    rw [← hoff]
    exact split.symm_apply_apply B
  intro hconst
  have hrowA := hconst A (split A).2 (split A).1 (split B).1
  have hrowB := hconst B (split A).2 (split A).1 (split B).1
  rw [hA, hB] at hrowA hrowB
  have hzero :
      originalWilsonContinuousPhysicalJointTwoByTwoMinor H beta (le_of_lt hbeta)
        A B A B = 0 := by
    unfold originalWilsonContinuousPhysicalJointTwoByTwoMinor
    rw [hrowA, hrowB]
    ring
  exact (ne_of_gt
    (originalWilsonContinuousPhysicalJoint_explicitMinor_pos H beta hbeta)) hzero

