/-- A norm bound for a bounded real-Hilbert endomorphism gives a coercive
quadratic-form bound for its discrete generator `I - T`.  This generic lemma
keeps the concrete completed pair-Hilbert carrier opaque. -/
theorem realContinuousLinearMap_one_sub_inner_lower_bound
    {E : Type*}
    [NormedAddCommGroup E]
    [InnerProductSpace ℝ E]
    (T : E →L[ℝ] E)
    (r : ℝ)
    (hT : ‖T‖ ≤ r)
    (u : E) :
    (1 - r) * ‖u‖ ^ 2 ≤ inner ℝ ((1 - T) u) u := by
  have hinner : inner ℝ (T u) u ≤ r * ‖u‖ ^ 2 := by
    calc
      inner ℝ (T u) u ≤ ‖T u‖ * ‖u‖ := real_inner_le_norm _ _
      _ ≤ (‖T‖ * ‖u‖) * ‖u‖ :=
        mul_le_mul_of_nonneg_right (T.le_opNorm u) (norm_nonneg u)
      _ ≤ (r * ‖u‖) * ‖u‖ :=
        mul_le_mul_of_nonneg_right
          (mul_le_mul_of_nonneg_right hT (norm_nonneg u))
          (norm_nonneg u)
      _ = r * ‖u‖ ^ 2 := by ring
  change (1 - r) * ‖u‖ ^ 2 ≤ inner ℝ (u - T u) u
  calc
    (1 - r) * ‖u‖ ^ 2 = ‖u‖ ^ 2 - r * ‖u‖ ^ 2 := by ring
    _ ≤ ‖u‖ ^ 2 - inner ℝ (T u) u := sub_le_sub_left hinner _
    _ = inner ℝ (u - T u) u := by
      rw [inner_sub_left, real_inner_self_eq_norm_sq]

/-- If the contraction radius is strictly below one, the quadratic form of
`I - T` is strictly positive away from zero. -/
theorem realContinuousLinearMap_one_sub_inner_pos
    {E : Type*}
    [NormedAddCommGroup E]
    [InnerProductSpace ℝ E]
    (T : E →L[ℝ] E)
    (r : ℝ)
    (hT : ‖T‖ ≤ r)
    (hr : r < 1)
    {u : E}
    (hu : u ≠ 0) :
    0 < inner ℝ ((1 - T) u) u := by
  have hnorm : 0 < ‖u‖ := norm_pos_iff.mpr hu
  have hcoef : 0 < 1 - r := sub_pos.mpr hr
  exact lt_of_lt_of_le
    (mul_pos hcoef (sq_pos_of_pos hnorm))
    (realContinuousLinearMap_one_sub_inner_lower_bound T r hT u)

/-- Self-adjointness is stable under passing to the bounded discrete generator
`I - T`. -/
theorem realContinuousLinearMap_one_sub_isSelfAdjoint
    {E : Type*}
    [NormedAddCommGroup E]
    [InnerProductSpace ℝ E]
    [CompleteSpace E]
    (T : E →L[ℝ] E)
    (hT : IsSelfAdjoint T) :
    IsSelfAdjoint (1 - T) := by
  apply continuousLinearMap_isSelfAdjoint_of_inner_symm
  intro x y
  have hSymm : T.toLinearMap.IsSymmetric :=
    (ContinuousLinearMap.isSelfAdjoint_iff_isSymmetric).mp hT
  change inner ℝ (x - T x) y = inner ℝ x (y - T y)
  rw [inner_sub_left, inner_sub_right]
  exact congrArg (fun z : ℝ => inner ℝ x y - z) (hSymm x y)

