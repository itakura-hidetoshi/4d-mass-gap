import MGAP4D.MathlibAnalytic.FiniteLatticeWilsonFourDimensionalIncidenceCertificate
import MGAP4D.MathlibAnalytic.FiniteWilsonCanonicalDobrushinStrictFamilyGap

namespace MGAP4D
namespace MathlibAnalytic

noncomputable section

/-- The explicit one-plaquette conditional-TV majorant supplied by the
four-dimensional incidence estimate. -/
def finiteWilsonFourDimensionalInfluenceMajorant
    (L : FiniteLatticeWilsonSystem) : ℝ :=
  (Real.exp (L.beta * (2 * L.plaquetteEnergyMax)) - 1) /
    (Real.exp (L.beta * (2 * L.plaquetteEnergyMax)) + 1)

/-- The resulting explicit four-dimensional Dobrushin margin. -/
def finiteWilsonFourDimensionalDobrushinMargin
    (L : FiniteLatticeWilsonSystem) : ℝ :=
  1 - 18 * finiteWilsonFourDimensionalInfluenceMajorant L

/-- The standard high-temperature threshold makes the explicit
four-dimensional Dobrushin margin strictly positive. -/
theorem finite_wilson_fourDimensionalDobrushinMargin_pos
    (L : FiniteLatticeWilsonSystem)
    (hThreshold :
      finiteWilsonFourDimensionalInfluenceMajorant L < (18 : ℝ)⁻¹) :
    0 < finiteWilsonFourDimensionalDobrushinMargin L := by
  unfold finiteWilsonFourDimensionalDobrushinMargin
  have h :
      18 * finiteWilsonFourDimensionalInfluenceMajorant L < 1 := by
    have h18 : (0 : ℝ) < 18 := by norm_num
    calc
      18 * finiteWilsonFourDimensionalInfluenceMajorant L <
          18 * (18 : ℝ)⁻¹ :=
        mul_lt_mul_of_pos_left hThreshold h18
      _ = 1 := by norm_num
  linarith

/-- Family-level high-temperature input for genuine four-dimensional Wilson
incidence geometry.  The package contains the concrete incidence certificate
at every finite scale and the explicit normalized-exponential threshold. -/
structure FiniteWilsonFourDimensionalIncidenceHighTemperatureFamilyData
    (W : FiniteWilsonOSAutomaticApproximationFamily) where
  incidence : ∀ i : W.index,
    FiniteLatticeWilsonFourDimensionalIncidenceCertificate (W.system i)
  influenceMajorant_lt_inv_eighteen : ∀ i : W.index,
    finiteWilsonFourDimensionalInfluenceMajorant (W.system i) < (18 : ℝ)⁻¹

namespace FiniteWilsonFourDimensionalIncidenceHighTemperatureFamilyData

variable {W : FiniteWilsonOSAutomaticApproximationFamily}
    (D : FiniteWilsonFourDimensionalIncidenceHighTemperatureFamilyData W)

/-- Every scale has a strictly positive explicit Dobrushin margin. -/
theorem margin_pos (i : W.index) :
    0 < finiteWilsonFourDimensionalDobrushinMargin (W.system i) :=
  finite_wilson_fourDimensionalDobrushinMargin_pos
    (W.system i)
    (FiniteWilsonFourDimensionalIncidenceHighTemperatureFamilyData.influenceMajorant_lt_inv_eighteen D i)

/-- Four-dimensional incidence and the explicit high-temperature threshold
produce strict exact canonical Dobrushin coefficients at all finite scales. -/
noncomputable def strictFamilyData :
    FiniteWilsonCanonicalDobrushinStrictFamilyData W :=
  { edgeCard_pos := fun i => (D.incidence i).edgeCard_pos
    coefficient_lt_one := fun i =>
      (D.incidence i).canonicalDobrushinCoefficient_lt_one
        (FiniteWilsonFourDimensionalIncidenceHighTemperatureFamilyData.influenceMajorant_lt_inv_eighteen D i) }

/-- The complete proof-relevant canonical Dobrushin matrix family generated
from the four-dimensional incidence package. -/
noncomputable def matrixFamilyData :
    FiniteWilsonCanonicalDobrushinMatrixFamilyData W :=
  D.strictFamilyData.matrixFamilyData

/-- Centered random-scan Rayleigh certificates at every finite scale. -/
noncomputable def rayleighFamilyData :
    FiniteWilsonDobrushinRandomScanRayleighFamilyData W :=
  D.strictFamilyData.rayleighFamilyData

/-- Canonically generated finite-volume normalized Hamiltonian gap data. -/
noncomputable def hamiltonianGapData
    (i : W.index) :
    FiniteWilsonVacuumOrthogonalDerivedInvarianceGapData :=
  D.strictFamilyData.hamiltonianGapData i

/-- The explicit four-dimensional high-temperature package yields the
normalized Hamiltonian exact-gap estimate on every finite-volume
vacuum-orthogonal sector. -/
theorem hamiltonian_gap
    (i : W.index)
    (x : (W.system i).GibbsHilbertSpace)
    (hx : x ∈ finiteVacuumOrthogonal (W.system i).gibbsHilbertVacuum) :
    exactGapValueReal * ‖x‖ ^ 2 ≤
      inner ℝ
        ((W.system i).gibbsDobrushinScaledHeatBathHamiltonianLinearMap
          (D.rayleighFamilyData.atScale i) x) x :=
  finite_wilson_canonical_dobrushin_strict_family_hamiltonian_gap
    W D.strictFamilyData i x hx

/-- Every excitation-sector eigenvalue generated by the package lies above
the repository's normalized exact-gap carrier. -/
theorem restricted_eigenvalues_ge_exactGap
    (i : W.index)
    (j : Fin (D.hamiltonianGapData i).ExcitedDimension) :
    exactGapValueReal ≤
      (finite_wilson_vacuum_orthogonal_restricted_hamiltonian_symmetric
        (D.hamiltonianGapData i).toVacuumOrthogonalGapData 0).eigenvalues
          (D.hamiltonianGapData i).excitedFinrank j :=
  finite_wilson_canonical_dobrushin_strict_family_restricted_eigenvalues_ge_exactGap
    W D.strictFamilyData i j

end FiniteWilsonFourDimensionalIncidenceHighTemperatureFamilyData

end

end MathlibAnalytic
end MGAP4D
