import MGAP4D.MathlibAnalytic.PeriodicHypercubicEvenAllSpatialPlanesZeroMomentumGeneratedPermutationSubgroup
import MGAP4D.MathlibAnalytic.PeriodicHypercubicEvenSpatialParityGeometry
import Mathlib.Tactic

/-!
# Spatial parity is generated by the signed spatial configuration subgroup

The concrete configuration subgroup generated by `swap12`, `swap23`, and `reflect1` is now
canonical.  This file ties the independently constructed global spatial-parity action back into that
same subgroup.

First, finite generator lists are evaluated as genuine configuration permutations, and every such
word is proved to lie in the generated subgroup.  We then use the fixed word

`reflect1 · (swap12 reflect1 swap12) · (swap23 swap12 reflect1 swap12 swap23)`

which is reflection of axis `1`, followed by the swap-conjugate reflections of axes `2` and `3`.
On the positive-link carrier its pullback edge is exactly the already-canonical global spatial-parity
edge, and the accumulated link-value inversion is exactly one inversion on every spatial direction
and none on time links.  Hence the word action agrees pointwise with the existing spatial-parity
configuration action.

Consequently the global parity permutation itself belongs to the generated signed-spatial subgroup.
This is a structural finite-lattice symmetry statement only; no abstract cubic-group isomorphism,
irrep label, continuum-spin identification, or spectral claim is introduced here.
-/

namespace MGAP4D
namespace MathlibAnalytic

noncomputable section

/-- Evaluate a finite signed-spatial generator word as a genuine permutation of the actual finite
`SU(N)` positive-link configuration carrier. -/
def periodicHypercubicEvenSpatialSignedGeneratorWordConfigurationEquiv
    (H N : ℕ) :
    List PeriodicHypercubicEvenSpatialSignedGenerator →
      Equiv.Perm
        (PeriodicHypercubicEvenEdge H → Matrix.specialUnitaryGroup (Fin N) ℂ)
  | [] => 1
  | g :: word =>
      periodicHypercubicEvenSpatialSignedGeneratorConfigurationEquiv H N g *
        periodicHypercubicEvenSpatialSignedGeneratorWordConfigurationEquiv H N word

@[simp]
theorem periodicHypercubicEvenSpatialSignedGeneratorWordConfigurationEquiv_apply
    (H N : ℕ)
    (word : List PeriodicHypercubicEvenSpatialSignedGenerator)
    (A : PeriodicHypercubicEvenEdge H →
      Matrix.specialUnitaryGroup (Fin N) ℂ) :
    periodicHypercubicEvenSpatialSignedGeneratorWordConfigurationEquiv H N word A =
      periodicHypercubicEvenSpatialSignedGeneratorWordAction word A := by
  induction word with
  | nil => rfl
  | cons g word ih =>
      change
        periodicHypercubicEvenSpatialSignedGeneratorConfigurationEquiv H N g
            (periodicHypercubicEvenSpatialSignedGeneratorWordConfigurationEquiv H N word A) =
          periodicHypercubicEvenSpatialSignedGeneratorAction g
            (periodicHypercubicEvenSpatialSignedGeneratorWordAction word A)
      rw [periodicHypercubicEvenSpatialSignedGeneratorConfigurationEquiv_apply, ih]

/-- Every finite generator word, now interpreted as a genuine configuration permutation, belongs to
the generated signed-spatial subgroup. -/
theorem periodicHypercubicEvenSpatialSignedGeneratorWordConfigurationEquiv_mem_generated
    (H N : ℕ)
    (word : List PeriodicHypercubicEvenSpatialSignedGenerator) :
    periodicHypercubicEvenSpatialSignedGeneratorWordConfigurationEquiv H N word ∈
      periodicHypercubicEvenGeneratedSignedSpatialPermutationSubgroup H N := by
  induction word with
  | nil => exact Subgroup.one_mem _
  | cons g word ih =>
      exact Subgroup.mul_mem _
        (periodicHypercubicEvenSpatialSignedGeneratorConfigurationEquiv_mem_generated H N g)
        ih

/-- The fixed three-axis reflection word: `r₁ · (s₁₂ r₁ s₁₂) ·
(s₂₃ s₁₂ r₁ s₁₂ s₂₃)`. -/
def periodicHypercubicEvenSpatialParityGeneratorWord :
    List PeriodicHypercubicEvenSpatialSignedGenerator :=
  [.reflect1,
   .swap12, .reflect1, .swap12,
   .swap23, .swap12, .reflect1, .swap12, .swap23]

/-- Positive-edge pullback associated to one signed-spatial generator. -/
def periodicHypercubicEvenSpatialSignedGeneratorEdgePullback
    (H : ℕ)
    (g : PeriodicHypercubicEvenSpatialSignedGenerator) :
    PeriodicHypercubicEvenEdge H → PeriodicHypercubicEvenEdge H :=
  match g with
  | .swap12 =>
      (periodicHypercubicEdgeSpatialAxisSwap12Equiv
        (PeriodicHypercubicEvenSideLength H)).symm
  | .swap23 =>
      (periodicHypercubicEdgeSpatialAxisSwap23Equiv
        (PeriodicHypercubicEvenSideLength H)).symm
  | .reflect1 => periodicHypercubicEvenEdgeSpatialAxis1Reflection H

/-- Positive-edge pullback of a finite signed-spatial generator word.  Since configuration actions
are pullbacks, the tail edge map acts after the head edge map. -/
def periodicHypercubicEvenSpatialSignedGeneratorWordEdgePullback
    (H : ℕ) :
    List PeriodicHypercubicEvenSpatialSignedGenerator →
      PeriodicHypercubicEvenEdge H → PeriodicHypercubicEvenEdge H
  | [], e => e
  | g :: word, e =>
      periodicHypercubicEvenSpatialSignedGeneratorWordEdgePullback H word
        (periodicHypercubicEvenSpatialSignedGeneratorEdgePullback H g e)

/-- The positive-edge pullback of the fixed three-axis reflection word is exactly the canonical
spatial-parity positive-edge representative. -/
theorem periodicHypercubicEvenSpatialParityGeneratorWordEdgePullback_eq
    (H : ℕ)
    (e : PeriodicHypercubicEvenEdge H) :
    periodicHypercubicEvenSpatialSignedGeneratorWordEdgePullback H
        periodicHypercubicEvenSpatialParityGeneratorWord e =
      periodicHypercubicEvenEdgeSpatialParity H e := by
  rcases e with ⟨v, mu⟩
  apply Prod.ext
  · funext i
    fin_cases mu <;> fin_cases i <;>
      simp [periodicHypercubicEvenSpatialParityGeneratorWord,
        periodicHypercubicEvenSpatialSignedGeneratorWordEdgePullback,
        periodicHypercubicEvenSpatialSignedGeneratorEdgePullback,
        periodicHypercubicEdgeSpatialAxisSwap12Equiv_symm_apply,
        periodicHypercubicEdgeSpatialAxisSwap23Equiv_symm_apply,
        periodicHypercubicVertexSpatialAxisSwap12Equiv_symm_apply,
        periodicHypercubicVertexSpatialAxisSwap23Equiv_symm_apply,
        periodicHypercubicEvenEdgeSpatialAxis1Reflection,
        periodicHypercubicEvenSpatialAxis1Reflection,
        periodicHypercubicEvenEdgeSpatialParity,
        periodicHypercubicEvenSpatialParity,
        periodicHypercubicUnshift, periodicHypercubicUnit] <;>
      ring
  · fin_cases mu <;>
      simp [periodicHypercubicEvenSpatialParityGeneratorWord,
        periodicHypercubicEvenSpatialSignedGeneratorWordEdgePullback,
        periodicHypercubicEvenSpatialSignedGeneratorEdgePullback,
        periodicHypercubicEdgeSpatialAxisSwap12Equiv_symm_apply,
        periodicHypercubicEdgeSpatialAxisSwap23Equiv_symm_apply,
        periodicHypercubicEvenEdgeSpatialAxis1Reflection,
        periodicHypercubicEvenEdgeSpatialParity]

/-- Along the fixed parity word, exactly one reflected-axis traversal is reversed for every spatial
link and no traversal is reversed for time links. -/
theorem periodicHypercubicEvenSpatialParityGeneratorWordAction_apply
    (H N : ℕ)
    (A : PeriodicHypercubicEvenEdge H →
      Matrix.specialUnitaryGroup (Fin N) ℂ)
    (e : PeriodicHypercubicEvenEdge H) :
    periodicHypercubicEvenSpatialSignedGeneratorWordAction
        periodicHypercubicEvenSpatialParityGeneratorWord A e =
      if e.2 = 0 then
        A (periodicHypercubicEvenSpatialSignedGeneratorWordEdgePullback H
          periodicHypercubicEvenSpatialParityGeneratorWord e)
      else
        (A (periodicHypercubicEvenSpatialSignedGeneratorWordEdgePullback H
          periodicHypercubicEvenSpatialParityGeneratorWord e))⁻¹ := by
  rcases e with ⟨v, mu⟩
  fin_cases mu <;>
    simp [periodicHypercubicEvenSpatialParityGeneratorWord,
      periodicHypercubicEvenSpatialSignedGeneratorWordAction,
      periodicHypercubicEvenSpatialSignedGeneratorAction,
      periodicHypercubicEvenSpatialSignedGeneratorWordEdgePullback,
      periodicHypercubicEvenSpatialSignedGeneratorEdgePullback,
      periodicHypercubicConfigurationSpatialAxisSwap12,
      periodicHypercubicConfigurationSpatialAxisSwap23,
      periodicHypercubicEvenConfigurationSpatialAxis1Reflection,
      periodicHypercubicEvenEdgeSpatialAxis1Reflection,
      periodicHypercubicEdgeSpatialAxisSwap12Equiv_symm_apply,
      periodicHypercubicEdgeSpatialAxisSwap23Equiv_symm_apply]

/-- The fixed generator word acts on actual finite configurations exactly as the independently
constructed global spatial-parity operation. -/
theorem periodicHypercubicEvenSpatialParityGeneratorWordAction_eq
    (H N : ℕ)
    (A : PeriodicHypercubicEvenEdge H →
      Matrix.specialUnitaryGroup (Fin N) ℂ) :
    periodicHypercubicEvenSpatialSignedGeneratorWordAction
        periodicHypercubicEvenSpatialParityGeneratorWord A =
      periodicHypercubicEvenConfigurationSpatialParity H A := by
  funext e
  rw [periodicHypercubicEvenSpatialParityGeneratorWordAction_apply,
    periodicHypercubicEvenSpatialParityGeneratorWordEdgePullback_eq]
  rfl

/-- Global spatial parity as a genuine permutation of the finite positive-link configuration
carrier. -/
def periodicHypercubicEvenConfigurationSpatialParityEquiv
    (H N : ℕ) :
    Equiv.Perm
      (PeriodicHypercubicEvenEdge H → Matrix.specialUnitaryGroup (Fin N) ℂ) where
  toFun := periodicHypercubicEvenConfigurationSpatialParity H
  invFun := periodicHypercubicEvenConfigurationSpatialParity H
  left_inv := periodicHypercubicEvenConfigurationSpatialParity_involutive H
  right_inv := periodicHypercubicEvenConfigurationSpatialParity_involutive H

@[simp]
theorem periodicHypercubicEvenConfigurationSpatialParityEquiv_apply
    (H N : ℕ)
    (A : PeriodicHypercubicEvenEdge H →
      Matrix.specialUnitaryGroup (Fin N) ℂ) :
    periodicHypercubicEvenConfigurationSpatialParityEquiv H N A =
      periodicHypercubicEvenConfigurationSpatialParity H A :=
  rfl

/-- The genuine parity permutation is exactly the permutation represented by the fixed generator
word. -/
theorem periodicHypercubicEvenConfigurationSpatialParityEquiv_eq_generatorWord
    (H N : ℕ) :
    periodicHypercubicEvenConfigurationSpatialParityEquiv H N =
      periodicHypercubicEvenSpatialSignedGeneratorWordConfigurationEquiv H N
        periodicHypercubicEvenSpatialParityGeneratorWord := by
  apply Equiv.ext
  intro A
  rw [periodicHypercubicEvenConfigurationSpatialParityEquiv_apply,
    periodicHypercubicEvenSpatialSignedGeneratorWordConfigurationEquiv_apply,
    periodicHypercubicEvenSpatialParityGeneratorWordAction_eq]

/-- The independently constructed global spatial-parity permutation belongs to the concrete
signed-spatial configuration subgroup generated by the two adjacent swaps and `reflect1`. -/
theorem periodicHypercubicEvenConfigurationSpatialParityEquiv_mem_generated
    (H N : ℕ) :
    periodicHypercubicEvenConfigurationSpatialParityEquiv H N ∈
      periodicHypercubicEvenGeneratedSignedSpatialPermutationSubgroup H N := by
  rw [periodicHypercubicEvenConfigurationSpatialParityEquiv_eq_generatorWord]
  exact
    periodicHypercubicEvenSpatialSignedGeneratorWordConfigurationEquiv_mem_generated
      H N periodicHypercubicEvenSpatialParityGeneratorWord

end

end MathlibAnalytic
end MGAP4D
