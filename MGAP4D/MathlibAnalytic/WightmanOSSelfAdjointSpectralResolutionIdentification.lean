import MGAP4D.MathlibAnalytic.WightmanOSSelfAdjointSpectralIntegralConstructor

namespace MGAP4D
namespace MathlibAnalytic

noncomputable section

/-- Spectral resolution supplied by a self-adjoint spectral theorem before it is
identified with the PVM already stored in a reconstructed model. -/
structure ExplicitWightmanOSSelfAdjointSpectralResolution
    (M : ExplicitWightmanOSReconstructedModel) where
  spectralPVM : OrthogonalProjectionValuedSetFunction M.H
  integral : (ℝ → ℝ) → M.H → M.H
  indicator_integral_eq_projection :
    ∀ (s : Set ℝ), MeasurableSet s → ∀ ψ : M.H,
      integral (s.indicator fun _ => (1 : ℝ)) ψ =
        spectralPVM.projection s ψ
  eigenvector_integral_evaluation :
    ∀ {E : ℝ} (x : M.hamiltonian.domain),
      M.hamiltonian x = E • (x : M.H) →
        ∀ f : ℝ → ℝ,
          integral f (x : M.H) = f E • (x : M.H)

/-- Identifying the spectral-theorem PVM with the PVM stored in the model turns a
spectral resolution into the previously defined real spectral integral. -/
def ExplicitWightmanOSSelfAdjointSpectralResolution.toRealSpectralIntegral
    {M : ExplicitWightmanOSReconstructedModel}
    (R : ExplicitWightmanOSSelfAdjointSpectralResolution M)
    (hIdent : R.spectralPVM = M.spectralPVM) :
    ExplicitWightmanOSRealSpectralIntegral M where
  integral := R.integral
  indicator_integral_eq_projection := by
    intro s hs ψ
    rw [← hIdent]
    exact R.indicator_integral_eq_projection s hs ψ
  eigenvector_integral_evaluation := R.eigenvector_integral_evaluation

/-- The mathematically intrinsic output of an unbounded self-adjoint spectral
theorem: a spectral resolution for every self-adjoint reconstructed Hamiltonian. -/
structure ExplicitWightmanOSSelfAdjointSpectralResolutionConstructor where
  construct :
    ∀ (M : ExplicitWightmanOSReconstructedModel),
      IsSelfAdjoint M.hamiltonian →
        ExplicitWightmanOSSelfAdjointSpectralResolution M

/-- Additional model-data obligation identifying the PVM generated by the
self-adjoint spectral theorem with the PVM already stored in the model. -/
structure ExplicitWightmanOSModelSpectralPVMIdentification
    (C : ExplicitWightmanOSSelfAdjointSpectralResolutionConstructor) where
  identified :
    ∀ (M : ExplicitWightmanOSReconstructedModel)
      (hSelfAdjoint : IsSelfAdjoint M.hamiltonian),
      (C.construct M hSelfAdjoint).spectralPVM = M.spectralPVM

/-- A self-adjoint spectral-resolution constructor plus model-PVM identification
produces the earlier spectral-integral constructor. -/
def ExplicitWightmanOSSelfAdjointSpectralResolutionConstructor.toSpectralIntegralConstructor
    (C : ExplicitWightmanOSSelfAdjointSpectralResolutionConstructor)
    (J : ExplicitWightmanOSModelSpectralPVMIdentification C) :
    ExplicitWightmanOSSelfAdjointSpectralIntegralConstructor where
  construct := fun M hSelfAdjoint =>
    (C.construct M hSelfAdjoint).toRealSpectralIntegral
      (J.identified M hSelfAdjoint)

/-- Once the generated PVM is identified with the reconstructed model PVM, the
self-adjoint spectral resolution yields measurable indicator evaluation on the
actual OS physical model. -/
theorem euclidean_yang_mills_os_physical_ambient_indicator_evaluation_of_identified_resolution
    (C : ExplicitWightmanOSSelfAdjointSpectralResolutionConstructor)
    (J : ExplicitWightmanOSModelSpectralPVMIdentification C)
    {S : EuclideanYangMillsContinuumMeasureConstructionSpine}
    (M : EuclideanYangMillsOSPhysicalHilbertReconstructedModel S) :
    ExplicitWightmanOSAmbientEigenvectorIndicatorEvaluationLaw M.toExplicitModel := by
  exact
    euclidean_yang_mills_os_physical_ambient_indicator_evaluation_of_selfAdjointConstructor
      (C.toSpectralIntegralConstructor J) M

/-- The same identified spectral resolution feeds the complete canonical
singleton eigenprojection chain on the actual OS physical model. -/
theorem euclidean_yang_mills_os_physical_canonical_eigenprojection_law_of_identified_resolution
    (C : ExplicitWightmanOSSelfAdjointSpectralResolutionConstructor)
    (J : ExplicitWightmanOSModelSpectralPVMIdentification C)
    {S : EuclideanYangMillsContinuumMeasureConstructionSpine}
    (M : EuclideanYangMillsOSPhysicalHilbertReconstructedModel S)
    (P : ExplicitWightmanOSCountablyAdditivePVMScalarMeasure M.toExplicitModel)
    (hQuadratic :
      ExplicitWightmanOSScalarMeasureENNRealQuadraticLaw M.toExplicitModel P) :
    ExplicitWightmanOSCanonicalEigenprojectionLaw M.toExplicitModel := by
  exact
    euclidean_yang_mills_os_physical_canonical_eigenprojection_law_of_selfAdjointConstructor
      (C.toSpectralIntegralConstructor J) M P hQuadratic

end

end MathlibAnalytic
end MGAP4D
