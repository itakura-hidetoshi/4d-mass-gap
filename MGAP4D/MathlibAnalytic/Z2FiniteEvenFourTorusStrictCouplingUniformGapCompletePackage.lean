import MGAP4D.MathlibAnalytic.Z2FiniteEvenFourTorusStrictCouplingUniformGapEquivalence

namespace MGAP4D
namespace MathlibAnalytic

noncomputable section

/-- Complete quantitative family package generated by one common excited
spectral cap.  It retains every all-finite-volume theorem from the preceding
strict-coupling package and adds a common positive energy floor, exact
family-level gap lower bound, mode-energy lower bound, and uniform natural-time
decay. -/
structure Z2UnfixedGaugeStrictCouplingUniformGapCompletePackage
    (β energyIdentity energyNontrivial : ℝ)
    (hβ : 0 < β)
    (hEnergy : energyIdentity < energyNontrivial) where
  finiteVolumeFamily :
    Z2UnfixedGaugeStrictCouplingFiniteVolumeFamilyCompletePackage
      β energyIdentity energyNontrivial hβ hEnergy
  spectralCap :
    Z2UnfixedGaugeStrictCouplingUniformSpectralCapCertificate
      β energyIdentity energyNontrivial hβ hEnergy
  uniformGap : ℝ
  uniformGap_eq_neg_log_rate :
    uniformGap = -Real.log spectralCap.rate
  uniformGap_pos :
    0 < uniformGap
  uniformGap_le_atVolume :
    ∀ H : ℕ,
      uniformGap ≤
        finiteEvenFourTorusZ2UnfixedGaugeStrictExcitationGapAt
          H β energyIdentity energyNontrivial hβ hEnergy
  uniformGap_le_excitedEnergy :
    ∀ (H : ℕ)
      (i : FiniteEvenFourTorusZ2UnfixedGaugeExcitedSpectralIndex
        H β energyIdentity energyNontrivial hβ.le hEnergy.le),
      uniformGap ≤
        finiteEvenFourTorusZ2UnfixedGaugePositiveSpectralEnergy
          H β energyIdentity energyNontrivial hβ.le hEnergy.le i.toPositive
  exp_neg_uniformGap_eq_rate :
    Real.exp (-uniformGap) = spectralCap.rate
  excited_coordinate_uniform_decay :
    ∀ (H n : ℕ)
      (x : FiniteEvenFourTorusZ2UnfixedGaugePositiveSpectralSpace
        H β energyIdentity energyNontrivial hβ.le hEnergy.le)
      (i : FiniteEvenFourTorusZ2UnfixedGaugeExcitedSpectralIndex
        H β energyIdentity energyNontrivial hβ.le hEnergy.le),
      |finiteEvenFourTorusZ2UnfixedGaugePositiveSpectralSemigroup
          H β energyIdentity energyNontrivial hβ.le hEnergy.le n x i.toPositive| ≤
        (Real.exp (-uniformGap)) ^ n * |x i.toPositive|
  common_rate_strict_at_positive_time :
    ∀ {n : ℕ}, 0 < n → spectralCap.rate ^ n < 1
  uniformGap_exists :
    Z2UnfixedGaugeStrictCouplingHasUniformGap
      β energyIdentity energyNontrivial hβ hEnergy

/-- Construct the complete quantitative family package from one common
strict excited-eigenvalue cap. -/
noncomputable def finiteEvenFourTorusZ2UnfixedGaugeStrictCouplingUniformGapCompletePackage
    (β energyIdentity energyNontrivial : ℝ)
    (hβ : 0 < β)
    (hEnergy : energyIdentity < energyNontrivial)
    (C : Z2UnfixedGaugeStrictCouplingUniformSpectralCapCertificate
      β energyIdentity energyNontrivial hβ hEnergy) :
    Z2UnfixedGaugeStrictCouplingUniformGapCompletePackage
      β energyIdentity energyNontrivial hβ hEnergy :=
  { finiteVolumeFamily :=
      finiteEvenFourTorusZ2UnfixedGaugeStrictCouplingFiniteVolumeFamilyCompletePackage
        β energyIdentity energyNontrivial hβ hEnergy
    spectralCap := C
    uniformGap := C.uniformExcitationGap
    uniformGap_eq_neg_log_rate := rfl
    uniformGap_pos := C.uniformExcitationGap_pos
    uniformGap_le_atVolume := C.uniformExcitationGap_le_strictExcitationGapAt
    uniformGap_le_excitedEnergy := C.uniformExcitationGap_le_excitedEnergy
    exp_neg_uniformGap_eq_rate := C.exp_neg_uniformExcitationGap
    excited_coordinate_uniform_decay :=
      C.excitedSemigroup_coordinate_abs_le_uniformGap
    common_rate_strict_at_positive_time := C.rate_pow_lt_one
    uniformGap_exists := C.exists_uniformExcitationGap }

/-- Construct the same complete package directly from a common positive energy
floor.  The intermediate spectral cap is generated canonically as
`exp (-gap)`. -/
noncomputable def finiteEvenFourTorusZ2UnfixedGaugeStrictCouplingUniformGapCompletePackageOfWitness
    (β energyIdentity energyNontrivial : ℝ)
    (hβ : 0 < β)
    (hEnergy : energyIdentity < energyNontrivial)
    (W : Z2UnfixedGaugeStrictCouplingUniformGapWitness
      β energyIdentity energyNontrivial hβ hEnergy) :
    Z2UnfixedGaugeStrictCouplingUniformGapCompletePackage
      β energyIdentity energyNontrivial hβ hEnergy :=
  finiteEvenFourTorusZ2UnfixedGaugeStrictCouplingUniformGapCompletePackage
    β energyIdentity energyNontrivial hβ hEnergy W.toSpectralCapCertificate

/-- The witness-based complete package retains the supplied common energy floor
exactly, rather than merely producing an unspecified smaller positive number. -/
theorem finiteEvenFourTorusZ2UnfixedGaugeStrictCouplingUniformGapCompletePackageOfWitness_gap_eq
    (β energyIdentity energyNontrivial : ℝ)
    (hβ : 0 < β)
    (hEnergy : energyIdentity < energyNontrivial)
    (W : Z2UnfixedGaugeStrictCouplingUniformGapWitness
      β energyIdentity energyNontrivial hβ hEnergy) :
    (finiteEvenFourTorusZ2UnfixedGaugeStrictCouplingUniformGapCompletePackageOfWitness
      β energyIdentity energyNontrivial hβ hEnergy W).uniformGap = W.gap := by
  exact W.toSpectralCapCertificate_uniformExcitationGap_eq

end

end MathlibAnalytic
end MGAP4D
