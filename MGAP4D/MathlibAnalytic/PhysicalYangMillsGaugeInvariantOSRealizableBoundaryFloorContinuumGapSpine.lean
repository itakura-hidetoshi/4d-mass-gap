/-- Final realizable-time Wilson OS gap spine after all algebraic and completion
machinery has been theorem-generated.

The structure deliberately exposes only the two genuinely model-dependent
inputs that remain on the discrete compact-Haar `SU(N)` route:

1. the exact one-slab centered boundary Gram-moment decay at mass `33/20`;
2. convergence of the floor-selected completed finite Wilson trajectories into
   the chosen continuum OS semigroup on a common carrier.

Everything between these two inputs and the continuum Hamiltonian lower bound
is generated by the merged Mathlib infrastructure.  In particular there is no
finite all-real-time semigroup, no heat-bath/geometric-time identification, and
no import of the separate high-temperature `Z₂` coercivity estimate. -/
structure PhysicalYangMillsEvenPeriodicWilsonOSRealizableBoundaryFloorContinuumGapSpine
    (S : PhysicalFourDimensionalYangMillsSymmetryLimit)
    (D : PhysicalYangMillsGaugeInvariantOSReflectionData S)
    (halfExtent : ℕ → ℕ)
    (N : ℕ)
    (hN : 0 < N)
    [Nontrivial (Matrix.specialUnitaryGroup (Fin N) ℂ)]
    (beta : ℕ → ℝ)
    (hbeta : ∀ n, 0 ≤ beta n)
    (Q : PhysicalYangMillsEvenPeriodicWilsonOSCoherentPositiveTimePullback
      S D halfExtent N hN beta hbeta)
    (E : PhysicalFourDimensionalYangMillsContinuumEuclideanTimeTranslation S)
    (R : PhysicalYangMillsEvenPeriodicWilsonOSRealizablePositiveTemporalCovariance
      S D halfExtent N hN beta hbeta Q E)
    (hInvariant : ∀ n,
      D.WeakStarReflectionInvariant
        (physicalYangMillsApproximatingGaugeInvariantWeakStarState S n))
    (P : D.OSPreHilbertData)
    (T : P.StronglyContinuousPhysicalSemigroup) where
  boundaryOneStep :
    PhysicalYangMillsEvenPeriodicWilsonOSRealizableOneStepExact3320BoundaryMomentGapCertificate
      S D halfExtent N hN beta hbeta Q E R hInvariant
  floorTransfer :
    PhysicalYangMillsEvenPeriodicWilsonOSRealizableFloorCommonCarrierGapTransfer
      S D halfExtent N hN beta hbeta Q E R hInvariant P T
        boundaryOneStep.toOneStepExact3320GapCertificate

namespace PhysicalYangMillsEvenPeriodicWilsonOSRealizableBoundaryFloorContinuumGapSpine

variable
    {S : PhysicalFourDimensionalYangMillsSymmetryLimit}
    {D : PhysicalYangMillsGaugeInvariantOSReflectionData S}
    {halfExtent : ℕ → ℕ}
    {N : ℕ}
    {hN : 0 < N}
    [Nontrivial (Matrix.specialUnitaryGroup (Fin N) ℂ)]
    {beta : ℕ → ℝ}
    {hbeta : ∀ n, 0 ≤ beta n}
    {Q : PhysicalYangMillsEvenPeriodicWilsonOSCoherentPositiveTimePullback
      S D halfExtent N hN beta hbeta}
    {E : PhysicalFourDimensionalYangMillsContinuumEuclideanTimeTranslation S}
    {R : PhysicalYangMillsEvenPeriodicWilsonOSRealizablePositiveTemporalCovariance
      S D halfExtent N hN beta hbeta Q E}
    {hInvariant : ∀ n,
      D.WeakStarReflectionInvariant
        (physicalYangMillsApproximatingGaugeInvariantWeakStarState S n)}
    {P : D.OSPreHilbertData}
    {T : P.StronglyContinuousPhysicalSemigroup}

/-- Recover the literal actual finite Wilson Gibbs reflected-integral one-step
certificate from the boundary-local input. -/
noncomputable def toFiniteIntegralGapCertificate
    (C : PhysicalYangMillsEvenPeriodicWilsonOSRealizableBoundaryFloorContinuumGapSpine
      S D halfExtent N hN beta hbeta Q E R hInvariant P T) :
    PhysicalYangMillsEvenPeriodicWilsonOSRealizableOneStepExact3320FiniteIntegralGapCertificate
      S D halfExtent N hN beta hbeta Q E R hInvariant :=
  C.boundaryOneStep.toFiniteIntegralGapCertificate

/-- Recover the exact centered one-step OS norm certificate of the discrete
semigroup lane. -/
noncomputable def toOneStepExact3320GapCertificate
    (C : PhysicalYangMillsEvenPeriodicWilsonOSRealizableBoundaryFloorContinuumGapSpine
      S D halfExtent N hN beta hbeta Q E R hInvariant P T) :
    PhysicalYangMillsEvenPeriodicWilsonOSRealizableOneStepExact3320GapCertificate
      S D halfExtent N hN beta hbeta Q E R hInvariant :=
  C.boundaryOneStep.toOneStepExact3320GapCertificate

/-- The final spine generates the exact continuum vacuum-semigroup gap slope. -/
noncomputable def toVacuumSemigroupGapSlope
    (C : PhysicalYangMillsEvenPeriodicWilsonOSRealizableBoundaryFloorContinuumGapSpine
      S D halfExtent N hN beta hbeta Q E R hInvariant P T) :
    T.VacuumSemigroupGapSlope :=
  C.floorTransfer.toVacuumSemigroupGapSlope

/-- The exact finite one-slab boundary decay, discrete iteration, and
floor-selected continuum limit generate the continuum exponential contraction
with literal mass `33/20`. -/
theorem continuum_operator_vacuumOrthogonal_norm_le_exp_3320
    (C : PhysicalYangMillsEvenPeriodicWilsonOSRealizableBoundaryFloorContinuumGapSpine
      S D halfExtent N hN beta hbeta Q E R hInvariant P T)
    (t : NNReal) (psi : P.PhysicalHilbert)
    (hpsi : inner ℝ psi P.vacuum = 0) :
    ‖T.toPhysicalSemigroup.operator t psi‖ ≤
      Real.exp (-physicalYangMillsExact3320Mass * (t : ℝ)) * ‖psi‖ := by
  exact C.floorTransfer.continuum_operator_vacuumOrthogonal_norm_le_exp_3320
    t psi hpsi

/-- Exact `33/20` Rayleigh lower bound on the continuum right-generator domain. -/
theorem rightHamiltonian_inner_ge_3320_mul_norm_sq
    (C : PhysicalYangMillsEvenPeriodicWilsonOSRealizableBoundaryFloorContinuumGapSpine
      S D halfExtent N hN beta hbeta Q E R hInvariant P T)
    (psi : T.rightGeneratorDomain)
    (hpsi : inner ℝ (psi : P.PhysicalHilbert) P.vacuum = 0) :
    (33 : ℝ) / 20 * ‖(psi : P.PhysicalHilbert)‖ ^ 2 ≤
      inner ℝ (T.rightHamiltonian psi) (psi : P.PhysicalHilbert) := by
  exact C.floorTransfer.rightHamiltonian_inner_ge_3320_mul_norm_sq psi hpsi

/-- Exact `33/20` Rayleigh lower bound on the graph-closed continuum
right-Hamiltonian. -/
theorem closedRightHamiltonian_inner_ge_3320_mul_norm_sq
    (C : PhysicalYangMillsEvenPeriodicWilsonOSRealizableBoundaryFloorContinuumGapSpine
      S D halfExtent N hN beta hbeta Q E R hInvariant P T)
    (hP : P.IsNormalized)
    (psi : T.closedRightHamiltonian.domain)
    (hpsi : inner ℝ (psi : P.PhysicalHilbert) P.vacuum = 0) :
    (33 : ℝ) / 20 * ‖(psi : P.PhysicalHilbert)‖ ^ 2 ≤
      inner ℝ (T.closedRightHamiltonian psi)
        (psi : P.PhysicalHilbert) := by
  exact C.floorTransfer.closedRightHamiltonian_inner_ge_3320_mul_norm_sq
    hP psi hpsi

end PhysicalYangMillsEvenPeriodicWilsonOSRealizableBoundaryFloorContinuumGapSpine

