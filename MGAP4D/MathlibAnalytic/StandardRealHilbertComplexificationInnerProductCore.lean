import MGAP4D.MathlibAnalytic.StandardRealHilbertComplexificationModule
import Mathlib.Analysis.InnerProductSpace.Basic
import Mathlib.Tactic

namespace MGAP4D
namespace MathlibAnalytic

noncomputable section

open scoped InnerProductSpace

namespace StandardRealHilbertComplexification

variable {H : Type*}
variable [NormedAddCommGroup H] [InnerProductSpace ℝ H]

/-- The standard complex inner product on the algebraic complexification of a real inner-product
space.  In coordinates,

`⟪(x,y),(u,v)⟫ = (⟪x,u⟫ + ⟪y,v⟫) + I * (⟪x,v⟫ - ⟪y,u⟫)`.
-/
def standardInner
    (z w : StandardRealHilbertComplexification H) : ℂ :=
  ⟨⟪z.1, w.1⟫_ℝ + ⟪z.2, w.2⟫_ℝ,
    ⟪z.1, w.2⟫_ℝ - ⟪z.2, w.1⟫_ℝ⟩

@[simp]
theorem standardInner_re
    (z w : StandardRealHilbertComplexification H) :
    (standardInner z w).re =
      ⟪z.1, w.1⟫_ℝ + ⟪z.2, w.2⟫_ℝ :=
  rfl

@[simp]
theorem standardInner_im
    (z w : StandardRealHilbertComplexification H) :
    (standardInner z w).im =
      ⟪z.1, w.2⟫_ℝ - ⟪z.2, w.1⟫_ℝ :=
  rfl

/-- The standard complex inner product is Hermitian. -/
theorem standardInner_conj_symm
    (z w : StandardRealHilbertComplexification H) :
    starRingEnd ℂ (standardInner w z) = standardInner z w := by
  apply Complex.ext <;> simp [standardInner, real_inner_comm]

/-- The self-inner-product has the expected real Euclidean value and zero imaginary part. -/
theorem standardInner_self
    (z : StandardRealHilbertComplexification H) :
    standardInner z z =
      ⟨‖z.1‖ ^ 2 + ‖z.2‖ ^ 2, 0⟩ := by
  apply Complex.ext
  · simp [standardInner, inner_self_eq_norm_sq_to_K]
  · simp [standardInner, real_inner_comm]

/-- The real part of the standard self-inner-product is nonnegative. -/
theorem standardInner_self_re_nonneg
    (z : StandardRealHilbertComplexification H) :
    0 ≤ (standardInner z z).re := by
  rw [standardInner_self]
  simp
  positivity

/-- The standard complex inner product is additive in the first coordinate. -/
theorem standardInner_add_left
    (z w u : StandardRealHilbertComplexification H) :
    standardInner (z + w) u = standardInner z u + standardInner w u := by
  apply Complex.ext <;>
    simp [standardInner, inner_add_left]
  all_goals ring

/-- The standard complex inner product is conjugate-linear in the first coordinate. -/
theorem standardInner_smul_left
    (z w : StandardRealHilbertComplexification H) (c : ℂ) :
    standardInner (c • z) w = starRingEnd ℂ c * standardInner z w := by
  apply Complex.ext <;>
    simp [standardInner, Complex.mul_re, Complex.mul_im,
      inner_sub_left, inner_add_left, real_inner_smul_left]
  all_goals ring

/-- The standard complex inner product is positive definite. -/
theorem standardInner_definite
    (z : StandardRealHilbertComplexification H)
    (hz : standardInner z z = 0) :
    z = 0 := by
  rcases z with ⟨x, y⟩
  have hre := congrArg Complex.re hz
  have hsum : ‖x‖ ^ 2 + ‖y‖ ^ 2 = 0 := by
    simpa [standardInner, inner_self_eq_norm_sq_to_K] using hre
  have hxnorm : ‖x‖ = 0 := by nlinarith [sq_nonneg ‖x‖, sq_nonneg ‖y‖]
  have hynorm : ‖y‖ = 0 := by nlinarith [sq_nonneg ‖x‖, sq_nonneg ‖y‖]
  have hx : x = 0 := norm_eq_zero.mp hxnorm
  have hy : y = 0 := norm_eq_zero.mp hynorm
  change (x, y) = (0, 0)
  simp [hx, hy]

/-- The positive-definite inner-product core of the standard complexification. -/
@[reducible]
def innerProductCore :
    InnerProductSpace.Core ℂ (StandardRealHilbertComplexification H) where
  inner := standardInner
  conj_inner_symm := standardInner_conj_symm
  re_inner_nonneg := standardInner_self_re_nonneg
  add_left := standardInner_add_left
  smul_left := standardInner_smul_left
  definite := standardInner_definite

/-- The norm canonically generated by the standard complex inner product. -/
def standardNorm
    (z : StandardRealHilbertComplexification H) : ℝ :=
  Real.sqrt ((standardInner z z).re)

/-- Coordinate formula for the generated norm. -/
theorem standardNorm_eq
    (z : StandardRealHilbertComplexification H) :
    standardNorm z = Real.sqrt (‖z.1‖ ^ 2 + ‖z.2‖ ^ 2) := by
  rw [standardNorm, standardInner_self]

/-- The square of the generated norm is the Euclidean sum of coordinate norm squares. -/
theorem standardNorm_sq
    (z : StandardRealHilbertComplexification H) :
    standardNorm z ^ 2 = ‖z.1‖ ^ 2 + ‖z.2‖ ^ 2 := by
  rw [standardNorm_eq]
  exact Real.sq_sqrt (by positivity)

/-- The canonical real embedding preserves the generated norm. -/
theorem standardNorm_ofReal
    (x : H) :
    standardNorm (ofReal x) = ‖x‖ := by
  rw [standardNorm_eq]
  simp only [ofReal_re, ofReal_im, norm_zero]
  rw [zero_pow (by norm_num : (2 : ℕ) ≠ 0), add_zero,
    Real.sqrt_sq_eq_abs, abs_of_nonneg (norm_nonneg x)]

/-- Standard conjugation preserves the generated norm. -/
theorem standardNorm_conjugation
    (z : StandardRealHilbertComplexification H) :
    standardNorm (conjugation z) = standardNorm z := by
  rw [standardNorm_eq, standardNorm_eq]
  simp [conjugation]

end StandardRealHilbertComplexification

end

end MathlibAnalytic
end MGAP4D
