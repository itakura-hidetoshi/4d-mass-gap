import MGAP4D.MathlibAnalytic.StandardRealHilbertComplexificationModule
import Mathlib.Analysis.InnerProductSpace.Defs
import Mathlib.Tactic

namespace MGAP4D
namespace MathlibAnalytic

noncomputable section

open scoped InnerProductSpace

namespace StandardRealHilbertComplexification

variable {H : Type*}
variable [NormedAddCommGroup H] [InnerProductSpace ℝ H]

/-- The standard complex inner product on the algebraic complexification of a real inner-product
space.  In coordinates,

`⟪(x,y),(u,v)⟫ = (⟪x,u⟫ + ⟪y,v⟫) + I * (⟪x,v⟫ - ⟪y,u⟫)`.
-/
def standardInner
    (z w : StandardRealHilbertComplexification H) : ℂ :=
  ⟨⟪z.1, w.1⟫_ℝ + ⟪z.2, w.2⟫_ℝ,
    ⟪z.1, w.2⟫_ℝ - ⟪z.2, w.1⟫_ℝ⟩

@[simp]
theorem standardInner_re
    (z w : StandardRealHilbertComplexification H) :
    (standardInner z w).re =
      ⟪z.1, w.1⟫_ℝ + ⟪z.2, w.2⟫_ℝ :=
  rfl

@[simp]
theorem standardInner_im
    (z w : StandardRealHilbertComplexification H) :
    (standardInner z w).im =
      ⟪z.1, w.2⟫_ℝ - ⟪z.2, w.1⟫_ℝ :=
  rfl

/-- The standard complex inner product is Hermitian. -/
theorem standardInner_conj_symm
    (z w : StandardRealHilbertComplexification H) :
    starRingEnd ℂ (standardInner w z) = standardInner z w := by
  apply Complex.ext <;> simp [standardInner, real_inner_comm]

/-- The real part of the standard self-inner-product is nonnegative. -/
theorem standardInner_self_re_nonneg
    (z : StandardRealHilbertComplexification H) :
    0 ≤ (standardInner z z).re := by
  simp [standardInner]
  exact add_nonneg real_inner_self_nonneg real_inner_self_nonneg

/-- The standard complex inner product is additive in the first coordinate. -/
theorem standardInner_add_left
    (z w u : StandardRealHilbertComplexification H) :
    standardInner (z + w) u = standardInner z u + standardInner w u := by
  apply Complex.ext <;>
    simp [standardInner, inner_add_left]
  all_goals ring

/-- The standard complex inner product is conjugate-linear in the first coordinate. -/
theorem standardInner_smul_left
    (z w : StandardRealHilbertComplexification H) (c : ℂ) :
    standardInner (c • z) w = starRingEnd ℂ c * standardInner z w := by
  apply Complex.ext <;>
    simp [standardInner, Complex.mul_re, Complex.mul_im, inner_add_left, inner_sub_left]
  all_goals ring

/-- The standard complex inner product is positive definite. -/
theorem standardInner_definite
    (z : StandardRealHilbertComplexification H)
    (hz : standardInner z z = 0) :
    z = 0 := by
  have hre := congrArg Complex.re hz
  have hsum : ⟪z.1, z.1⟫_ℝ + ⟪z.2, z.2⟫_ℝ = 0 := by
    simpa [standardInner] using hre
  have h₁non : 0 ≤ ⟪z.1, z.1⟫_ℝ := real_inner_self_nonneg
  have h₂non : 0 ≤ ⟪z.2, z.2⟫_ℝ := real_inner_self_nonneg
  have h₁zero : ⟪z.1, z.1⟫_ℝ = 0 := by linarith
  have h₂zero : ⟪z.2, z.2⟫_ℝ = 0 := by linarith
  have hz₁ : z.1 = 0 := by
    rw [← norm_sq_eq_re_inner (𝕜 := ℝ)] at h₁zero
    exact norm_eq_zero.mp (sq_eq_zero_iff.mp h₁zero)
  have hz₂ : z.2 = 0 := by
    rw [← norm_sq_eq_re_inner (𝕜 := ℝ)] at h₂zero
    exact norm_eq_zero.mp (sq_eq_zero_iff.mp h₂zero)
  apply Prod.ext <;> simp [hz₁, hz₂]

/-- The positive-definite inner-product core of the standard complexification. -/
def innerProductCore :
    InnerProductSpace.Core ℂ (StandardRealHilbertComplexification H) where
  inner := standardInner
  conj_inner_symm := standardInner_conj_symm
  re_inner_nonneg := standardInner_self_re_nonneg
  add_left := standardInner_add_left
  smul_left := standardInner_smul_left
  definite := standardInner_definite

/-- The normed additive group generated by the standard complex inner product. -/
noncomputable instance instNormedAddCommGroup :
    NormedAddCommGroup (StandardRealHilbertComplexification H) := by
  letI : InnerProductSpace.Core ℂ (StandardRealHilbertComplexification H) := innerProductCore
  exact InnerProductSpace.Core.toNormedAddCommGroup

/-- The complex normed-space structure generated by the standard complex inner product. -/
noncomputable instance instNormedSpace :
    NormedSpace ℂ (StandardRealHilbertComplexification H) := by
  letI : InnerProductSpace.Core ℂ (StandardRealHilbertComplexification H) := innerProductCore
  exact InnerProductSpace.Core.toNormedSpace

/-- The complex inner-product-space structure generated by the standard core. -/
noncomputable instance instInnerProductSpace :
    InnerProductSpace ℂ (StandardRealHilbertComplexification H) where
  inner := standardInner
  norm_sq_eq_re_inner z := by
    change ‖z‖ ^ 2 = (standardInner z z).re
    rw [show ‖z‖ = Real.sqrt ((standardInner z z).re) by rfl]
    exact Real.sq_sqrt (standardInner_self_re_nonneg z)
  conj_inner_symm := standardInner_conj_symm
  add_left := standardInner_add_left
  smul_left := standardInner_smul_left
  norm_smul_le := NormedSpace.norm_smul_le

@[simp]
theorem inner_apply
    (z w : StandardRealHilbertComplexification H) :
    ⟪z, w⟫_ℂ = standardInner z w :=
  rfl

/-- The generated norm has the expected Euclidean square. -/
theorem norm_sq_eq
    (z : StandardRealHilbertComplexification H) :
    ‖z‖ ^ 2 = ‖z.1‖ ^ 2 + ‖z.2‖ ^ 2 := by
  rw [norm_sq_eq_re_inner (𝕜 := ℂ)]
  simp [standardInner, norm_sq_eq_re_inner (𝕜 := ℝ)]

/-- The canonical real embedding is isometric. -/
theorem norm_ofReal
    (x : H) :
    ‖ofReal x‖ = ‖x‖ := by
  apply sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)
  rw [norm_sq_eq]
  simp [ofReal]

/-- Standard conjugation preserves the generated norm. -/
theorem norm_conjugation
    (z : StandardRealHilbertComplexification H) :
    ‖conjugation z‖ = ‖z‖ := by
  apply sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)
  rw [norm_sq_eq, norm_sq_eq]
  simp [conjugation]

end StandardRealHilbertComplexification

end

end MathlibAnalytic
end MGAP4D
