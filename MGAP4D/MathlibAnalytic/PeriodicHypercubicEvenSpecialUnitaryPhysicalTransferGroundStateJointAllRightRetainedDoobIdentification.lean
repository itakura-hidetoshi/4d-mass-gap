variable (H N : ℕ) (hN : 0 < N) (beta : ℝ) (hbeta : 0 ≤ beta)

local notation "X" =>
  PeriodicHypercubicEvenSpecialUnitarySpatialSliceConfiguration H N
local notation "muJ" =>
  periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabGroundStateJointMeasure
    H N hN beta hbeta
local notation "muV" =>
  periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabVacuumMeasure
    H N hN beta hbeta
local notation "JL2" =>
  PeriodicHypercubicEvenSpecialUnitaryPhysicalOneSlabGroundStateJointL2
    H N hN beta hbeta
local notation "V" =>
  PeriodicHypercubicEvenSpecialUnitaryPhysicalOneSlabGroundStateVacuumL2
    H N hN beta hbeta
local notation "LeftSigma" =>
  MeasurableSpace.comap (Prod.fst : X × X → X)
    (inferInstance : MeasurableSpace X)
local notation "J" =>
  periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabGroundStateLeftBoundaryL2Isometry
    H N hN beta hbeta
local notation "A" =>
  periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabGroundStateLeftBoundaryAdjoint
    H N hN beta hbeta
local notation "Q" =>
  periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabGroundStateCoarseCondExp
    H N hN beta hbeta
local notation "Cleft" =>
  allRightLeftRetainedCondExpL2 H N hN beta hbeta
local notation "R" =>
  periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabGroundStateRightBoundaryL2Isometry
    H N hN beta hbeta
local notation "D" =>
  periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabGroundStateDoobBoundaryOperator
    H N hN beta hbeta

/-- Every literal left-retained joint-L2 vector is exactly a pullback of a
vacuum-boundary L2 vector.  This is the missing reverse range inclusion for J.

The proof chooses a strongly measurable representative only locally, factors it
through fst by the pinned Doob-Dynkin lemma, and uses exact fst
measure-preservation to recover L2 integrability of the factor. -/
theorem leftBoundaryL2Isometry_surjective_onto_leftRetained
    (f : JL2)
    (hf : f ∈ lpMeas ℝ ℝ LeftSigma 2 muJ) :
    ∃ u : V, J u = f := by
  let hfst :=
    periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabGroundStateJointMeasure_fst_measurePreserving
      H N hN beta hbeta
  have hfm :
      AEStronglyMeasurable[LeftSigma] (fun z : X × X => f z) muJ :=
    mem_lpMeas_iff_aestronglyMeasurable.mp hf
  let g : X × X → ℝ := hfm.mk (fun z : X × X => f z)
  have hgStrong : StronglyMeasurable[LeftSigma] g := by
    exact hfm.stronglyMeasurable_mk
  obtain ⟨h, hhStrong, hfactor⟩ :=
    hgStrong.exists_eq_measurable_comp (f := (Prod.fst : X × X → X))
  have hfMem : MemLp (fun z : X × X => f z) 2 muJ := Lp.memLp f
  have hgMem : MemLp g 2 muJ := by
    exact (memLp_congr_ae hfm.ae_eq_mk).mp hfMem
  have hcompMem : MemLp (h ∘ (Prod.fst : X × X → X)) 2 muJ := by
    simpa only [← hfactor] using hgMem
  have hhMem : MemLp h 2 muV := by
    refine ⟨hhStrong.aestronglyMeasurable, ?_⟩
    rw [← eLpNorm_comp_measurePreserving hhStrong.aestronglyMeasurable hfst]
    exact hcompMem.eLpNorm_lt_top
  let u : V := hhMem.toLp h
  refine ⟨u, ?_⟩
  change Lp.compMeasurePreserving Prod.fst hfst u = f
  rw [Lp.ext_iff]
  have hu : (fun x : X => u x) =ᵐ[muV] h := by
    exact MemLp.coeFn_toLp hhMem
  have huComp :
      (fun z : X × X => u z.1) =ᵐ[muJ]
        (fun z : X × X => h z.1) := by
    simpa only [Function.comp_apply] using
      hfst.quasiMeasurePreserving.ae_eq_comp hu
  have hpull :
      (fun z : X × X =>
        (Lp.compMeasurePreserving Prod.fst hfst u) z) =ᵐ[muJ]
        (fun z : X × X => u z.1) := by
    simpa only [Function.comp_apply] using
      (Lp.coeFn_compMeasurePreserving u hfst)
  filter_upwards [hpull, huComp, hfm.ae_eq_mk] with z hzPull hzU hzF
  rw [hzPull, hzU, hzF]
  exact congrFun hfactor z |>.symm

private theorem coarseCondExp_leftBoundary_fixed (u : V) :
    Q (J u) = J u := by
  change J (A (J u)) = J u
  rw [periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabGroundStateLeftBoundaryAdjoint_comp_left
    H N hN beta hbeta u]

private theorem leftRetained_coarse_fixed (f : JL2) :
    Q (Cleft f) = Cleft f := by
  have hMem :
      Cleft f ∈ lpMeas ℝ ℝ LeftSigma 2 muJ := by
    exact
      (condExpL2 (μ := muJ) (m := LeftSigma) ℝ ℝ measurable_fst.comap_le f).property
  obtain ⟨u, hu⟩ :=
    leftBoundaryL2Isometry_surjective_onto_leftRetained
      H N hN beta hbeta (Cleft f) hMem
  rw [← hu]
  exact coarseCondExp_leftBoundary_fixed H N hN beta hbeta u

private theorem coarse_leftRetained_fixed (f : JL2) :
    Cleft (Q f) = Q f := by
  change Cleft (J (A f)) = J (A f)
  apply (allRightLeftRetained_fixed_iff_mem H N hN beta hbeta (J (A f))).mpr
  have hRight :
      J (A f) ∈
        periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabGroundStateRightSixRetainedLpMeas
          H N hN beta hbeta :=
    periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabGroundStateLeftBoundaryL2Isometry_mem_rightSixRetained
      H N hN beta hbeta (A f)
  rw [periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabGroundStateRightSixRetainedLpMeas_eq_fst
    H N hN beta hbeta] at hRight
  exact hRight

/-- The literal fst conditional expectation from the ordered route equals the
older coarse boundary orthogonal projection J J† as continuous linear maps. -/
theorem allRightLeftRetainedCondExpL2_eq_coarseCondExp :
    Cleft = Q := by
  apply ContinuousLinearMap.ext
  intro f
  apply ext_inner_right ℝ
  intro g
  calc
    inner ℝ (Cleft f) g =
        inner ℝ (Q (Cleft f)) g := by
          rw [leftRetained_coarse_fixed H N hN beta hbeta f]
    _ = inner ℝ (Cleft f) (Q g) :=
      periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabGroundStateCoarseCondExp_inner_symm
        H N hN beta hbeta
    _ = inner ℝ f (Cleft (Q g)) :=
      allRightLeftRetained_symmetric H N hN beta hbeta _ _
    _ = inner ℝ f (Q g) := by
      rw [coarse_leftRetained_fixed H N hN beta hbeta g]
    _ = inner ℝ (Q f) g :=
      (periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabGroundStateCoarseCondExp_inner_symm
        H N hN beta hbeta).symm

/-- On a genuine right-boundary lift the literal retained projection is exactly
left-boundary pullback of the Doob boundary operator. -/
theorem allRightLeftRetainedCondExpL2_rightBoundary_eq_leftBoundary_doob
    (u : V) :
    Cleft (R u) = J (D u) := by
  rw [allRightLeftRetainedCondExpL2_eq_coarseCondExp H N hN beta hbeta]
  exact
    periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabGroundStateCoarseCondExp_rightBoundary
      H N hN beta hbeta u

/-- Norm form of the preceding exact identification. -/
theorem allRightLeftRetainedCondExpL2_rightBoundary_norm_eq_doob
    (u : V) :
    ‖Cleft (R u)‖ = ‖D u‖ := by
  rw [allRightLeftRetainedCondExpL2_rightBoundary_eq_leftBoundary_doob
    H N hN beta hbeta u]
  exact J.norm_map _

/-- The retained-boundary contraction isolated in #4944 is definitionally the
same quantitative requirement as contraction of the existing Doob boundary
operator after the ground-state transform. -/
theorem retainedBoundaryContraction_iff_doobContraction
    (rho : ℝ) :
    (∀ x :
      periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabTopEigenspaceOrthogonal
        H N hN beta hbeta,
      ‖Cleft
        (R
          (periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabHaarToVacuumL2LinearIsometry
            H N hN beta hbeta
            (((x :
              periodicHypercubicEvenSpecialUnitarySpatialSliceGaugeInvariantL2Submodule H N) :
              Lp ℝ 2 (periodicHypercubicEvenSpecialUnitarySpatialSliceHaarMeasure H N)))))‖ ^ 2 ≤
        rho *
          ‖(x :
            periodicHypercubicEvenSpecialUnitarySpatialSliceGaugeInvariantL2Submodule H N)‖ ^ 2) ↔
    (∀ x :
      periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabTopEigenspaceOrthogonal
        H N hN beta hbeta,
      ‖D
        (periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabHaarToVacuumL2LinearIsometry
          H N hN beta hbeta
          (((x :
            periodicHypercubicEvenSpecialUnitarySpatialSliceGaugeInvariantL2Submodule H N) :
            Lp ℝ 2 (periodicHypercubicEvenSpecialUnitarySpatialSliceHaarMeasure H N))))‖ ^ 2 ≤
        rho *
          ‖(x :
            periodicHypercubicEvenSpecialUnitarySpatialSliceGaugeInvariantL2Submodule H N)‖ ^ 2) := by
  constructor <;> intro h x
  · simpa only [
      allRightLeftRetainedCondExpL2_rightBoundary_norm_eq_doob
        H N hN beta hbeta] using h x
  · simpa only [
      allRightLeftRetainedCondExpL2_rightBoundary_norm_eq_doob
        H N hN beta hbeta] using h x

