import MGAP4D.MathlibAnalytic.FiniteWilsonGibbsCanonicalGaugeGlobalObservation

namespace MGAP4D
namespace MathlibAnalytic

noncomputable section

/-!
Close the finite/discrete typeclass boundary for the explicit canonical gauge
observation and expose its interaction and exact-threshold endpoints.
-/

/-- The explicit canonical gauge-valued single-source realization. -/
noncomputable def finiteWilsonExplicitCanonicalGaugeRealization
    (W : FiniteWilsonOSAutomaticApproximationFamily)
    (s : W.index) :
    FiniteWilsonGibbsSingleSourceProjectiveRealization W :=
  (finiteWilsonCanonicalGaugeFieldData W s).realization

@[simp]
theorem finiteWilsonExplicitCanonicalGaugeRealization_sourceScale
    (W : FiniteWilsonOSAutomaticApproximationFamily)
    (s : W.index) :
    (finiteWilsonExplicitCanonicalGaugeRealization W s).sourceScale = s :=
  rfl

local instance finiteWilsonExplicitCanonicalGauge_fieldValueFintype
    (W : FiniteWilsonOSAutomaticApproximationFamily)
    (s : W.index)
    (x : EuclideanFourSpace) :
    Fintype ((finiteWilsonExplicitCanonicalGaugeRealization W s).fieldValue x) := by
  change Fintype (W.system s).Gauge
  infer_instance

local instance finiteWilsonExplicitCanonicalGauge_fieldValueCountable
    (W : FiniteWilsonOSAutomaticApproximationFamily)
    (s : W.index)
    (x : EuclideanFourSpace) :
    Countable ((finiteWilsonExplicitCanonicalGaugeRealization W s).fieldValue x) := by
  change Countable (W.system s).Gauge
  infer_instance

local instance finiteWilsonExplicitCanonicalGauge_fieldValueDiscrete
    (W : FiniteWilsonOSAutomaticApproximationFamily)
    (s : W.index)
    (x : EuclideanFourSpace) :
    DiscreteMeasurableSpace
      ((finiteWilsonExplicitCanonicalGaugeRealization W s).fieldValue x) := by
  change DiscreteMeasurableSpace (W.system s).Gauge
  infer_instance

local instance finiteWilsonExplicitCanonicalGauge_configurationNontrivial
    (W : FiniteWilsonOSAutomaticApproximationFamily)
    (s : W.index)
    [Nonempty (W.system s).Edge] :
    Nontrivial
      ((W.system
        (finiteWilsonExplicitCanonicalGaugeRealization W s).sourceScale).Configuration) := by
  change Nontrivial ((W.system s).Edge → (W.system s).Gauge)
  infer_instance

/-- Exact canonical edge observation for the explicit realization. -/
noncomputable def finiteWilsonExplicitCanonicalGaugeEdgeObservation
    (W : FiniteWilsonOSAutomaticApproximationFamily)
    (s : W.index) :
    FiniteWilsonGibbsCanonicalEdgeObservation
      (finiteWilsonExplicitCanonicalGaugeRealization W s) :=
  (finiteWilsonCanonicalGaugeFieldData W s).toCanonicalEdgeObservation

/-- Faithfulness of the explicit canonical global observation requires no
additional measurable-space hypotheses. -/
def finiteWilsonExplicitCanonicalGaugeFaithful
    (W : FiniteWilsonOSAutomaticApproximationFamily)
    (s : W.index) :
    FiniteWilsonGibbsFaithfulGlobalObservation
      (finiteWilsonExplicitCanonicalGaugeRealization W s) :=
  (finiteWilsonExplicitCanonicalGaugeEdgeObservation W s).toFaithfulGlobalObservation

/-- A nondegenerate finite cylinder interaction witness generated by the
explicit canonical gauge field. -/
noncomputable def finiteWilsonExplicitCanonicalGaugeInteractionWitness
    (W : FiniteWilsonOSAutomaticApproximationFamily)
    (s : W.index)
    [Nonempty (W.system s).Edge] :
    FiniteWilsonGibbsCylinderInteractionWitness
      (finiteWilsonExplicitCanonicalGaugeRealization W s) :=
  (finiteWilsonExplicitCanonicalGaugeEdgeObservation W s).toInteractionWitness

/-- The explicit canonical gauge interaction survives in the continuum as a
nonzero connected correlation. -/
theorem finite_wilson_explicit_canonical_gauge_interaction_passes_to_continuum
    (W : FiniteWilsonOSAutomaticApproximationFamily)
    (s : W.index)
    [Nonempty (W.system s).Edge]
    (L : FiniteWilsonGibbsSingleSourceExactGapOSLimitData
      (finiteWilsonExplicitCanonicalGaugeRealization W s)) :
    finiteWilsonContinuumCylinderConnectedCorrelation
        (finiteWilsonExplicitCanonicalGaugeRealization W s) L
        (finiteWilsonExplicitCanonicalGaugeInteractionWitness W s).support
        (finiteWilsonExplicitCanonicalGaugeInteractionWitness W s).leftObservable
        (finiteWilsonExplicitCanonicalGaugeInteractionWitness W s).rightObservable ≠ 0 := by
  simpa [finiteWilsonExplicitCanonicalGaugeInteractionWitness] using
    finite_wilson_canonical_edge_observation_interaction_passes_to_continuum
      (finiteWilsonExplicitCanonicalGaugeRealization W s) L
      (finiteWilsonExplicitCanonicalGaugeEdgeObservation W s)

/-- The explicit canonical gauge realization reaches the exact-threshold
spectral endpoint. -/
theorem
    FiniteWilsonGibbsConcreteAnalyticFrontierCore.explicitCanonicalGauge_exactThresholdSeparation
    (W : FiniteWilsonOSAutomaticApproximationFamily)
    (s : W.index)
    [Nonempty (W.system s).Edge]
    (C : FiniteWilsonGibbsConcreteAnalyticFrontierCore
      (finiteWilsonExplicitCanonicalGaugeRealization W s)) :
    euclideanYangMillsCompleteConstructionDirectBounded_exactThresholdSeparationProp
      (C.toExactGapConstructionSpineOfGlobalObservationSeparation
        (FiniteWilsonGibbsFiniteCoordinateSelector.toGlobalObservationSeparation
          (finiteWilsonExplicitCanonicalGaugeEdgeObservation W s).toExactLinkObservation.toFiniteCoordinateSelector)).toConstructionSpine := by
  exact C.canonicalEdgeObservation_exactThresholdSeparation
    (finiteWilsonExplicitCanonicalGaugeEdgeObservation W s)

end

end MathlibAnalytic
end MGAP4D
