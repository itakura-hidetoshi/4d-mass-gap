/-- The genuine fixed-beta original Wilson temporal section real
linear span, distinct from NO's multiplicative generated algebra. -/
noncomputable def p4Q2NZ_originalWilsonTemporalSectionSpan
    (b : ℝ) : Submodule ℝ C(Gauge,ℝ) :=
  Submodule.span ℝ (Set.range (k b))

/-- Any real continuous linear functional bounded strictly ABOVE on
a whole real submodule vanishes there. This elementary lemma is the
linear-space component of the geometric Hahn–Banach contradiction.
No compactness or signed probability theorem is used. -/
private theorem p4Q2NZ_boundedAbove_linearFunctional_vanish
    {E : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (K : Submodule ℝ E) (f : E →L[ℝ] ℝ) (u : ℝ)
    (hBound : ∀ v : E, v ∈ K → f v < u) :
    ∀ v : E, v ∈ K → f v = 0 := by
  have hNonpos (v : E) (hv : v ∈ K) : f v ≤ 0 := by
    by_contra h
    have hvpos : 0 < f v := lt_of_not_ge h
    have hScaled := hBound (((u + 1) / f v) • v)
      (K.smul_mem ((u + 1) / f v) hv)
    have hValue : ((u + 1) / f v) * f v = u + 1 := by
      field_simp [hvpos.ne']
    have hScaled' : ((u + 1) / f v) * f v < u := by
      simpa only [map_smul, smul_eq_mul] using hScaled
    rw [hValue] at hScaled'
    linarith
  intro v hv
  have hvle := hNonpos v hv
  have hnegle := hNonpos (-v) (K.neg_mem hv)
  rw [map_neg] at hnegle
  linarith

/-- MAIN exact Hahn–Banach descent: the original Wilson temporal
Gaussian kernel sections have DENSE REAL LINEAR SPAN on all SU(2),
for every genuine b>0. This uses NY's proved strict double-energy
nondegeneracy, not NO algebra density alone. -/
theorem p4Q2NZ_originalWilsonTemporalSectionSpan_dense
    (b : ℝ) (hb : 0 < b) :
    Dense
      (↑(p4Q2NZ_originalWilsonTemporalSectionSpan b) : Set C(Gauge, ℝ)) := by
  classical
  let W : Submodule ℝ C(Gauge, ℝ) :=
    p4Q2NZ_originalWilsonTemporalSectionSpan b
  let K : Submodule ℝ C(Gauge, ℝ) := W.topologicalClosure
  by_contra hNotDense
  have hKne : K ≠ ⊤ := by
    intro hTop
    apply hNotDense
    exact (Submodule.dense_iff_topologicalClosure_eq_top).2 hTop
  obtain ⟨v, hv⟩ : ∃ v : C(Gauge, ℝ), v ∉ K := by
    by_contra h
    apply hKne
    ext v
    simp only [Submodule.mem_top, iff_true]
    by_contra hv
    exact h ⟨v, hv⟩
  obtain ⟨f, u, hBound, hAbove⟩ :=
    geometric_hahn_banach_closed_point
      (s := (K : Set C(Gauge, ℝ))) (x := v)
      (Submodule.convex K) W.isClosed_topologicalClosure hv
  have hZero : ∀ w : C(Gauge,ℝ), w ∈ K → f w = 0 :=
    p4Q2NZ_boundedAbove_linearFunctional_vanish K f u hBound
  have hFnonzero : f ≠ 0 := by
    intro hFzero
    have hUpos : (0 : ℝ) < u := by
      have h := hBound 0 K.zero_mem
      simpa [hFzero] using h
    have hUneg : u < (0 : ℝ) := by
      simpa [hFzero] using hAbove
    linarith
  obtain ⟨x, hx⟩ :=
    p4Q2NY_originalPositiveWilsonSection_detects_nonzeroSigned f
      hFnonzero b hb
  have hxW : k b x ∈ W := by
    change k b x ∈ Submodule.span ℝ (Set.range (k b))
    exact Submodule.subset_span (Set.mem_range_self x)
  exact hx (hZero (k b x) (W.le_topologicalClosure hxW))

/-- The verified true fixed-b kernel section real-linear span has
the entire Banach C(SU2,R) as its topological closure. -/
theorem p4Q2NZ_originalWilsonTemporalSectionSpan_closure_eq_top
    (b : ℝ) (hb : 0 < b) :
    (p4Q2NZ_originalWilsonTemporalSectionSpan b).topologicalClosure = ⊤ :=
  (Submodule.dense_iff_topologicalClosure_eq_top).1
    (p4Q2NZ_originalWilsonTemporalSectionSpan_dense b hb)

