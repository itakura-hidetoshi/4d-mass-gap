import MGAP4D.MathlibAnalytic.RealHilbertProjectionSweepVectorTelescoping
import Mathlib.Tactic

/-!
# Exact target-cross-residual telescoping for an ordered projection sweep

For a distinguished target map `P target`, write

  r_target(x) = x - P target x.

After one source update `x ↦ P source x`, the target residual changes by the
target projection residual of the source residual itself:

  r_target(P source x)
    = r_target(x)
      - ((x - P source x) - P target (x - P source x)).

The bracketed vector is the exact target-cross residual generated by that
source step.  Iterating the identity along an ordered sweep gives a signed
vector telescope.  If the initial vector is already fixed by the target map,
the final target residual is exactly the negative sum of the successive
target-cross residuals.

This layer is purely linear.  It uses no self-adjointness, commutativity,
probability estimate, triangle inequality, Cauchy estimate, or cardinality
factor.  In particular, signs are retained for the later beta-small
cancellation argument.
-/

namespace MGAP4D.MathlibAnalytic

noncomputable section

/-- Exact target-cross residual generated by applying one source map at the
current stage vector. -/
def realHilbertProjectionSweepTargetCrossResidual
    {E C : Type*}
    [NormedAddCommGroup E]
    [NormedSpace ℝ E]
    (P : C → E →L[ℝ] E)
    (target source : C)
    (x : E) : E :=
  (x - P source x) -
    P target (x - P source x)

/-- Recursive signed sum of target-cross residuals along an ordered source
sweep.  Each summand is evaluated at the actual stage vector immediately
before its source map is applied. -/
def realHilbertProjectionSweepTargetCrossResidualVectorSum
    {E C : Type*}
    [NormedAddCommGroup E]
    [NormedSpace ℝ E]
    (P : C → E →L[ℝ] E)
    (target : C) :
    List C → E → E
  | [], _ => 0
  | source :: sources, x =>
      realHilbertProjectionSweepTargetCrossResidual P target source x +
        realHilbertProjectionSweepTargetCrossResidualVectorSum
          P target sources (P source x)

/-- One source step changes the distinguished target residual by subtracting
exactly the target-cross residual of the source-stage residual. -/
theorem realHilbertProjectionSweep_targetResidual_apply_eq_sub_crossResidual
    {E C : Type*}
    [NormedAddCommGroup E]
    [NormedSpace ℝ E]
    (P : C → E →L[ℝ] E)
    (target source : C)
    (x : E) :
    P source x - P target (P source x) =
      (x - P target x) -
        realHilbertProjectionSweepTargetCrossResidual
          P target source x := by
  unfold realHilbertProjectionSweepTargetCrossResidual
  rw [map_sub]
  abel

/-- Target-cross-residual sums compose exactly over list append. -/
theorem realHilbertProjectionSweepTargetCrossResidualVectorSum_append
    {E C : Type*}
    [NormedAddCommGroup E]
    [NormedSpace ℝ E]
    (P : C → E →L[ℝ] E)
    (target : C)
    (pre suffix : List C)
    (x : E) :
    realHilbertProjectionSweepTargetCrossResidualVectorSum
        P target (pre ++ suffix) x =
      realHilbertProjectionSweepTargetCrossResidualVectorSum
          P target pre x +
        realHilbertProjectionSweepTargetCrossResidualVectorSum
          P target suffix
          (realHilbertProjectionSweep P pre x) := by
  induction pre generalizing x with
  | nil =>
      simp [
        realHilbertProjectionSweepTargetCrossResidualVectorSum,
        realHilbertProjectionSweep]
  | cons source pre ih =>
      simp only [
        List.cons_append,
        realHilbertProjectionSweepTargetCrossResidualVectorSum,
        realHilbertProjectionSweep,
        ContinuousLinearMap.comp_apply]
      rw [ih (P source x)]
      abel

/-- Exact signed telescope for the target residual after an arbitrary ordered
sweep. -/
theorem realHilbertProjectionSweep_targetResidual_eq_initial_sub_crossResidualVectorSum
    {E C : Type*}
    [NormedAddCommGroup E]
    [NormedSpace ℝ E]
    (P : C → E →L[ℝ] E)
    (target : C)
    (sources : List C)
    (x : E) :
    realHilbertProjectionSweep P sources x -
        P target (realHilbertProjectionSweep P sources x) =
      (x - P target x) -
        realHilbertProjectionSweepTargetCrossResidualVectorSum
          P target sources x := by
  induction sources generalizing x with
  | nil =>
      simp [
        realHilbertProjectionSweep,
        realHilbertProjectionSweepTargetCrossResidualVectorSum]
  | cons source sources ih =>
      simp only [
        realHilbertProjectionSweep,
        ContinuousLinearMap.comp_apply,
        realHilbertProjectionSweepTargetCrossResidualVectorSum]
      rw [ih (P source x)]
      rw [
        realHilbertProjectionSweep_targetResidual_apply_eq_sub_crossResidual
          P target source x]
      abel

/-- If the initial vector is fixed by the target map, the final target residual
is exactly the negative signed sum of all successive target-cross residuals. -/
theorem realHilbertProjectionSweep_targetResidual_eq_neg_crossResidualVectorSum_of_fixed
    {E C : Type*}
    [NormedAddCommGroup E]
    [NormedSpace ℝ E]
    (P : C → E →L[ℝ] E)
    (target : C)
    (sources : List C)
    (x : E)
    (hfixed : P target x = x) :
    realHilbertProjectionSweep P sources x -
        P target (realHilbertProjectionSweep P sources x) =
      -realHilbertProjectionSweepTargetCrossResidualVectorSum
        P target sources x := by
  rw [
    realHilbertProjectionSweep_targetResidual_eq_initial_sub_crossResidualVectorSum
      P target sources x,
    hfixed,
    sub_self,
    zero_sub]

/-- Useful post-projection specialization: starting from `P target y`, only
idempotence at that vector is needed to obtain the exact signed telescope. -/
theorem realHilbertProjectionSweep_targetResidual_eq_neg_crossResidualVectorSum_of_projected
    {E C : Type*}
    [NormedAddCommGroup E]
    [NormedSpace ℝ E]
    (P : C → E →L[ℝ] E)
    (target : C)
    (sources : List C)
    (y : E)
    (hidem : P target (P target y) = P target y) :
    realHilbertProjectionSweep P sources (P target y) -
        P target
          (realHilbertProjectionSweep P sources (P target y)) =
      -realHilbertProjectionSweepTargetCrossResidualVectorSum
        P target sources (P target y) := by
  exact
    realHilbertProjectionSweep_targetResidual_eq_neg_crossResidualVectorSum_of_fixed
      P target sources (P target y) hidem

end

end MGAP4D.MathlibAnalytic
