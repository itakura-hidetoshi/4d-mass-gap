import MGAP4D.MathlibAnalytic.EuclideanYangMillsProjectiveContinuumMeasure
import MGAP4D.MathlibAnalytic.FiniteWilsonOSAutomaticApproximationFamily

namespace MGAP4D
namespace MathlibAnalytic

open MeasureTheory

noncomputable section

/-- A concrete realization of continuum finite-dimensional field distributions
as pushforwards of finite Wilson Gibbs measures.

For each finite set `J` of points in four-dimensional Euclidean spacetime, a
lattice scale is selected and a measurable observation map reads the associated
finite field data from a Wilson link configuration.  Projective consistency is
then stated directly for these concrete pushforward measures. -/
structure FiniteWilsonGibbsProjectiveRealization
    (W : FiniteWilsonOSAutomaticApproximationFamily) where
  fieldValue : EuclideanFourSpace → Type
  [fieldValueMeasurableSpace :
    ∀ x, MeasurableSpace (fieldValue x)]
  scale : Finset EuclideanFourSpace → W.index
  observe :
    ∀ J : Finset EuclideanFourSpace,
      (W.system (scale J)).Configuration →
        (∀ x : J, fieldValue x)
  observe_measurable : ∀ J, Measurable (observe J)
  pushforward_projective :
    IsProjectiveMeasureFamily
      (fun J =>
        (W.system (scale J)).gibbsMeasure.map (observe J))

attribute [instance]
  FiniteWilsonGibbsProjectiveRealization.fieldValueMeasurableSpace

/-- The concrete finite-dimensional marginal obtained by observing a finite
Wilson Gibbs configuration at the scale assigned to `J`. -/
noncomputable def FiniteWilsonGibbsProjectiveRealization.finiteMarginal
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    (R : FiniteWilsonGibbsProjectiveRealization W)
    (J : Finset EuclideanFourSpace) :
    Measure (∀ x : J, R.fieldValue x) :=
  (W.system (R.scale J)).gibbsMeasure.map (R.observe J)

/-- Every concrete pushforward marginal is a probability measure because the
source Wilson Gibbs measure is normalized and the observation map is
measurable. -/
theorem finite_wilson_gibbs_projective_marginal_probability
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    (R : FiniteWilsonGibbsProjectiveRealization W)
    (J : Finset EuclideanFourSpace) :
    IsProbabilityMeasure (R.finiteMarginal J) := by
  letI : IsProbabilityMeasure
      ((W.system (R.scale J)).gibbsMeasure) := inferInstance
  exact Measure.isProbabilityMeasure_map
    (R.observe_measurable J).aemeasurable

/-- The Wilson Gibbs pushforward family is projectively consistent by the
realization's concrete compatibility theorem. -/
theorem finite_wilson_gibbs_projective_marginals_consistent
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    (R : FiniteWilsonGibbsProjectiveRealization W) :
    IsProjectiveMeasureFamily R.finiteMarginal := by
  exact R.pushforward_projective

/-- Package the concrete Wilson Gibbs pushforwards as the finite-dimensional
distribution family used by the four-dimensional projective continuum layer. -/
def FiniteWilsonGibbsProjectiveRealization.toProjectiveCylinderFamily
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    (R : FiniteWilsonGibbsProjectiveRealization W) :
    EuclideanYangMillsProjectiveCylinderFamily :=
  { fieldValue := R.fieldValue
    fieldValueMeasurableSpace := R.fieldValueMeasurableSpace
    finiteMarginal := R.finiteMarginal
    finiteMarginalProbability :=
      finite_wilson_gibbs_projective_marginal_probability R
    projective :=
      finite_wilson_gibbs_projective_marginals_consistent R }

/-- The finite marginal in the projective cylinder package is definitionally the
pushforward of the selected finite Wilson Gibbs measure. -/
theorem finite_wilson_gibbs_projective_family_marginal_eq_map
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    (R : FiniteWilsonGibbsProjectiveRealization W)
    (J : Finset EuclideanFourSpace) :
    R.toProjectiveCylinderFamily.finiteMarginal J =
      (W.system (R.scale J)).gibbsMeasure.map (R.observe J) := by
  rfl

/-- On every measurable finite-dimensional event, the marginal probability is
exactly the Wilson Gibbs probability of its observable preimage. -/
theorem finite_wilson_gibbs_projective_marginal_apply
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    (R : FiniteWilsonGibbsProjectiveRealization W)
    (J : Finset EuclideanFourSpace)
    {s : Set (∀ x : J, R.fieldValue x)}
    (hs : MeasurableSet s) :
    R.finiteMarginal J s =
      (W.system (R.scale J)).gibbsMeasure
        ((R.observe J) ⁻¹' s) := by
  unfold FiniteWilsonGibbsProjectiveRealization.finiteMarginal
  exact Measure.map_apply (R.observe_measurable J) hs

/-- The cylinder content generated by the projective family is therefore
already fixed by a concrete finite Wilson Gibbs probability. -/
theorem finite_wilson_gibbs_cylinder_content_eq_gibbs_preimage
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    (R : FiniteWilsonGibbsProjectiveRealization W)
    (J : Finset EuclideanFourSpace)
    {s : Set (∀ x : J, R.fieldValue x)}
    (hs : MeasurableSet s) :
    R.toProjectiveCylinderFamily.cylinderContent (cylinder J s) =
      (W.system (R.scale J)).gibbsMeasure
        ((R.observe J) ⁻¹' s) := by
  rw [euclidean_yang_mills_projective_cylinder_content_eq_marginal
    R.toProjectiveCylinderFamily hs]
  exact finite_wilson_gibbs_projective_marginal_apply R J hs

/-- Once a projective-limit measure is supplied, every measurable continuum
cylinder probability is identified directly with a finite Wilson Gibbs
probability. -/
theorem finite_wilson_gibbs_projective_limit_cylinder_eq_gibbs_preimage
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    (R : FiniteWilsonGibbsProjectiveRealization W)
    (L : EuclideanYangMillsProjectiveLimitMeasure
      R.toProjectiveCylinderFamily)
    (J : Finset EuclideanFourSpace)
    {s : Set (∀ x : J, R.fieldValue x)}
    (hs : MeasurableSet s) :
    L.continuumMeasure (cylinder J s) =
      (W.system (R.scale J)).gibbsMeasure
        ((R.observe J) ⁻¹' s) := by
  rw [euclidean_yang_mills_projective_limit_measure_cylinder L J hs]
  exact finite_wilson_gibbs_projective_marginal_apply R J hs

/-- Audit-visible certificate that the finite-dimensional distributions are
actual pushforwards of normalized finite Wilson Gibbs measures. -/
structure FiniteWilsonGibbsProjectiveMarginalCertificate
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    (R : FiniteWilsonGibbsProjectiveRealization W) where
  marginalIsWilsonPushforward :
    ∀ J : Finset EuclideanFourSpace,
      R.toProjectiveCylinderFamily.finiteMarginal J =
        (W.system (R.scale J)).gibbsMeasure.map (R.observe J)
  marginalProbability :
    ∀ J : Finset EuclideanFourSpace,
      IsProbabilityMeasure
        (R.toProjectiveCylinderFamily.finiteMarginal J)
  projectiveConsistency :
    IsProjectiveMeasureFamily
      R.toProjectiveCylinderFamily.finiteMarginal
  measurableEventFormula :
    ∀ (J : Finset EuclideanFourSpace)
      (s : Set (∀ x : J, R.fieldValue x)),
      MeasurableSet s →
        R.toProjectiveCylinderFamily.finiteMarginal J s =
          (W.system (R.scale J)).gibbsMeasure
            ((R.observe J) ⁻¹' s)

/-- Construct the concrete finite-Wilson-to-projective-marginal certificate. -/
def finiteWilsonGibbsProjectiveMarginalCertificate
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    (R : FiniteWilsonGibbsProjectiveRealization W) :
    FiniteWilsonGibbsProjectiveMarginalCertificate R :=
  { marginalIsWilsonPushforward :=
      finite_wilson_gibbs_projective_family_marginal_eq_map R
    marginalProbability :=
      finite_wilson_gibbs_projective_marginal_probability R
    projectiveConsistency :=
      finite_wilson_gibbs_projective_marginals_consistent R
    measurableEventFormula := fun J s hs =>
      finite_wilson_gibbs_projective_marginal_apply R J hs }

end

end MathlibAnalytic
end MGAP4D
