import MGAP4D.MathlibAnalytic.StandardRealHilbertComplexificationInnerProductCore
import Mathlib.Analysis.InnerProductSpace.Basic

namespace MGAP4D
namespace MathlibAnalytic

noncomputable section

open scoped InnerProductSpace

namespace StandardRealHilbertComplexification

variable {H : Type*}
variable [NormedAddCommGroup H] [InnerProductSpace ℝ H]

/-- The normed additive-group structure generated by the positive-definite standard inner product. -/
noncomputable instance instNormedAddCommGroup :
    NormedAddCommGroup (StandardRealHilbertComplexification H) := by
  letI : InnerProductSpace.Core ℂ (StandardRealHilbertComplexification H) := innerProductCore
  exact @InnerProductSpace.Core.toNormedAddCommGroup ℂ
    (StandardRealHilbertComplexification H) _ _ _ innerProductCore

@[simp]
theorem norm_eq_standardNorm
    (z : StandardRealHilbertComplexification H) :
    ‖z‖ = standardNorm z :=
  rfl

/-- The generated norm scales correctly under the already-installed complex scalar action. -/
theorem norm_smul_eq
    (c : ℂ) (z : StandardRealHilbertComplexification H) :
    ‖c • z‖ = ‖c‖ * ‖z‖ := by
  rw [norm_eq_standardNorm, norm_eq_standardNorm]
  refine (sq_eq_sq₀ (Real.sqrt_nonneg _) (mul_nonneg (norm_nonneg c) (Real.sqrt_nonneg _))).mp ?_
  rw [standardNorm_sq, mul_pow, standardNorm_sq]
  simp only [complex_smul_re, complex_smul_im, norm_sq_eq_re_inner (𝕜 := ℝ)]
  rw [Complex.sq_norm]
  ring_nf
  simp only [real_inner_add_left, real_inner_sub_left, real_inner_smul_left]
  ring

/-- Complex normed-space structure transported onto the existing complex module instance. -/
noncomputable instance instNormedSpace :
    NormedSpace ℂ (StandardRealHilbertComplexification H) where
  norm_smul_le c z := by
    rw [norm_smul_eq]

/-- The standard complex inner product is compatible with the transported normed-space structure. -/
noncomputable instance instInnerProductSpace :
    InnerProductSpace ℂ (StandardRealHilbertComplexification H) where
  inner := standardInner
  norm_sq_eq_re_inner z := by
    rw [norm_eq_standardNorm, standardNorm_sq, standardInner_self]
    change ‖z.1‖ ^ 2 + ‖z.2‖ ^ 2 = ‖z.1‖ ^ 2 + ‖z.2‖ ^ 2
    rfl
  conj_inner_symm := standardInner_conj_symm
  add_left := standardInner_add_left
  smul_left := standardInner_smul_left

@[simp]
theorem inner_apply
    (z w : StandardRealHilbertComplexification H) :
    ⟪z, w⟫_ℂ = standardInner z w :=
  rfl

@[simp]
theorem norm_ofReal
    (x : H) :
    ‖ofReal x‖ = ‖x‖ := by
  rw [norm_eq_standardNorm, standardNorm_ofReal]

@[simp]
theorem norm_conjugation
    (z : StandardRealHilbertComplexification H) :
    ‖conjugation z‖ = ‖z‖ := by
  rw [norm_eq_standardNorm, norm_eq_standardNorm, standardNorm_conjugation]

end StandardRealHilbertComplexification

end

end MathlibAnalytic
end MGAP4D
