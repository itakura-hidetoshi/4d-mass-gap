import MGAP4D.MathlibAnalytic.PeriodicHypercubicEvenSpecialUnitaryPhysicalTransferContinuousVacuumReferenceCanonicalFixedRightExceptionalWeightedColumn
import MGAP4D.MathlibAnalytic.PeriodicHypercubicEvenSpecialUnitaryPhysicalTransferContinuousVacuumReferencePinFreeCanonicalRemoteWeightedColumn
import Mathlib.Tactic

/-!
# Canonical fixed-right full weighted bootstrap

The canonical fixed-right response column is split exactly into the finite C5
exceptional block and its geometric remote complement.

The exceptional block is already bounded without any response hypothesis by

  20 * s^2 * exp(16 beta) * eta_R(beta).

The remote block is bounded by the pin-free aggregate resolvent whenever a
weighted-column certificate M is available and the corresponding pin-free
physical coefficient is strictly below one.

This file combines the two estimates into a genuine improvement map on
weighted-column certificates:

  M  |->  Phi(M)
       = 20 s^2 exp(16 beta) eta_R(beta)
         + eta_R(beta) exp(16 beta) / (1 - c_pf(M)),

where
  c_pf(M) = 18 eta(beta) s^2 + exp(16 beta) M.

No claim is made here that an arbitrary M is self-consistent.  This theorem
only constructs the exact bootstrap map that the next closure step must solve.
-/

namespace MGAP4D
namespace MathlibAnalytic

open scoped BigOperators

noncomputable section

local instance canonicalFixedRightFullWeightedBootstrapSpatialLinkFintype
    (H : ℕ) : Fintype (PeriodicHypercubicEvenSpatialSliceLink H) :=
  Fintype.ofFinite _

/-- Explicit full-column bootstrap coefficient obtained by adding the finite
C5 exceptional contribution to the pin-free remote resolvent contribution. -/
noncomputable def
    periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabContinuousVacuumReferenceCanonicalFixedRightTargetRatioResponseBootstrapCoefficient
    (beta s responseCoefficient : ℝ) : ℝ :=
  20 * s ^ 2 * Real.exp (16 * beta) *
      periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabFixedRightKernelSectionBoundaryUpdateHarnackInfluence
        beta +
    periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabFixedRightKernelSectionBoundaryUpdateHarnackInfluence
        beta *
      Real.exp (16 * beta) *
      (1 -
        periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabContinuousVacuumReferencePinFreeResponseControlledExponentialWeightedColumnCoefficient
          beta s responseCoefficient)⁻¹

/-- Under the strict pin-free denominator condition, the bootstrap coefficient
is nonnegative. -/
theorem
    periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabContinuousVacuumReferenceCanonicalFixedRightTargetRatioResponseBootstrapCoefficient_nonneg
    (beta s responseCoefficient : ℝ)
    (hbeta : 0 ≤ beta)
    (hResponseCoefficient : 0 ≤ responseCoefficient)
    (hCoefficientLtOne :
      periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabContinuousVacuumReferencePinFreeResponseControlledExponentialWeightedColumnCoefficient
        beta s responseCoefficient < 1) :
    0 ≤
      periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabContinuousVacuumReferenceCanonicalFixedRightTargetRatioResponseBootstrapCoefficient
        beta s responseCoefficient := by
  let etaR :=
    periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabFixedRightKernelSectionBoundaryUpdateHarnackInfluence
      beta
  let c :=
    periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabContinuousVacuumReferencePinFreeResponseControlledExponentialWeightedColumnCoefficient
      beta s responseCoefficient
  have hEtaR : 0 ≤ etaR := by
    simpa [etaR] using
      periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabFixedRightKernelSectionBoundaryUpdateHarnackInfluence_nonneg
        beta hbeta
  have hcNonneg : 0 ≤ c := by
    simpa [c] using
      periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabContinuousVacuumReferencePinFreeResponseControlledExponentialWeightedColumnCoefficient_nonneg
        beta s responseCoefficient hbeta hResponseCoefficient
  have hDenPos : 0 < 1 - c := sub_pos.mpr hCoefficientLtOne
  have hInvNonneg : 0 ≤ (1 - c)⁻¹ := (inv_pos.mpr hDenPos).le
  unfold
    periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabContinuousVacuumReferenceCanonicalFixedRightTargetRatioResponseBootstrapCoefficient
  change
    0 ≤
      20 * s ^ 2 * Real.exp (16 * beta) * etaR +
        etaR * Real.exp (16 * beta) * (1 - c)⁻¹
  have hsSq : 0 ≤ s ^ 2 := sq_nonneg s
  positivity

/-- Every weighted-column certificate for the canonical response profile is
improved to the explicit full-column bootstrap coefficient, provided the
pin-free physical coefficient generated by that certificate is strictly below
one. -/
theorem
    periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabContinuousVacuumReferenceCanonicalFixedRightTargetRatioResponseProfile_exponentialWeightedColumnBound_bootstrap
    (H N : ℕ)
    (hN : 0 < N)
    (beta : ℝ)
    (hbeta : 0 ≤ beta)
    (s : ℝ)
    (hs : 1 ≤ s)
    (center : PeriodicHypercubicEvenSpatialSliceLink H)
    (responseCoefficient : ℝ)
    (hResponseCoefficient : 0 ≤ responseCoefficient)
    (hResponseWeighted :
      periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabContinuousVacuumReferenceFixedRightTargetRatioResponseExponentialWeightedColumnBound
        H s center
        (periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabContinuousVacuumReferenceCanonicalFixedRightTargetRatioResponseProfile
          H N hN beta hbeta)
        responseCoefficient)
    (hCoefficientLtOne :
      periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabContinuousVacuumReferencePinFreeResponseControlledExponentialWeightedColumnCoefficient
        beta s responseCoefficient < 1) :
    periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabContinuousVacuumReferenceFixedRightTargetRatioResponseExponentialWeightedColumnBound
      H s center
      (periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabContinuousVacuumReferenceCanonicalFixedRightTargetRatioResponseProfile
        H N hN beta hbeta)
      (periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabContinuousVacuumReferenceCanonicalFixedRightTargetRatioResponseBootstrapCoefficient
        beta s responseCoefficient) := by
  classical
  intro source
  let exceptional :=
    periodicHypercubicEvenSpatialSliceC5ExceptionalBackgroundFibers
      H source center
  let remote :=
    periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabContinuousVacuumReferenceC5RemoteTargetFibers
      H source center
  let W :=
    periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabContinuousVacuumReferencePhysicalLeftLocalHarnackBaseL1ExponentialWeight
      H s center
  let Rcan :=
    periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabContinuousVacuumReferenceCanonicalFixedRightTargetRatioResponseProfile
      H N hN beta hbeta
  let etaR :=
    periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabFixedRightKernelSectionBoundaryUpdateHarnackInfluence
      beta
  let c :=
    periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabContinuousVacuumReferencePinFreeResponseControlledExponentialWeightedColumnCoefficient
      beta s responseCoefficient
  have hExceptional :=
    periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabContinuousVacuumReferenceCanonicalFixedRightTargetRatioResponseProfile_exceptionalExponentialWeightedColumn_le
      H N hN beta hbeta s hs center source
  have hRemote :=
    periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabContinuousVacuumReferenceCanonicalFixedRightTargetRatioResponseProfile_remoteExponentialWeightedColumn_le_pinFreeAggregateResolvent
      H N hN beta hbeta s hs center source
      responseCoefficient hResponseCoefficient hResponseWeighted hCoefficientLtOne
  have hSdiff :
      (∑ target ∈ remote, W target * Rcan target source) =
        (∑ target : PeriodicHypercubicEvenSpatialSliceLink H,
          W target * Rcan target source) -
        (∑ target ∈ exceptional, W target * Rcan target source) := by
    simpa [
      remote, exceptional,
      periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabContinuousVacuumReferenceC5RemoteTargetFibers] using
      (Finset.sum_sdiff_eq_sub
        (Finset.subset_univ exceptional)
        (f := fun target : PeriodicHypercubicEvenSpatialSliceLink H =>
          W target * Rcan target source))
  have hPartition :
      (∑ target : PeriodicHypercubicEvenSpatialSliceLink H,
        W target * Rcan target source) =
        (∑ target ∈ exceptional, W target * Rcan target source) +
          (∑ target ∈ remote, W target * Rcan target source) := by
    linarith
  have hFull :
      (∑ target : PeriodicHypercubicEvenSpatialSliceLink H,
        W target * Rcan target source) ≤
        (20 * s ^ 2 * Real.exp (16 * beta) * etaR) * W source +
          etaR * Real.exp (16 * beta) * W source * (1 - c)⁻¹ := by
    rw [hPartition]
    exact
      add_le_add
        (by simpa [exceptional, W, Rcan, etaR] using hExceptional)
        (by
          simpa [
            remote, W, Rcan, etaR, c,
            periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabContinuousVacuumReferenceCrossBoundaryBoundedTestMajorant,
            periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabFixedRightKernelSectionBoundaryUpdateHarnackInfluence] using
            hRemote)
  calc
    (∑ target : PeriodicHypercubicEvenSpatialSliceLink H,
      Rcan target source * W target) =
        ∑ target : PeriodicHypercubicEvenSpatialSliceLink H,
          W target * Rcan target source := by
            apply Finset.sum_congr rfl
            intro target _hTarget
            ring
    _ ≤
      (20 * s ^ 2 * Real.exp (16 * beta) * etaR) * W source +
        etaR * Real.exp (16 * beta) * W source * (1 - c)⁻¹ :=
      hFull
    _ =
      periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabContinuousVacuumReferenceCanonicalFixedRightTargetRatioResponseBootstrapCoefficient
          beta s responseCoefficient *
        W source := by
      unfold
        periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabContinuousVacuumReferenceCanonicalFixedRightTargetRatioResponseBootstrapCoefficient
      change
        (20 * s ^ 2 * Real.exp (16 * beta) * etaR) * W source +
            etaR * Real.exp (16 * beta) * W source * (1 - c)⁻¹ =
          (20 * s ^ 2 * Real.exp (16 * beta) * etaR +
            etaR * Real.exp (16 * beta) * (1 - c)⁻¹) * W source
      ring

end

end MathlibAnalytic
end MGAP4D
