import MGAP4D.MathlibAnalytic.SpatialSignedPermutationGroupGeneration
import MGAP4D.MathlibAnalytic.PeriodicHypercubicEvenSpatialAxis1ReflectionGeometry
import Mathlib.Tactic

/-!
# Abstract signed spatial permutations acting on periodic lattice vertices

The abstract signed-coordinate group is now theorem-generated as

`SpatialSignedPermutationGroup = (Fin 3 → ℤˣ) ⋊ S₃`,

has cardinality `48`, and is generated by the same two adjacent swaps and one independent
reflection already used on the concrete finite lattice.  This file supplies the first direct bridge
from that abstract group back to the actual four-dimensional periodic lattice geometry.

Time coordinate `0` is fixed.  For an abstract signed permutation `g = (ε, σ)`, the three spatial
coordinates transform by

`(T_g v)_(i+1) = ε_i · v_(σ⁻¹(i)+1)`.

Since `ε_i : ℤˣ` is exactly `+1` or `-1`, its action on `ZMod n` is implemented without introducing
any new scalar-action infrastructure: `+1` leaves the coordinate fixed and `-1` negates it.  The
semidirect-product multiplication law is then exactly the composition law for these vertex maps.

The resulting map

`SpatialSignedPermutationGroup →* Equiv.Perm (PeriodicHypercubicVertex n)`

is a genuine group action on the actual finite periodic vertex carrier.  The distinguished abstract
`swap12`, `swap23`, `reflect1`, and parity elements are proved to recover the existing canonical
concrete vertex transformations.

This layer is vertex geometry only.  Positive-edge representatives, configuration values,
plaquette observables, cubic irrep labels, continuum spin, and spectral statements remain separate
additive obligations.
-/

namespace MGAP4D
namespace MathlibAnalytic

noncomputable section

/-- The canonical action of an integer unit `±1` on a periodic coordinate. -/
def spatialIntegerUnitZModAction
    {n : ℕ} (u : ℤˣ) (x : ZMod n) : ZMod n :=
  if u = -1 then -x else x

@[simp]
theorem spatialIntegerUnitZModAction_one
    {n : ℕ} (x : ZMod n) :
    spatialIntegerUnitZModAction (1 : ℤˣ) x = x := by
  simp [spatialIntegerUnitZModAction]

@[simp]
theorem spatialIntegerUnitZModAction_neg_one
    {n : ℕ} (x : ZMod n) :
    spatialIntegerUnitZModAction (-1 : ℤˣ) x = -x := by
  simp [spatialIntegerUnitZModAction]

/-- Multiplication of integer signs acts by composition on periodic coordinates. -/
theorem spatialIntegerUnitZModAction_mul
    {n : ℕ} (u v : ℤˣ) (x : ZMod n) :
    spatialIntegerUnitZModAction (u * v) x =
      spatialIntegerUnitZModAction u (spatialIntegerUnitZModAction v x) := by
  rcases Int.units_eq_one_or u with rfl | rfl <;>
    rcases Int.units_eq_one_or v with rfl | rfl <;>
    simp [spatialIntegerUnitZModAction]

/-- Vertex action of an abstract signed permutation.  Euclidean time is fixed; the three spatial
coordinates are reindexed by the inverse permutation and multiplied by their output-coordinate
signs. -/
def periodicHypercubicVertexSpatialSignedPermutation
    (n : ℕ)
    (g : SpatialSignedPermutationGroup)
    (v : PeriodicHypercubicVertex n) :
    PeriodicHypercubicVertex n :=
  Fin.cases (v 0) fun i =>
    spatialIntegerUnitZModAction (g.left i)
      (v ((g.right.symm i).succ))

@[simp]
theorem periodicHypercubicVertexSpatialSignedPermutation_time
    (n : ℕ)
    (g : SpatialSignedPermutationGroup)
    (v : PeriodicHypercubicVertex n) :
    periodicHypercubicVertexSpatialSignedPermutation n g v 0 = v 0 :=
  rfl

@[simp]
theorem periodicHypercubicVertexSpatialSignedPermutation_space
    (n : ℕ)
    (g : SpatialSignedPermutationGroup)
    (v : PeriodicHypercubicVertex n)
    (i : Fin 3) :
    periodicHypercubicVertexSpatialSignedPermutation n g v i.succ =
      spatialIntegerUnitZModAction (g.left i)
        (v ((g.right.symm i).succ)) :=
  rfl

/-- The identity signed permutation acts identically on vertices. -/
@[simp]
theorem periodicHypercubicVertexSpatialSignedPermutation_one
    (n : ℕ)
    (v : PeriodicHypercubicVertex n) :
    periodicHypercubicVertexSpatialSignedPermutation n 1 v = v := by
  funext mu
  refine Fin.cases ?_ (fun i => ?_) mu
  · rfl
  · simp [periodicHypercubicVertexSpatialSignedPermutation]

/-- Semidirect-product multiplication is exactly composition of the corresponding vertex maps. -/
theorem periodicHypercubicVertexSpatialSignedPermutation_mul
    (n : ℕ)
    (g h : SpatialSignedPermutationGroup)
    (v : PeriodicHypercubicVertex n) :
    periodicHypercubicVertexSpatialSignedPermutation n (g * h) v =
      periodicHypercubicVertexSpatialSignedPermutation n g
        (periodicHypercubicVertexSpatialSignedPermutation n h v) := by
  funext mu
  refine Fin.cases ?_ (fun i => ?_) mu
  · rfl
  · simpa [periodicHypercubicVertexSpatialSignedPermutation,
      spatialAxisPermutationSignAction_apply] using
      (spatialIntegerUnitZModAction_mul
        (g.left i) (h.left (g.right.symm i))
        (v ((h.right.symm (g.right.symm i)).succ)))

/-- Each abstract signed permutation is a genuine permutation of the periodic vertex carrier. -/
def periodicHypercubicVertexSpatialSignedPermutationEquiv
    (n : ℕ)
    (g : SpatialSignedPermutationGroup) :
    Equiv.Perm (PeriodicHypercubicVertex n) where
  toFun := periodicHypercubicVertexSpatialSignedPermutation n g
  invFun := periodicHypercubicVertexSpatialSignedPermutation n g⁻¹
  left_inv v := by
    have h :=
      periodicHypercubicVertexSpatialSignedPermutation_mul n g⁻¹ g v
    simpa using h.symm
  right_inv v := by
    have h :=
      periodicHypercubicVertexSpatialSignedPermutation_mul n g g⁻¹ v
    simpa using h.symm

@[simp]
theorem periodicHypercubicVertexSpatialSignedPermutationEquiv_apply
    (n : ℕ)
    (g : SpatialSignedPermutationGroup)
    (v : PeriodicHypercubicVertex n) :
    periodicHypercubicVertexSpatialSignedPermutationEquiv n g v =
      periodicHypercubicVertexSpatialSignedPermutation n g v :=
  rfl

/-- The abstract signed-coordinate group acts on every periodic vertex carrier by a group
homomorphism into its full permutation group. -/
def periodicHypercubicVertexSpatialSignedPermutationHom
    (n : ℕ) :
    SpatialSignedPermutationGroup →*
      Equiv.Perm (PeriodicHypercubicVertex n) where
  toFun := periodicHypercubicVertexSpatialSignedPermutationEquiv n
  map_one' := by
    ext v
    exact periodicHypercubicVertexSpatialSignedPermutation_one n v
  map_mul' g h := by
    ext v
    exact periodicHypercubicVertexSpatialSignedPermutation_mul n g h v

/-- The abstract `swap12` element recovers the canonical concrete spatial-axis `(1 2)` vertex
reindexing. -/
theorem periodicHypercubicVertexSpatialSignedPermutation_swap12
    (n : ℕ)
    (v : PeriodicHypercubicVertex n) :
    periodicHypercubicVertexSpatialSignedPermutation n
        spatialSignedPermutationSwap12 v =
      periodicHypercubicVertexSpatialAxisSwap12Equiv n v := by
  funext mu
  fin_cases mu <;>
    simp [periodicHypercubicVertexSpatialSignedPermutation,
      spatialIntegerUnitZModAction,
      spatialSignedPermutationSwap12,
      spatialAxisPositiveSign,
      periodicHypercubicVertexSpatialAxisSwap12Equiv_apply]

/-- The abstract `swap23` element recovers the canonical concrete spatial-axis `(2 3)` vertex
reindexing. -/
theorem periodicHypercubicVertexSpatialSignedPermutation_swap23
    (n : ℕ)
    (v : PeriodicHypercubicVertex n) :
    periodicHypercubicVertexSpatialSignedPermutation n
        spatialSignedPermutationSwap23 v =
      periodicHypercubicVertexSpatialAxisSwap23Equiv n v := by
  funext mu
  fin_cases mu <;>
    simp [periodicHypercubicVertexSpatialSignedPermutation,
      spatialIntegerUnitZModAction,
      spatialSignedPermutationSwap23,
      spatialAxisPositiveSign,
      periodicHypercubicVertexSpatialAxisSwap23Equiv_apply]

/-- The abstract first-axis reflection recovers the canonical concrete reflection of spatial axis
`1` on the even periodic lattice. -/
theorem periodicHypercubicVertexSpatialSignedPermutation_reflect1
    (H : ℕ)
    (v : PeriodicHypercubicEvenVertex H) :
    periodicHypercubicVertexSpatialSignedPermutation
        (PeriodicHypercubicEvenSideLength H)
        spatialSignedPermutationReflect1 v =
      periodicHypercubicEvenSpatialAxis1Reflection H v := by
  funext mu
  fin_cases mu <;>
    simp [periodicHypercubicVertexSpatialSignedPermutation,
      spatialIntegerUnitZModAction,
      spatialSignedPermutationReflect1,
      spatialAxisReflect1Sign,
      periodicHypercubicEvenSpatialAxis1Reflection]

/-- The abstract global parity element recovers the canonical concrete spatial-parity vertex map on
the even periodic lattice. -/
theorem periodicHypercubicVertexSpatialSignedPermutation_parity
    (H : ℕ)
    (v : PeriodicHypercubicEvenVertex H) :
    periodicHypercubicVertexSpatialSignedPermutation
        (PeriodicHypercubicEvenSideLength H)
        spatialSignedPermutationParity v =
      periodicHypercubicEvenSpatialParity H v := by
  funext mu
  fin_cases mu <;>
    simp [periodicHypercubicVertexSpatialSignedPermutation,
      spatialIntegerUnitZModAction,
      spatialSignedPermutationParity,
      spatialAxisParitySign,
      periodicHypercubicEvenSpatialParity]

end

end MathlibAnalytic
end MGAP4D
