noncomputable section

namespace FiniteSchurPairResidual

/-- A coercive finite Schur residual converts a profile majorant for a global
energy and a residual minorant for a local energy into a direct global-to-local
coercive estimate. -/
theorem global_energy_coercive
    {ι : Type*}
    [Fintype ι]
    (matrix : ι → ι → ℝ)
    (alpha : ℝ)
    (hAlphaNonneg : 0 ≤ alpha)
    (hAlphaLtOne : alpha < 1)
    (hSchur : ∀ vector : ι → ℝ,
      (∑ i, (∑ j, matrix i j * vector j) ^ 2) ≤
        alpha ^ 2 * ∑ i, vector i ^ 2)
    (profile : ι → ℝ)
    (globalEnergy localEnergy : ℝ)
    (hGlobalLe : globalEnergy ≤ ∑ i, profile i ^ 2)
    (hResidualLe :
      (∑ i, (profile i - ∑ j, matrix i j * profile j) ^ 2) ≤
        localEnergy) :
    (1 - alpha) ^ 2 * globalEnergy ≤ localEnergy := by
  have hCoeffNonneg : 0 ≤ (1 - alpha) ^ 2 := sq_nonneg _
  calc
    (1 - alpha) ^ 2 * globalEnergy ≤
        (1 - alpha) ^ 2 * ∑ i, profile i ^ 2 :=
      mul_le_mul_of_nonneg_left hGlobalLe hCoeffNonneg
    _ ≤ ∑ i, (profile i - ∑ j, matrix i j * profile j) ^ 2 :=
      FiniteSchurResolvent.residual_l2_sq_lower_bound
        matrix alpha hAlphaNonneg hAlphaLtOne hSchur profile
    _ ≤ localEnergy := hResidualLe

end FiniteSchurPairResidual

/-- Positive coefficient generated by the explicit periodic compact-Haar
`SU(N)` Dobrushin resolvent.  This is the squared resolvent constant; no claim of
sharpness relative to the expected `1 - alpha` tensorization constant is made. -/
def periodicHypercubicSpecialUnitaryPairResidualCoreGap
    (beta : ℝ) : ℝ :=
  (1 - periodicHypercubicSpecialUnitaryDobrushinCoefficient beta) ^ 2

/-- Pair-residual profile data for one bounded continuous observable on the
actual periodic compact-Haar `SU(N)` Wilson system.

The first field majorizes the global independent Gibbs-pair difference energy
by a finite link profile.  The second field bounds the `I - C` residual of that
profile by the summed native conditional independent-link-pair energies.  These
are precisely the two measure-theoretic coupling/martingale inequalities still
needed after the exact identities of PRs #849 and #850. -/
structure PeriodicHypercubicSpecialUnitaryPairResidualProfileDataBCF
    (n N : ℕ)
    [NeZero n]
    (hN : 0 < N)
    [Nontrivial (Matrix.specialUnitaryGroup (Fin N) ℂ)]
    (beta : ℝ)
    (beta_nonneg : 0 ≤ beta)
    (O : BoundedContinuousFunction
      (periodicHypercubicSpecialUnitaryWilsonSystem
        n N hN beta beta_nonneg).base.Configuration ℝ) where
  profile : PeriodicHypercubicEdge n → ℝ
  globalPair_le_profile_sq :
    (periodicHypercubicSpecialUnitaryWilsonSystem
      n N hN beta beta_nonneg).gibbsIndependentPairDifferenceEnergyBCF O ≤
      ∑ target, profile target ^ 2
  residual_sq_le_localPair :
    (∑ target,
      (profile target -
        ∑ source,
          periodicHypercubicSpecialUnitaryDobrushinInfluence
            n N hN beta beta_nonneg target source * profile source) ^ 2) ≤
      ∑ target,
        ∫ A,
          (periodicHypercubicSpecialUnitaryWilsonSystem
            n N hN beta beta_nonneg).
              singleLinkConditionalIndependentPairDifferenceEnergyBCF
                target O A
          ∂(periodicHypercubicSpecialUnitaryWilsonSystem
            n N hN beta beta_nonneg).gibbsMeasure

/-- Family data supplying a pair-residual profile for every bounded continuous
observable on one periodic compact-Haar `SU(N)` Wilson system. -/
structure PeriodicHypercubicSpecialUnitaryPairResidualProfileFamilyDataBCF
    (n N : ℕ)
    [NeZero n]
    (hN : 0 < N)
    [Nontrivial (Matrix.specialUnitaryGroup (Fin N) ℂ)]
    (beta : ℝ)
    (beta_nonneg : 0 ≤ beta) where
  profileData :
    ∀ O : BoundedContinuousFunction
      (periodicHypercubicSpecialUnitaryWilsonSystem
        n N hN beta beta_nonneg).base.Configuration ℝ,
      PeriodicHypercubicSpecialUnitaryPairResidualProfileDataBCF
        n N hN beta beta_nonneg O

/-- Bounded-continuous-core heat-bath Poincaré property for a native compact-Haar
Wilson system. -/
def ContinuousCompactOrientedGaugeWilsonSystem.BoundedContinuousCoreHeatBathPoincare
    (C : ContinuousCompactOrientedGaugeWilsonSystem)
    (gap : ℝ) : Prop :=
  ∀ O : BoundedContinuousFunction C.base.Configuration ℝ,
    gap * ‖C.vacuumCenteredL2 (C.gibbsL2RepresentativeBCF O)‖ ^ 2 ≤
      inner ℝ
        (C.heatBathHamiltonianL2 (C.gibbsL2RepresentativeBCF O))
        (C.gibbsL2RepresentativeBCF O)

/-- The explicit periodic `SU(N)` pair-residual profile yields direct coercivity
between the global and summed conditional independent-pair energies. -/
theorem periodicHypercubicSpecialUnitary_pairResidual_pairEnergy_coercive
    (n N : ℕ)
    [NeZero n]
    (hn : 3 ≤ n)
    (hN : 0 < N)
    [Nontrivial (Matrix.specialUnitaryGroup (Fin N) ℂ)]
    (beta : ℝ)
    (beta_nonneg : 0 ≤ beta)
    (hBetaLt : beta < Real.log ((19 : ℝ) / 17) / 4)
    (O : BoundedContinuousFunction
      (periodicHypercubicSpecialUnitaryWilsonSystem
        n N hN beta beta_nonneg).base.Configuration ℝ)
    (R : PeriodicHypercubicSpecialUnitaryPairResidualProfileDataBCF
      n N hN beta beta_nonneg O) :
    periodicHypercubicSpecialUnitaryPairResidualCoreGap beta *
        (periodicHypercubicSpecialUnitaryWilsonSystem
          n N hN beta beta_nonneg).
            gibbsIndependentPairDifferenceEnergyBCF O ≤
      ∑ target,
        ∫ A,
          (periodicHypercubicSpecialUnitaryWilsonSystem
            n N hN beta beta_nonneg).
              singleLinkConditionalIndependentPairDifferenceEnergyBCF
                target O A
          ∂(periodicHypercubicSpecialUnitaryWilsonSystem
            n N hN beta beta_nonneg).gibbsMeasure := by
  unfold periodicHypercubicSpecialUnitaryPairResidualCoreGap
  apply FiniteSchurPairResidual.global_energy_coercive
    (periodicHypercubicSpecialUnitaryDobrushinInfluence
      n N hN beta beta_nonneg)
    (periodicHypercubicSpecialUnitaryDobrushinCoefficient beta)
    (R.profile)
  · unfold periodicHypercubicSpecialUnitaryDobrushinCoefficient
    exact mul_nonneg (by norm_num)
      (compactHaarOscillationInfluence_nonneg (by positivity))
  · simpa [periodicHypercubicSpecialUnitaryDobrushinCoefficient] using
      periodicHypercubicSpecialUnitary_eighteen_mul_eta_lt_one_of_beta_lt
        beta hBetaLt
  · exact periodicHypercubicSpecialUnitaryDobrushinInfluence_l2_sq_le
      n N hn hN beta beta_nonneg
  · exact R.globalPair_le_profile_sq
  · exact R.residual_sq_le_localPair

/-- Pair-residual coercivity and the exact global/local pair identities produce a
native bounded-continuous-core heat-bath Poincaré inequality. -/
theorem periodicHypercubicSpecialUnitary_pairResidual_boundedContinuousCorePoincare
    (n N : ℕ)
    [NeZero n]
    (hn : 3 ≤ n)
    (hN : 0 < N)
    [Nontrivial (Matrix.specialUnitaryGroup (Fin N) ℂ)]
    (beta : ℝ)
    (beta_nonneg : 0 ≤ beta)
    (hBetaLt : beta < Real.log ((19 : ℝ) / 17) / 4)
    (O : BoundedContinuousFunction
      (periodicHypercubicSpecialUnitaryWilsonSystem
        n N hN beta beta_nonneg).base.Configuration ℝ)
    (R : PeriodicHypercubicSpecialUnitaryPairResidualProfileDataBCF
      n N hN beta beta_nonneg O) :
    periodicHypercubicSpecialUnitaryPairResidualCoreGap beta *
        ‖(periodicHypercubicSpecialUnitaryWilsonSystem
          n N hN beta beta_nonneg).vacuumCenteredL2
            ((periodicHypercubicSpecialUnitaryWilsonSystem
              n N hN beta beta_nonneg).gibbsL2RepresentativeBCF O)‖ ^ 2 ≤
      inner ℝ
        ((periodicHypercubicSpecialUnitaryWilsonSystem
          n N hN beta beta_nonneg).heatBathHamiltonianL2
            ((periodicHypercubicSpecialUnitaryWilsonSystem
              n N hN beta beta_nonneg).gibbsL2RepresentativeBCF O))
        ((periodicHypercubicSpecialUnitaryWilsonSystem
          n N hN beta beta_nonneg).gibbsL2RepresentativeBCF O) := by
  let C := periodicHypercubicSpecialUnitaryWilsonSystem
    n N hN beta beta_nonneg
  have hPair :=
    periodicHypercubicSpecialUnitary_pairResidual_pairEnergy_coercive
      n N hn hN beta beta_nonneg hBetaLt O R
  rw [continuous_compact_oriented_gibbsIndependentPairDifferenceEnergyBCF_eq_two_mul_centered_norm_sq
        C O,
      continuous_compact_oriented_sum_integral_singleLinkConditionalIndependentPairDifferenceEnergyBCF_eq_two_mul_hamiltonian
        C O] at hPair
  simpa [C] using (half_le_half hPair)

/-- Family pair-residual data generate the bounded-continuous-core Poincaré
property with one explicit volume-independent positive coefficient. -/
theorem periodicHypercubicSpecialUnitary_pairResidual_family_boundedContinuousCorePoincare
    (n N : ℕ)
    [NeZero n]
    (hn : 3 ≤ n)
    (hN : 0 < N)
    [Nontrivial (Matrix.specialUnitaryGroup (Fin N) ℂ)]
    (beta : ℝ)
    (beta_nonneg : 0 ≤ beta)
    (hBetaLt : beta < Real.log ((19 : ℝ) / 17) / 4)
    (R : PeriodicHypercubicSpecialUnitaryPairResidualProfileFamilyDataBCF
      n N hN beta beta_nonneg) :
    (periodicHypercubicSpecialUnitaryWilsonSystem
      n N hN beta beta_nonneg).BoundedContinuousCoreHeatBathPoincare
        (periodicHypercubicSpecialUnitaryPairResidualCoreGap beta) := by
  intro O
  exact
    periodicHypercubicSpecialUnitary_pairResidual_boundedContinuousCorePoincare
      n N hn hN beta beta_nonneg hBetaLt O (R.profileData O)

/-- The pair-residual bounded-continuous-core gap is strictly positive throughout
the explicit periodic `SU(N)` strict Dobrushin region. -/
theorem periodicHypercubicSpecialUnitaryPairResidualCoreGap_pos
    (beta : ℝ)
    (hBetaLt : beta < Real.log ((19 : ℝ) / 17) / 4) :
    0 < periodicHypercubicSpecialUnitaryPairResidualCoreGap beta := by
  have hAlphaLt :
      periodicHypercubicSpecialUnitaryDobrushinCoefficient beta < 1 := by
    simpa [periodicHypercubicSpecialUnitaryDobrushinCoefficient] using
      periodicHypercubicSpecialUnitary_eighteen_mul_eta_lt_one_of_beta_lt
        beta hBetaLt
  have hSub :
      0 < 1 - periodicHypercubicSpecialUnitaryDobrushinCoefficient beta :=
    sub_pos.mpr hAlphaLt
  unfold periodicHypercubicSpecialUnitaryPairResidualCoreGap
  simpa [pow_two] using mul_pos hSub hSub

end

end MathlibAnalytic
