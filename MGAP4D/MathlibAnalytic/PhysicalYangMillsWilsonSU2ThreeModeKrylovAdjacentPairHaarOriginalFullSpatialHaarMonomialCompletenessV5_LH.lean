/-!
# P4-Q2-LH — ALL finite-volume spatial SU(2) monomial Haar moments separate sources

The ORIGINAL finite-volume spatial configuration is the real physical
product Cfg_H = (actual spatial links -> SU(2)). The Haar measure used
here is the SAME original product Haar reference in the Wilson
transfer integral, NOT an independent substitute for either genuinely
interacting conditional Wilson posterior.

LD proved the coordinate algebra generated by each actual spatial
link matrix entry is uniformly dense (Stone-Weierstrass) in C(Cfg_H,R).
LF proved each finite coordinate monomial comes from actual matrix
entries of actual links. LG identified exact finite homogeneous
full-spatial Wilson energies as sums of squares of these Haar moments.

We now prove FULL SOURCE SEPARATION:

  any continuous ψ : C(Cfg_H,R) with all finite coordinate-monomial
  moments zero is identically zero.

A bounded REAL spatial Haar moment functional is constructed through
the original spatial Haar L² Riesz pairing. LD's density plus true
full Haar support implies that vanishing on the dense coordinate
algebra forces the source itself to vanish, pointwise.

We prove every element of the submonoid generated by original
matrix-real coordinate functions is a finite LF monomial. Via pinned
mathlib Algebra.adjoin_eq_span and actual bounded functional's kernel,
vanishing on all monomials extends to the entire uniformly dense
algebra. Hence nonzero continuous spatial source has an explicitly
existential nonzero true finite-degree spatial monomial Haar moment.
Combined with LG it has some strictly positive full-spatial
homogeneous Wilson Haar energy — no rank or frame assumption.

This is not yet the full exponential, strict physical transfer
injectivity, centered spatial Wilson GI detector, H1-C3 or
continuum YM mass gap. No new axiom, sorry or posterior replacement.
-/

namespace MGAP4D
namespace MathlibAnalytic
open MeasureTheory
open scoped ENNReal Topology InnerProductSpace BigOperators
noncomputable section
set_option maxHeartbeats 3900000
set_option synthInstance.maxHeartbeats 1050000

local instance p4Q2LH_topologicalGroup :
    IsTopologicalGroup (Matrix.specialUnitaryGroup (Fin 2) ℂ) :=
  specialUnitaryGroupIsTopologicalGroup 2
local instance p4Q2LH_compactSpace :
    CompactSpace (Matrix.specialUnitaryGroup (Fin 2) ℂ) :=
  specialUnitaryGroupCompactSpace 2
local instance p4Q2LH_secondCountable :
    SecondCountableTopology (Matrix.specialUnitaryGroup (Fin 2) ℂ) :=
  specialUnitaryGroupSecondCountableTopology 2
local instance p4Q2LH_measurableSpace :
    MeasurableSpace (Matrix.specialUnitaryGroup (Fin 2) ℂ) :=
  specialUnitaryGroupMeasurableSpace 2
local instance p4Q2LH_borelSpace :
    BorelSpace (Matrix.specialUnitaryGroup (Fin 2) ℂ) :=
  specialUnitaryGroupBorelSpace 2
local instance p4Q2LH_spatialHaarOpenPos (H : ℕ) :
    (periodicHypercubicEvenSpecialUnitarySpatialSliceHaarMeasure H 2).IsOpenPosMeasure := by
  unfold periodicHypercubicEvenSpecialUnitarySpatialSliceHaarMeasure
  infer_instance

namespace GroundStatePosteriorJoint
section Spatial
variable (H : ℕ)
local notation "Cfg" => PeriodicHypercubicEvenSpecialUnitarySpatialSliceConfiguration H 2
local notation "Link" => PeriodicHypercubicEvenSpatialSliceLink H
local notation "Coord" => ((Fin 2 × Fin 2) × Bool)
local notation "ProductCoord" => (Link × Coord)
local notation "haar" => periodicHypercubicEvenSpecialUnitarySpatialSliceHaarMeasure H 2
local notation "Alg" => p4Q2LD_originalSpatialMatrixCoordinateAlgebra H
local notation "Generator" => (fun p : ProductCoord =>
  p4Q2LD_originalSpatialLinkRealCoordinate H p.1 p.2)
local notation "Mon" => p4Q2LF_originalSpatialMatrixCoordinateMonomial H
local notation "Energy" => p4Q2LG_originalFullSpatialHomogeneousWilsonHaarEnergy H

/-- The actual finite-volume spatial Haar L² Riesz moment functional
for any real continuous signed spatial source ψ. -/
noncomputable def p4Q2LH_originalFullSpatialHaarMomentCLM
    (ψ : C(Cfg, ℝ)) : C(Cfg, ℝ) →L[ℝ] ℝ :=
  (innerSL ℝ (ContinuousMap.toLp 2 haar ℝ ψ)).comp
    (ContinuousMap.toLp 2 haar ℝ)

/-- Exact identification with the ORIGINAL spatial Haar moment, not a
substituted conditional Wilson posterior. -/
theorem p4Q2LH_originalFullSpatialHaarMomentCLM_apply
    (ψ f : C(Cfg, ℝ)) :
    p4Q2LH_originalFullSpatialHaarMomentCLM H ψ f =
      ∫ A : Cfg, f A * ψ A ∂haar := by
  change inner ℝ (ContinuousMap.toLp 2 haar ℝ ψ)
    (ContinuousMap.toLp 2 haar ℝ f) = _
  simpa using (ContinuousMap.inner_toLp haar ψ f)

/-- FULL Haar polynomial algebra closure is ALL spatial continuous
functions, by exactly the original LD Stone-Weierstrass theorem. -/
theorem p4Q2LH_originalSpatialCoordinateAlgebra_closure_univ :
    closure (Alg : Set C(Cfg, ℝ)) = Set.univ := by
  rw [← Subalgebra.topologicalClosure_coe]
  rw [p4Q2LD_originalSpatialMatrixCoordinateAlgebra_closure_eq_top H]
  rfl

/-- Every real bounded continuous linear functional vanishing on
the original dense all-spatial-link coordinate algebra is zero. -/
theorem p4Q2LH_zeroCLM_of_originalSpatialCoordinatePolynomialMoments_zero
    (L : C(Cfg, ℝ) →L[ℝ] ℝ)
    (h : ∀ f : C(Cfg, ℝ), f ∈ Alg → L f = 0) :
    L = 0 := by
  have hClosed : IsClosed {f : C(Cfg, ℝ) | L f = 0} :=
    (isClosed_singleton : IsClosed ({(0 : ℝ)} : Set ℝ)).preimage L.continuous
  have hSub : (Alg : Set C(Cfg, ℝ)) ⊆ {f : C(Cfg, ℝ) | L f = 0} := by
    intro f hf
    exact h f hf
  have hClosure := closure_minimal hSub hClosed
  have hAll (f : C(Cfg, ℝ)) : L f = 0 := by
    exact hClosure (by rw [p4Q2LH_originalSpatialCoordinateAlgebra_closure_univ H]; trivial)
  apply ContinuousLinearMap.ext
  intro f
  simpa using hAll f

/-- Any real continuous full-spatial Haar source with all moments
zero against the dense coordinate POLYNOMIAL algebra is zero
POINTWISE, not merely as a Haar-a.e. L² class. -/
theorem p4Q2LH_originalFullSpatialHaarMomentCLM_separates_sources
    (ψ : C(Cfg, ℝ))
    (h : ∀ f : C(Cfg, ℝ), f ∈ Alg →
      p4Q2LH_originalFullSpatialHaarMomentCLM H ψ f = 0) :
    ψ = 0 := by
  have hL : p4Q2LH_originalFullSpatialHaarMomentCLM H ψ = 0 :=
    p4Q2LH_zeroCLM_of_originalSpatialCoordinatePolynomialMoments_zero
      H (p4Q2LH_originalFullSpatialHaarMomentCLM H ψ) h
  have hSelf := congrArg
    (fun (L : C(Cfg, ℝ) →L[ℝ] ℝ) => L ψ) hL
  have hInner :
      inner ℝ (ContinuousMap.toLp 2 haar ℝ ψ)
        (ContinuousMap.toLp 2 haar ℝ ψ) = 0 := by
    simpa [p4Q2LH_originalFullSpatialHaarMomentCLM] using hSelf
  rw [real_inner_self_eq_norm_sq] at hInner
  have hNorm : ‖ContinuousMap.toLp 2 haar ℝ ψ‖ = 0 := by
    nlinarith [norm_nonneg (ContinuousMap.toLp 2 haar ℝ ψ)]
  have hLp : ContinuousMap.toLp 2 haar ℝ ψ = 0 := norm_eq_zero.mp hNorm
  apply (ContinuousMap.toLp_injective
    (E := ℝ) (p := (2 : ℝ≥0∞)) (𝕜 := ℝ) (μ := haar))
  simpa using hLp

/-- Every actual full-spatial coordinate monomial product can be
concatenated exactly, with finite-degree structure retained. -/
theorem p4Q2LH_originalSpatialCoordinateMonomial_mul
    (n m : ℕ) (a : Fin n → ProductCoord) (b : Fin m → ProductCoord) :
    Mon n a * Mon m b = Mon (n + m) (Fin.append a b) := by
  ext A
  simp only [ContinuousMap.mul_apply,
    p4Q2LF_originalSpatialMatrixCoordinateMonomial_apply]
  rw [Fin.prod_univ_add]
  simp only [Fin.append_left, Fin.append_right]

/-- Every element of the multiplicative monoid generated by
the real matrix entries on all original physical spatial links
is exactly a finite-degree LF spatial coordinate monomial. -/
theorem p4Q2LH_originalSpatialCoordinateSubmonoid_generated_by_monomials
    (f : C(Cfg, ℝ))
    (hf : f ∈ Submonoid.closure (Set.range Generator)) :
    ∃ n : ℕ, ∃ a : Fin n → ProductCoord, f = Mon n a := by
  induction hf using Submonoid.closure_induction with
  | mem f hf =>
      obtain ⟨p, rfl⟩ := hf
      refine ⟨1, (fun _ : Fin 1 => p), ?_⟩
      ext A
      simp [p4Q2LF_originalSpatialMatrixCoordinateMonomial]
  | one =>
      refine ⟨0, Fin.elim0, ?_⟩
      simp [p4Q2LF_originalSpatialMatrixCoordinateMonomial]
  | mul x y _ _ hx hy =>
      obtain ⟨n, a, rfl⟩ := hx
      obtain ⟨m, b, rfl⟩ := hy
      exact ⟨n + m, Fin.append a b,
        p4Q2LH_originalSpatialCoordinateMonomial_mul H n m a b⟩

/-- On the original finite-volume spatial Haar continuous carrier,
zero moment against EVERY original finite-degree monomial forces
the REAL bounded functional to vanish on the ENTIRE coordinate
polynomial algebra, using the pinned mathlib generated-span theorem. -/
theorem p4Q2LH_zero_on_originalSpatialCoordinateAlgebra_of_all_monomialMoments_zero
    (L : C(Cfg, ℝ) →L[ℝ] ℝ)
    (hMon : ∀ (n : ℕ) (a : Fin n → ProductCoord), L (Mon n a) = 0) :
    ∀ f : C(Cfg, ℝ), f ∈ Alg → L f = 0 := by
  intro f hf
  have hSpan : f ∈ Submodule.span ℝ
      (Submonoid.closure
        (Set.range Generator) : Set C(Cfg, ℝ)) := by
    change f ∈ Subalgebra.toSubmodule
      (Algebra.adjoin ℝ (Set.range Generator)) at hf
    rwa [Algebra.adjoin_eq_span] at hf
  have hGenerators :
      (Submonoid.closure
        (Set.range Generator) : Set C(Cfg, ℝ)) ⊆
      (L.toLinearMap.ker : Set C(Cfg, ℝ)) := by
    intro x hx
    obtain ⟨n, a, rfl⟩ :=
      p4Q2LH_originalSpatialCoordinateSubmonoid_generated_by_monomials H x hx
    exact LinearMap.mem_ker.mpr (hMon n a)
  have hSpanKer :
      Submodule.span ℝ
        (Submonoid.closure
          (Set.range Generator) : Set C(Cfg, ℝ)) ≤
      L.toLinearMap.ker :=
    Submodule.span_le.mpr hGenerators
  exact LinearMap.mem_ker.mp (hSpanKer hSpan)

/-- The actual original FULL spatial product Haar moments against
ALL true spatial coordinate monomials jointly determine any
continuous signed spatial source, pointwise. -/
theorem p4Q2LH_originalFullSpatialHaar_all_monomialMoments_zero_imp_source_zero
    (ψ : C(Cfg, ℝ))
    (hMon : ∀ (n : ℕ) (a : Fin n → ProductCoord),
      (∫ A : Cfg, ψ A * Mon n a A ∂haar) = 0) :
    ψ = 0 := by
  apply p4Q2LH_originalFullSpatialHaarMomentCLM_separates_sources H ψ
  apply p4Q2LH_zero_on_originalSpatialCoordinateAlgebra_of_all_monomialMoments_zero H
  intro n a
  rw [p4Q2LH_originalFullSpatialHaarMomentCLM_apply]
  have h := hMon n a
  simpa only [mul_comm] using h

/-- EVERY genuinely NONZERO continuous full spatial Wilson source
has some nonzero actual normalized spatial product Haar moment
against a concrete finite-degree matrix-coordinate monomial. -/
theorem p4Q2LH_originalFullSpatialHaar_exists_nonzero_monomialMoment
    (ψ : C(Cfg, ℝ)) (hψ : ψ ≠ 0) :
    ∃ (n : ℕ) (a : Fin n → ProductCoord),
      (∫ A : Cfg, ψ A * Mon n a A ∂haar) ≠ 0 := by
  by_contra hn
  push Not at hn
  exact hψ
    (p4Q2LH_originalFullSpatialHaar_all_monomialMoments_zero_imp_source_zero
      H ψ hn)

/-- Every nonzero continuous TRUE spatial Wilson source has a
strictly POSITIVE homogeneous full-spatial Wilson feature Haar
energy in some finite degree, by LG's exact square-moment identity. -/
theorem p4Q2LH_originalFullSpatialHaar_exists_positive_homogeneousWilsonEnergy
    (ψ : C(Cfg, ℝ)) (hψ : ψ ≠ 0) :
    ∃ n : ℕ, 0 < Energy ψ n := by
  obtain ⟨n, a, ha⟩ :=
    p4Q2LH_originalFullSpatialHaar_exists_nonzero_monomialMoment H ψ hψ
  exact ⟨n,
    p4Q2LG_originalFullSpatialHomogeneousHaarEnergy_pos_of_moment_ne
      H ψ n a ha⟩

