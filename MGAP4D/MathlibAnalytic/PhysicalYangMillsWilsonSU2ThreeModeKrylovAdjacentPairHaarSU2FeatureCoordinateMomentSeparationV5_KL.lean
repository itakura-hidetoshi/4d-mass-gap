/-!
# P4-Q2-KL — genuine SU(2) Haar moment separation by Wilson matrix coordinates

KK proves (using pinned mathlib Stone–Weierstrass) that the real algebra
generated by the eight continuous real/imaginary coordinates of the
ACTUAL defining SU(2) matrix representation is uniformly dense in
C(SU(2),ℝ).

For each continuous signed test source ψ on the genuine SU(2) group,
define its authentic normalized SU(2) Haar moment bounded real-linear
functional Lψ(f) = ∫ f(g) ψ(g) dHaar(g), using the canonical Haar L²
inner-product Riesz representation and ContinuousMap.toLp.

We prove: if Lψ vanishes on the actual matrix-coordinate polynomial
algebra, continuity and Stone–Weierstrass imply Lψ=0 on all continuous
tests. Evaluating at ψ itself and using full support of compact Haar
then forces ψ=0 POINTWISE. Equivalently the complete coordinate
polynomial Haar moment family separates every nonzero continuous source.

No independent-Haar replacement of the actual interacting posterior:
Haar here is only the canonical reference measure in the genuine
SU(2) integral of a source function. This theorem is the precise
moment-completeness bridge, NOT YET the exponential integral-transform
injectivity (which requires deriving all moments from the exponential
kernel), the physical GI receiver separation, H1-C3, or continuum gap.
No sorry/admit/new axioms/artificial detector rank.
-/

namespace MGAP4D
namespace MathlibAnalytic
open MeasureTheory
open scoped ENNReal Topology InnerProductSpace
noncomputable section
set_option maxHeartbeats 3900000
set_option synthInstance.maxHeartbeats 1050000

local instance p4Q2KL_topologicalGroup :
    IsTopologicalGroup (Matrix.specialUnitaryGroup (Fin 2) ℂ) :=
  specialUnitaryGroupIsTopologicalGroup 2
local instance p4Q2KL_compactSpace :
    CompactSpace (Matrix.specialUnitaryGroup (Fin 2) ℂ) :=
  specialUnitaryGroupCompactSpace 2
local instance p4Q2KL_secondCountable :
    SecondCountableTopology (Matrix.specialUnitaryGroup (Fin 2) ℂ) :=
  specialUnitaryGroupSecondCountableTopology 2
local instance p4Q2KL_measurableSpace :
    MeasurableSpace (Matrix.specialUnitaryGroup (Fin 2) ℂ) :=
  specialUnitaryGroupMeasurableSpace 2
local instance p4Q2KL_borelSpace :
    BorelSpace (Matrix.specialUnitaryGroup (Fin 2) ℂ) :=
  specialUnitaryGroupBorelSpace 2
local instance p4Q2KL_haarOpenPos :
    (normalizedCompactHaar (Matrix.specialUnitaryGroup (Fin 2) ℂ)).IsOpenPosMeasure := by
  unfold normalizedCompactHaar
  infer_instance

namespace GroundStatePosteriorJoint
section SU2
local notation "Gauge" => Matrix.specialUnitaryGroup (Fin 2) ℂ
local notation "nu" => normalizedCompactHaar Gauge
local notation "Alg" => p4Q2KK_originalSU2MatrixCoordinateAlgebra

/-- The true SU(2) normalized Haar L² Riesz moment functional of a
continuous real source. The canonical Haar is NOT an artificial
replacement of either interacting physical posterior. -/
noncomputable def p4Q2KL_originalSU2HaarMomentCLM
    (ψ : C(Gauge, ℝ)) : C(Gauge, ℝ) →L[ℝ] ℝ :=
  (innerSL ℝ (ContinuousMap.toLp 2 nu ℝ ψ)).comp
    (ContinuousMap.toLp 2 nu ℝ)

/-- Exact Haar integral formula for the same bounded moment functional. -/
theorem p4Q2KL_originalSU2HaarMomentCLM_apply
    (ψ f : C(Gauge, ℝ)) :
    p4Q2KL_originalSU2HaarMomentCLM ψ f =
      ∫ g : Gauge, f g * ψ g ∂nu := by
  change inner ℝ (ContinuousMap.toLp 2 nu ℝ ψ)
    (ContinuousMap.toLp 2 nu ℝ f) = _
  simpa using (ContinuousMap.inner_toLp nu ψ f)

/-- Closure of the actual coordinate-polynomial function algebra is
literally ALL continuous SU(2) functions, as a SET of C(SU2,ℝ).
The identity is derived from KK's theorem-proved Stone–Weierstrass
result, not an assumed functional completeness hypothesis. -/
theorem p4Q2KL_originalSU2CoordinateAlgebra_closure_univ :
    closure (Alg : Set C(Gauge, ℝ)) = Set.univ := by
  rw [← Subalgebra.topologicalClosure_coe]
  rw [p4Q2KK_originalSU2MatrixCoordinateAlgebra_closure_eq_top]
  rfl

/-- A continuous linear functional on C(SU2,R) that vanishes on
every original SU(2) coordinate polynomial must be the ZERO
functional. This is a real continuous-functional separation theorem. -/
theorem p4Q2KL_zeroCLM_of_coordinatePolynomialMoments_zero
    (L : C(Gauge, ℝ) →L[ℝ] ℝ)
    (h : ∀ f : C(Gauge, ℝ), f ∈ Alg → L f = 0) :
    L = 0 := by
  have hClosed : IsClosed {f : C(Gauge, ℝ) | L f = 0} :=
    (isClosed_singleton : IsClosed ({(0 : ℝ)} : Set ℝ)).preimage L.continuous
  have hSub : (Alg : Set C(Gauge, ℝ)) ⊆ {f : C(Gauge, ℝ) | L f = 0} := by
    intro f hf
    exact h f hf
  have hClosure := closure_minimal hSub hClosed
  have hAll (f : C(Gauge, ℝ)) : L f = 0 := by
    exact hClosure (by rw [p4Q2KL_originalSU2CoordinateAlgebra_closure_univ]; trivial)
  apply ContinuousLinearMap.ext
  intro f
  simpa using hAll f

/-- COMPLETE original SU(2) Haar polynomial moment separation:
if a continuous signed source has zero moment against EVERY
coordinate polynomial in the original real/imaginary SU(2)
matrix entries, then that source vanishes pointwise. -/
theorem p4Q2KL_originalSU2HaarMomentCLM_separates_sources
    (ψ : C(Gauge, ℝ))
    (h : ∀ f : C(Gauge, ℝ), f ∈ Alg →
      p4Q2KL_originalSU2HaarMomentCLM ψ f = 0) :
    ψ = 0 := by
  have hL : p4Q2KL_originalSU2HaarMomentCLM ψ = 0 :=
    p4Q2KL_zeroCLM_of_coordinatePolynomialMoments_zero
      (p4Q2KL_originalSU2HaarMomentCLM ψ) h
  have hSelf := congrArg
    (fun (L : C(Gauge, ℝ) →L[ℝ] ℝ) => L ψ) hL
  have hInner :
      inner ℝ (ContinuousMap.toLp 2 nu ℝ ψ)
        (ContinuousMap.toLp 2 nu ℝ ψ) = 0 := by
    simpa [p4Q2KL_originalSU2HaarMomentCLM] using hSelf
  rw [real_inner_self_eq_norm_sq] at hInner
  have hNorm : ‖ContinuousMap.toLp 2 nu ℝ ψ‖ = 0 := by
    nlinarith [norm_nonneg (ContinuousMap.toLp 2 nu ℝ ψ)]
  have hLp : ContinuousMap.toLp 2 nu ℝ ψ = 0 := norm_eq_zero.mp hNorm
  apply (ContinuousMap.toLp_injective
    (E := ℝ) (p := (2 : ℝ≥0∞)) (𝕜 := ℝ) (μ := nu))
  simpa using hLp

/-- The physically transparent integral-only formulation:
the genuine normalized Haar moments of a continuous SU(2) signed
source against all original SU(2) coordinate polynomials determine
that source pointwise. -/
theorem p4Q2KL_originalSU2HaarCoordinatePolynomialMoments_separate
    (ψ : C(Gauge, ℝ))
    (h : ∀ f : Alg,
      (∫ g : Gauge, (f : C(Gauge, ℝ)) g * ψ g ∂nu) = 0) :
    ψ = 0 := by
  apply p4Q2KL_originalSU2HaarMomentCLM_separates_sources ψ
  intro f hf
  rw [p4Q2KL_originalSU2HaarMomentCLM_apply]
  exact h ⟨f, hf⟩

