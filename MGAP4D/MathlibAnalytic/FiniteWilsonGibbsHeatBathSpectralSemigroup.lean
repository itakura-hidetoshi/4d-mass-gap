import MGAP4D.MathlibAnalytic.FiniteDimensionalSymmetricHamiltonianSpectralSemigroup
import MGAP4D.MathlibAnalytic.FiniteWilsonCanonicalHeatBathHamiltonian
import Mathlib.Tactic

namespace MGAP4D
namespace MathlibAnalytic

noncomputable section

open Filter Set Topology
open scoped InnerProductSpace

/-- The continuous-time spectral semigroup generated by the concrete finite
Wilson Gibbs heat-bath Hamiltonian `sum_e (I - P_e)`. -/
noncomputable def FiniteLatticeWilsonSystem.gibbsHeatBathSpectralSemigroup
    (L : FiniteLatticeWilsonSystem)
    (t : NNReal) :
    L.GibbsHilbertSpace →L[ℝ] L.GibbsHilbertSpace :=
  finiteDimensionalSymmetricHamiltonianSpectralSemigroup
    L.gibbsHeatBathHamiltonianLinearMap
    (finite_lattice_gibbsHeatBathHamiltonianLinearMap_isSymmetric L)
    (Module.finrank ℝ L.GibbsHilbertSpace)
    rfl
    t

/-- Conjugate the concrete Gibbs-Hilbert spectral semigroup through the
`sqrt(mu)` observable equivalence.  This is the actual continuous-time
heat-bath evolution on finite Wilson observables. -/
noncomputable def
    FiniteLatticeWilsonSystem.gibbsObservableHeatBathSpectralSemigroup
    (L : FiniteLatticeWilsonSystem)
    (t : NNReal) :
    (L.Configuration → ℝ) →ₗ[ℝ] (L.Configuration → ℝ) :=
  L.gibbsHilbertObserveLinearMap.comp
    ((L.gibbsHeatBathSpectralSemigroup t).toLinearMap.comp
      L.gibbsHilbertEmbedLinearMap)

@[simp] theorem finite_lattice_gibbsObservableHeatBathSpectralSemigroup_apply
    (L : FiniteLatticeWilsonSystem)
    (t : NNReal)
    (f : L.Configuration → ℝ) :
    L.gibbsObservableHeatBathSpectralSemigroup t f =
      L.gibbsHilbertObserveLinearMap
        (L.gibbsHeatBathSpectralSemigroup t
          (L.gibbsHilbertEmbedLinearMap f)) :=
  rfl

/-- Gibbs embedding exactly intertwines the concrete observable evolution with
the Gibbs-Hilbert spectral semigroup. -/
@[simp] theorem
    finite_lattice_gibbsObservableHeatBathSpectralSemigroup_embed
    (L : FiniteLatticeWilsonSystem)
    (t : NNReal)
    (f : L.Configuration → ℝ) :
    L.gibbsHilbertEmbedLinearMap
        (L.gibbsObservableHeatBathSpectralSemigroup t f) =
      L.gibbsHeatBathSpectralSemigroup t
        (L.gibbsHilbertEmbedLinearMap f) := by
  rw [finite_lattice_gibbsObservableHeatBathSpectralSemigroup_apply,
    finite_lattice_gibbsHilbert_embed_observe]

/-- Decoding a Gibbs-Hilbert state after spectral evolution is the same as
applying the concrete observable heat-bath evolution to its decoded observable. -/
@[simp] theorem
    finite_lattice_gibbsObservableHeatBathSpectralSemigroup_observe
    (L : FiniteLatticeWilsonSystem)
    (t : NNReal)
    (x : L.GibbsHilbertSpace) :
    L.gibbsObservableHeatBathSpectralSemigroup t
        (L.gibbsHilbertObserveLinearMap x) =
      L.gibbsHilbertObserveLinearMap
        (L.gibbsHeatBathSpectralSemigroup t x) := by
  rw [finite_lattice_gibbsObservableHeatBathSpectralSemigroup_apply,
    finite_lattice_gibbsHilbert_embed_observe]

/-- Decoding the concrete Gibbs-Hilbert Hamiltonian gives exactly the observable
heat-bath Hamiltonian `sum_e (I - P_e)`. -/
@[simp] theorem finite_lattice_gibbsHeatBathHamiltonian_observe
    (L : FiniteLatticeWilsonSystem)
    (x : L.GibbsHilbertSpace) :
    L.gibbsHilbertObserveLinearMap
        (L.gibbsHeatBathHamiltonianLinearMap x) =
      L.singleLinkHeatBathHamiltonianObservable
        (L.gibbsHilbertObserveLinearMap x) := by
  rw [finite_lattice_gibbsHeatBathHamiltonianLinearMap_apply,
    finite_lattice_gibbsHilbert_observe_embed]

/-- Gibbs embedding intertwines the observable heat-bath Hamiltonian with the
canonical Gibbs-Hilbert Hamiltonian. -/
@[simp] theorem finite_lattice_gibbsHeatBathHamiltonianObservable_embed
    (L : FiniteLatticeWilsonSystem)
    (f : L.Configuration → ℝ) :
    L.gibbsHilbertEmbedLinearMap
        (L.singleLinkHeatBathHamiltonianObservable f) =
      L.gibbsHeatBathHamiltonianLinearMap
        (L.gibbsHilbertEmbedLinearMap f) := by
  symm
  rw [finite_lattice_gibbsHeatBathHamiltonianLinearMap_apply,
    finite_lattice_gibbsHilbert_observe_embed]

/-- The concrete Gibbs-Hilbert heat-bath spectral semigroup has right
Hamiltonian derivative equal to the actual heat-bath Hamiltonian on every
finite Gibbs state. -/
theorem finite_lattice_gibbsHeatBathSpectralSemigroup_differenceQuotient_tendsto
    (L : FiniteLatticeWilsonSystem)
    (x : L.GibbsHilbertSpace) :
    Tendsto
      (fun t : NNReal =>
        (t : ℝ)⁻¹ •
          (x - L.gibbsHeatBathSpectralSemigroup t x))
      (nhdsWithin 0 (Ioi 0))
      (nhds (L.gibbsHeatBathHamiltonianLinearMap x)) := by
  simpa [FiniteLatticeWilsonSystem.gibbsHeatBathSpectralSemigroup] using
    (finiteDimensionalSymmetricHamiltonianSpectralSemigroup_differenceQuotient_tendsto
      L.gibbsHeatBathHamiltonianLinearMap
      (finite_lattice_gibbsHeatBathHamiltonianLinearMap_isSymmetric L)
      (Module.finrank ℝ L.GibbsHilbertSpace)
      rfl
      x)

/-- Embedding the observable difference quotient gives exactly the
Gibbs-Hilbert difference quotient. -/
theorem
    finite_lattice_gibbsObservableHeatBathSpectralSemigroup_differenceQuotient_embed
    (L : FiniteLatticeWilsonSystem)
    (f : L.Configuration → ℝ)
    (t : NNReal) :
    L.gibbsHilbertEmbedLinearMap
        ((t : ℝ)⁻¹ •
          (f - L.gibbsObservableHeatBathSpectralSemigroup t f)) =
      (t : ℝ)⁻¹ •
        (L.gibbsHilbertEmbedLinearMap f -
          L.gibbsHeatBathSpectralSemigroup t
            (L.gibbsHilbertEmbedLinearMap f)) := by
  rw [map_smul, map_sub,
    finite_lattice_gibbsObservableHeatBathSpectralSemigroup_embed]

/-- The actual finite Gibbs observable evolution has right Hamiltonian
difference quotient converging, after the canonical Gibbs embedding, to the
explicit observable heat-bath Hamiltonian `sum_e (I - P_e)`. -/
theorem
    finite_lattice_gibbsObservableHeatBathSpectralSemigroup_differenceQuotient_tendsto
    (L : FiniteLatticeWilsonSystem)
    (f : L.Configuration → ℝ) :
    Tendsto
      (fun t : NNReal =>
        L.gibbsHilbertEmbedLinearMap
          ((t : ℝ)⁻¹ •
            (f - L.gibbsObservableHeatBathSpectralSemigroup t f)))
      (nhdsWithin 0 (Ioi 0))
      (nhds
        (L.gibbsHilbertEmbedLinearMap
          (L.singleLinkHeatBathHamiltonianObservable f))) := by
  rw [finite_lattice_gibbsHeatBathHamiltonianObservable_embed]
  apply
    (finite_lattice_gibbsHeatBathSpectralSemigroup_differenceQuotient_tendsto
      L (L.gibbsHilbertEmbedLinearMap f)).congr'
  exact Filter.Eventually.of_forall fun t =>
    (finite_lattice_gibbsObservableHeatBathSpectralSemigroup_differenceQuotient_embed
      L f t).symm

/-- On every canonical Gibbs-Hilbert Hamiltonian eigenvector, the decoded
finite Wilson observable evolves with the expected exponential energy factor. -/
@[simp] theorem
    finite_lattice_gibbsObservableHeatBathSpectralSemigroup_apply_observed_eigenvector
    (L : FiniteLatticeWilsonSystem)
    (t : NNReal)
    (i : Fin (Module.finrank ℝ L.GibbsHilbertSpace)) :
    L.gibbsObservableHeatBathSpectralSemigroup t
        (L.gibbsHilbertObserveLinearMap
          ((finite_lattice_gibbsHeatBathHamiltonianLinearMap_isSymmetric L).eigenvectorBasis
            rfl i)) =
      Real.exp
          (-((finite_lattice_gibbsHeatBathHamiltonianLinearMap_isSymmetric L).eigenvalues
              rfl i) * (t : ℝ)) •
        L.gibbsHilbertObserveLinearMap
          ((finite_lattice_gibbsHeatBathHamiltonianLinearMap_isSymmetric L).eigenvectorBasis
            rfl i) := by
  rw [finite_lattice_gibbsObservableHeatBathSpectralSemigroup_observe]
  rw [FiniteLatticeWilsonSystem.gibbsHeatBathSpectralSemigroup,
    finiteDimensionalSymmetricHamiltonianSpectralSemigroup_apply_eigenvectorBasis,
    map_smul]

end

end MathlibAnalytic
end MGAP4D
