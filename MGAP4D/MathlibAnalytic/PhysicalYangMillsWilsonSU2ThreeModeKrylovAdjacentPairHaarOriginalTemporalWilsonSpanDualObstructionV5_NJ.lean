local notation "Gauge" => Matrix.specialUnitaryGroup (Fin 2) ℂ

/-- An exact genuine fixed-positive-beta SU(2) Wilson temporal
exponential section, regarded as a real continuous function in the
ACTUAL link variable g. No additional probability measure. -/
noncomputable def p4Q2NJ_originalSU2WilsonTemporalSection
    (b : ℝ) (x : Gauge) : C(Gauge,ℝ) := by
  have hShift : Continuous (fun g : Gauge => x⁻¹ * g) :=
    continuous_const.mul continuous_id
  have hChar : Continuous
      (fun g : Gauge => p4Q2NG_originalSU2TemporalCharacter x g) := by
    unfold p4Q2NG_originalSU2TemporalCharacter
    exact continuous_const.sub
      ((continuous_specialUnitaryWilsonPlaquetteEnergy 2).comp hShift)
  exact ⟨fun g => Real.exp (b * p4Q2NG_originalSU2TemporalCharacter x g),
    Real.continuous_exp.comp (continuous_const.mul hChar)⟩

section GenuineSignedContinuousDual
variable (H : ℕ) (b : ℝ) (hb : 0 ≤ b)
local notation "Cfg" =>
  PeriodicHypercubicEvenSpecialUnitarySpatialSliceConfiguration H 2
local notation "Link" => PeriodicHypercubicEvenSpatialSliceLink H
local notation "mu" => normalizedCompactHaar Gauge
local notation "rho" => p4Q2NG_originalSpatialPerronSignedContrast H b hb
local notation "q" => p4Q2NC_originalSignedReceiverLinkScore H b hb
local notation "T" => p4Q2NG_originalTemporalSU2CharacterMoment H b hb
local notation "Q" => p4Q2NC_originalSignedReceiverLinkHaarVariance H b hb
local notation "Delta" => p4Q2NH_originalFundamentalMomentDeterminant H b hb
include hb

private theorem p4Q2NJ_originalSignedPairing_integrable
    (e : Link) (z : Cfg × Cfg) (f : C(Gauge,ℝ)) :
    Integrable (fun g : Gauge => f g * rho e z g) mu :=
  (f.continuous.mul
    (p4Q2NI_originalSpatialPerronSignedContrast_continuous H b hb e z)).
    integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)

/-- The actual original Wilson–Perron signed integral, as a real
LINEAR map on the real Banach algebra C(SU2,R). -/
noncomputable def p4Q2NJ_originalSignedHaarIntegralLinear
    (e : Link) (z : Cfg × Cfg) : C(Gauge,ℝ) →ₗ[ℝ] ℝ where
  toFun := fun f => ∫ g : Gauge, f g * rho e z g ∂mu
  map_add' f h := by
    change
      (∫ g : Gauge, (f g + h g) * rho e z g ∂mu) =
        (∫ g : Gauge, f g * rho e z g ∂mu) +
          (∫ g : Gauge, h g * rho e z g ∂mu)
    simp_rw [add_mul]
    exact integral_add
      (p4Q2NJ_originalSignedPairing_integrable H b hb e z f)
      (p4Q2NJ_originalSignedPairing_integrable H b hb e z h)
  map_smul' a f := by
    change
      (∫ g : Gauge, (a * f g) * rho e z g ∂mu) =
        a * (∫ g : Gauge, f g * rho e z g ∂mu)
    simp_rw [mul_assoc]
    exact integral_const_mul _ _

/-- Actual original signed integral as a BOUNDED real-linear functional.
Its norm is controlled by the true continuous rho sup norm, not by
a synthetic Haar posterior or any invented physical rank. -/
noncomputable def p4Q2NJ_originalSignedHaarIntegralCLM
    (e : Link) (z : Cfg × Cfg) : C(Gauge,ℝ) →L[ℝ] ℝ := by
  let rhoC : C(Gauge,ℝ) :=
    ⟨rho e z,
      p4Q2NI_originalSpatialPerronSignedContrast_continuous H b hb e z⟩
  apply LinearMap.mkContinuous
    (𝕜 := ℝ) (𝕜₂ := ℝ) (E := C(Gauge,ℝ)) (F := ℝ)
    (σ := RingHom.id ℝ)
    (p4Q2NJ_originalSignedHaarIntegralLinear H b hb e z)
    ‖rhoC‖
  intro f
  change
    ‖∫ g : Gauge, f g * rho e z g ∂mu‖ ≤ ‖rhoC‖ * ‖f‖
  have hPoint (g : Gauge) :
      ‖f g * rho e z g‖ ≤ ‖rhoC‖ * ‖f‖ := by
    change ‖f g * rhoC g‖ ≤ ‖rhoC‖ * ‖f‖
    rw [norm_mul]
    calc
      ‖f g‖ * ‖rhoC g‖ ≤ ‖f‖ * ‖rhoC‖ :=
        mul_le_mul (f.norm_coe_le_norm g) (rhoC.norm_coe_le_norm g)
          (norm_nonneg _) (norm_nonneg _)
      _ = ‖rhoC‖ * ‖f‖ := mul_comm _ _
  exact norm_integral_le_of_norm_le_const
    (μ := mu) (C := ‖rhoC‖ * ‖f‖)
    (f := fun g : Gauge => f g * rho e z g)
    (ae_of_all _ hPoint)

/-- The EXACT original signed Haar functional minus point evaluation
at an ACTUAL boundary link y, with arbitrary real coefficient c. -/
noncomputable def p4Q2NJ_originalSignedDiracDefectCLM
    (e : Link) (z : Cfg × Cfg) (y : Gauge) (c : ℝ) :
    C(Gauge,ℝ) →L[ℝ] ℝ :=
  p4Q2NJ_originalSignedHaarIntegralCLM H b hb e z -
    c • ContinuousMap.evalCLM ℝ y

theorem p4Q2NJ_originalSignedDiracDefectCLM_apply
    (e : Link) (z : Cfg × Cfg) (y : Gauge)
    (c : ℝ) (f : C(Gauge,ℝ)) :
    p4Q2NJ_originalSignedDiracDefectCLM H b hb e z y c f =
      (∫ g : Gauge, f g * rho e z g ∂mu) - c * f y := by
  rfl

/-- NI's explicit genuine Wilson–Perron signed lobe witness makes
the actual Dirac-defect continuous linear functional NONZERO
for every positive beta and every c,y, without any injectivity axiom. -/
theorem p4Q2NJ_originalSignedDiracDefectCLM_ne_zero
    (bpos : 0 < b) (e : Link) (z : Cfg × Cfg)
    (y : Gauge) (c : ℝ) :
    p4Q2NJ_originalSignedDiracDefectCLM H b hb e z y c ≠ 0 := by
  obtain ⟨f,hf⟩ :=
    p4Q2NI_originalSpatialPerronSignedContrast_not_pointEvaluation
      H b hb bpos e z y c
  intro hZero
  have hValue :
      p4Q2NJ_originalSignedDiracDefectCLM H b hb e z y c f = 0 := by
    rw [hZero]
    simp
  rw [p4Q2NJ_originalSignedDiracDefectCLM_apply] at hValue
  exact hf (sub_eq_zero.mp hValue)

/-- The original fixed-coupling Wilson temporal exponential section
is tested ONLY by the already-existing genuine two-posterior rho.
Its result is the exact original NG character moment, not a proxy. -/
theorem p4Q2NJ_originalSignedDiracDefect_kernelSection_eq_momentDefect
    (e : Link) (z : Cfg × Cfg) (x : Gauge) :
    p4Q2NJ_originalSignedDiracDefectCLM H b hb e z (z.2 e) (q e z 1)
        (p4Q2NJ_originalSU2WilsonTemporalSection b x) =
      T e z x -
        Real.exp (b * p4Q2NG_originalSU2TemporalCharacter x (z.2 e)) *
          q e z 1 := by
  rw [p4Q2NJ_originalSignedDiracDefectCLM_apply]
  change
    (∫ g : Gauge,
      Real.exp (b * p4Q2NG_originalSU2TemporalCharacter x g) *
        rho e z g ∂mu) -
      q e z 1 * Real.exp
        (b * p4Q2NG_originalSU2TemporalCharacter x (z.2 e)) = _
  unfold p4Q2NG_originalTemporalSU2CharacterMoment
  ring

/-- Genuine positive Haar signed receiver score fluctuation is
EQUIVALENT to an actual Wilson temporal kernel section detecting
the nonzero original signed Dirac-defect continuous functional. -/
theorem p4Q2NJ_originalSignedReceiverHaarVariance_pos_iff_sectionWitness
    (e : Link) (z : Cfg × Cfg) :
    0 < Q e z ↔
      ∃ x : Gauge,
        p4Q2NJ_originalSignedDiracDefectCLM H b hb e z
            (z.2 e) (q e z 1)
          (p4Q2NJ_originalSU2WilsonTemporalSection b x) ≠ 0 := by
  rw [p4Q2NG_originalSignedScoreHaarVariance_pos_iff_characterMoment_witness
    H b hb e z]
  apply exists_congr
  intro x
  rw [p4Q2NJ_originalSignedDiracDefect_kernelSection_eq_momentDefect
    H b hb e z x]
  exact sub_ne_zero

/-- MAIN NJ UNCONDITIONAL OBSTRUCTION.

For EVERY beta>0 and every genuine finite-volume H,e,z,
if the original interacting-Wilson signed one-link score has ZERO
Haar variance, then the *real linear span* of its exact original
SU(2) Wilson temporal kernel sections is NOT DENSE in C(SU2,R).

There is NO unproved density assumption anywhere in this theorem.
The argument uses NI's genuine signed-lobe nonzero functional and
mathlib's extension of equality of continuous linear maps from a
dense linear span. The open task is the analytic verification that
the fixed-b Wilson kernel sections DO have dense linear span. -/
theorem p4Q2NJ_originalSignedReceiverHaarVariance_zero_forces_kernelSpan_nondense
    (bpos : 0 < b) (e : Link) (z : Cfg × Cfg)
    (hZero : Q e z = 0) :
    ¬ Dense
      (↑(Submodule.span ℝ
          (Set.range (p4Q2NJ_originalSU2WilsonTemporalSection b)))
        : Set C(Gauge,ℝ)) := by
  let L : C(Gauge,ℝ) →L[ℝ] ℝ :=
    p4Q2NJ_originalSignedDiracDefectCLM H b hb e z
      (z.2 e) (q e z 1)
  have hLne : L ≠ 0 :=
    p4Q2NJ_originalSignedDiracDefectCLM_ne_zero H b hb
      bpos e z (z.2 e) (q e z 1)
  have hMom :=
    (p4Q2NG_originalSignedScoreHaarVariance_zero_iff_characterMoment_proportional
      H b hb e z).1 hZero
  have hVan (x : Gauge) :
      L (p4Q2NJ_originalSU2WilsonTemporalSection b x) = 0 := by
    change
      p4Q2NJ_originalSignedDiracDefectCLM H b hb e z
        (z.2 e) (q e z 1)
        (p4Q2NJ_originalSU2WilsonTemporalSection b x) = 0
    rw [p4Q2NJ_originalSignedDiracDefect_kernelSection_eq_momentDefect
      H b hb e z x, hMom x]
    ring
  intro hDense
  have hAgree : Set.EqOn (⇑L) (⇑(0 : C(Gauge,ℝ) →L[ℝ] ℝ))
      (Set.range (p4Q2NJ_originalSU2WilsonTemporalSection b)) := by
    rintro f ⟨x,rfl⟩
    simpa using hVan x
  have hLzero : L = 0 := ContinuousLinearMap.ext_on hDense hAgree
  exact hLne hLzero

/-- No false positivity assumption: IF one eventually establishes
density of the genuine fixed-positive-beta SU(2) Wilson temporal
kernel-section LINEAR SPAN (stronger than Stone-Weierstrass algebra
density), NJ + NI + NC force strict genuine signed score variance.

The density premise is explicitly UNSOLVED and this conditional
result is NOT counted as an unconditional mass-gap or GI theorem. -/
theorem p4Q2NJ_originalSignedReceiverHaarVariance_pos_of_kernelSpan_dense
    (bpos : 0 < b) (e : Link) (z : Cfg × Cfg)
    (hDense : Dense
      (↑(Submodule.span ℝ
          (Set.range (p4Q2NJ_originalSU2WilsonTemporalSection b)))
        : Set C(Gauge,ℝ))) :
    0 < Q e z := by
  by_contra hNot
  have hZero : Q e z = 0 := by
    have hLe : Q e z ≤ 0 := le_of_not_gt hNot
    exact le_antisymm hLe
      (p4Q2NC_originalSignedReceiverLinkHaarVariance_nonneg H b hb e z)
  exact
    (p4Q2NJ_originalSignedReceiverHaarVariance_zero_forces_kernelSpan_nondense
      H b hb bpos e z hZero) hDense

