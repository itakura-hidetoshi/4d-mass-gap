/-!
# P4-Q2-KK — Stone–Weierstrass density of genuine SU(2) matrix feature coordinates

KJ proves that the actual matrix-realification feature
  Phi : SU(2) → EuclideanSpace ℝ ((Fin 2 × Fin 2) × Bool)
is injective, with no synthetic detector or rank assumptions.

Here we bundle each of its eight explicit real/imaginary matrix-entry
coordinates as a continuous real function on the genuine SU(2) compact
group. The real subalgebra of C(SU(2),ℝ) generated by these very
coordinate functions separates distinct genuine SU(2) group elements.
The FIXED mathlib Stone–Weierstrass theorem gives its full uniform
density in C(SU(2),ℝ), including the explicit arbitrarily-good
continuous-function approximation receipt.

This is the polynomial test-family completeness step needed for a
future exponential-kernel integral-transform injectivity proof.
It does NOT assert that integral-transform injectivity is already
proved, nor does it infer any physical GI second-context witness.
No independent Haar posterior, synthetic physical source, artificial
rank, sorry/axiom, H1-C3 or continuum mass-gap claim.
-/

namespace MGAP4D
namespace MathlibAnalytic
open MeasureTheory
open scoped ENNReal Topology InnerProductSpace
noncomputable section
set_option maxHeartbeats 3900000
set_option synthInstance.maxHeartbeats 1050000

local instance p4Q2KK_topologicalGroup :
    IsTopologicalGroup (Matrix.specialUnitaryGroup (Fin 2) ℂ) :=
  specialUnitaryGroupIsTopologicalGroup 2
local instance p4Q2KK_compactSpace :
    CompactSpace (Matrix.specialUnitaryGroup (Fin 2) ℂ) :=
  specialUnitaryGroupCompactSpace 2
local instance p4Q2KK_secondCountable :
    SecondCountableTopology (Matrix.specialUnitaryGroup (Fin 2) ℂ) :=
  specialUnitaryGroupSecondCountableTopology 2
local instance p4Q2KK_measurableSpace :
    MeasurableSpace (Matrix.specialUnitaryGroup (Fin 2) ℂ) :=
  specialUnitaryGroupMeasurableSpace 2
local instance p4Q2KK_borelSpace :
    BorelSpace (Matrix.specialUnitaryGroup (Fin 2) ℂ) :=
  specialUnitaryGroupBorelSpace 2

namespace GroundStatePosteriorJoint
section SU2
local notation "Gauge" => Matrix.specialUnitaryGroup (Fin 2) ℂ
local notation "Coord" => ((Fin 2 × Fin 2) × Bool)

/-- A genuine finite-dimensional real matrix entry coordinate of
the SU(2) defining representation, with its actual topology. -/
noncomputable def p4Q2KK_originalSU2MatrixRealCoordinate (q : Coord) :
    C(Gauge, ℝ) := by
  refine ⟨(fun U : Gauge => specialUnitaryMatrixRealFeature 2 U q), ?_⟩
  change Continuous (fun U : Gauge =>
    if q.2 then
      ((U : Matrix (Fin 2) (Fin 2) ℂ) q.1.2 q.1.1).re
    else
      ((U : Matrix (Fin 2) (Fin 2) ℂ) q.1.2 q.1.1).im)
  by_cases hq : q.2
  · simp only [hq, ite_true]
    fun_prop
  · simp only [hq, ite_false]
    fun_prop

/-- The continuous physical SU(2) real/imaginary coordinate is precisely
evaluation of the same KJ theorem-generated injective Hilbert feature. -/
@[simp] theorem p4Q2KK_originalSU2MatrixRealCoordinate_apply
    (q : Coord) (g : Gauge) :
    p4Q2KK_originalSU2MatrixRealCoordinate q g =
      specialUnitaryMatrixRealFeature 2 g q := by
  rfl

/-- The real algebra generated by the EIGHT physical matrix-entry
coordinates of the original SU(2) defining representation. -/
noncomputable def p4Q2KK_originalSU2MatrixCoordinateAlgebra :
    Subalgebra ℝ C(Gauge, ℝ) :=
  Algebra.adjoin ℝ (Set.range p4Q2KK_originalSU2MatrixRealCoordinate)

/-- This generated real function algebra genuinely separates ANY two
distinct SU(2) elements, because all complex entries can be recovered
from the real/imaginary feature coordinate family (proved in KJ). -/
theorem p4Q2KK_originalSU2MatrixCoordinateAlgebra_separatesPoints :
    p4Q2KK_originalSU2MatrixCoordinateAlgebra.SeparatesPoints := by
  intro g h hne
  have hPhi :
      specialUnitaryMatrixRealFeature 2 g ≠ specialUnitaryMatrixRealFeature 2 h := by
    intro heq
    exact hne (p4Q2KJ_specialUnitaryMatrixRealFeature_injective 2 heq)
  have hCoord : ∃ q : Coord,
      specialUnitaryMatrixRealFeature 2 g q ≠
        specialUnitaryMatrixRealFeature 2 h q := by
    by_contra hn
    push Not at hn
    apply hPhi
    ext q
    exact hn q
  obtain ⟨q, hq⟩ := hCoord
  refine ⟨(p4Q2KK_originalSU2MatrixRealCoordinate q : Gauge → ℝ), ?_, ?_⟩
  · refine ⟨p4Q2KK_originalSU2MatrixRealCoordinate q, ?_, rfl⟩
    change p4Q2KK_originalSU2MatrixRealCoordinate q ∈
      Algebra.adjoin ℝ (Set.range p4Q2KK_originalSU2MatrixRealCoordinate)
    exact Algebra.mem_adjoin_of_mem (Set.mem_range_self q)
  · simpa only [p4Q2KK_originalSU2MatrixRealCoordinate_apply] using hq

/-- FIXED mathlib Stone–Weierstrass identifies the completed physical
SU(2) coordinate polynomial algebra with the full real C(SU(2)).
No new density axiom is inserted. -/
theorem p4Q2KK_originalSU2MatrixCoordinateAlgebra_closure_eq_top :
    p4Q2KK_originalSU2MatrixCoordinateAlgebra.topologicalClosure = ⊤ :=
  ContinuousMap.subalgebra_topologicalClosure_eq_top_of_separatesPoints
    p4Q2KK_originalSU2MatrixCoordinateAlgebra
    p4Q2KK_originalSU2MatrixCoordinateAlgebra_separatesPoints

/-- Explicit uniform approximation of every true SU(2) continuous
test observable by polynomials in its eight physical real matrix
coordinates, with any strictly positive tolerance. -/
theorem p4Q2KK_originalSU2MatrixCoordinatePolynomial_approximate
    (f : C(Gauge, ℝ)) (ε : ℝ) (hε : 0 < ε) :
    ∃ g : p4Q2KK_originalSU2MatrixCoordinateAlgebra,
      ‖(g : C(Gauge, ℝ)) - f‖ < ε :=
  ContinuousMap.exists_mem_subalgebra_near_continuousMap_of_separatesPoints
    p4Q2KK_originalSU2MatrixCoordinateAlgebra
    p4Q2KK_originalSU2MatrixCoordinateAlgebra_separatesPoints f ε hε

end SU2
end GroundStatePosteriorJoint
end
