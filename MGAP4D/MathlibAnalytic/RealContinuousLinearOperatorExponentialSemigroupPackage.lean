import MGAP4D.MathlibAnalytic.ContinuousRealLinearOperatorExpEigenvector
import Mathlib.Analysis.SpecialFunctions.Exponential

namespace MGAP4D
namespace MathlibAnalytic

noncomputable section

/-- The canonical operator-exponential one-parameter family generated by a
bounded continuous real-linear operator. -/
noncomputable def realContinuousLinearOperatorExponentialSemigroup
    {E : Type*}
    [NormedAddCommGroup E]
    [NormedSpace ℝ E]
    [CompleteSpace E]
    (G : E →L[ℝ] E)
    (t : ℝ) : E →L[ℝ] E :=
  NormedSpace.exp (t • G)

@[simp] theorem realContinuousLinearOperatorExponentialSemigroup_zero
    {E : Type*}
    [NormedAddCommGroup E]
    [NormedSpace ℝ E]
    [CompleteSpace E]
    (G : E →L[ℝ] E) :
    realContinuousLinearOperatorExponentialSemigroup G 0 = 1 := by
  simp [realContinuousLinearOperatorExponentialSemigroup]

/-- The bounded exponential family satisfies the exact additive semigroup
law for all real times. -/
theorem realContinuousLinearOperatorExponentialSemigroup_add
    {E : Type*}
    [NormedAddCommGroup E]
    [NormedSpace ℝ E]
    [CompleteSpace E]
    (G : E →L[ℝ] E)
    (s t : ℝ) :
    realContinuousLinearOperatorExponentialSemigroup G (s + t) =
      realContinuousLinearOperatorExponentialSemigroup G s *
        realContinuousLinearOperatorExponentialSemigroup G t := by
  unfold realContinuousLinearOperatorExponentialSemigroup
  rw [add_smul]
  exact NormedSpace.exp_add_of_commute (𝕂 := ℝ)
    (((Commute.refl G).smul_left s).smul_right t)

/-- The exponential family is continuous in operator norm. -/
theorem continuous_realContinuousLinearOperatorExponentialSemigroup
    {E : Type*}
    [NormedAddCommGroup E]
    [NormedSpace ℝ E]
    [CompleteSpace E]
    (G : E →L[ℝ] E) :
    Continuous (realContinuousLinearOperatorExponentialSemigroup G) := by
  exact (NormedSpace.differentiable_exp_smul_const ℝ G).continuous

/-- The operator-norm derivative of the exponential family is multiplication
by its bounded generator. -/
theorem realContinuousLinearOperatorExponentialSemigroup_hasDerivAt
    {E : Type*}
    [NormedAddCommGroup E]
    [NormedSpace ℝ E]
    [CompleteSpace E]
    (G : E →L[ℝ] E)
    (t : ℝ) :
    HasDerivAt
      (realContinuousLinearOperatorExponentialSemigroup G)
      (realContinuousLinearOperatorExponentialSemigroup G t * G) t := by
  simpa [realContinuousLinearOperatorExponentialSemigroup] using
    (hasDerivAt_exp_smul_const G t)

/-- The strong derivative on every state is the generator action transported
by the exponential time slice. -/
theorem realContinuousLinearOperatorExponentialSemigroup_hasDerivAt_apply
    {E : Type*}
    [NormedAddCommGroup E]
    [NormedSpace ℝ E]
    [CompleteSpace E]
    (G : E →L[ℝ] E)
    (t : ℝ)
    (x : E) :
    HasDerivAt
      (fun u : ℝ => realContinuousLinearOperatorExponentialSemigroup G u x)
      ((realContinuousLinearOperatorExponentialSemigroup G t * G) x) t := by
  have h :=
    (realContinuousLinearOperatorExponentialSemigroup_hasDerivAt G t).clm_apply
      (hasDerivAt_const t x)
  simpa using h

/-- An eigenvector evolves by the scalar exponential of its generator
eigenvalue. -/
theorem realContinuousLinearOperatorExponentialSemigroup_apply_eigenvector
    {E : Type*}
    [NormedAddCommGroup E]
    [NormedSpace ℝ E]
    [CompleteSpace E]
    (G : E →L[ℝ] E)
    (v : E)
    (a t : ℝ)
    (hGv : G v = a • v) :
    realContinuousLinearOperatorExponentialSemigroup G t v =
      Real.exp (t * a) • v := by
  unfold realContinuousLinearOperatorExponentialSemigroup
  apply normedSpace_exp_apply_of_real_eigenvector
  rw [ContinuousLinearMap.smul_apply, hGv, smul_smul]

end

end MathlibAnalytic
end MGAP4D
