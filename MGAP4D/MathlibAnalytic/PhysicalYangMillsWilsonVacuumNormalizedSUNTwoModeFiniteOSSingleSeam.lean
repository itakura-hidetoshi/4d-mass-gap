import MGAP4D.MathlibAnalytic.PeriodicHypercubicEvenSpecialUnitaryPhysicalPairIndependentGaugeFixedEquality
import MGAP4D.MathlibAnalytic.PhysicalYangMillsWilsonSUNTwoModeFiniteOSVacuumPairFixedSeam
import Mathlib.Tactic

/-!
# Vacuum-normalized SU(N) two-mode H1-D6 reduction to the single H1-D5 seam

H1-D4 is now theorem-generated: the canonical-sign vacuum-normalized explicit
OS vacuum pair belongs to the completed physical pair carrier with no external
compatibility witness.

Therefore the old two-input H1-D6 route

* physical-pair carrier membership;
* completed-transfer compatibility;

reduces to the second item alone.

This file records that reduction at the actual canonical-sign
`Q.vacuumNormalized` model:

* the finite OS vacuum-pair carrier package is automatic;
* one-vector completed-transfer compatibility alone implies pair-top alignment;
* hence the explicit centered SU(N) two-mode vectors obey the already-proved
  uniform `q0^m` decay.

No new transfer compatibility is assumed beyond the single H1-D5 statement
already isolated in #5016.
-/

namespace MGAP4D
namespace MathlibAnalytic

open MeasureTheory
open scoped InnerProductSpace InnerProduct

noncomputable section

local instance vacuumNormalizedSingleSeamTopologicalGroup (N : ℕ) :
    IsTopologicalGroup (Matrix.specialUnitaryGroup (Fin N) ℂ) :=
  specialUnitaryGroupIsTopologicalGroup N

local instance vacuumNormalizedSingleSeamCompactSpace (N : ℕ) :
    CompactSpace (Matrix.specialUnitaryGroup (Fin N) ℂ) :=
  specialUnitaryGroupCompactSpace N

local instance vacuumNormalizedSingleSeamSecondCountable (N : ℕ) :
    SecondCountableTopology (Matrix.specialUnitaryGroup (Fin N) ℂ) :=
  specialUnitaryGroupSecondCountableTopology N

local instance vacuumNormalizedSingleSeamMeasurableSpace (N : ℕ) :
    MeasurableSpace (Matrix.specialUnitaryGroup (Fin N) ℂ) :=
  specialUnitaryGroupMeasurableSpace N

local instance vacuumNormalizedSingleSeamBorelSpace (N : ℕ) :
    BorelSpace (Matrix.specialUnitaryGroup (Fin N) ℂ) :=
  specialUnitaryGroupBorelSpace N

local instance vacuumNormalizedSingleSeamSpatialLinkFintype (H : ℕ) :
    Fintype (PeriodicHypercubicEvenSpatialSliceLink H) :=
  Fintype.ofFinite _

section VacuumNormalizedSingleSeam

variable
    {S : PhysicalFourDimensionalYangMillsSymmetryLimit}
    {D : PhysicalYangMillsGaugeInvariantOSReflectionData S}
    {halfExtent : ℕ → ℕ}
    {N : ℕ} {hN : 0 < N}
    [Nontrivial (Matrix.specialUnitaryGroup (Fin N) ℂ)]
    {beta : ℕ → ℝ} {hbeta : ∀ n, 0 ≤ beta n}
    (Q : PhysicalYangMillsEvenPeriodicWilsonOSCoherentPositiveTimePullback
      S D halfExtent N hN beta hbeta)
    (hInvariant : ∀ n,
      D.WeakStarReflectionInvariant
        (physicalYangMillsApproximatingGaugeInvariantWeakStarState S n))

/-- After H1-D4, canonical-sign vacuum-normalized finite OS vacuum-pair carrier
membership is automatic at every scale. -/
theorem
    physicalYangMillsVacuumNormalizedSUNTwoModeExplicitOSVacuumPairPhysicalCarrier :
    PhysicalYangMillsSUNTwoModeExplicitOSVacuumPairPhysicalCarrier
      (S := S) (D := D) (halfExtent := halfExtent)
      (N := N) (hN := hN)
      (beta := beta) (hbeta := hbeta)
      (Q := Q.vacuumNormalized) (hInvariant := hInvariant) := by
  intro n
  exact
    physicalYangMillsVacuumNormalizedSUNTwoModeExplicitOSVacuumBoundaryPairL2_mem_physicalPairCarrier
      Q hInvariant n

/-- H1-D6 now needs only the single H1-D5 one-vector completed-transfer seam:
carrier membership is theorem-generated by H1-D4. -/
theorem
    physicalYangMillsVacuumNormalizedSUNTwoModeExplicitOSVacuumPairTopAlignment_of_completedCompatibility
    (C : PhysicalYangMillsEvenPeriodicWilsonOSApproximatingSemigroupFamily
      S D halfExtent N hN beta hbeta
        Q.vacuumNormalized.toWeakStarBridge hInvariant)
    (hCompat :
      PhysicalYangMillsSUNTwoModeExplicitOSVacuumPairCompletedTransferCompatibility
        (S := S) (D := D) (halfExtent := halfExtent)
        (N := N) (hN := hN)
        (beta := beta) (hbeta := hbeta)
        (Q := Q.vacuumNormalized) (hInvariant := hInvariant) C) :
    PhysicalYangMillsSUNTwoModeExplicitOSVacuumPairTopAlignment
      (S := S) (D := D) (halfExtent := halfExtent)
      (N := N) (hN := hN)
      (beta := beta) (hbeta := hbeta)
      (Q := Q.vacuumNormalized) (hInvariant := hInvariant) := by
  exact
    physicalYangMillsSUNTwoModeExplicitOSVacuumPairTopAlignment_of_carrier_completedCompatibility
      C
      (physicalYangMillsVacuumNormalizedSUNTwoModeExplicitOSVacuumPairPhysicalCarrier
        Q hInvariant)
      hCompat

variable {hN2 : 2 ≤ N}

/-- Canonical-sign vacuum-normalized explicit centered SU(N) two-mode decay
from H1-D5 alone.  No separate pair-carrier compatibility remains. -/
theorem
    physicalYangMillsVacuumNormalizedSUNTwoModeExplicitCenteredBoundaryPairL2_pow_norm_le_uniform_q0_of_completedCompatibility
    (C : PhysicalYangMillsEvenPeriodicWilsonOSApproximatingSemigroupFamily
      S D halfExtent N hN beta hbeta
        Q.vacuumNormalized.toWeakStarBridge hInvariant)
    (hCompat :
      PhysicalYangMillsSUNTwoModeExplicitOSVacuumPairCompletedTransferCompatibility
        (S := S) (D := D) (halfExtent := halfExtent)
        (N := N) (hN := hN)
        (beta := beta) (hbeta := hbeta)
        (Q := Q.vacuumNormalized) (hInvariant := hInvariant) C)
    (s : ℝ) (hs : 8 < s)
    (hcut :
      ∀ n : ℕ,
        beta n ≤
          GroundStateSourceFixedPairEnergy.twoSidedTwelveSpatialUniformGapCutoff
            s hs)
    (k : Fin 2) (n m : ℕ) :
    ‖(periodicHypercubicEvenSpecialUnitaryNormalizedPhysicalPairTransferOperator
        (halfExtent n) N hN (beta n) (hbeta n) ^ m)
        (physicalYangMillsSUNTwoModeExplicitCenteredBoundaryPairL2
          (S := S) (D := D) (halfExtent := halfExtent)
          (N := N) (hN := hN) (hN2 := hN2)
          (beta := beta) (hbeta := hbeta)
          (Q := Q.vacuumNormalized) (hInvariant := hInvariant) k n)‖ ≤
      GroundStateSourceFixedPairEnergy.twoSidedTwelveSpatialUniformTopOrthogonalContractionFactor ^ m *
        ‖physicalYangMillsSUNTwoModeExplicitCenteredBoundaryPairL2
          (S := S) (D := D) (halfExtent := halfExtent)
          (N := N) (hN := hN) (hN2 := hN2)
          (beta := beta) (hbeta := hbeta)
          (Q := Q.vacuumNormalized) (hInvariant := hInvariant) k n‖ := by
  exact
    physicalYangMillsSUNTwoModeExplicitCenteredBoundaryPairL2_pow_norm_le_uniform_q0_of_vacuumCarrier_completedCompatibility
      C
      (physicalYangMillsVacuumNormalizedSUNTwoModeExplicitOSVacuumPairPhysicalCarrier
        Q hInvariant)
      hCompat s hs hcut k n m

/-- Audit-visible reduction of H1-D6 to the single remaining H1-D5 seam. -/
structure PhysicalYangMillsVacuumNormalizedSUNTwoModeFiniteOSSingleSeamPackage :
    Prop where
  carrier :
    PhysicalYangMillsSUNTwoModeExplicitOSVacuumPairPhysicalCarrier
      (S := S) (D := D) (halfExtent := halfExtent)
      (N := N) (hN := hN)
      (beta := beta) (hbeta := hbeta)
      (Q := Q.vacuumNormalized) (hInvariant := hInvariant)
  alignmentFromSingleSeam :
    ∀
      (C : PhysicalYangMillsEvenPeriodicWilsonOSApproximatingSemigroupFamily
        S D halfExtent N hN beta hbeta
          Q.vacuumNormalized.toWeakStarBridge hInvariant),
      PhysicalYangMillsSUNTwoModeExplicitOSVacuumPairCompletedTransferCompatibility
          (S := S) (D := D) (halfExtent := halfExtent)
          (N := N) (hN := hN)
          (beta := beta) (hbeta := hbeta)
          (Q := Q.vacuumNormalized) (hInvariant := hInvariant) C →
        PhysicalYangMillsSUNTwoModeExplicitOSVacuumPairTopAlignment
          (S := S) (D := D) (halfExtent := halfExtent)
          (N := N) (hN := hN)
          (beta := beta) (hbeta := hbeta)
          (Q := Q.vacuumNormalized) (hInvariant := hInvariant)

/-- Construct the single-seam H1-D6 reduction package. -/
theorem physicalYangMillsVacuumNormalizedSUNTwoModeFiniteOSSingleSeamPackage :
    PhysicalYangMillsVacuumNormalizedSUNTwoModeFiniteOSSingleSeamPackage
      (Q := Q) (hInvariant := hInvariant) :=
  { carrier :=
      physicalYangMillsVacuumNormalizedSUNTwoModeExplicitOSVacuumPairPhysicalCarrier
        Q hInvariant
    alignmentFromSingleSeam := fun C hCompat =>
      physicalYangMillsVacuumNormalizedSUNTwoModeExplicitOSVacuumPairTopAlignment_of_completedCompatibility
        Q hInvariant C hCompat }

end VacuumNormalizedSingleSeam

end

end MathlibAnalytic
end MGAP4D
