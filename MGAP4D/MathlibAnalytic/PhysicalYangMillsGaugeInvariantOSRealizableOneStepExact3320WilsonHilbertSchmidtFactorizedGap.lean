  A.toBoundaryL2FactorizedGapCertificate.toGeometricDirichletGapCertificate

/-- Finally recover the exact centered one-step OS contraction certificate and
all downstream discrete/floor-continuum mass-gap machinery. -/
noncomputable def toOneStepExact3320GapCertificate
    (A : PhysicalYangMillsEvenPeriodicWilsonOSRealizableOneStepExact3320WilsonHilbertSchmidtFactorizedGapCertificate
      S D halfExtent N hN beta hbeta Q E R hInvariant) :
    PhysicalYangMillsEvenPeriodicWilsonOSRealizableOneStepExact3320GapCertificate
      S D halfExtent N hN beta hbeta Q E R hInvariant :=
  A.toBoundaryL2FactorizedGapCertificate.toOneStepExact3320GapCertificate

