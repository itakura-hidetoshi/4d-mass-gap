import MGAP4D.MathlibAnalytic.Z2FiniteEvenFourTorusAllVolumeGaugeOrbitWitness
import MGAP4D.MathlibAnalytic.Z2FiniteEvenFourTorusStrictCouplingWitnessMinor
import MGAP4D.MathlibAnalytic.Z2FiniteEvenFourTorusUnfixedGaugeFullSpectralDecomposition
import Mathlib.Tactic

namespace MGAP4D
namespace MathlibAnalytic

noncomputable section

/-- Nonidentity of the actual invariant transfer forces an excited or null mode
at every finite side parameter. -/
theorem finiteEvenFourTorusZ2UnfixedGaugeExcitedOrNullSpectralIndex_allVolume_nonempty
    (H : ℕ)
    (β energyIdentity energyNontrivial : ℝ)
    (hβ : 0 ≤ β)
    (hEnergy : energyIdentity ≤ energyNontrivial) :
    Nonempty
        (FiniteEvenFourTorusZ2UnfixedGaugeExcitedSpectralIndex
          H β energyIdentity energyNontrivial hβ hEnergy) ∨
      Nonempty
        (FiniteEvenFourTorusZ2UnfixedGaugeNullSpectralIndex
          H β energyIdentity energyNontrivial hβ hEnergy) :=
  (finiteEvenFourTorusZ2UnfixedGaugeInvariantSpectralData
    H β energyIdentity energyNontrivial hβ hEnergy).nonempty_excited_or_null_of_operator_ne_one
      (finiteEvenFourTorusZ2UnfixedGaugeInvariantOneSlabTransfer_allVolume_ne_identity
        H β energyIdentity energyNontrivial hβ hEnergy)

/-- Strict coupling makes the strictly excited sector inhabited at every finite
side parameter: all-volume nonidentity provides an excited-or-null direction,
and strict positive definiteness excludes the null alternative. -/
theorem finiteEvenFourTorusZ2UnfixedGaugeExcitedSpectralIndex_allVolume_nonempty_strict
    (H : ℕ)
    (β energyIdentity energyNontrivial : ℝ)
    (hβ : 0 < β)
    (hEnergy : energyIdentity < energyNontrivial) :
    Nonempty
      (FiniteEvenFourTorusZ2UnfixedGaugeExcitedSpectralIndex
        H β energyIdentity energyNontrivial hβ.le hEnergy.le) := by
  rcases
      finiteEvenFourTorusZ2UnfixedGaugeExcitedOrNullSpectralIndex_allVolume_nonempty
        H β energyIdentity energyNontrivial hβ.le hEnergy.le with hexc | hnull
  · exact hexc
  · exact False.elim
      (finiteEvenFourTorusZ2UnfixedGaugeNullSpectralIndex_not_nonempty_strict
        H β energyIdentity energyNontrivial hβ hEnergy hnull)

/-- The actual strict-coupling excitation gap at a specified finite side
parameter. -/
noncomputable def finiteEvenFourTorusZ2UnfixedGaugeStrictExcitationGapAt
    (H : ℕ)
    (β energyIdentity energyNontrivial : ℝ)
    (hβ : 0 < β)
    (hEnergy : energyIdentity < energyNontrivial) : ℝ := by
  letI : Nonempty
      (FiniteEvenFourTorusZ2UnfixedGaugeExcitedSpectralIndex
        H β energyIdentity energyNontrivial hβ.le hEnergy.le) :=
    finiteEvenFourTorusZ2UnfixedGaugeExcitedSpectralIndex_allVolume_nonempty_strict
      H β energyIdentity energyNontrivial hβ hEnergy
  exact finiteEvenFourTorusZ2UnfixedGaugeExcitationGap
    H β energyIdentity energyNontrivial hβ.le hEnergy.le

/-- Every finite member of the strict-coupling family has a positive excitation
gap.  The value may depend on the finite side parameter `H`. -/
theorem finiteEvenFourTorusZ2UnfixedGaugeStrictExcitationGapAt_pos
    (H : ℕ)
    (β energyIdentity energyNontrivial : ℝ)
    (hβ : 0 < β)
    (hEnergy : energyIdentity < energyNontrivial) :
    0 < finiteEvenFourTorusZ2UnfixedGaugeStrictExcitationGapAt
      H β energyIdentity energyNontrivial hβ hEnergy := by
  letI : Nonempty
      (FiniteEvenFourTorusZ2UnfixedGaugeExcitedSpectralIndex
        H β energyIdentity energyNontrivial hβ.le hEnergy.le) :=
    finiteEvenFourTorusZ2UnfixedGaugeExcitedSpectralIndex_allVolume_nonempty_strict
      H β energyIdentity energyNontrivial hβ hEnergy
  exact finiteEvenFourTorusZ2UnfixedGaugeExcitationGap_pos
    H β energyIdentity energyNontrivial hβ.le hEnergy.le

/-- Every strictly excited coordinate at arbitrary finite volume obeys the
exact exponential natural-time estimate generated by its own finite-volume
gap. -/
theorem finiteEvenFourTorusZ2UnfixedGaugeStrict_allVolume_excitedSemigroup_coordinate_abs_le_gap
    (H : ℕ)
    (β energyIdentity energyNontrivial : ℝ)
    (hβ : 0 < β)
    (hEnergy : energyIdentity < energyNontrivial)
    (n : ℕ)
    (x : FiniteEvenFourTorusZ2UnfixedGaugePositiveSpectralSpace
      H β energyIdentity energyNontrivial hβ.le hEnergy.le)
    (i : FiniteEvenFourTorusZ2UnfixedGaugeExcitedSpectralIndex
      H β energyIdentity energyNontrivial hβ.le hEnergy.le) :
    |finiteEvenFourTorusZ2UnfixedGaugePositiveSpectralSemigroup
        H β energyIdentity energyNontrivial hβ.le hEnergy.le n x i.toPositive| ≤
      (Real.exp
        (-finiteEvenFourTorusZ2UnfixedGaugeStrictExcitationGapAt
          H β energyIdentity energyNontrivial hβ hEnergy)) ^ n *
        |x i.toPositive| := by
  letI : Nonempty
      (FiniteEvenFourTorusZ2UnfixedGaugeExcitedSpectralIndex
        H β energyIdentity energyNontrivial hβ.le hEnergy.le) :=
    finiteEvenFourTorusZ2UnfixedGaugeExcitedSpectralIndex_allVolume_nonempty_strict
      H β energyIdentity energyNontrivial hβ hEnergy
  exact finiteEvenFourTorusZ2UnfixedGauge_excitedSemigroup_coordinate_abs_le_gap
    H β energyIdentity energyNontrivial hβ.le hEnergy.le n x i

/-- Every actual strict-coupling excited mode at arbitrary finite volume has a
finite strictly positive extended spectral energy. -/
theorem finiteEvenFourTorusZ2UnfixedGaugeStrict_allVolume_excited_extendedEnergy_finite_pos
    (H : ℕ)
    (β energyIdentity energyNontrivial : ℝ)
    (hβ : 0 < β)
    (hEnergy : energyIdentity < energyNontrivial)
    (i : FiniteEvenFourTorusZ2UnfixedGaugeExcitedSpectralIndex
      H β energyIdentity energyNontrivial hβ.le hEnergy.le) :
    finiteEvenFourTorusZ2UnfixedGaugeExtendedSpectralEnergy
        H β energyIdentity energyNontrivial hβ.le hEnergy.le i.1 =
      ExtendedSpectralEnergy.finite
        (finiteEvenFourTorusZ2UnfixedGaugePositiveSpectralEnergy
          H β energyIdentity energyNontrivial hβ.le hEnergy.le i.toPositive) ∧
    0 < finiteEvenFourTorusZ2UnfixedGaugePositiveSpectralEnergy
      H β energyIdentity energyNontrivial hβ.le hEnergy.le i.toPositive :=
  ⟨finiteEvenFourTorusZ2UnfixedGaugeExtendedSpectralEnergy_excited
      H β energyIdentity energyNontrivial hβ.le hEnergy.le i,
    finiteEvenFourTorusZ2UnfixedGaugeExtendedSpectralEnergy_excited_pos
      H β energyIdentity energyNontrivial hβ.le hEnergy.le i⟩

/-- Strict coupling removes all null coordinates from every state at every
finite side parameter. -/
theorem finiteEvenFourTorusZ2UnfixedGaugeStrict_allVolume_nullCoordinates_eq_zero
    (H : ℕ)
    (β energyIdentity energyNontrivial : ℝ)
    (hβ : 0 < β)
    (hEnergy : energyIdentity < energyNontrivial)
    (x : FiniteEvenFourTorusZ2GaugeInvariantSliceHilbert H) :
    finiteEvenFourTorusZ2UnfixedGaugeNullCoordinates
      H β energyIdentity energyNontrivial hβ.le hEnergy.le x = 0 := by
  ext i
  exact False.elim
    (finiteEvenFourTorusZ2UnfixedGaugeNullSpectralIndex_not_nonempty_strict
      H β energyIdentity energyNontrivial hβ hEnergy ⟨i⟩)

/-- Consequently every actual invariant state decomposes exactly into its
unique-ground and strictly-excited sectors, with no null summand. -/
theorem finiteEvenFourTorusZ2UnfixedGaugeStrict_allVolume_ground_add_excited
    (H : ℕ)
    (β energyIdentity energyNontrivial : ℝ)
    (hβ : 0 < β)
    (hEnergy : energyIdentity < energyNontrivial)
    (x : FiniteEvenFourTorusZ2GaugeInvariantSliceHilbert H) :
    finiteEvenFourTorusZ2UnfixedGaugeGroundSpectralSynthesis
        H β energyIdentity energyNontrivial hβ.le hEnergy.le
        (finiteEvenFourTorusZ2UnfixedGaugeGroundCoordinates
          H β energyIdentity energyNontrivial hβ.le hEnergy.le x) +
      finiteEvenFourTorusZ2UnfixedGaugeExcitedSpectralSynthesis
        H β energyIdentity energyNontrivial hβ.le hEnergy.le
        (finiteEvenFourTorusZ2UnfixedGaugeExcitedCoordinates
          H β energyIdentity energyNontrivial hβ.le hEnergy.le x) = x := by
  have hfull :=
    finiteEvenFourTorusZ2UnfixedGauge_ground_add_excited_add_null
      H β energyIdentity energyNontrivial hβ.le hEnergy.le x
  rw [finiteEvenFourTorusZ2UnfixedGaugeStrict_allVolume_nullCoordinates_eq_zero
      H β energyIdentity energyNontrivial hβ hEnergy x,
    map_zero, add_zero] at hfull
  exact hfull

/-- Injectivity gives a trivial transfer kernel at every finite volume in the
strict regime. -/
theorem finiteEvenFourTorusZ2UnfixedGaugeStrict_allVolume_transfer_eq_zero_iff
    (H : ℕ)
    (β energyIdentity energyNontrivial : ℝ)
    (hβ : 0 < β)
    (hEnergy : energyIdentity < energyNontrivial)
    (x : FiniteEvenFourTorusZ2GaugeInvariantSliceHilbert H) :
    finiteEvenFourTorusZ2UnfixedGaugeInvariantOneSlabTransfer
        H β energyIdentity energyNontrivial hβ.le hEnergy.le x = 0 ↔
      x = 0 := by
  constructor
  · intro hx
    apply finiteEvenFourTorusZ2UnfixedGaugeInvariantOneSlabTransfer_injective_strict
      H β energyIdentity energyNontrivial hβ hEnergy
    simpa using hx
  · rintro rfl
    exact map_zero _

end

end MathlibAnalytic
end MGAP4D
