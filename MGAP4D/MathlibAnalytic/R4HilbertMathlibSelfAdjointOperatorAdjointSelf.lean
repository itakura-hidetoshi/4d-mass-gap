/-!
# The R4 mathlib self-adjoint operator is equal to its adjoint

This file closes the loop between the R4 adjoint-evaluation layer and the actual
R4 self-adjoint operator object.

It records that `LinearPMap.adjoint M.mathlibOperator` is the same partial
linear operator as `M.mathlibOperator`, and carries the induced domain and graph
identities together with the existing adjoint-evaluation package.

This remains unbounded-operator infrastructure.  It does not assert a spectral
measure, spectral projection, positive lower bound, or spectral gap.
-/

/-- The actual R4 mathlib self-adjoint operator is equal to its mathlib adjoint. -/
theorem r4HilbertMathlibSelfAdjointOperator_actual_adjoint_eq_self
    (M : R4HilbertMathlibSelfAdjointOperatorData I TR) :
    (letI : NormedAddCommGroup
        (r4HilbertMathlibSelfAdjointCarrier I TR M.selfAdjointnessData) :=
      r4HilbertMathlibSelfAdjointCarrierNormedAddCommGroup I TR M.selfAdjointnessData
    letI : InnerProductSpace ℝ
        (r4HilbertMathlibSelfAdjointCarrier I TR M.selfAdjointnessData) :=
      r4HilbertMathlibSelfAdjointCarrierInnerProductSpace I TR M.selfAdjointnessData
    letI : CompleteSpace
        (r4HilbertMathlibSelfAdjointCarrier I TR M.selfAdjointnessData) :=
      r4HilbertMathlibSelfAdjointCarrierCompleteSpace I TR M.selfAdjointnessData
    LinearPMap.adjoint M.mathlibOperator = M.mathlibOperator) := by
  letI : NormedAddCommGroup
      (r4HilbertMathlibSelfAdjointCarrier I TR M.selfAdjointnessData) :=
    r4HilbertMathlibSelfAdjointCarrierNormedAddCommGroup I TR M.selfAdjointnessData
  letI : InnerProductSpace ℝ
      (r4HilbertMathlibSelfAdjointCarrier I TR M.selfAdjointnessData) :=
    r4HilbertMathlibSelfAdjointCarrierInnerProductSpace I TR M.selfAdjointnessData
  letI : CompleteSpace
      (r4HilbertMathlibSelfAdjointCarrier I TR M.selfAdjointnessData) :=
    r4HilbertMathlibSelfAdjointCarrierCompleteSpace I TR M.selfAdjointnessData
  exact LinearPMap.isSelfAdjoint_def.mp
    (r4HilbertMathlibSelfAdjointOperator_self_adjoint I TR M)

/-- The same equality in the reverse direction. -/
theorem r4HilbertMathlibSelfAdjointOperator_actual_self_eq_adjoint
    (M : R4HilbertMathlibSelfAdjointOperatorData I TR) :
    (letI : NormedAddCommGroup
        (r4HilbertMathlibSelfAdjointCarrier I TR M.selfAdjointnessData) :=
      r4HilbertMathlibSelfAdjointCarrierNormedAddCommGroup I TR M.selfAdjointnessData
    letI : InnerProductSpace ℝ
        (r4HilbertMathlibSelfAdjointCarrier I TR M.selfAdjointnessData) :=
      r4HilbertMathlibSelfAdjointCarrierInnerProductSpace I TR M.selfAdjointnessData
    letI : CompleteSpace
        (r4HilbertMathlibSelfAdjointCarrier I TR M.selfAdjointnessData) :=
      r4HilbertMathlibSelfAdjointCarrierCompleteSpace I TR M.selfAdjointnessData
    M.mathlibOperator = LinearPMap.adjoint M.mathlibOperator) := by
  letI : NormedAddCommGroup
      (r4HilbertMathlibSelfAdjointCarrier I TR M.selfAdjointnessData) :=
    r4HilbertMathlibSelfAdjointCarrierNormedAddCommGroup I TR M.selfAdjointnessData
  letI : InnerProductSpace ℝ
      (r4HilbertMathlibSelfAdjointCarrier I TR M.selfAdjointnessData) :=
    r4HilbertMathlibSelfAdjointCarrierInnerProductSpace I TR M.selfAdjointnessData
  letI : CompleteSpace
      (r4HilbertMathlibSelfAdjointCarrier I TR M.selfAdjointnessData) :=
    r4HilbertMathlibSelfAdjointCarrierCompleteSpace I TR M.selfAdjointnessData
  exact (r4HilbertMathlibSelfAdjointOperator_actual_adjoint_eq_self I TR M).symm

/-- The adjoint domain is the original domain for the actual R4 operator. -/
theorem r4HilbertMathlibSelfAdjointOperator_actual_adjoint_domain_eq_domain
    (M : R4HilbertMathlibSelfAdjointOperatorData I TR) :
    (letI : NormedAddCommGroup
        (r4HilbertMathlibSelfAdjointCarrier I TR M.selfAdjointnessData) :=
      r4HilbertMathlibSelfAdjointCarrierNormedAddCommGroup I TR M.selfAdjointnessData
    letI : InnerProductSpace ℝ
        (r4HilbertMathlibSelfAdjointCarrier I TR M.selfAdjointnessData) :=
      r4HilbertMathlibSelfAdjointCarrierInnerProductSpace I TR M.selfAdjointnessData
    letI : CompleteSpace
        (r4HilbertMathlibSelfAdjointCarrier I TR M.selfAdjointnessData) :=
      r4HilbertMathlibSelfAdjointCarrierCompleteSpace I TR M.selfAdjointnessData
    (LinearPMap.adjoint M.mathlibOperator).domain = M.mathlibOperator.domain) := by
  letI : NormedAddCommGroup
      (r4HilbertMathlibSelfAdjointCarrier I TR M.selfAdjointnessData) :=
    r4HilbertMathlibSelfAdjointCarrierNormedAddCommGroup I TR M.selfAdjointnessData
  letI : InnerProductSpace ℝ
      (r4HilbertMathlibSelfAdjointCarrier I TR M.selfAdjointnessData) :=
    r4HilbertMathlibSelfAdjointCarrierInnerProductSpace I TR M.selfAdjointnessData
  letI : CompleteSpace
      (r4HilbertMathlibSelfAdjointCarrier I TR M.selfAdjointnessData) :=
    r4HilbertMathlibSelfAdjointCarrierCompleteSpace I TR M.selfAdjointnessData
  exact congrArg (fun T => T.domain)
    (r4HilbertMathlibSelfAdjointOperator_actual_adjoint_eq_self I TR M)

/-- The adjoint graph is the original graph for the actual R4 operator. -/
theorem r4HilbertMathlibSelfAdjointOperator_actual_adjoint_graph_eq_graph
    (M : R4HilbertMathlibSelfAdjointOperatorData I TR) :
    (letI : NormedAddCommGroup
        (r4HilbertMathlibSelfAdjointCarrier I TR M.selfAdjointnessData) :=
      r4HilbertMathlibSelfAdjointCarrierNormedAddCommGroup I TR M.selfAdjointnessData
    letI : InnerProductSpace ℝ
        (r4HilbertMathlibSelfAdjointCarrier I TR M.selfAdjointnessData) :=
      r4HilbertMathlibSelfAdjointCarrierInnerProductSpace I TR M.selfAdjointnessData
    letI : CompleteSpace
        (r4HilbertMathlibSelfAdjointCarrier I TR M.selfAdjointnessData) :=
      r4HilbertMathlibSelfAdjointCarrierCompleteSpace I TR M.selfAdjointnessData
    (LinearPMap.adjoint M.mathlibOperator).graph = M.mathlibOperator.graph) := by
  letI : NormedAddCommGroup
      (r4HilbertMathlibSelfAdjointCarrier I TR M.selfAdjointnessData) :=
    r4HilbertMathlibSelfAdjointCarrierNormedAddCommGroup I TR M.selfAdjointnessData
  letI : InnerProductSpace ℝ
      (r4HilbertMathlibSelfAdjointCarrier I TR M.selfAdjointnessData) :=
    r4HilbertMathlibSelfAdjointCarrierInnerProductSpace I TR M.selfAdjointnessData
  letI : CompleteSpace
      (r4HilbertMathlibSelfAdjointCarrier I TR M.selfAdjointnessData) :=
    r4HilbertMathlibSelfAdjointCarrierCompleteSpace I TR M.selfAdjointnessData
  exact congrArg (fun T => T.graph)
    (r4HilbertMathlibSelfAdjointOperator_actual_adjoint_eq_self I TR M)

/-- The actual R4 operator carries adjoint equality, domain equality, graph equality,
and the adjoint-evaluation formulas from the previous layer. -/
theorem r4HilbertMathlibSelfAdjointOperator_actual_adjoint_self_package
    (M : R4HilbertMathlibSelfAdjointOperatorData I TR) :
    (letI : NormedAddCommGroup
        (r4HilbertMathlibSelfAdjointCarrier I TR M.selfAdjointnessData) :=
      r4HilbertMathlibSelfAdjointCarrierNormedAddCommGroup I TR M.selfAdjointnessData
    letI : InnerProductSpace ℝ
        (r4HilbertMathlibSelfAdjointCarrier I TR M.selfAdjointnessData) :=
      r4HilbertMathlibSelfAdjointCarrierInnerProductSpace I TR M.selfAdjointnessData
    letI : CompleteSpace
        (r4HilbertMathlibSelfAdjointCarrier I TR M.selfAdjointnessData) :=
      r4HilbertMathlibSelfAdjointCarrierCompleteSpace I TR M.selfAdjointnessData
    LinearPMap.adjoint M.mathlibOperator = M.mathlibOperator ∧
      (LinearPMap.adjoint M.mathlibOperator).domain = M.mathlibOperator.domain ∧
      (LinearPMap.adjoint M.mathlibOperator).graph = M.mathlibOperator.graph ∧
      (∀ y : (LinearPMap.adjoint M.mathlibOperator).domain,
        LinearPMap.adjoint M.mathlibOperator y =
          LinearPMap.adjointAux
            (r4HilbertMathlibSelfAdjointOperator_actual_dense_domain I TR M) y)) := by
  letI : NormedAddCommGroup
      (r4HilbertMathlibSelfAdjointCarrier I TR M.selfAdjointnessData) :=
    r4HilbertMathlibSelfAdjointCarrierNormedAddCommGroup I TR M.selfAdjointnessData
  letI : InnerProductSpace ℝ
      (r4HilbertMathlibSelfAdjointCarrier I TR M.selfAdjointnessData) :=
    r4HilbertMathlibSelfAdjointCarrierInnerProductSpace I TR M.selfAdjointnessData
  letI : CompleteSpace
      (r4HilbertMathlibSelfAdjointCarrier I TR M.selfAdjointnessData) :=
    r4HilbertMathlibSelfAdjointCarrierCompleteSpace I TR M.selfAdjointnessData
  exact ⟨r4HilbertMathlibSelfAdjointOperator_actual_adjoint_eq_self I TR M,
    r4HilbertMathlibSelfAdjointOperator_actual_adjoint_domain_eq_domain I TR M,
    r4HilbertMathlibSelfAdjointOperator_actual_adjoint_graph_eq_graph I TR M,
    r4HilbertMathlibSelfAdjointOperator_actual_adjoint_apply_of_dense I TR M⟩

/-- This adjoint-self layer remains operator infrastructure, not a spectral-gap assertion. -/
def r4HilbertMathlibSelfAdjointOperatorAdjointSelfButNoGapAssertion
    (_M : R4HilbertMathlibSelfAdjointOperatorData I TR) : Prop := True

theorem r4HilbertMathlibSelfAdjointOperatorAdjointSelfButNoGapAssertion_holds
    (M : R4HilbertMathlibSelfAdjointOperatorData I TR) :
    r4HilbertMathlibSelfAdjointOperatorAdjointSelfButNoGapAssertion I TR M :=
  trivial

