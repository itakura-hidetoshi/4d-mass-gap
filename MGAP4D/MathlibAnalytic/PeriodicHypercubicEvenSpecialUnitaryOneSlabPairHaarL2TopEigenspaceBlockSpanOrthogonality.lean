/-- Decomposable generators of the full top-top block `F ⊠ F`. -/
noncomputable def periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopGeneratorSet
    (H N : ℕ) (hN : 0 < N) (beta : ℝ) (hbeta : 0 ≤ beta) :
    Set (PeriodicHypercubicEvenSpecialUnitarySpatialSlicePairHaarL2 H N) :=
  Set.range fun p :
      periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabTopEigenspace H N hN beta hbeta ×
        periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabTopEigenspace H N hN beta hbeta =>
    periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopDecomposableL2
      H N hN beta hbeta p.1 p.2

/-- Decomposable generators of the mixed block `K ⊠ F`. -/
noncomputable def periodicHypercubicEvenSpecialUnitaryPhysicalPairOrthogonalTopGeneratorSet
    (H N : ℕ) (hN : 0 < N) (beta : ℝ) (hbeta : 0 ≤ beta) :
    Set (PeriodicHypercubicEvenSpecialUnitarySpatialSlicePairHaarL2 H N) :=
  Set.range fun p :
      periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabTopEigenspaceOrthogonal
          H N hN beta hbeta ×
        periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabTopEigenspace H N hN beta hbeta =>
    periodicHypercubicEvenSpecialUnitaryPhysicalPairOrthogonalTopDecomposableL2
      H N hN beta hbeta p.1 p.2

/-- Decomposable generators of the mixed block `F ⊠ K`. -/
noncomputable def periodicHypercubicEvenSpecialUnitaryPhysicalPairTopOrthogonalGeneratorSet
    (H N : ℕ) (hN : 0 < N) (beta : ℝ) (hbeta : 0 ≤ beta) :
    Set (PeriodicHypercubicEvenSpecialUnitarySpatialSlicePairHaarL2 H N) :=
  Set.range fun p :
      periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabTopEigenspace H N hN beta hbeta ×
        periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabTopEigenspaceOrthogonal
          H N hN beta hbeta =>
    periodicHypercubicEvenSpecialUnitaryPhysicalPairTopOrthogonalDecomposableL2
      H N hN beta hbeta p.1 p.2

/-- Decomposable generators of the double-excitation block `K ⊠ K`. -/
noncomputable def periodicHypercubicEvenSpecialUnitaryPhysicalPairOrthogonalOrthogonalGeneratorSet
    (H N : ℕ) (hN : 0 < N) (beta : ℝ) (hbeta : 0 ≤ beta) :
    Set (PeriodicHypercubicEvenSpecialUnitarySpatialSlicePairHaarL2 H N) :=
  Set.range fun p :
      periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabTopEigenspaceOrthogonal
          H N hN beta hbeta ×
        periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabTopEigenspaceOrthogonal
          H N hN beta hbeta =>
    periodicHypercubicEvenSpecialUnitaryPhysicalPairOrthogonalOrthogonalDecomposableL2
      H N hN beta hbeta p.1 p.2

/-- Algebraic Hilbert submodule generated by the `F ⊠ F` decomposable block. -/
noncomputable def periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockSpan
    (H N : ℕ) (hN : 0 < N) (beta : ℝ) (hbeta : 0 ≤ beta) :
    Submodule ℝ (PeriodicHypercubicEvenSpecialUnitarySpatialSlicePairHaarL2 H N) :=
  Submodule.span ℝ
    (periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopGeneratorSet
      H N hN beta hbeta)

/-- Algebraic Hilbert submodule generated by the `K ⊠ F` decomposable block. -/
noncomputable def periodicHypercubicEvenSpecialUnitaryPhysicalPairOrthogonalTopBlockSpan
    (H N : ℕ) (hN : 0 < N) (beta : ℝ) (hbeta : 0 ≤ beta) :
    Submodule ℝ (PeriodicHypercubicEvenSpecialUnitarySpatialSlicePairHaarL2 H N) :=
  Submodule.span ℝ
    (periodicHypercubicEvenSpecialUnitaryPhysicalPairOrthogonalTopGeneratorSet
      H N hN beta hbeta)

/-- Algebraic Hilbert submodule generated by the `F ⊠ K` decomposable block. -/
noncomputable def periodicHypercubicEvenSpecialUnitaryPhysicalPairTopOrthogonalBlockSpan
    (H N : ℕ) (hN : 0 < N) (beta : ℝ) (hbeta : 0 ≤ beta) :
    Submodule ℝ (PeriodicHypercubicEvenSpecialUnitarySpatialSlicePairHaarL2 H N) :=
  Submodule.span ℝ
    (periodicHypercubicEvenSpecialUnitaryPhysicalPairTopOrthogonalGeneratorSet
      H N hN beta hbeta)

/-- Algebraic Hilbert submodule generated by the `K ⊠ K` decomposable block. -/
noncomputable def periodicHypercubicEvenSpecialUnitaryPhysicalPairOrthogonalOrthogonalBlockSpan
    (H N : ℕ) (hN : 0 < N) (beta : ℝ) (hbeta : 0 ≤ beta) :
    Submodule ℝ (PeriodicHypercubicEvenSpecialUnitarySpatialSlicePairHaarL2 H N) :=
  Submodule.span ℝ
    (periodicHypercubicEvenSpecialUnitaryPhysicalPairOrthogonalOrthogonalGeneratorSet
      H N hN beta hbeta)

/-- The algebraic sum of the three blocks carrying at least one excitation factor. -/
noncomputable def periodicHypercubicEvenSpecialUnitaryPhysicalPairNonTopBlockSpan
    (H N : ℕ) (hN : 0 < N) (beta : ℝ) (hbeta : 0 ≤ beta) :
    Submodule ℝ (PeriodicHypercubicEvenSpecialUnitarySpatialSlicePairHaarL2 H N) :=
  (periodicHypercubicEvenSpecialUnitaryPhysicalPairOrthogonalTopBlockSpan
      H N hN beta hbeta ⊔
    periodicHypercubicEvenSpecialUnitaryPhysicalPairTopOrthogonalBlockSpan
      H N hN beta hbeta) ⊔
    periodicHypercubicEvenSpecialUnitaryPhysicalPairOrthogonalOrthogonalBlockSpan
      H N hN beta hbeta

/-- The generated `F ⊠ F` and `K ⊠ F` spans are orthogonal. -/
theorem periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockSpan_isOrtho_orthogonalTopBlockSpan
    (H N : ℕ) (hN : 0 < N) (beta : ℝ) (hbeta : 0 ≤ beta) :
    periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockSpan
        H N hN beta hbeta ⟂
      periodicHypercubicEvenSpecialUnitaryPhysicalPairOrthogonalTopBlockSpan
        H N hN beta hbeta := by
  rw [periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockSpan,
    periodicHypercubicEvenSpecialUnitaryPhysicalPairOrthogonalTopBlockSpan,
    Submodule.isOrtho_span]
  intro x hx y hy
  rcases hx with ⟨⟨u, v⟩, rfl⟩
  rcases hy with ⟨⟨f, w⟩, rfl⟩
  exact
    periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTop_inner_orthogonalTop_eq_zero
      H N hN beta hbeta u v w f

/-- The generated `F ⊠ F` and `F ⊠ K` spans are orthogonal. -/
theorem periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockSpan_isOrtho_topOrthogonalBlockSpan
    (H N : ℕ) (hN : 0 < N) (beta : ℝ) (hbeta : 0 ≤ beta) :
    periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockSpan
        H N hN beta hbeta ⟂
      periodicHypercubicEvenSpecialUnitaryPhysicalPairTopOrthogonalBlockSpan
        H N hN beta hbeta := by
  rw [periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockSpan,
