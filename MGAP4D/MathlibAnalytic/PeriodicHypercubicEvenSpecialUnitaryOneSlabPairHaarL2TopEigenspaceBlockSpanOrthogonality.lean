  rcases hy with ⟨⟨w, f⟩, rfl⟩
  exact
    periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTop_inner_topOrthogonal_eq_zero
      H N hN beta hbeta u v w f

/-- The generated `F ⊠ F` and `K ⊠ K` spans are orthogonal. -/
theorem periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockSpan_isOrtho_orthogonalOrthogonalBlockSpan
    (H N : ℕ) (hN : 0 < N) (beta : ℝ) (hbeta : 0 ≤ beta) :
    periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockSpan
        H N hN beta hbeta ⟂
