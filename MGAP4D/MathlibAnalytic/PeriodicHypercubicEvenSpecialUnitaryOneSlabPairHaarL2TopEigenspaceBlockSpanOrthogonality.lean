  intro x hx y hy
  rcases hx with ⟨⟨u, f⟩, rfl⟩
  rcases hy with ⟨⟨g, h⟩, rfl⟩
  exact
    periodicHypercubicEvenSpecialUnitaryPhysicalPairTopOrthogonal_inner_orthogonalOrthogonal_eq_zero
      H N hN beta hbeta f g h u

/-- The full generated top-top span is orthogonal to the algebraic sum of all
three generated blocks carrying at least one excitation factor. -/
theorem periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockSpan_isOrtho_nonTopBlockSpan
    (H N : ℕ) (hN : 0 < N) (beta : ℝ) (hbeta : 0 ≤ beta) :
    periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockSpan
        H N hN beta hbeta ⟂
      periodicHypercubicEvenSpecialUnitaryPhysicalPairNonTopBlockSpan
        H N hN beta hbeta := by
  simp only [periodicHypercubicEvenSpecialUnitaryPhysicalPairNonTopBlockSpan,
    Submodule.isOrtho_sup_right]
  exact
    ⟨⟨periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockSpan_isOrtho_orthogonalTopBlockSpan
          H N hN beta hbeta,
        periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockSpan_isOrtho_topOrthogonalBlockSpan
          H N hN beta hbeta⟩,
      periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockSpan_isOrtho_orthogonalOrthogonalBlockSpan
        H N hN beta hbeta⟩

/-- Audit-visible algebraic block-span orthogonality package.  This remains one
step before taking topological closures or identifying a completed orthogonal
complement. -/
structure PeriodicHypercubicEvenSpecialUnitaryPhysicalPairBlockSpanOrthogonalityPackage
    (H N : ℕ) (hN : 0 < N) (beta : ℝ) (hbeta : 0 ≤ beta) : Prop where
  topTop_orthogonalTop :
    periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockSpan H N hN beta hbeta ⟂
      periodicHypercubicEvenSpecialUnitaryPhysicalPairOrthogonalTopBlockSpan H N hN beta hbeta
  topTop_topOrthogonal :
    periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockSpan H N hN beta hbeta ⟂
      periodicHypercubicEvenSpecialUnitaryPhysicalPairTopOrthogonalBlockSpan H N hN beta hbeta
  topTop_orthogonalOrthogonal :
    periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockSpan H N hN beta hbeta ⟂
      periodicHypercubicEvenSpecialUnitaryPhysicalPairOrthogonalOrthogonalBlockSpan H N hN beta hbeta
  orthogonalTop_topOrthogonal :
    periodicHypercubicEvenSpecialUnitaryPhysicalPairOrthogonalTopBlockSpan H N hN beta hbeta ⟂
      periodicHypercubicEvenSpecialUnitaryPhysicalPairTopOrthogonalBlockSpan H N hN beta hbeta
  orthogonalTop_orthogonalOrthogonal :
    periodicHypercubicEvenSpecialUnitaryPhysicalPairOrthogonalTopBlockSpan H N hN beta hbeta ⟂
      periodicHypercubicEvenSpecialUnitaryPhysicalPairOrthogonalOrthogonalBlockSpan H N hN beta hbeta
  topOrthogonal_orthogonalOrthogonal :
    periodicHypercubicEvenSpecialUnitaryPhysicalPairTopOrthogonalBlockSpan H N hN beta hbeta ⟂
      periodicHypercubicEvenSpecialUnitaryPhysicalPairOrthogonalOrthogonalBlockSpan H N hN beta hbeta
  topTop_nonTop :
    periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockSpan H N hN beta hbeta ⟂
      periodicHypercubicEvenSpecialUnitaryPhysicalPairNonTopBlockSpan H N hN beta hbeta

/-- Construct the algebraic block-span orthogonality package from the exact
decomposable-vector inner-product identities. -/
theorem periodicHypercubicEvenSpecialUnitaryPhysicalPairBlockSpanOrthogonalityPackage
    (H N : ℕ) (hN : 0 < N) (beta : ℝ) (hbeta : 0 ≤ beta) :
    PeriodicHypercubicEvenSpecialUnitaryPhysicalPairBlockSpanOrthogonalityPackage
      H N hN beta hbeta :=
  { topTop_orthogonalTop :=
      periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockSpan_isOrtho_orthogonalTopBlockSpan
        H N hN beta hbeta
    topTop_topOrthogonal :=
      periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockSpan_isOrtho_topOrthogonalBlockSpan
        H N hN beta hbeta
    topTop_orthogonalOrthogonal :=
      periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockSpan_isOrtho_orthogonalOrthogonalBlockSpan
        H N hN beta hbeta
    orthogonalTop_topOrthogonal :=
      periodicHypercubicEvenSpecialUnitaryPhysicalPairOrthogonalTopBlockSpan_isOrtho_topOrthogonalBlockSpan
        H N hN beta hbeta
    orthogonalTop_orthogonalOrthogonal :=
      periodicHypercubicEvenSpecialUnitaryPhysicalPairOrthogonalTopBlockSpan_isOrtho_orthogonalOrthogonalBlockSpan
        H N hN beta hbeta
    topOrthogonal_orthogonalOrthogonal :=
      periodicHypercubicEvenSpecialUnitaryPhysicalPairTopOrthogonalBlockSpan_isOrtho_orthogonalOrthogonalBlockSpan
        H N hN beta hbeta
    topTop_nonTop :=
      periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockSpan_isOrtho_nonTopBlockSpan
        H N hN beta hbeta }

end

