  intro x hx y hy
  rcases hx with ⟨⟨u, v⟩, rfl⟩
  rcases hy with ⟨⟨f, g⟩, rfl⟩
  exact
    periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTop_inner_orthogonalOrthogonal_eq_zero
      H N hN beta hbeta u v f g

/-- The two generated mixed-block spans are orthogonal. -/
theorem periodicHypercubicEvenSpecialUnitaryPhysicalPairOrthogonalTopBlockSpan_isOrtho_topOrthogonalBlockSpan
    (H N : ℕ) (hN : 0 < N) (beta : ℝ) (hbeta : 0 ≤ beta) :
    periodicHypercubicEvenSpecialUnitaryPhysicalPairOrthogonalTopBlockSpan
        H N hN beta hbeta ⟂
      periodicHypercubicEvenSpecialUnitaryPhysicalPairTopOrthogonalBlockSpan
        H N hN beta hbeta := by
