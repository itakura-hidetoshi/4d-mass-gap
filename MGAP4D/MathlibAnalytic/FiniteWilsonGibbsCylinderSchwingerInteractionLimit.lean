import MGAP4D.MathlibAnalytic.FiniteWilsonGibbsSingleSourceExactGapContinuumSpineTheorems
import Mathlib.MeasureTheory.Integral.Bochner.Basic

namespace MGAP4D
namespace MathlibAnalytic

open MeasureTheory

noncomputable section

/-!
Concrete cylinder Schwinger functions and interaction transfer for the fixed
finite-Wilson source route.

The continuum Schwinger value of a finite cylinder observable is defined as its
integral against the corresponding marginal of the projective-limit measure.
The finite-Wilson value is the integral of the same observable against the
pushforward of the fixed Wilson Gibbs source.  Projective-limit marginal
recovery proves exact equality for every real-valued cylinder observable.

Interaction is expressed by a nonfactorization witness: the connected
correlation of two local observables is nonzero for the fixed Wilson Gibbs
marginal.  Exact marginal recovery then transports that nonzero connected
correlation to the continuum law.

This closes the measure-theoretic Schwinger-limit and interaction-transfer
steps.  It does not construct a nonfactorization witness for a particular
physical Wilson action and does not assert an unconditional Yang--Mills
construction.
-/

/-- Finite-dimensional field configurations on a cylinder support. -/
abbrev FiniteWilsonGibbsCylinderConfiguration
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    (R : FiniteWilsonGibbsSingleSourceProjectiveRealization W)
    (J : Finset EuclideanFourSpace) :=
  ∀ x : J, R.fieldValue x

/-- Real-valued observables on a finite cylinder support. -/
abbrev FiniteWilsonGibbsCylinderObservable
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    (R : FiniteWilsonGibbsSingleSourceProjectiveRealization W)
    (J : Finset EuclideanFourSpace) :=
  FiniteWilsonGibbsCylinderConfiguration R J → ℝ

/-- The cylinder Schwinger value computed from the fixed finite Wilson Gibbs
source. -/
noncomputable def finiteWilsonGibbsCylinderSchwingerValue
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    (R : FiniteWilsonGibbsSingleSourceProjectiveRealization W)
    (J : Finset EuclideanFourSpace)
    (O : FiniteWilsonGibbsCylinderObservable R J) : ℝ :=
  ∫ X, O X ∂((W.system R.sourceScale).gibbsMeasure.map (R.observe J))

/-- The cylinder Schwinger value computed from the projective-limit continuum
marginal generated by exact-gap OS limit data. -/
noncomputable def finiteWilsonContinuumCylinderSchwingerValue
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    (R : FiniteWilsonGibbsSingleSourceProjectiveRealization W)
    (D : FiniteWilsonGibbsSingleSourceExactGapOSLimitData R)
    (J : Finset EuclideanFourSpace)
    (O : FiniteWilsonGibbsCylinderObservable R J) : ℝ :=
  ∫ X, O X ∂((R.explicitOSContinuumConstruction
    (R.automaticOSLimitTransferData D.toAutomaticData)).limit.continuumMeasure.map
      J.restrict)

/-- Every cylinder Schwinger value of the continuum law is exactly the value
computed from the fixed Wilson Gibbs source.  No limiting interchange is left
opaque: the equality follows from the projective-limit marginal identity. -/
theorem finite_wilson_continuum_cylinder_schwinger_eq_source
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    (R : FiniteWilsonGibbsSingleSourceProjectiveRealization W)
    (D : FiniteWilsonGibbsSingleSourceExactGapOSLimitData R)
    (J : Finset EuclideanFourSpace)
    (O : FiniteWilsonGibbsCylinderObservable R J) :
    finiteWilsonContinuumCylinderSchwingerValue R D J O =
      finiteWilsonGibbsCylinderSchwingerValue R J O := by
  change
    (∫ X, O X ∂(R.projectiveLimitMeasure.continuumMeasure.map J.restrict)) =
      ∫ X, O X ∂((W.system R.sourceScale).gibbsMeasure.map (R.observe J))
  rw [euclidean_yang_mills_projective_limit_recovers_marginal]
  rfl

/-- Concrete proposition saying that all finite-cylinder Schwinger values are
projective-limit values of the fixed Wilson Gibbs source. -/
abbrev FiniteWilsonCylinderSchwingerLimitProp
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    (R : FiniteWilsonGibbsSingleSourceProjectiveRealization W)
    (D : FiniteWilsonGibbsSingleSourceExactGapOSLimitData R) : Prop :=
  ∀ (J : Finset EuclideanFourSpace)
    (O : FiniteWilsonGibbsCylinderObservable R J),
    finiteWilsonContinuumCylinderSchwingerValue R D J O =
      finiteWilsonGibbsCylinderSchwingerValue R J O

/-- The concrete cylinder Schwinger-limit proposition is theorem-generated. -/
theorem finite_wilson_cylinder_schwinger_limit
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    (R : FiniteWilsonGibbsSingleSourceProjectiveRealization W)
    (D : FiniteWilsonGibbsSingleSourceExactGapOSLimitData R) :
    FiniteWilsonCylinderSchwingerLimitProp R D := by
  intro J O
  exact finite_wilson_continuum_cylinder_schwinger_eq_source R D J O

/-- A cylinder observable invariant under the continuum gauge action. -/
structure FiniteWilsonGaugeInvariantCylinderObservable
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    (R : FiniteWilsonGibbsSingleSourceProjectiveRealization W)
    (D : FiniteWilsonGibbsSingleSourceExactGapOSLimitData R)
    (J : Finset EuclideanFourSpace) where
  observable : FiniteWilsonGibbsCylinderObservable R J
  invariant :
    ∀ (g : D.gaugeGroup)
      (X : R.toProjectiveRealization.toProjectiveCylinderFamily.Configuration),
      observable (J.restrict (g • X)) = observable (J.restrict X)

/-- The zero observable gives a canonical gauge-invariant cylinder observable
on every finite support. -/
def finiteWilsonZeroGaugeInvariantCylinderObservable
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    (R : FiniteWilsonGibbsSingleSourceProjectiveRealization W)
    (D : FiniteWilsonGibbsSingleSourceExactGapOSLimitData R)
    (J : Finset EuclideanFourSpace) :
    FiniteWilsonGaugeInvariantCylinderObservable R D J where
  observable := fun _ => 0
  invariant := by
    intro g X
    rfl

/-- Gauge-invariant cylinder Schwinger observables are concretely constructed on
every finite support. -/
abbrev FiniteWilsonGaugeInvariantCylinderSchwingerConstructedProp
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    (R : FiniteWilsonGibbsSingleSourceProjectiveRealization W)
    (D : FiniteWilsonGibbsSingleSourceExactGapOSLimitData R) : Prop :=
  ∀ J : Finset EuclideanFourSpace,
    Nonempty (FiniteWilsonGaugeInvariantCylinderObservable R D J)

/-- Construction theorem for the gauge-invariant cylinder Schwinger domain. -/
theorem finite_wilson_gauge_invariant_cylinder_schwinger_constructed
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    (R : FiniteWilsonGibbsSingleSourceProjectiveRealization W)
    (D : FiniteWilsonGibbsSingleSourceExactGapOSLimitData R) :
    FiniteWilsonGaugeInvariantCylinderSchwingerConstructedProp R D := by
  intro J
  exact ⟨finiteWilsonZeroGaugeInvariantCylinderObservable R D J⟩

/-- The continuum Schwinger functional on gauge-invariant cylinder observables. -/
noncomputable def finiteWilsonGaugeInvariantContinuumSchwingerFunction
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    (R : FiniteWilsonGibbsSingleSourceProjectiveRealization W)
    (D : FiniteWilsonGibbsSingleSourceExactGapOSLimitData R)
    (J : Finset EuclideanFourSpace) :
    FiniteWilsonGaugeInvariantCylinderObservable R D J → ℝ :=
  fun O => finiteWilsonContinuumCylinderSchwingerValue R D J O.observable

/-- Gauge-invariant cylinder Schwinger values also satisfy the exact source
identity. -/
theorem finite_wilson_gauge_invariant_continuum_schwinger_eq_source
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    (R : FiniteWilsonGibbsSingleSourceProjectiveRealization W)
    (D : FiniteWilsonGibbsSingleSourceExactGapOSLimitData R)
    (J : Finset EuclideanFourSpace)
    (O : FiniteWilsonGaugeInvariantCylinderObservable R D J) :
    finiteWilsonGaugeInvariantContinuumSchwingerFunction R D J O =
      finiteWilsonGibbsCylinderSchwingerValue R J O.observable := by
  exact finite_wilson_continuum_cylinder_schwinger_eq_source
    R D J O.observable

/-- Connected correlation of two local observables in the fixed Wilson Gibbs
marginal. -/
noncomputable def finiteWilsonGibbsCylinderConnectedCorrelation
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    (R : FiniteWilsonGibbsSingleSourceProjectiveRealization W)
    (J : Finset EuclideanFourSpace)
    (O₁ O₂ : FiniteWilsonGibbsCylinderObservable R J) : ℝ :=
  finiteWilsonGibbsCylinderSchwingerValue R J (fun X => O₁ X * O₂ X) -
    finiteWilsonGibbsCylinderSchwingerValue R J O₁ *
      finiteWilsonGibbsCylinderSchwingerValue R J O₂

/-- Connected correlation of two local observables in the continuum marginal. -/
noncomputable def finiteWilsonContinuumCylinderConnectedCorrelation
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    (R : FiniteWilsonGibbsSingleSourceProjectiveRealization W)
    (D : FiniteWilsonGibbsSingleSourceExactGapOSLimitData R)
    (J : Finset EuclideanFourSpace)
    (O₁ O₂ : FiniteWilsonGibbsCylinderObservable R J) : ℝ :=
  finiteWilsonContinuumCylinderSchwingerValue R D J (fun X => O₁ X * O₂ X) -
    finiteWilsonContinuumCylinderSchwingerValue R D J O₁ *
      finiteWilsonContinuumCylinderSchwingerValue R D J O₂

/-- Connected correlations are transported exactly from the fixed Wilson Gibbs
source to the projective-limit continuum law. -/
theorem finite_wilson_continuum_cylinder_connected_eq_source
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    (R : FiniteWilsonGibbsSingleSourceProjectiveRealization W)
    (D : FiniteWilsonGibbsSingleSourceExactGapOSLimitData R)
    (J : Finset EuclideanFourSpace)
    (O₁ O₂ : FiniteWilsonGibbsCylinderObservable R J) :
    finiteWilsonContinuumCylinderConnectedCorrelation R D J O₁ O₂ =
      finiteWilsonGibbsCylinderConnectedCorrelation R J O₁ O₂ := by
  unfold finiteWilsonContinuumCylinderConnectedCorrelation
    finiteWilsonGibbsCylinderConnectedCorrelation
  rw [finite_wilson_continuum_cylinder_schwinger_eq_source R D J
      (fun X => O₁ X * O₂ X),
    finite_wilson_continuum_cylinder_schwinger_eq_source R D J O₁,
    finite_wilson_continuum_cylinder_schwinger_eq_source R D J O₂]

/-- A precise finite-source interaction witness: two local observables have
nonzero connected correlation. -/
structure FiniteWilsonGibbsCylinderInteractionWitness
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    (R : FiniteWilsonGibbsSingleSourceProjectiveRealization W) where
  support : Finset EuclideanFourSpace
  leftObservable : FiniteWilsonGibbsCylinderObservable R support
  rightObservable : FiniteWilsonGibbsCylinderObservable R support
  finiteConnectedCorrelation_ne_zero :
    finiteWilsonGibbsCylinderConnectedCorrelation R support
      leftObservable rightObservable ≠ 0

/-- A finite-source nonfactorization witness survives exactly in the continuum
law. -/
theorem finite_wilson_cylinder_interaction_passes_to_continuum
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    (R : FiniteWilsonGibbsSingleSourceProjectiveRealization W)
    (D : FiniteWilsonGibbsSingleSourceExactGapOSLimitData R)
    (I : FiniteWilsonGibbsCylinderInteractionWitness R) :
    finiteWilsonContinuumCylinderConnectedCorrelation R D I.support
      I.leftObservable I.rightObservable ≠ 0 := by
  rw [finite_wilson_continuum_cylinder_connected_eq_source]
  exact I.finiteConnectedCorrelation_ne_zero

/-- The five OS limit properties, including the separately supplied permutation
symmetry, hold simultaneously for exact-gap finite-Wilson limit data. -/
abbrev FiniteWilsonExactGapOSFiveLimitProperties
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    {F : EuclideanYangMillsProjectiveCylinderFamily}
    {L : EuclideanYangMillsProjectiveLimitMeasure F}
    (D : FiniteWilsonOSAutomaticExactGapAnalyticLimitConstructionData W F L) : Prop :=
  D.toAutomaticData.reflectionLimit.ContinuumReflectionPositive ∧
    D.toAutomaticData.euclideanLimit.toEuclideanInvarianceLimitData.ContinuumEuclideanInvariant ∧
    D.symmetric ∧
    D.toAutomaticData.clusterLimit.toClusterLimitData.ContinuumClusterProperty ∧
    D.toAutomaticData.regularityLimit.toRegularityLimitData.ContinuumRegularity

/-- Simultaneous theorem for the full five-property OS limit package. -/
theorem finite_wilson_exact_gap_os_five_limit_properties
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    {F : EuclideanYangMillsProjectiveCylinderFamily}
    {L : EuclideanYangMillsProjectiveLimitMeasure F}
    (D : FiniteWilsonOSAutomaticExactGapAnalyticLimitConstructionData W F L) :
    FiniteWilsonExactGapOSFiveLimitProperties D := by
  rcases finite_wilson_os_exact_gap_four_limit_properties D with
    ⟨hReflection, hEuclidean, hCluster, hRegularity⟩
  exact ⟨hReflection, hEuclidean, D.symmetric_proof, hCluster, hRegularity⟩

/-- The five OS properties, concrete gauge-invariant Schwinger construction,
exact cylinder Schwinger limit, and nonzero continuum interaction witness are
compatible in one theorem package. -/
theorem finite_wilson_os_five_schwinger_interaction_limit_package
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    (R : FiniteWilsonGibbsSingleSourceProjectiveRealization W)
    (D : FiniteWilsonGibbsSingleSourceExactGapOSLimitData R)
    (I : FiniteWilsonGibbsCylinderInteractionWitness R) :
    FiniteWilsonExactGapOSFiveLimitProperties D ∧
      FiniteWilsonGaugeInvariantCylinderSchwingerConstructedProp R D ∧
      FiniteWilsonCylinderSchwingerLimitProp R D ∧
      finiteWilsonContinuumCylinderConnectedCorrelation R D I.support
        I.leftObservable I.rightObservable ≠ 0 := by
  exact ⟨
    finite_wilson_exact_gap_os_five_limit_properties D,
    finite_wilson_gauge_invariant_cylinder_schwinger_constructed R D,
    finite_wilson_cylinder_schwinger_limit R D,
    finite_wilson_cylinder_interaction_passes_to_continuum R D I⟩

end

end MathlibAnalytic
