import MGAP4D.MathlibAnalytic.WightmanOSCanonicalRestrictedHamiltonianPVMSpectralTheorem
import Mathlib.Tactic

namespace MGAP4D
namespace MathlibAnalytic

noncomputable section

/-!
Express the missing operator/PVM spectral-theorem boundary in its local resolvent
form.

For a fixed real energy `E`, absence from the support of every scalar PVM orbit is
not a global set equality.  It is the vectorwise statement that each physical
vector has an open neighborhood of `E` on which its spectral projection vanishes.
The standard self-adjoint spectral theorem identifies exactly this local
vanishing condition with bijectivity of `H|Ω⊥ - E I`.

Once this local compatibility is available, the pointwise PVM spectral theorem,
the equality of PVM open support with the actual real operator spectrum, and the
existing exact-gap bridge are generated by classical logic and set extensionality.
-/

/-- Local resolvent/PVM compatibility for the actual canonical Hamiltonian on
`Ω⊥`.  This is the vectorwise local form of the self-adjoint spectral theorem. -/
structure ExplicitWightmanOSCanonicalRestrictedPVMResolventCompatibility
    (M : ExplicitWightmanOSReconstructedModel) where
  realShift_bijective_iff_vectorwise_pvm_localVanish :
    ∀ E : ℝ,
      Function.Bijective
          (M.canonicalVacuumOrthogonalHamiltonian.realShift E) ↔
        ∀ ψ : M.VacuumOrthogonalHilbert,
          ∃ U : Set ℝ, E ∈ U ∧ IsOpen U ∧
            M.spectralPVM.projection U (ψ : M.H) = 0

/-- The local resolvent/PVM criterion is exactly the pointwise characterization
of membership in the real operator spectrum by PVM open support. -/
theorem ExplicitWightmanOSCanonicalRestrictedPVMResolventCompatibility.mem_realSpectrum_iff_pvmOpenSupport
    {M : ExplicitWightmanOSReconstructedModel}
    (C : ExplicitWightmanOSCanonicalRestrictedPVMResolventCompatibility M)
    (E : ℝ) :
    E ∈ LinearPMap.realBijectiveSpectrum
          M.canonicalVacuumOrthogonalHamiltonian ↔
      ∃ ψ : M.VacuumOrthogonalHilbert,
        ∀ U : Set ℝ, E ∈ U → IsOpen U →
          M.spectralPVM.projection U (ψ : M.H) ≠ 0 := by
  classical
  simp only [LinearPMap.realBijectiveSpectrum,
    LinearPMap.realBijectiveResolventSet, Set.mem_compl_iff,
    Set.mem_setOf_eq]
  rw [C.realShift_bijective_iff_vectorwise_pvm_localVanish E]
  constructor
  · intro hNotAllLocalVanish
    by_contra hNoSupportVector
    apply hNotAllLocalVanish
    intro ψ
    by_contra hNoVanishingNeighborhood
    apply hNoSupportVector
    refine ⟨ψ, ?_⟩
    intro U hEU hU hProjectionZero
    apply hNoVanishingNeighborhood
    exact ⟨U, hEU, hU, hProjectionZero⟩
  · rintro ⟨ψ, hψ⟩ hAllLocalVanish
    obtain ⟨U, hEU, hU, hProjectionZero⟩ := hAllLocalVanish ψ
    exact hψ U hEU hU hProjectionZero

/-- Consequently the pure PVM open support is the actual real spectrum defined
by failure of bijectivity of the shifted canonical restricted Hamiltonian. -/
theorem ExplicitWightmanOSCanonicalRestrictedPVMResolventCompatibility.pvmOpenSupport_eq_realSpectrum
    {M : ExplicitWightmanOSReconstructedModel}
    (C : ExplicitWightmanOSCanonicalRestrictedPVMResolventCompatibility M) :
    M.vacuumOrthogonalPVMOpenSupport =
      LinearPMap.realBijectiveSpectrum
        M.canonicalVacuumOrthogonalHamiltonian := by
  ext E
  simpa [ExplicitWightmanOSReconstructedModel.vacuumOrthogonalPVMOpenSupport]
    using (C.mem_realSpectrum_iff_pvmOpenSupport E).symm

/-- Relative to an existing physical PVM-support bridge, the local criterion
identifies the actual real operator spectrum with the bridge's restricted
Hamiltonian spectrum. -/
theorem ExplicitWightmanOSCanonicalRestrictedPVMResolventCompatibility.realSpectrum_eq_restrictedSpectrum
    {M : ExplicitWightmanOSReconstructedModel}
    (C : ExplicitWightmanOSCanonicalRestrictedPVMResolventCompatibility M)
    (B : ExplicitWightmanOSCanonicalPVMOpenSupportBridge M) :
    LinearPMap.realBijectiveSpectrum
        M.canonicalVacuumOrthogonalHamiltonian =
      B.restrictedSpectrum := by
  calc
    LinearPMap.realBijectiveSpectrum
        M.canonicalVacuumOrthogonalHamiltonian =
        M.vacuumOrthogonalPVMOpenSupport :=
      C.pvmOpenSupport_eq_realSpectrum.symm
    _ = B.restrictedSpectrum := B.pvmOpenSupport_eq_restrictedSpectrum

/-- A local resolvent/PVM compatibility theorem and the physical identification
of PVM support with the non-vacuum energy spectrum generate the full canonical
restricted PVM spectral theorem introduced in the preceding layer. -/
noncomputable def ExplicitWightmanOSCanonicalRestrictedPVMResolventCompatibility.toCanonicalRestrictedPVMSpectralTheorem
    {M : ExplicitWightmanOSReconstructedModel}
    (C : ExplicitWightmanOSCanonicalRestrictedPVMResolventCompatibility M)
    (hSupport :
      M.vacuumOrthogonalPVMOpenSupport =
        M.hamiltonianEnergySpectrum \ ({0} : Set ℝ)) :
    ExplicitWightmanOSCanonicalRestrictedPVMSpectralTheorem M :=
  { realSpectrum_eq_nonvacuum := by
      calc
        LinearPMap.realBijectiveSpectrum
            M.canonicalVacuumOrthogonalHamiltonian =
            M.vacuumOrthogonalPVMOpenSupport :=
          C.pvmOpenSupport_eq_realSpectrum.symm
        _ = M.hamiltonianEnergySpectrum \ ({0} : Set ℝ) := hSupport
    mem_realSpectrum_iff_pvmOpenSupport :=
      C.mem_realSpectrum_iff_pvmOpenSupport }

/-- An existing pure-PVM support bridge supplies the physical support equality,
so only the local resolvent/PVM theorem remains to construct the canonical
operator/PVM spectral theorem. -/
noncomputable def ExplicitWightmanOSCanonicalRestrictedPVMResolventCompatibility.toCanonicalRestrictedPVMSpectralTheoremOfBridge
    {M : ExplicitWightmanOSReconstructedModel}
    (C : ExplicitWightmanOSCanonicalRestrictedPVMResolventCompatibility M)
    (B : ExplicitWightmanOSCanonicalPVMOpenSupportBridge M) :
    ExplicitWightmanOSCanonicalRestrictedPVMSpectralTheorem M :=
  C.toCanonicalRestrictedPVMSpectralTheorem <| by
    calc
      M.vacuumOrthogonalPVMOpenSupport = B.restrictedSpectrum :=
        B.pvmOpenSupport_eq_restrictedSpectrum
      _ = M.hamiltonianEnergySpectrum \ ({0} : Set ℝ) :=
        B.restrictedSpectrum_eq_nonvacuum

/-- Exact-gap endpoint generated from the local resolvent/PVM theorem.  The
former global pointwise spectral-theorem package is no longer an independent
input. -/
theorem explicit_wightman_os_exact_gap_pvm_open_support_of_resolvent_pvm_localVanish
    (M : ExplicitWightmanOSReconstructedModel)
    (C : ExplicitWightmanOSCanonicalRestrictedPVMResolventCompatibility M)
    (hSelf : IsSelfAdjoint M.canonicalVacuumOrthogonalHamiltonian)
    (D : ExplicitWightmanOSSpectralPVMDetection M)
    (hGap :
      HasHamiltonianMassGap M.hamiltonianEnergySpectrum exactGapValueReal)
    (hExactSpectrum :
      exactGapValueReal ∈ M.hamiltonianEnergySpectrum)
    (hSupport :
      M.vacuumOrthogonalPVMOpenSupport =
        M.hamiltonianEnergySpectrum \ ({0} : Set ℝ)) :
    ExplicitWightmanOSExactGapPVMOpenSupportProp M
      ((C.toCanonicalRestrictedPVMSpectralTheorem hSupport).toCanonicalPVMOpenSupportBridge
        hSelf D hExactSpectrum (ne_of_gt hGap.1))
      hGap hExactSpectrum := by
  exact
    explicit_wightman_os_exact_gap_pvm_open_support_of_canonical_spectralTheorem
      M (C.toCanonicalRestrictedPVMSpectralTheorem hSupport)
        hSelf D hGap hExactSpectrum

end

end MathlibAnalytic
end MGAP4D
