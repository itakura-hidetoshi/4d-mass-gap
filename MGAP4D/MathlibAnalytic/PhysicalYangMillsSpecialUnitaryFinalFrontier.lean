import MGAP4D.MathlibAnalytic.PhysicalYangMillsWilsonProperFunctionalLimitCompileSmoke
import MGAP4D.MathlibAnalytic.SpecialUnitaryCompactGaugeWilsonSystemCompileSmoke
import MGAP4D.MathlibAnalytic.PhysicalYangMillsWilsonSpecialUnitaryStandardEnergyCompileSmoke

namespace MGAP4D
namespace MathlibAnalytic

noncomputable section

/-- The current special-unitary physical weak-limit frontier packages both the
concrete finite `SU(N)` Wilson system and the canonical standard-energy
continuum weak-limit constructor. -/
structure PhysicalYangMillsSpecialUnitaryFinalFrontier where
  finiteGeometry : FiniteFourDimensionalPlaquetteGeometry
  rank : ℕ
  rank_pos : 0 < rank
  rankNontrivial : Nontrivial (Matrix.specialUnitaryGroup (Fin rank) ℂ)
  beta : ℝ
  beta_nonneg : 0 ≤ beta
  physicalEmbedding : ContinuousCompactGaugeWilsonPhysicalEmbedding
  periodicGeometry : physicalEmbedding.PeriodicHypercubicPlaquetteFamily
  standardEnergy : physicalEmbedding.WilsonSpecialUnitaryStandardEnergyFamily
  functional : physicalEmbedding.PhysicalConfiguration → NNReal
  functional_proper : IsProperMap functional
  functional_le_action :
    ∀ n U,
      (functional (physicalEmbedding.interpolate n U) : ENNReal) ≤
        physicalEmbedding.renormalizedWilsonActionObservable
          periodicGeometry.reciprocalPlaquetteScale
          (fun _ : ℕ => (0 : ENNReal)) n U

namespace PhysicalYangMillsSpecialUnitaryFinalFrontier

/-- The concrete finite continuous `SU(N)` Wilson system attached to the
frontier geometry and coupling. -/
def finiteSystem
    (F : PhysicalYangMillsSpecialUnitaryFinalFrontier) :
    ContinuousCompactGaugeWilsonSystem := by
  letI : Nontrivial (Matrix.specialUnitaryGroup (Fin F.rank) ℂ) :=
    F.rankNontrivial
  exact specialUnitaryContinuousCompactGaugeWilsonSystem
    F.finiteGeometry F.rank F.rank_pos F.beta F.beta_nonneg

/-- The physical subsequential continuum weak limit generated by the frontier
receipts. -/
noncomputable def weakLimit
    (F : PhysicalYangMillsSpecialUnitaryFinalFrontier) :
    PhysicalFourDimensionalYangMillsWeakLimit :=
  continuous_compact_gauge_wilson_weak_limit_of_periodicHypercubicSpecialUnitaryStandardEnergyProperNNRealFunctional
    F.physicalEmbedding F.periodicGeometry F.standardEnergy
      F.functional F.functional_proper F.functional_le_action

end PhysicalYangMillsSpecialUnitaryFinalFrontier

end

end MathlibAnalytic
end MGAP4D
