local instance osBoundaryOneSidedPhysicalTransferSpatialLinkFintype (H : ℕ) :
    Fintype (PeriodicHypercubicEvenSpatialSliceLink H) :=
  Fintype.ofFinite _

local instance osBoundaryOneSidedPhysicalTransferSpatialSliceHaarSFinite (H N : ℕ) :
    SFinite (periodicHypercubicEvenSpecialUnitarySpatialSliceHaarMeasure H N) := by
  unfold periodicHypercubicEvenSpecialUnitarySpatialSliceHaarMeasure
  infer_instance

/-- Forgetting only the Gauss-law subtype is an exact isometry from the full
physical one-slice Hilbert space into ambient spatial-slice Haar `L²`. -/
noncomputable def periodicHypercubicEvenSpecialUnitaryPhysicalModeL2LinearIsometry
    (H N : ℕ) :
    periodicHypercubicEvenSpecialUnitarySpatialSliceGaugeInvariantL2Submodule H N →ₗᵢ[ℝ]
      Lp ℝ 2 (periodicHypercubicEvenSpecialUnitarySpatialSliceHaarMeasure H N) where
  toLinearMap :=
    (periodicHypercubicEvenSpecialUnitarySpatialSliceGaugeInvariantL2Submodule H N).subtype
  norm_map' f := rfl

@[simp] theorem periodicHypercubicEvenSpecialUnitaryPhysicalModeL2LinearIsometry_apply
    (H N : ℕ)
    (f : periodicHypercubicEvenSpecialUnitarySpatialSliceGaugeInvariantL2Submodule H N) :
    periodicHypercubicEvenSpecialUnitaryPhysicalModeL2LinearIsometry H N f =
      periodicHypercubicEvenSpecialUnitaryPhysicalModeLp H N f := by
  rfl

/-- Embed an arbitrary physical one-slice state into ordered endpoint-pair Haar
`L²` by tensoring it with the normalized physical top mode on the companion
endpoint.  Unlike the excitation-only construction, this map is defined on the
whole Gauss-invariant physical slice Hilbert space. -/
noncomputable def periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalPairLinearMap
    (H N : ℕ)
    (hN : 0 < N)
    (beta : ℝ)
    (hbeta : 0 ≤ beta) :
    periodicHypercubicEvenSpecialUnitarySpatialSliceGaugeInvariantL2Submodule H N →ₗ[ℝ]
      PeriodicHypercubicEvenSpecialUnitarySpatialSlicePairHaarL2 H N where
  toFun f :=
    realL2ExternalTensor
      (periodicHypercubicEvenSpecialUnitaryPhysicalModeL2LinearIsometry H N f)
      (periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabTopModeL2
        H N hN beta hbeta)
  map_add' f g := by
    rw [map_add, realL2ExternalTensor_add_left]
    rfl
  map_smul' c f := by
    rw [map_smul, realL2ExternalTensor_smul_left]
    rfl

/-- Tensoring with the unit top mode is an exact isometry on the full physical
slice Hilbert space. -/
noncomputable def periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalPairLinearIsometry
    (H N : ℕ)
    (hN : 0 < N)
    (beta : ℝ)
    (hbeta : 0 ≤ beta) :
    periodicHypercubicEvenSpecialUnitarySpatialSliceGaugeInvariantL2Submodule H N →ₗᵢ[ℝ]
      PeriodicHypercubicEvenSpecialUnitarySpatialSlicePairHaarL2 H N where
  toLinearMap :=
    periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalPairLinearMap
      H N hN beta hbeta
  norm_map' f := by
    change
      ‖realL2ExternalTensor
        (periodicHypercubicEvenSpecialUnitaryPhysicalModeL2LinearIsometry H N f)
        (periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabTopModeL2
          H N hN beta hbeta)‖ = ‖f‖
    rw [realL2ExternalTensor_norm]
    rw [(periodicHypercubicEvenSpecialUnitaryPhysicalModeL2LinearIsometry H N).norm_map]
    rw [periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabTopModeL2_norm]
    simp

/-- Concrete full one-particle pair sector generated by `f ↦ f ⊗ Ω_top`. -/
abbrev periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalPairSector
    (H N : ℕ)
    (hN : 0 < N)
    (beta : ℝ)
    (hbeta : 0 ≤ beta) :=
  LinearMap.range
    (periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalPairLinearMap
      H N hN beta hbeta)

/-- The complete Gauss-invariant physical slice Hilbert space is isometrically
equivalent to its one-sided pair realization. -/
noncomputable def periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalPairEquiv
    (H N : ℕ)
    (hN : 0 < N)
    (beta : ℝ)
    (hbeta : 0 ≤ beta) :
    periodicHypercubicEvenSpecialUnitarySpatialSliceGaugeInvariantL2Submodule H N ≃ₗᵢ[ℝ]
      periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalPairSector
        H N hN beta hbeta where
  toLinearEquiv :=
    LinearEquiv.ofInjective
      (periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalPairLinearMap
        H N hN beta hbeta)
      (periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalPairLinearIsometry
        H N hN beta hbeta).injective
  norm_map' f :=
    (periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalPairLinearIsometry
      H N hN beta hbeta).norm_map f

/-- Transport the full one-sided physical isometry to the genuine shared Wilson
reflection-boundary Haar `L²` carrier. -/
noncomputable def periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalBoundaryLinearIsometry
    (H N : ℕ)
    (hN : 0 < N)
    (beta : ℝ)
    (hbeta : 0 ≤ beta) :
    periodicHypercubicEvenSpecialUnitarySpatialSliceGaugeInvariantL2Submodule H N →ₗᵢ[ℝ]
      PeriodicHypercubicEvenSpecialUnitaryBoundaryHaarL2 H N where
  toLinearMap :=
    (periodicHypercubicEvenSpatialSlicePairHaarL2ToBoundaryLinearIsometry H N).toLinearMap.comp
      (periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalPairLinearMap
        H N hN beta hbeta)
  norm_map' f := by
    change
      ‖periodicHypercubicEvenSpatialSlicePairHaarL2ToBoundaryLinearIsometry H N
        (periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalPairLinearMap
          H N hN beta hbeta f)‖ = ‖f‖
    rw [(periodicHypercubicEvenSpatialSlicePairHaarL2ToBoundaryLinearIsometry H N).norm_map]
    exact
      (periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalPairLinearIsometry
        H N hN beta hbeta).norm_map f

/-- Concrete full one-particle sector in shared-boundary Haar `L²`. -/
abbrev periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalBoundarySector
    (H N : ℕ)
    (hN : 0 < N)
    (beta : ℝ)
    (hbeta : 0 ≤ beta) :=
  LinearMap.range
    (periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalBoundaryLinearIsometry
      H N hN beta hbeta).toLinearMap

/-- The physical slice Hilbert space is isometrically equivalent to its actual
shared-boundary one-particle range. -/
noncomputable def periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalBoundaryEquiv
    (H N : ℕ)
    (hN : 0 < N)
    (beta : ℝ)
    (hbeta : 0 ≤ beta) :
    periodicHypercubicEvenSpecialUnitarySpatialSliceGaugeInvariantL2Submodule H N ≃ₗᵢ[ℝ]
      periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalBoundarySector
        H N hN beta hbeta where
  toLinearEquiv :=
    LinearEquiv.ofInjective
      (periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalBoundaryLinearIsometry
        H N hN beta hbeta).toLinearMap
      (periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalBoundaryLinearIsometry
        H N hN beta hbeta).injective
  norm_map' f :=
    (periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalBoundaryLinearIsometry
      H N hN beta hbeta).norm_map f

/-- The ambient pair realization is exactly the previously canonical
`physicalMode ⊗ physicalTopMode` vector. -/
theorem periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalPairLinearIsometry_apply
    (H N : ℕ)
    (hN : 0 < N)
    (beta : ℝ)
    (hbeta : 0 ≤ beta)
    (f : periodicHypercubicEvenSpecialUnitarySpatialSliceGaugeInvariantL2Submodule H N) :
    periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalPairLinearIsometry
        H N hN beta hbeta f =
      periodicHypercubicEvenSpecialUnitaryOneSidedPairL2 H N
        (periodicHypercubicEvenSpecialUnitaryPhysicalModeLp H N f)
        (periodicHypercubicEvenSpecialUnitaryPhysicalTopModeLp
          H N hN beta hbeta) := by
  rfl

/-- The shared-boundary realization is exactly the canonical one-sided Wilson
boundary vector. -/
theorem periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalBoundaryLinearIsometry_apply
    (H N : ℕ)
    (hN : 0 < N)
    (beta : ℝ)
    (hbeta : 0 ≤ beta)
    (f : periodicHypercubicEvenSpecialUnitarySpatialSliceGaugeInvariantL2Submodule H N) :
    periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalBoundaryLinearIsometry
        H N hN beta hbeta f =
      periodicHypercubicEvenSpecialUnitaryOneSidedBoundaryL2 H N
        (periodicHypercubicEvenSpecialUnitaryPhysicalModeLp H N f)
        (periodicHypercubicEvenSpecialUnitaryPhysicalTopModeLp
          H N hN beta hbeta) := by
  rfl

/-- The full one-sided pair transfer is the actual normalized physical transfer
power conjugated through the exact `f ⊗ Ω_top` pair isometry. -/
noncomputable def periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalPairSectorTransfer
    (H N : ℕ)
    (hN : 0 < N)
    (beta : ℝ)
    (hbeta : 0 ≤ beta)
    (n : ℕ) :
    periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalPairSector
        H N hN beta hbeta →L[ℝ]
      periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalPairSector
        H N hN beta hbeta :=
  continuousLinearMapConjugateLinearIsometryEquiv
    (periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalPairEquiv
      H N hN beta hbeta)
    ((periodicHypercubicEvenSpecialUnitaryNormalizedPhysicalOneSlabTransferOperator
      H N hN beta hbeta) ^ n)

/-- Exact pair-sector intertwining on every represented physical state. -/
@[simp] theorem periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalPairSectorTransfer_apply_image
    (H N : ℕ)
    (hN : 0 < N)
    (beta : ℝ)
    (hbeta : 0 ≤ beta)
    (n : ℕ)
    (f : periodicHypercubicEvenSpecialUnitarySpatialSliceGaugeInvariantL2Submodule H N) :
    periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalPairSectorTransfer
        H N hN beta hbeta n
        (periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalPairEquiv
          H N hN beta hbeta f) =
      periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalPairEquiv
        H N hN beta hbeta
        (((periodicHypercubicEvenSpecialUnitaryNormalizedPhysicalOneSlabTransferOperator
          H N hN beta hbeta) ^ n) f) := by
  exact
    continuousLinearMapConjugateLinearIsometryEquiv_apply_image
      (periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalPairEquiv
        H N hN beta hbeta)
      ((periodicHypercubicEvenSpecialUnitaryNormalizedPhysicalOneSlabTransferOperator
        H N hN beta hbeta) ^ n) f

/-- The corresponding full one-sided transfer on the actual shared-boundary
sector. -/
noncomputable def periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalBoundarySectorTransfer
    (H N : ℕ)
    (hN : 0 < N)
    (beta : ℝ)
    (hbeta : 0 ≤ beta)
    (n : ℕ) :
    periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalBoundarySector
        H N hN beta hbeta →L[ℝ]
      periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalBoundarySector
        H N hN beta hbeta :=
  continuousLinearMapConjugateLinearIsometryEquiv
    (periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalBoundaryEquiv
      H N hN beta hbeta)
    ((periodicHypercubicEvenSpecialUnitaryNormalizedPhysicalOneSlabTransferOperator
      H N hN beta hbeta) ^ n)

/-- Exact shared-boundary-sector intertwining on every represented physical
state. -/
@[simp] theorem periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalBoundarySectorTransfer_apply_image
    (H N : ℕ)
    (hN : 0 < N)
    (beta : ℝ)
    (hbeta : 0 ≤ beta)
    (n : ℕ)
    (f : periodicHypercubicEvenSpecialUnitarySpatialSliceGaugeInvariantL2Submodule H N) :
    periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalBoundarySectorTransfer
        H N hN beta hbeta n
        (periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalBoundaryEquiv
          H N hN beta hbeta f) =
      periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalBoundaryEquiv
        H N hN beta hbeta
        (((periodicHypercubicEvenSpecialUnitaryNormalizedPhysicalOneSlabTransferOperator
          H N hN beta hbeta) ^ n) f) := by
  exact
    continuousLinearMapConjugateLinearIsometryEquiv_apply_image
      (periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalBoundaryEquiv
        H N hN beta hbeta)
      ((periodicHypercubicEvenSpecialUnitaryNormalizedPhysicalOneSlabTransferOperator
        H N hN beta hbeta) ^ n) f

/-- At one step, the ambient pair representative of the full one-sided physical
sector transfer is exactly the canonical one-step pair vector. -/
theorem periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalPair_oneStep
    (H N : ℕ)
    (hN : 0 < N)
    (beta : ℝ)
    (hbeta : 0 ≤ beta)
    (f : periodicHypercubicEvenSpecialUnitarySpatialSliceGaugeInvariantL2Submodule H N) :
    periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalPairLinearIsometry
        H N hN beta hbeta
        (periodicHypercubicEvenSpecialUnitaryNormalizedPhysicalOneSlabTransferOperator
          H N hN beta hbeta f) =
      periodicHypercubicEvenSpecialUnitaryOneSidedPairOneStepL2
        H N
        (periodicHypercubicEvenSpecialUnitaryPhysicalModeOneStepLp
          H N hN beta hbeta f)
        (periodicHypercubicEvenSpecialUnitaryPhysicalModeOneStepLp
          H N hN beta hbeta
          (periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabTopEigenvector
            H N hN beta hbeta)) := by
  rw [periodicHypercubicEvenSpecialUnitaryPhysicalModeOneStepLp_top_eq]
  rfl

/-- Consequently every arbitrary pair-Haar test vector sees the one-step
one-sided physical transfer through the exact normalized raw Wilson kernel
coefficient.  No decomposable-test density argument is used. -/
theorem periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalPair_oneStep_inner_eq_rawKernel
    (H N : ℕ)
    (hN : 0 < N)
    (beta : ℝ)
    (hbeta : 0 ≤ beta)
    (f : periodicHypercubicEvenSpecialUnitarySpatialSliceGaugeInvariantL2Submodule H N)
    (z : PeriodicHypercubicEvenSpecialUnitarySpatialSlicePairHaarL2 H N) :
    inner ℝ
        (periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalPairLinearIsometry
          H N hN beta hbeta
          (periodicHypercubicEvenSpecialUnitaryNormalizedPhysicalOneSlabTransferOperator
            H N hN beta hbeta f)) z =
      ‖periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabTransferOperator
          H N hN beta hbeta‖⁻¹ *
        realL2HilbertSchmidtKernelPairing z
          (periodicHypercubicEvenSpecialUnitaryTemporalGaugeOneSlabTransferOperator
            H N hN beta hbeta
            (periodicHypercubicEvenSpecialUnitaryPhysicalModeLp H N f))
          (periodicHypercubicEvenSpecialUnitaryPhysicalTopModeLp
            H N hN beta hbeta) := by
  rw [periodicHypercubicEvenSpecialUnitaryOneSidedPhysicalPair_oneStep]
  exact
    periodicHypercubicEvenSpecialUnitaryOneSidedPairOneStep_top_inner_eq_rawKernel
      H N hN beta hbeta f z

end

