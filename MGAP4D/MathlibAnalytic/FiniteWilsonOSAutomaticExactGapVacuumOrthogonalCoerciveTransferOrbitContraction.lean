import MGAP4D.MathlibAnalytic.FiniteWilsonOSAutomaticExactGapCoerciveTransferOrbitContraction
import Mathlib.Analysis.InnerProductSpace.Orthogonal

namespace MGAP4D
namespace MathlibAnalytic

open Filter

noncomputable section

/-- The one-dimensional line generated by a candidate vacuum vector. -/
def finiteVacuumLine
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (vacuum : E) : Submodule ℝ E :=
  ℝ ∙ vacuum

/-- The finite-dimensional excitation sector orthogonal to the vacuum line. -/
def finiteVacuumOrthogonal
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (vacuum : E) : Submodule ℝ E :=
  (finiteVacuumLine vacuum)ᗮ

/-- Finite-volume Hamiltonian data with a normalized zero-energy vacuum and a
uniform quadratic-form lower bound only on the physical excitation sector
`Ω⊥`.  No positive lower bound is imposed on the full state space. -/
structure FiniteWilsonVacuumOrthogonalHamiltonianGapData where
  StateSpace : Type
  [stateNormedAddCommGroup : NormedAddCommGroup StateSpace]
  [stateInnerProductSpace : InnerProductSpace ℝ StateSpace]
  [stateFiniteDimensional : FiniteDimensional ℝ StateSpace]
  vacuum : StateSpace
  vacuum_norm : ‖vacuum‖ = 1
  hamiltonian : ℕ → StateSpace →ₗ[ℝ] StateSpace
  hamiltonianSymmetric :
    ∀ n : ℕ, (hamiltonian n).IsSymmetric
  vacuumEnergyZero :
    ∀ n : ℕ, hamiltonian n vacuum = 0
  hamiltonianPreservesVacuumOrthogonal :
    ∀ (n : ℕ) (x : StateSpace),
      x ∈ finiteVacuumOrthogonal vacuum →
        hamiltonian n x ∈ finiteVacuumOrthogonal vacuum
  hamiltonianQuadraticFormLowerBoundOnVacuumOrthogonal :
    ∀ (n : ℕ) (x : StateSpace),
      x ∈ finiteVacuumOrthogonal vacuum →
        exactGapValueReal * ‖x‖ ^ 2 ≤
          inner ℝ (hamiltonian n x) x
  ExcitedDimension : ℕ
  excitedFinrank :
    Module.finrank ℝ (finiteVacuumOrthogonal vacuum) = ExcitedDimension

attribute [instance]
  FiniteWilsonVacuumOrthogonalHamiltonianGapData.stateNormedAddCommGroup
  FiniteWilsonVacuumOrthogonalHamiltonianGapData.stateInnerProductSpace
  FiniteWilsonVacuumOrthogonalHamiltonianGapData.stateFiniteDimensional

/-- Carrier of the finite-volume physical excitation sector `Ω⊥`. -/
abbrev FiniteWilsonVacuumOrthogonalHamiltonianGapData.ExcitedStateSpace
    (G : FiniteWilsonVacuumOrthogonalHamiltonianGapData) : Type :=
  finiteVacuumOrthogonal G.vacuum

/-- Restriction of the finite-volume Hamiltonian to the invariant excitation
sector `Ω⊥`. -/
noncomputable def
    FiniteWilsonVacuumOrthogonalHamiltonianGapData.restrictedHamiltonian
    (G : FiniteWilsonVacuumOrthogonalHamiltonianGapData)
    (n : ℕ) : G.ExcitedStateSpace →ₗ[ℝ] G.ExcitedStateSpace :=
  { toFun := fun x =>
      ⟨G.hamiltonian n (x : G.StateSpace),
        G.hamiltonianPreservesVacuumOrthogonal
          n (x : G.StateSpace) x.property⟩
    map_add' := by
      intro x y
      apply Subtype.ext
      simpa using (G.hamiltonian n).map_add
        (x : G.StateSpace) (y : G.StateSpace)
    map_smul' := by
      intro c x
      apply Subtype.ext
      simpa using (G.hamiltonian n).map_smul c (x : G.StateSpace) }

/-- The restriction remains symmetric on the inherited inner-product space. -/
theorem finite_wilson_vacuum_orthogonal_restricted_hamiltonian_symmetric
    (G : FiniteWilsonVacuumOrthogonalHamiltonianGapData)
    (n : ℕ) :
    (G.restrictedHamiltonian n).IsSymmetric := by
  intro x y
  change inner ℝ
      (G.hamiltonian n (x : G.StateSpace)) (y : G.StateSpace) =
    inner ℝ (x : G.StateSpace)
      (G.hamiltonian n (y : G.StateSpace))
  exact G.hamiltonianSymmetric n (x : G.StateSpace) (y : G.StateSpace)

/-- The excitation-sector coercive estimate descends to the restricted
Hamiltonian without imposing a false positive lower bound on the vacuum. -/
theorem finite_wilson_vacuum_orthogonal_restricted_hamiltonian_coercive
    (G : FiniteWilsonVacuumOrthogonalHamiltonianGapData)
    (n : ℕ) (x : G.ExcitedStateSpace) :
    exactGapValueReal * ‖x‖ ^ 2 ≤
      inner ℝ (G.restrictedHamiltonian n x) x := by
  change exactGapValueReal * ‖(x : G.StateSpace)‖ ^ 2 ≤
    inner ℝ (G.hamiltonian n (x : G.StateSpace)) (x : G.StateSpace)
  exact G.hamiltonianQuadraticFormLowerBoundOnVacuumOrthogonal
    n (x : G.StateSpace) x.property

/-- Every eigenvalue of the Hamiltonian restricted to `Ω⊥` lies above the
uniform exact gap. -/
theorem finite_wilson_vacuum_orthogonal_restricted_eigenvalues_ge_exactGap
    (G : FiniteWilsonVacuumOrthogonalHamiltonianGapData)
    (n : ℕ) (i : Fin G.ExcitedDimension) :
    exactGapValueReal ≤
      (finite_wilson_vacuum_orthogonal_restricted_hamiltonian_symmetric G n).eigenvalues
        G.excitedFinrank i :=
  symmetric_eigenvalue_ge_of_quadratic_form_lower_bound
    (finite_wilson_vacuum_orthogonal_restricted_hamiltonian_symmetric G n)
    G.excitedFinrank
    exactGapValueReal
    (finite_wilson_vacuum_orthogonal_restricted_hamiltonian_coercive G n)
    i

/-- Finite Wilson correlation data whose transfer orbit lives directly in the
vacuum-orthogonal excitation sector. -/
structure FiniteWilsonOSAutomaticExactGapVacuumOrthogonalCoerciveTransferOrbitContractionData
    (W : FiniteWilsonOSAutomaticApproximationFamily) where
  Observable : Type
  gapData : FiniteWilsonVacuumOrthogonalHamiltonianGapData
  scale : ℕ → W.index
  leftObservable :
    (n : ℕ) → Observable → (W.system (scale n)).Configuration → ℝ
  rightObservable :
    (n : ℕ) → Observable → ℕ → (W.system (scale n)).Configuration → ℝ
  continuumConnectedCorrelation : Observable → ℕ → ℝ
  decayAmplitude : Observable → ℝ
  initialCorrelationState :
    ℕ → Observable → gapData.ExcitedStateSpace
  correlationReadout :
    ℕ → Observable → gapData.ExcitedStateSpace →L[ℝ] ℝ
  connectedCorrelation_representation :
    ∀ (n : ℕ) (O : Observable) (r : ℕ),
      (W.system (scale n)).gibbsConnectedCorrelation
          (leftObservable n O) (rightObservable n O r) =
        correlationReadout n O
          (continuousLinearMapOrbit
            (orthonormalDiagonalOperator
              ((finite_wilson_vacuum_orthogonal_restricted_hamiltonian_symmetric
                gapData n).eigenvectorBasis gapData.excitedFinrank)
              (fun i =>
                Real.exp
                  (-((finite_wilson_vacuum_orthogonal_restricted_hamiltonian_symmetric
                    gapData n).eigenvalues gapData.excitedFinrank i))))
            (initialCorrelationState n O) r)
  readoutInitialStateBound :
    ∀ (n : ℕ) (O : Observable),
      ‖correlationReadout n O‖ * ‖initialCorrelationState n O‖ ≤
        decayAmplitude O
  pointwiseConvergence :
    ∀ (O : Observable) (r : ℕ),
      Tendsto
        (fun n : ℕ =>
          (W.system (scale n)).gibbsConnectedCorrelation
            (leftObservable n O) (rightObservable n O r))
        atTop (nhds (continuumConnectedCorrelation O r))

/-- Enter the established coercive transfer-orbit route after restricting the
Hamiltonian to `Ω⊥` and proving coercivity there. -/
noncomputable def
    FiniteWilsonOSAutomaticExactGapVacuumOrthogonalCoerciveTransferOrbitContractionData.toCoerciveTransferOrbitData
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    (D : FiniteWilsonOSAutomaticExactGapVacuumOrthogonalCoerciveTransferOrbitContractionData W) :
    FiniteWilsonOSAutomaticExactGapCoerciveTransferOrbitContractionData W :=
  { Observable := D.Observable
    StateSpace := D.gapData.ExcitedStateSpace
    stateNormedAddCommGroup := inferInstance
    stateInnerProductSpace := inferInstance
    stateFiniteDimensional := inferInstance
    StateDimension := D.gapData.ExcitedDimension
    stateFinrank := D.gapData.excitedFinrank
    scale := D.scale
    leftObservable := D.leftObservable
    rightObservable := D.rightObservable
    continuumConnectedCorrelation := D.continuumConnectedCorrelation
    decayAmplitude := D.decayAmplitude
    hamiltonian := D.gapData.restrictedHamiltonian
    hamiltonianSymmetric :=
      finite_wilson_vacuum_orthogonal_restricted_hamiltonian_symmetric D.gapData
    hamiltonianQuadraticFormLowerBound :=
      finite_wilson_vacuum_orthogonal_restricted_hamiltonian_coercive D.gapData
    initialCorrelationState := D.initialCorrelationState
    correlationReadout := D.correlationReadout
    connectedCorrelation_representation := D.connectedCorrelation_representation
    readoutInitialStateBound := D.readoutInitialStateBound
    pointwiseConvergence := D.pointwiseConvergence }

/-- Vacuum-orthogonal coercivity generates finite-volume exact-gap connected
correlation decay. -/
theorem finite_wilson_exact_gap_bound_of_vacuum_orthogonal_coercive_hamiltonian
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    (D : FiniteWilsonOSAutomaticExactGapVacuumOrthogonalCoerciveTransferOrbitContractionData W)
    (n : ℕ) (O : D.Observable) (r : ℕ) :
    ‖(W.system (D.scale n)).gibbsConnectedCorrelation
        (D.leftObservable n O) (D.rightObservable n O r)‖ ≤
      D.decayAmplitude O * exactGapClusterContractionRatio ^ r :=
  finite_wilson_exact_gap_bound_of_coercive_hamiltonian
    D.toCoerciveTransferOrbitData n O r

/-- The continuum connected correlation inherits the exact-gap estimate from
coercivity on the physical excitation sector `Ω⊥`. -/
theorem finite_wilson_exact_gap_vacuum_orthogonal_coercive_continuum_bound
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    (D : FiniteWilsonOSAutomaticExactGapVacuumOrthogonalCoerciveTransferOrbitContractionData W)
    (O : D.Observable) (r : ℕ) :
    ‖D.continuumConnectedCorrelation O r‖ ≤
      D.decayAmplitude O * exactGapClusterContractionRatio ^ r :=
  finite_wilson_exact_gap_coercive_hamiltonian_continuum_bound
    D.toCoerciveTransferOrbitData O r

end

