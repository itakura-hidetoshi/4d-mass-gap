import MGAP4D.MathlibAnalytic.PeriodicHypercubicEvenSpecialUnitaryPhysicalTransferContinuousVacuumTopRayUniqueness
import MGAP4D.MathlibAnalytic.PeriodicHypercubicEvenSpecialUnitaryComplexPhysicalTopCFCProjection
import Mathlib.LinearAlgebra.Span.Basic
import Mathlib.Tactic

/-!
# One-dimensionality of the finite-volume complex Wilson top sector

The preceding positive-kernel theorem proves that every genuine real physical
top eigenvector is a real scalar multiple of the canonical nonnegative top
vector.  This file transports that uniqueness through the same-root complex
physical carrier.

The results identify

* the real normalized-transfer top eigenspace with the real span of the
  canonical nonnegative top vector;
* the genuine complex top eigenspace with the complex span of its real
  embedding;
* the range of the canonical complex CFC top projection with that same
  one-dimensional complex span.

No continuity of the excited-sector gap is used.
-/

namespace MGAP4D
namespace MathlibAnalytic

open Set
open scoped InnerProductSpace InnerProduct Ring Topology

noncomputable section

set_option maxHeartbeats 5000000
set_option synthInstance.maxHeartbeats 750000

local instance complexTopRayRankOneSpecialUnitaryIsTopologicalGroup
    (N : ℕ) :
    IsTopologicalGroup (Matrix.specialUnitaryGroup (Fin N) ℂ) :=
  specialUnitaryGroupIsTopologicalGroup N

local instance complexTopRayRankOneSpecialUnitaryCompactSpace
    (N : ℕ) :
    CompactSpace (Matrix.specialUnitaryGroup (Fin N) ℂ) :=
  specialUnitaryGroupCompactSpace N

local instance complexTopRayRankOneSpecialUnitarySecondCountableTopology
    (N : ℕ) :
    SecondCountableTopology (Matrix.specialUnitaryGroup (Fin N) ℂ) :=
  specialUnitaryGroupSecondCountableTopology N

local instance complexTopRayRankOneSpecialUnitaryMeasurableSpace
    (N : ℕ) :
    MeasurableSpace (Matrix.specialUnitaryGroup (Fin N) ℂ) :=
  specialUnitaryGroupMeasurableSpace N

local instance complexTopRayRankOneSpecialUnitaryBorelSpace
    (N : ℕ) :
    BorelSpace (Matrix.specialUnitaryGroup (Fin N) ℂ) :=
  specialUnitaryGroupBorelSpace N

local instance complexTopRayRankOneSpatialLinkFintype
    (H : ℕ) :
    Fintype (PeriodicHypercubicEvenSpatialSliceLink H) :=
  Fintype.ofFinite _

/-- The full real eigenvalue-one sector of the normalized physical one-slab
transfer is exactly the real line generated by the canonical nonnegative top
vector. -/
theorem
    periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabTopEigenspace_eq_span_nonnegativeTop
    (H N : ℕ)
    (hN : 0 < N)
    (beta : ℝ)
    (hbeta : 0 ≤ beta) :
    periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabTopEigenspace
        H N hN beta hbeta =
      ℝ ∙ periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabNonnegativeTopEigenvector
        H N hN beta hbeta := by
  let T :=
    periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabTransferOperator
      H N hN beta hbeta
  let Omega :=
    periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabNonnegativeTopEigenvector
      H N hN beta hbeta
  have hnorm : 0 < ‖T‖ := by
    simpa [T] using
      periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabTransferOperator_norm_pos
        H N hN beta hbeta
  have hOmegaTop :
      Omega ∈
        periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabTopEigenspace
          H N hN beta hbeta := by
    rw [periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabTopEigenspace_mem]
    have heig :=
      periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabNonnegativeTopEigenvector_eigen
        H N hN beta hbeta
    change ‖T‖⁻¹ • T Omega = Omega
    rw [show T Omega = ‖T‖ • Omega by simpa [T, Omega] using heig]
    rw [smul_smul, inv_mul_cancel₀ hnorm.ne', one_smul]
  apply le_antisymm
  · intro g hg
    have hfix :=
      (periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabTopEigenspace_mem
        H N hN beta hbeta g).1 hg
    have hfix' : ‖T‖⁻¹ • T g = g := by
      simpa [T,
        periodicHypercubicEvenSpecialUnitaryNormalizedPhysicalOneSlabTransferOperator_apply]
        using hfix
    have hscaled := congrArg (fun x => ‖T‖ • x) hfix'
    have hraw : T g = ‖T‖ • g := by
      simpa [smul_smul, hnorm.ne'] using hscaled
    obtain ⟨c, hc⟩ :=
      periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabTopEigenvector_eq_smul_nonnegativeTop
        H N hN beta hbeta g (by simpa [T] using hraw)
    exact Submodule.mem_span_singleton.mpr ⟨c, hc.symm⟩
  · intro g hg
    obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp hg
    rw [← hc]
    exact
      (periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabTopEigenspace
        H N hN beta hbeta).smul_mem c hOmegaTop

/-- The genuine complex eigenvalue-one sector is the complex line generated by
the real embedding of the canonical nonnegative top vector. -/
theorem
    periodicHypercubicEvenSpecialUnitaryComplexPhysicalOneSlabTopEigenspace_eq_span_nonnegativeTop
    (H N : ℕ)
    (hN : 0 < N)
    (beta : ℝ)
    (hbeta : 0 ≤ beta) :
    periodicHypercubicEvenSpecialUnitaryComplexPhysicalOneSlabTopEigenspace
        H N hN beta hbeta =
      ℂ ∙ periodicHypercubicEvenSpecialUnitaryPhysicalOfReal H N
        (periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabNonnegativeTopEigenvector
          H N hN beta hbeta) := by
  let Omega :=
    periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabNonnegativeTopEigenvector
      H N hN beta hbeta
  let OmegaC :=
    periodicHypercubicEvenSpecialUnitaryPhysicalOfReal H N Omega
  have hRealTop :=
    periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabTopEigenspace_eq_span_nonnegativeTop
      H N hN beta hbeta
  have hOmegaTop :
      Omega ∈
        periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabTopEigenspace
          H N hN beta hbeta := by
    rw [hRealTop]
    exact Submodule.mem_span_singleton_self Omega
  have hOmegaCTop :
      OmegaC ∈
        periodicHypercubicEvenSpecialUnitaryComplexPhysicalOneSlabTopEigenspace
          H N hN beta hbeta := by
    apply
      (periodicHypercubicEvenSpecialUnitaryComplexPhysicalOneSlabTopEigenspace_mem_iff_components
        H N hN beta hbeta OmegaC).2
    constructor
    · simpa [OmegaC, Omega] using hOmegaTop
    · simpa [OmegaC] using
        (show (0 :
          periodicHypercubicEvenSpecialUnitarySpatialSliceGaugeInvariantL2Submodule H N) ∈
          periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabTopEigenspace
            H N hN beta hbeta from
          (periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabTopEigenspace
            H N hN beta hbeta).zero_mem)
  apply le_antisymm
  · intro f hf
    have hcomp :=
      (periodicHypercubicEvenSpecialUnitaryComplexPhysicalOneSlabTopEigenspace_mem_iff_components
        H N hN beta hbeta f).1 hf
    have hreSpan :
        periodicHypercubicEvenSpecialUnitaryComplexPhysicalRealPart H N f ∈
          ℝ ∙ Omega := by
      rw [← hRealTop]
      exact hcomp.1
    have himSpan :
        periodicHypercubicEvenSpecialUnitaryComplexPhysicalImagPart H N f ∈
          ℝ ∙ Omega := by
      rw [← hRealTop]
      exact hcomp.2
    obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp hreSpan
    obtain ⟨b, hb⟩ := Submodule.mem_span_singleton.mp himSpan
    let c : ℂ := (a : ℂ) + Complex.I * (b : ℂ)
    refine Submodule.mem_span_singleton.mpr ⟨c, ?_⟩
    apply periodicHypercubicEvenSpecialUnitaryComplexPhysical_ext_components H N
    · rw [periodicHypercubicEvenSpecialUnitaryComplexPhysicalRealPart_smul]
      simp [c, OmegaC, Omega, ha]
    · rw [periodicHypercubicEvenSpecialUnitaryComplexPhysicalImagPart_smul]
      simp [c, OmegaC, Omega, hb]
  · intro f hf
    obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp hf
    rw [← hc]
    exact
      (periodicHypercubicEvenSpecialUnitaryComplexPhysicalOneSlabTopEigenspace
        H N hN beta hbeta).smul_mem c hOmegaCTop

/-- The canonical isolated-top CFC projection therefore has one-dimensional
complex range, generated by the complexified canonical nonnegative vacuum. -/
@[simp] theorem
    periodicHypercubicEvenSpecialUnitaryComplexPhysicalOneSlabCFCTopSpectralProjection_range_eq_span_nonnegativeTop
    (H N : ℕ)
    (hN : 0 < N)
    (beta : ℝ)
    (hbeta : 0 ≤ beta) :
    (periodicHypercubicEvenSpecialUnitaryComplexPhysicalOneSlabCFCTopSpectralProjection
      H N hN beta hbeta).range =
      ℂ ∙ periodicHypercubicEvenSpecialUnitaryPhysicalOfReal H N
        (periodicHypercubicEvenSpecialUnitaryPhysicalOneSlabNonnegativeTopEigenvector
          H N hN beta hbeta) := by
  rw [
    periodicHypercubicEvenSpecialUnitaryComplexPhysicalOneSlabCFCTopSpectralProjection_range,
    periodicHypercubicEvenSpecialUnitaryComplexPhysicalOneSlabTopEigenspace_eq_span_nonnegativeTop
  ]

end

end MathlibAnalytic
end MGAP4D
