      H N hN beta hbeta)

/-- Completion preserves orthogonality of `F ⊠ K` and `K ⊠ K`. -/
theorem periodicHypercubicEvenSpecialUnitaryPhysicalPairTopOrthogonalBlockClosure_isOrtho_orthogonalOrthogonalBlockClosure
    (H N : ℕ) (hN : 0 < N) (beta : ℝ) (hbeta : 0 ≤ beta) :
    periodicHypercubicEvenSpecialUnitaryPhysicalPairTopOrthogonalBlockClosure
        H N hN beta hbeta ⟂
      periodicHypercubicEvenSpecialUnitaryPhysicalPairOrthogonalOrthogonalBlockClosure
        H N hN beta hbeta := by
  exact isOrtho_topologicalClosure_of_isOrtho
    (periodicHypercubicEvenSpecialUnitaryPhysicalPairTopOrthogonalBlockSpan_isOrtho_orthogonalOrthogonalBlockSpan
      H N hN beta hbeta)

/-- The completed top-top block is orthogonal to the completed algebraic non-top
sector. -/
theorem periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockClosure_isOrtho_nonTopBlockClosure
    (H N : ℕ) (hN : 0 < N) (beta : ℝ) (hbeta : 0 ≤ beta) :
    periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockClosure
        H N hN beta hbeta ⟂
      periodicHypercubicEvenSpecialUnitaryPhysicalPairNonTopBlockClosure
        H N hN beta hbeta := by
  exact isOrtho_topologicalClosure_of_isOrtho
    (periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockSpan_isOrtho_nonTopBlockSpan
      H N hN beta hbeta)

/-- Every vector in the completed non-top block lies in the orthogonal complement
of the completed top-top block.  This is an inclusion only, not an equality. -/
theorem periodicHypercubicEvenSpecialUnitaryPhysicalPairNonTopBlockClosure_le_topTopBlockClosure_orthogonal
    (H N : ℕ) (hN : 0 < N) (beta : ℝ) (hbeta : 0 ≤ beta) :
    periodicHypercubicEvenSpecialUnitaryPhysicalPairNonTopBlockClosure
        H N hN beta hbeta ≤
      (periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockClosure
        H N hN beta hbeta)ᗮ := by
  exact
    (periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockClosure_isOrtho_nonTopBlockClosure
      H N hN beta hbeta).symm

/-- Audit-visible completed block orthogonality package.  It records the Hilbert
completion of the four decomposable block spans while keeping the unresolved
surjectivity/equality with a full pair-top orthogonal complement explicit. -/
structure PeriodicHypercubicEvenSpecialUnitaryPhysicalPairBlockClosureOrthogonalityPackage
    (H N : ℕ) (hN : 0 < N) (beta : ℝ) (hbeta : 0 ≤ beta) : Prop where
  topTop_orthogonalTop :
    periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockClosure H N hN beta hbeta ⟂
      periodicHypercubicEvenSpecialUnitaryPhysicalPairOrthogonalTopBlockClosure H N hN beta hbeta
  topTop_topOrthogonal :
    periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockClosure H N hN beta hbeta ⟂
      periodicHypercubicEvenSpecialUnitaryPhysicalPairTopOrthogonalBlockClosure H N hN beta hbeta
  topTop_orthogonalOrthogonal :
    periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockClosure H N hN beta hbeta ⟂
      periodicHypercubicEvenSpecialUnitaryPhysicalPairOrthogonalOrthogonalBlockClosure H N hN beta hbeta
  orthogonalTop_topOrthogonal :
    periodicHypercubicEvenSpecialUnitaryPhysicalPairOrthogonalTopBlockClosure H N hN beta hbeta ⟂
      periodicHypercubicEvenSpecialUnitaryPhysicalPairTopOrthogonalBlockClosure H N hN beta hbeta
  orthogonalTop_orthogonalOrthogonal :
    periodicHypercubicEvenSpecialUnitaryPhysicalPairOrthogonalTopBlockClosure H N hN beta hbeta ⟂
      periodicHypercubicEvenSpecialUnitaryPhysicalPairOrthogonalOrthogonalBlockClosure H N hN beta hbeta
  topOrthogonal_orthogonalOrthogonal :
    periodicHypercubicEvenSpecialUnitaryPhysicalPairTopOrthogonalBlockClosure H N hN beta hbeta ⟂
      periodicHypercubicEvenSpecialUnitaryPhysicalPairOrthogonalOrthogonalBlockClosure H N hN beta hbeta
  topTop_nonTop :
    periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockClosure H N hN beta hbeta ⟂
      periodicHypercubicEvenSpecialUnitaryPhysicalPairNonTopBlockClosure H N hN beta hbeta
  nonTop_le_topTop_orthogonal :
    periodicHypercubicEvenSpecialUnitaryPhysicalPairNonTopBlockClosure H N hN beta hbeta ≤
      (periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockClosure H N hN beta hbeta)ᗮ

/-- Construct the completed block orthogonality package from the algebraic span
package and closedness of orthogonal complements. -/
theorem periodicHypercubicEvenSpecialUnitaryPhysicalPairBlockClosureOrthogonalityPackage
    (H N : ℕ) (hN : 0 < N) (beta : ℝ) (hbeta : 0 ≤ beta) :
    PeriodicHypercubicEvenSpecialUnitaryPhysicalPairBlockClosureOrthogonalityPackage
      H N hN beta hbeta :=
  { topTop_orthogonalTop :=
      periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockClosure_isOrtho_orthogonalTopBlockClosure
        H N hN beta hbeta
    topTop_topOrthogonal :=
      periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockClosure_isOrtho_topOrthogonalBlockClosure
        H N hN beta hbeta
    topTop_orthogonalOrthogonal :=
      periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockClosure_isOrtho_orthogonalOrthogonalBlockClosure
        H N hN beta hbeta
    orthogonalTop_topOrthogonal :=
      periodicHypercubicEvenSpecialUnitaryPhysicalPairOrthogonalTopBlockClosure_isOrtho_topOrthogonalBlockClosure
        H N hN beta hbeta
    orthogonalTop_orthogonalOrthogonal :=
      periodicHypercubicEvenSpecialUnitaryPhysicalPairOrthogonalTopBlockClosure_isOrtho_orthogonalOrthogonalBlockClosure
        H N hN beta hbeta
    topOrthogonal_orthogonalOrthogonal :=
      periodicHypercubicEvenSpecialUnitaryPhysicalPairTopOrthogonalBlockClosure_isOrtho_orthogonalOrthogonalBlockClosure
        H N hN beta hbeta
    topTop_nonTop :=
      periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockClosure_isOrtho_nonTopBlockClosure
        H N hN beta hbeta
    nonTop_le_topTop_orthogonal :=
      periodicHypercubicEvenSpecialUnitaryPhysicalPairNonTopBlockClosure_le_topTopBlockClosure_orthogonal
        H N hN beta hbeta }

end

