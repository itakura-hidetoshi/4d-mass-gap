  exact isOrtho_topologicalClosure_of_isOrtho
    (periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockSpan_isOrtho_orthogonalOrthogonalBlockSpan
      H N hN beta hbeta)

/-- Completion preserves orthogonality of the two mixed blocks. -/
theorem periodicHypercubicEvenSpecialUnitaryPhysicalPairOrthogonalTopBlockClosure_isOrtho_topOrthogonalBlockClosure
    (H N : ℕ) (hN : 0 < N) (beta : ℝ) (hbeta : 0 ≤ beta) :
    periodicHypercubicEvenSpecialUnitaryPhysicalPairOrthogonalTopBlockClosure
        H N hN beta hbeta ⟂
      periodicHypercubicEvenSpecialUnitaryPhysicalPairTopOrthogonalBlockClosure
