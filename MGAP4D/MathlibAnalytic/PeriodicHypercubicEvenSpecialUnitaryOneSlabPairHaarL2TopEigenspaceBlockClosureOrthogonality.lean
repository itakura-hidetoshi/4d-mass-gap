open scoped InnerProductSpace InnerProduct

noncomputable section

local instance topEigenspaceBlockClosureTopologicalGroup (N : ℕ) :
    IsTopologicalGroup (Matrix.specialUnitaryGroup (Fin N) ℂ) :=
  specialUnitaryGroupIsTopologicalGroup N

local instance topEigenspaceBlockClosureCompactSpace (N : ℕ) :
    CompactSpace (Matrix.specialUnitaryGroup (Fin N) ℂ) :=
  specialUnitaryGroupCompactSpace N

local instance topEigenspaceBlockClosureSecondCountable (N : ℕ) :
    SecondCountableTopology (Matrix.specialUnitaryGroup (Fin N) ℂ) :=
  specialUnitaryGroupSecondCountableTopology N

local instance topEigenspaceBlockClosureMeasurableSpace (N : ℕ) :
    MeasurableSpace (Matrix.specialUnitaryGroup (Fin N) ℂ) :=
  specialUnitaryGroupMeasurableSpace N

local instance topEigenspaceBlockClosureBorelSpace (N : ℕ) :
    BorelSpace (Matrix.specialUnitaryGroup (Fin N) ℂ) :=
  specialUnitaryGroupBorelSpace N

local instance topEigenspaceBlockClosureSpatialLinkFintype (H : ℕ) :
    Fintype (PeriodicHypercubicEvenSpatialSliceLink H) :=
  Fintype.ofFinite _

local instance topEigenspaceBlockClosureSpatialSliceHaarSFinite (H N : ℕ) :
    SFinite (periodicHypercubicEvenSpecialUnitarySpatialSliceHaarMeasure H N) := by
  unfold periodicHypercubicEvenSpecialUnitarySpatialSliceHaarMeasure
  infer_instance

private theorem isOrtho_topologicalClosure_of_isOrtho
    {E : Type*}
    [NormedAddCommGroup E]
    [InnerProductSpace ℝ E]
    {U V : Submodule ℝ E}
    (h : U ⟂ V) :
    U.topologicalClosure ⟂ V.topologicalClosure := by
  rw [Submodule.isOrtho_iff_le, Submodule.orthogonal_closure]
  exact closure_minimal h V.isClosed_orthogonal

/-- Completed Hilbert block generated by the decomposable `F ⊠ F` vectors. -/
noncomputable def periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockClosure
    (H N : ℕ) (hN : 0 < N) (beta : ℝ) (hbeta : 0 ≤ beta) :
    Submodule ℝ (PeriodicHypercubicEvenSpecialUnitarySpatialSlicePairHaarL2 H N) :=
  (periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockSpan
    H N hN beta hbeta).topologicalClosure

/-- Completed Hilbert block generated by the decomposable `K ⊠ F` vectors. -/
noncomputable def periodicHypercubicEvenSpecialUnitaryPhysicalPairOrthogonalTopBlockClosure
    (H N : ℕ) (hN : 0 < N) (beta : ℝ) (hbeta : 0 ≤ beta) :
    Submodule ℝ (PeriodicHypercubicEvenSpecialUnitarySpatialSlicePairHaarL2 H N) :=
  (periodicHypercubicEvenSpecialUnitaryPhysicalPairOrthogonalTopBlockSpan
    H N hN beta hbeta).topologicalClosure

/-- Completed Hilbert block generated by the decomposable `F ⊠ K` vectors. -/
noncomputable def periodicHypercubicEvenSpecialUnitaryPhysicalPairTopOrthogonalBlockClosure
    (H N : ℕ) (hN : 0 < N) (beta : ℝ) (hbeta : 0 ≤ beta) :
    Submodule ℝ (PeriodicHypercubicEvenSpecialUnitarySpatialSlicePairHaarL2 H N) :=
  (periodicHypercubicEvenSpecialUnitaryPhysicalPairTopOrthogonalBlockSpan
    H N hN beta hbeta).topologicalClosure

/-- Completed Hilbert block generated by the decomposable `K ⊠ K` vectors. -/
noncomputable def periodicHypercubicEvenSpecialUnitaryPhysicalPairOrthogonalOrthogonalBlockClosure
    (H N : ℕ) (hN : 0 < N) (beta : ℝ) (hbeta : 0 ≤ beta) :
    Submodule ℝ (PeriodicHypercubicEvenSpecialUnitarySpatialSlicePairHaarL2 H N) :=
  (periodicHypercubicEvenSpecialUnitaryPhysicalPairOrthogonalOrthogonalBlockSpan
    H N hN beta hbeta).topologicalClosure

/-- Completed Hilbert non-top sector generated algebraically by all three blocks
carrying at least one excitation factor.  No equality with a full orthogonal
complement is asserted here. -/
noncomputable def periodicHypercubicEvenSpecialUnitaryPhysicalPairNonTopBlockClosure
    (H N : ℕ) (hN : 0 < N) (beta : ℝ) (hbeta : 0 ≤ beta) :
    Submodule ℝ (PeriodicHypercubicEvenSpecialUnitarySpatialSlicePairHaarL2 H N) :=
  (periodicHypercubicEvenSpecialUnitaryPhysicalPairNonTopBlockSpan
    H N hN beta hbeta).topologicalClosure

/-- Completion preserves orthogonality of the `F ⊠ F` and `K ⊠ F` blocks. -/
theorem periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockClosure_isOrtho_orthogonalTopBlockClosure
    (H N : ℕ) (hN : 0 < N) (beta : ℝ) (hbeta : 0 ≤ beta) :
    periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockClosure
        H N hN beta hbeta ⟂
      periodicHypercubicEvenSpecialUnitaryPhysicalPairOrthogonalTopBlockClosure
        H N hN beta hbeta := by
  exact isOrtho_topologicalClosure_of_isOrtho
    (periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockSpan_isOrtho_orthogonalTopBlockSpan
      H N hN beta hbeta)

/-- Completion preserves orthogonality of the `F ⊠ F` and `F ⊠ K` blocks. -/
theorem periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockClosure_isOrtho_topOrthogonalBlockClosure
    (H N : ℕ) (hN : 0 < N) (beta : ℝ) (hbeta : 0 ≤ beta) :
    periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockClosure
        H N hN beta hbeta ⟂
      periodicHypercubicEvenSpecialUnitaryPhysicalPairTopOrthogonalBlockClosure
        H N hN beta hbeta := by
  exact isOrtho_topologicalClosure_of_isOrtho
    (periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockSpan_isOrtho_topOrthogonalBlockSpan
      H N hN beta hbeta)

/-- Completion preserves orthogonality of the `F ⊠ F` and `K ⊠ K` blocks. -/
theorem periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockClosure_isOrtho_orthogonalOrthogonalBlockClosure
    (H N : ℕ) (hN : 0 < N) (beta : ℝ) (hbeta : 0 ≤ beta) :
    periodicHypercubicEvenSpecialUnitaryPhysicalPairTopTopBlockClosure
