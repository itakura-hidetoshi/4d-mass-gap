import MGAP4D.MathlibAnalytic.LinearMarkovTwoSidedIntegerPathOSHilbertShift
import Mathlib.Tactic

namespace MGAP4D
namespace MathlibAnalytic

noncomputable section

/-- The `n`-fold positive-time translation of a cylinder observable. -/
def linearMarkovPositiveTimeShiftIterate
    {Ω : Type*} [Fintype Ω] [MeasurableSpace Ω]
    (n : ℕ)
    (F : linearMarkovPositiveTimeCylinderSubalgebra (Ω := Ω)) :
    linearMarkovPositiveTimeCylinderSubalgebra (Ω := Ω) :=
  Nat.rec F (fun _ G => linearMarkovPositiveTimeShiftAlgHom G) n

@[simp] theorem linearMarkovPositiveTimeShiftIterate_zero
    {Ω : Type*} [Fintype Ω] [MeasurableSpace Ω]
    (F : linearMarkovPositiveTimeCylinderSubalgebra (Ω := Ω)) :
    linearMarkovPositiveTimeShiftIterate 0 F = F :=
  rfl

@[simp] theorem linearMarkovPositiveTimeShiftIterate_succ
    {Ω : Type*} [Fintype Ω] [MeasurableSpace Ω]
    (n : ℕ)
    (F : linearMarkovPositiveTimeCylinderSubalgebra (Ω := Ω)) :
    linearMarkovPositiveTimeShiftIterate (n + 1) F =
      linearMarkovPositiveTimeShiftAlgHom
        (linearMarkovPositiveTimeShiftIterate n F) :=
  rfl

namespace LinearMarkovTwoSidedIntegerPathOSPreHilbertData

variable {Ω : Type*} [Fintype Ω]
  [MeasurableSpace Ω] [MeasurableSingletonClass Ω]

/-- The discrete temporal OS transfer semigroup generated by the completed
one-step shift. -/
noncomputable def hilbertShiftSemigroup
    (D : LinearMarkovTwoSidedIntegerPathOSPreHilbertData Ω) :
    ℕ → D.Hilbert →L[ℝ] D.Hilbert
  | 0 => 1
  | n + 1 => D.hilbertShiftContinuousLinearMap.comp
      (D.hilbertShiftSemigroup n)

@[simp] theorem hilbertShiftSemigroup_zero
    (D : LinearMarkovTwoSidedIntegerPathOSPreHilbertData Ω) :
    D.hilbertShiftSemigroup 0 = 1 :=
  rfl

@[simp] theorem hilbertShiftSemigroup_succ
    (D : LinearMarkovTwoSidedIntegerPathOSPreHilbertData Ω)
    (n : ℕ) :
    D.hilbertShiftSemigroup (n + 1) =
      D.hilbertShiftContinuousLinearMap.comp
        (D.hilbertShiftSemigroup n) :=
  rfl

@[simp] theorem hilbertShiftSemigroup_zero_apply
    (D : LinearMarkovTwoSidedIntegerPathOSPreHilbertData Ω)
    (x : D.Hilbert) :
    D.hilbertShiftSemigroup 0 x = x := by
  rfl

@[simp] theorem hilbertShiftSemigroup_succ_apply
    (D : LinearMarkovTwoSidedIntegerPathOSPreHilbertData Ω)
    (n : ℕ)
    (x : D.Hilbert) :
    D.hilbertShiftSemigroup (n + 1) x =
      D.hilbertShiftContinuousLinearMap (D.hilbertShiftSemigroup n x) :=
  rfl

/-- The completed temporal shifts satisfy the additive semigroup law. -/
theorem hilbertShiftSemigroup_add
    (D : LinearMarkovTwoSidedIntegerPathOSPreHilbertData Ω)
    (m n : ℕ) :
    D.hilbertShiftSemigroup (m + n) =
      (D.hilbertShiftSemigroup m).comp (D.hilbertShiftSemigroup n) := by
  induction m with
  | zero =>
      ext x
      rfl
  | succ m ih =>
      ext x
      change D.hilbertShiftContinuousLinearMap
          (D.hilbertShiftSemigroup (m + n) x) =
        D.hilbertShiftContinuousLinearMap
          (D.hilbertShiftSemigroup m (D.hilbertShiftSemigroup n x))
      rw [ih]
      rfl

/-- Every discrete-time member remains norm nonincreasing. -/
theorem norm_hilbertShiftSemigroup_le
    (D : LinearMarkovTwoSidedIntegerPathOSPreHilbertData Ω)
    (n : ℕ)
    (x : D.Hilbert) :
    ‖D.hilbertShiftSemigroup n x‖ ≤ ‖x‖ := by
  induction n with
  | zero => rfl
  | succ n ih =>
      exact le_trans
        (D.norm_hilbertShiftContinuousLinearMap_le
          (D.hilbertShiftSemigroup n x)) ih

/-- The semigroup acts on completed observable classes by repeated
positive-time translation. -/
@[simp] theorem hilbertShiftSemigroup_completedObservableClass
    (D : LinearMarkovTwoSidedIntegerPathOSPreHilbertData Ω)
    (n : ℕ)
    (F : linearMarkovPositiveTimeCylinderSubalgebra (Ω := Ω)) :
    D.hilbertShiftSemigroup n (D.completedObservableClass F) =
      D.completedObservableClass
        (linearMarkovPositiveTimeShiftIterate n F) := by
  induction n with
  | zero => rfl
  | succ n ih =>
      rw [D.hilbertShiftSemigroup_succ_apply, ih,
        D.hilbertShiftContinuousLinearMap_completedObservableClass]
      rfl

end LinearMarkovTwoSidedIntegerPathOSPreHilbertData

end

end MathlibAnalytic
end MGAP4D
