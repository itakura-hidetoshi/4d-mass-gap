import MGAP4D.MathlibAnalytic.PeriodicHypercubicEvenFixedTimeClassification
import MGAP4D.MathlibAnalytic.FiniteInvolutiveEdgeBoundaryFiberedCoordinates

namespace MGAP4D
namespace MathlibAnalytic

open scoped BigOperators

noncomputable section

/-- The antipodal time `H+1` has additive order two in the even periodic time
circle of length `2(H+1)`. -/
@[simp]
theorem periodicHypercubicEven_halfPeriod_add_self
    (H : ℕ) :
    (((H + 1 : ℕ) : ZMod (PeriodicHypercubicEvenSideLength H)) +
      ((H + 1 : ℕ) : ZMod (PeriodicHypercubicEvenSideLength H))) = 0 := by
  rw [← Nat.cast_add]
  have hsum : H + 1 + (H + 1) = PeriodicHypercubicEvenSideLength H := by
    simp only [PeriodicHypercubicEvenSideLength]
    omega
  rw [hsum, ZMod.natCast_self]

/-- Negation fixes the antipodal time slice. -/
@[simp]
theorem periodicHypercubicEven_neg_halfPeriod
    (H : ℕ) :
    -((H + 1 : ℕ) : ZMod (PeriodicHypercubicEvenSideLength H)) =
      ((H + 1 : ℕ) : ZMod (PeriodicHypercubicEvenSideLength H)) := by
  let a : ZMod (PeriodicHypercubicEvenSideLength H) :=
    ((H + 1 : ℕ) : ZMod (PeriodicHypercubicEvenSideLength H))
  have hsum : a + a = 0 := by
    exact periodicHypercubicEven_halfPeriod_add_self H
  calc
    -a = -a + (a + a) := by rw [hsum]; simp
    _ = a := by abel

/-- Site reflection fixes every vertex on the primary reflection plane. -/
theorem periodicHypercubicEvenTimeReflection_eq_self_of_onPrimary
    (H : ℕ)
    (v : PeriodicHypercubicEvenVertex H)
    (hv : periodicHypercubicEvenOnPrimaryReflectionPlane H v) :
    periodicHypercubicEvenTimeReflection H v = v := by
  funext i
  by_cases hi : i = 0
  · subst i
    simp [periodicHypercubicEvenTimeReflection,
      periodicHypercubicEvenOnPrimaryReflectionPlane] at hv ⊢
    exact hv
  · simp [periodicHypercubicEvenTimeReflection, hi]

/-- Site reflection fixes every vertex on the antipodal reflection plane. -/
theorem periodicHypercubicEvenTimeReflection_eq_self_of_onAntipodal
    (H : ℕ)
    (v : PeriodicHypercubicEvenVertex H)
    (hv : periodicHypercubicEvenOnAntipodalReflectionPlane H v) :
    periodicHypercubicEvenTimeReflection H v = v := by
  funext i
  by_cases hi : i = 0
  · subst i
    unfold periodicHypercubicEvenOnAntipodalReflectionPlane at hv
    simp [periodicHypercubicEvenTimeReflection, hv,
      periodicHypercubicEven_neg_halfPeriod]
  · simp [periodicHypercubicEvenTimeReflection, hi]

/-- Site reflection fixes vertices on either reflection-fixed time slice. -/
theorem periodicHypercubicEvenTimeReflection_eq_self_of_on_fixedPlane
    (H : ℕ)
    (v : PeriodicHypercubicEvenVertex H)
    (hv : periodicHypercubicEvenOnPrimaryReflectionPlane H v ∨
      periodicHypercubicEvenOnAntipodalReflectionPlane H v) :
    periodicHypercubicEvenTimeReflection H v = v := by
  rcases hv with hv | hv
  · exact periodicHypercubicEvenTimeReflection_eq_self_of_onPrimary H v hv
  · exact periodicHypercubicEvenTimeReflection_eq_self_of_onAntipodal H v hv

/-- A spatial shift preserves the union of the two reflection-fixed time
slices. -/
theorem periodicHypercubicEven_shift_spatial_on_fixedPlane
    (H : ℕ)
    (v : PeriodicHypercubicEvenVertex H)
    (mu : PeriodicHypercubicAxis)
    (hmu : mu ≠ 0)
    (hv : periodicHypercubicEvenOnPrimaryReflectionPlane H v ∨
      periodicHypercubicEvenOnAntipodalReflectionPlane H v) :
    periodicHypercubicEvenOnPrimaryReflectionPlane H
        (periodicHypercubicShift (PeriodicHypercubicEvenSideLength H) v mu) ∨
      periodicHypercubicEvenOnAntipodalReflectionPlane H
        (periodicHypercubicShift (PeriodicHypercubicEvenSideLength H) v mu) := by
  have h0mu : (0 : PeriodicHypercubicAxis) ≠ mu := Ne.symm hmu
  rcases hv with hv | hv
  · left
    unfold periodicHypercubicEvenOnPrimaryReflectionPlane at hv ⊢
    simp [periodicHypercubicShift_apply, h0mu, hv]
  · right
    unfold periodicHypercubicEvenOnAntipodalReflectionPlane at hv ⊢
    simp [periodicHypercubicShift_apply, h0mu, hv]

/-- Every spatial link based on a reflection-fixed slice is fixed by physical
link reflection. -/
theorem periodicHypercubicEvenEdgeReflection_eq_self_of_spatial_on_fixedPlane
    (H : ℕ)
    (e : PeriodicHypercubicEvenEdge H)
    (hspace : e.2 ≠ 0)
    (hfixed : periodicHypercubicEvenOnPrimaryReflectionPlane H e.1 ∨
      periodicHypercubicEvenOnAntipodalReflectionPlane H e.1) :
    periodicHypercubicEvenEdgeReflection H e = e := by
  rw [periodicHypercubicEvenEdgeReflection_spatial H e hspace]
  apply Prod.ext
  · exact periodicHypercubicEvenTimeReflection_eq_self_of_on_fixedPlane
      H e.1 hfixed
  · rfl

/-- An edge fixed pointwise by link reflection belongs to the fixed edge-side
sector generated by the reflection-compatible time rank. -/
theorem periodicHypercubicEvenEdgeSide_eq_fixed_of_reflection_eq
    (H : ℕ)
    (e : PeriodicHypercubicEvenEdge H)
    (hreflection : periodicHypercubicEvenEdgeReflection H e = e) :
    periodicHypercubicEvenEdgeSide H e = ReflectionEdgeSide.fixed := by
  simp [periodicHypercubicEvenEdgeSide, finiteInvolutiveEdgeRankSide,
    hreflection]

/-- Every physical link in the signed boundary of a spatial crossing plaquette
belongs to the reflection-fixed edge sector. -/
theorem periodicHypercubicEvenSpatialCrossing_boundaryStep_edge_side_fixed
    {H : ℕ}
    (p : PeriodicHypercubicEvenPlaquette H)
    (hp : periodicHypercubicEvenSpatialCrossingPlaquette p)
    (k : Fin 4) :
    (periodicHypercubicEvenEdgeOrbitPartition H).side
        (periodicHypercubicBoundaryStep
          (PeriodicHypercubicEvenSideLength H) p k).edge =
      ReflectionEdgeSide.fixed := by
  have hgeom :=
    (periodicHypercubicEvenSpatialCrossingPlaquette_iff_on_fixedPlane p).1 hp
  have htime := hgeom.1
  have hfixed := hgeom.2
  have hmu : periodicHypercubicPlaquetteFirstAxis p ≠ 0 :=
    periodicHypercubicEvenPlaquetteFirstAxis_ne_zero_of_not_hasTimeDirection
      p htime
  have hnu : periodicHypercubicPlaquetteSecondAxis p ≠ 0 :=
    periodicHypercubicEvenPlaquetteSecondAxis_ne_zero_of_not_hasTimeDirection
      p htime
  change periodicHypercubicEvenEdgeSide H
      (periodicHypercubicBoundaryStep
        (PeriodicHypercubicEvenSideLength H) p k).edge =
    ReflectionEdgeSide.fixed
  fin_cases k
  · change periodicHypercubicEvenEdgeSide H
      (p.1, periodicHypercubicPlaquetteFirstAxis p) =
        ReflectionEdgeSide.fixed
    apply periodicHypercubicEvenEdgeSide_eq_fixed_of_reflection_eq
    exact periodicHypercubicEvenEdgeReflection_eq_self_of_spatial_on_fixedPlane
      H _ hmu hfixed
  · change periodicHypercubicEvenEdgeSide H
      (periodicHypercubicShift (PeriodicHypercubicEvenSideLength H) p.1
          (periodicHypercubicPlaquetteFirstAxis p),
        periodicHypercubicPlaquetteSecondAxis p) =
        ReflectionEdgeSide.fixed
    apply periodicHypercubicEvenEdgeSide_eq_fixed_of_reflection_eq
    exact periodicHypercubicEvenEdgeReflection_eq_self_of_spatial_on_fixedPlane
      H _ hnu
        (periodicHypercubicEven_shift_spatial_on_fixedPlane
          H p.1 (periodicHypercubicPlaquetteFirstAxis p) hmu hfixed)
  · change periodicHypercubicEvenEdgeSide H
      (periodicHypercubicShift (PeriodicHypercubicEvenSideLength H) p.1
          (periodicHypercubicPlaquetteSecondAxis p),
        periodicHypercubicPlaquetteFirstAxis p) =
        ReflectionEdgeSide.fixed
    apply periodicHypercubicEvenEdgeSide_eq_fixed_of_reflection_eq
    exact periodicHypercubicEvenEdgeReflection_eq_self_of_spatial_on_fixedPlane
      H _ hmu
        (periodicHypercubicEven_shift_spatial_on_fixedPlane
          H p.1 (periodicHypercubicPlaquetteSecondAxis p) hnu hfixed)
  · change periodicHypercubicEvenEdgeSide H
      (p.1, periodicHypercubicPlaquetteSecondAxis p) =
        ReflectionEdgeSide.fixed
    apply periodicHypercubicEvenEdgeSide_eq_fixed_of_reflection_eq
    exact periodicHypercubicEvenEdgeReflection_eq_self_of_spatial_on_fixedPlane
      H _ hnu hfixed

/-- On a spatial crossing plaquette, boundary-fibered assembly reads every
signed-boundary link from the shared boundary configuration. -/
theorem periodicHypercubicEvenBoundaryFiberedAssemble_spatialCrossing_boundaryStep
    {H : ℕ}
    {Value : Type*}
    (b : (periodicHypercubicEvenEdgeOrbitPartition H).BoundaryConfiguration Value)
    (x y : (periodicHypercubicEvenEdgeOrbitPartition H).OpenHalfConfiguration Value)
    (p : PeriodicHypercubicEvenPlaquette H)
    (hp : periodicHypercubicEvenSpatialCrossingPlaquette p)
    (k : Fin 4) :
    (periodicHypercubicEvenEdgeOrbitPartition H).boundaryFiberedAssemble b x y
        (periodicHypercubicBoundaryStep
          (PeriodicHypercubicEvenSideLength H) p k).edge =
      b ⟨(periodicHypercubicBoundaryStep
          (PeriodicHypercubicEvenSideLength H) p k).edge,
        periodicHypercubicEvenSpatialCrossing_boundaryStep_edge_side_fixed
          p hp k⟩ := by
  exact
    (periodicHypercubicEvenEdgeOrbitPartition H).boundaryFiberedAssemble_fixed
      b x y
      ⟨(periodicHypercubicBoundaryStep
          (PeriodicHypercubicEvenSideLength H) p k).edge,
        periodicHypercubicEvenSpatialCrossing_boundaryStep_edge_side_fixed
          p hp k⟩

/-- The holonomy of a spatial crossing plaquette in boundary-fibered coordinates
is independent of both open-half configurations. -/
theorem periodicHypercubicEvenSpatialCrossingPlaquetteHolonomy_boundaryFiberedAssemble_independent
    {H : ℕ}
    {Gauge : Type*}
    [Group Gauge]
    (b : (periodicHypercubicEvenEdgeOrbitPartition H).BoundaryConfiguration Gauge)
    (x₁ y₁ x₂ y₂ :
      (periodicHypercubicEvenEdgeOrbitPartition H).OpenHalfConfiguration Gauge)
    (p : PeriodicHypercubicEvenPlaquette H)
    (hp : periodicHypercubicEvenSpatialCrossingPlaquette p) :
    periodicHypercubicPlaquetteHolonomy
        ((periodicHypercubicEvenEdgeOrbitPartition H).boundaryFiberedAssemble
          b x₁ y₁) p =
      periodicHypercubicPlaquetteHolonomy
        ((periodicHypercubicEvenEdgeOrbitPartition H).boundaryFiberedAssemble
          b x₂ y₂) p := by
  have hvalue (k : Fin 4) :
      (periodicHypercubicEvenEdgeOrbitPartition H).boundaryFiberedAssemble
          b x₁ y₁
          (periodicHypercubicBoundaryStep
            (PeriodicHypercubicEvenSideLength H) p k).edge =
        (periodicHypercubicEvenEdgeOrbitPartition H).boundaryFiberedAssemble
          b x₂ y₂
          (periodicHypercubicBoundaryStep
            (PeriodicHypercubicEvenSideLength H) p k).edge := by
    rw [periodicHypercubicEvenBoundaryFiberedAssemble_spatialCrossing_boundaryStep
      b x₁ y₁ p hp k]
    rw [periodicHypercubicEvenBoundaryFiberedAssemble_spatialCrossing_boundaryStep
      b x₂ y₂ p hp k]
  have hstep (k : Fin 4) :
      periodicHypercubicStepValue
          ((periodicHypercubicEvenEdgeOrbitPartition H).boundaryFiberedAssemble
            b x₁ y₁)
          (periodicHypercubicBoundaryStep
            (PeriodicHypercubicEvenSideLength H) p k) =
        periodicHypercubicStepValue
          ((periodicHypercubicEvenEdgeOrbitPartition H).boundaryFiberedAssemble
            b x₂ y₂)
          (periodicHypercubicBoundaryStep
            (PeriodicHypercubicEvenSideLength H) p k) := by
    cases h_orientation :
      (periodicHypercubicBoundaryStep
        (PeriodicHypercubicEvenSideLength H) p k).orientation <;>
      simp [periodicHypercubicStepValue, h_orientation, hvalue k]
  unfold periodicHypercubicPlaquetteHolonomy
  rw [hstep 0, hstep 1, hstep 2, hstep 3]

/-- The spatial crossing Wilson action in boundary-fibered coordinates depends
only on the shared boundary configuration. -/
theorem periodicHypercubicEvenSpatialCrossingWilsonAction_boundaryFiberedAssemble_independent
    (H N : ℕ)
    [Nontrivial (Matrix.specialUnitaryGroup (Fin N) ℂ)]
    (b : (periodicHypercubicEvenEdgeOrbitPartition H).BoundaryConfiguration
      (Matrix.specialUnitaryGroup (Fin N) ℂ))
    (x₁ y₁ x₂ y₂ :
      (periodicHypercubicEvenEdgeOrbitPartition H).OpenHalfConfiguration
        (Matrix.specialUnitaryGroup (Fin N) ℂ)) :
    periodicHypercubicEvenSpatialCrossingWilsonAction H N
        ((periodicHypercubicEvenEdgeOrbitPartition H).boundaryFiberedAssemble
          b x₁ y₁) =
      periodicHypercubicEvenSpatialCrossingWilsonAction H N
        ((periodicHypercubicEvenEdgeOrbitPartition H).boundaryFiberedAssemble
          b x₂ y₂) := by
  classical
  unfold periodicHypercubicEvenSpatialCrossingWilsonAction
  apply Finset.sum_congr rfl
  intro p _hp
  by_cases hspatial : periodicHypercubicEvenSpatialCrossingPlaquette p
  · have hholonomy :=
      periodicHypercubicEvenSpatialCrossingPlaquetteHolonomy_boundaryFiberedAssemble_independent
        b x₁ y₁ x₂ y₂ p hspatial
    rw [hholonomy]
  · simp [propositionIndicator, hspatial]

/-- The spatial crossing Boltzmann weight in boundary-fibered coordinates
therefore depends only on the shared boundary configuration. -/
theorem periodicHypercubicEvenSpatialCrossingWilsonBoltzmannWeight_boundaryFiberedAssemble_independent
    (H N : ℕ)
    [Nontrivial (Matrix.specialUnitaryGroup (Fin N) ℂ)]
    (beta : ℝ)
    (b : (periodicHypercubicEvenEdgeOrbitPartition H).BoundaryConfiguration
      (Matrix.specialUnitaryGroup (Fin N) ℂ))
    (x₁ y₁ x₂ y₂ :
      (periodicHypercubicEvenEdgeOrbitPartition H).OpenHalfConfiguration
        (Matrix.specialUnitaryGroup (Fin N) ℂ)) :
    periodicHypercubicEvenSpatialCrossingWilsonBoltzmannWeight H N beta
        ((periodicHypercubicEvenEdgeOrbitPartition H).boundaryFiberedAssemble
          b x₁ y₁) =
      periodicHypercubicEvenSpatialCrossingWilsonBoltzmannWeight H N beta
        ((periodicHypercubicEvenEdgeOrbitPartition H).boundaryFiberedAssemble
          b x₂ y₂) := by
  unfold periodicHypercubicEvenSpatialCrossingWilsonBoltzmannWeight
  rw [periodicHypercubicEvenSpatialCrossingWilsonAction_boundaryFiberedAssemble_independent
    H N b x₁ y₁ x₂ y₂]

/-- Boundary-only spatial crossing Boltzmann weight, defined using identity
open-half configurations. -/
noncomputable def periodicHypercubicEvenBoundarySpatialCrossingWilsonBoltzmannWeight
    (H N : ℕ)
    [Nontrivial (Matrix.specialUnitaryGroup (Fin N) ℂ)]
    (beta : ℝ)
    (b : (periodicHypercubicEvenEdgeOrbitPartition H).BoundaryConfiguration
      (Matrix.specialUnitaryGroup (Fin N) ℂ)) : ℝ :=
  periodicHypercubicEvenSpatialCrossingWilsonBoltzmannWeight H N beta
    ((periodicHypercubicEvenEdgeOrbitPartition H).boundaryFiberedAssemble
      b (fun _ => 1) (fun _ => 1))

/-- Every boundary-fibered realization of the spatial crossing weight equals
the boundary-only representative. -/
theorem periodicHypercubicEvenSpatialCrossingWilsonBoltzmannWeight_boundaryFiberedAssemble_eq_boundary
    (H N : ℕ)
    [Nontrivial (Matrix.specialUnitaryGroup (Fin N) ℂ)]
    (beta : ℝ)
    (b : (periodicHypercubicEvenEdgeOrbitPartition H).BoundaryConfiguration
      (Matrix.specialUnitaryGroup (Fin N) ℂ))
    (x y : (periodicHypercubicEvenEdgeOrbitPartition H).OpenHalfConfiguration
      (Matrix.specialUnitaryGroup (Fin N) ℂ)) :
    periodicHypercubicEvenSpatialCrossingWilsonBoltzmannWeight H N beta
        ((periodicHypercubicEvenEdgeOrbitPartition H).boundaryFiberedAssemble
          b x y) =
      periodicHypercubicEvenBoundarySpatialCrossingWilsonBoltzmannWeight
        H N beta b := by
  exact
    periodicHypercubicEvenSpatialCrossingWilsonBoltzmannWeight_boundaryFiberedAssemble_independent
      H N beta b x y (fun _ => 1) (fun _ => 1)

end

end MathlibAnalytic
