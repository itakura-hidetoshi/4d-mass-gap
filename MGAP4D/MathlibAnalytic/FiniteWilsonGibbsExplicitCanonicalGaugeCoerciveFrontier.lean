import MGAP4D.MathlibAnalytic.FiniteWilsonGibbsExplicitCanonicalGaugeFrontier
import MGAP4D.MathlibAnalytic.FiniteWilsonGibbsSingleSourceCoerciveTransferOrbitOSLimitAssembly

namespace MGAP4D
namespace MathlibAnalytic

open MeasureTheory

noncomputable section

/-!
Connect the explicit canonical gauge realization to the existing coercive
transfer-orbit OS-limit assembly without routing continuum cylinder observables
through the one-step exact-gap input surface.
-/

local instance finiteWilsonExplicitCanonicalGaugeCoercive_fieldValueFintype
    (W : FiniteWilsonOSAutomaticApproximationFamily)
    (s : W.index)
    (x : EuclideanFourSpace) :
    Fintype ((finiteWilsonExplicitCanonicalGaugeRealization W s).fieldValue x) := by
  change Fintype (W.system s).Gauge
  infer_instance

local instance finiteWilsonExplicitCanonicalGaugeCoercive_fieldValueCountable
    (W : FiniteWilsonOSAutomaticApproximationFamily)
    (s : W.index)
    (x : EuclideanFourSpace) :
    Countable ((finiteWilsonExplicitCanonicalGaugeRealization W s).fieldValue x) := by
  change Countable (W.system s).Gauge
  infer_instance

local instance finiteWilsonExplicitCanonicalGaugeCoercive_fieldValueDiscrete
    (W : FiniteWilsonOSAutomaticApproximationFamily)
    (s : W.index)
    (x : EuclideanFourSpace) :
    DiscreteMeasurableSpace
      ((finiteWilsonExplicitCanonicalGaugeRealization W s).fieldValue x) := by
  change DiscreteMeasurableSpace (W.system s).Gauge
  infer_instance

local instance finiteWilsonExplicitCanonicalGaugeCoercive_configurationNontrivial
    (W : FiniteWilsonOSAutomaticApproximationFamily)
    (s : W.index)
    [Nonempty (W.system s).Edge] :
    Nontrivial
      ((W.system
        (finiteWilsonExplicitCanonicalGaugeRealization W s).sourceScale).Configuration) := by
  change Nontrivial ((W.system s).Edge → (W.system s).Gauge)
  infer_instance

/-- The automatic OS-limit datum generated by the existing coercive
transfer-orbit assembly for the explicit canonical gauge realization. -/
noncomputable def finiteWilsonExplicitCanonicalGaugeCoerciveAutomaticOSLimitData
    (W : FiniteWilsonOSAutomaticApproximationFamily)
    (s : W.index)
    (D : FiniteWilsonGibbsSingleSourceCoerciveTransferOrbitOSLimitData
      (finiteWilsonExplicitCanonicalGaugeRealization W s)) :
    FiniteWilsonGibbsSingleSourceAutomaticOSLimitData
      (finiteWilsonExplicitCanonicalGaugeRealization W s) :=
  D.toConstructedTransferOrbitAnalyticData
    |>.toConstructedHamiltonianTransferAnalyticData
    |>.toHamiltonianEigenactionAnalyticData
    |>.toFiniteDimensionalHamiltonianAnalyticData
    |>.toOrthonormalEigenbasisAnalyticData
    |>.toFiniteSpectralAnalyticData
    |>.toPositiveRayleighAnalyticData
    |>.toSymmetricRayleighAnalyticData
    |>.toTransferAnalyticData
    |>.toAutomaticData

/-- Continuum cylinder Schwinger value generated from arbitrary automatic
single-source OS-limit data.  Exact-gap one-step data are not needed for this
projective-marginal construction. -/
noncomputable def finiteWilsonAutomaticContinuumCylinderSchwingerValue
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    (R : FiniteWilsonGibbsSingleSourceProjectiveRealization W)
    [∀ x, Fintype (R.fieldValue x)]
    [∀ x, Countable (R.fieldValue x)]
    [∀ x, DiscreteMeasurableSpace (R.fieldValue x)]
    (D : FiniteWilsonGibbsSingleSourceAutomaticOSLimitData R)
    (J : Finset EuclideanFourSpace)
    (O : FiniteWilsonGibbsCylinderObservable R J) : ℝ :=
  ∫ X, O X ∂((R.explicitOSContinuumConstruction
    (R.automaticOSLimitTransferData D)).limit.continuumMeasure.map J.restrict)

/-- Automatic OS-limit cylinder values recover exactly the fixed Wilson Gibbs
source marginal. -/
theorem finite_wilson_automatic_continuum_cylinder_schwinger_eq_source
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    (R : FiniteWilsonGibbsSingleSourceProjectiveRealization W)
    [∀ x, Fintype (R.fieldValue x)]
    [∀ x, Countable (R.fieldValue x)]
    [∀ x, DiscreteMeasurableSpace (R.fieldValue x)]
    (D : FiniteWilsonGibbsSingleSourceAutomaticOSLimitData R)
    (J : Finset EuclideanFourSpace)
    (O : FiniteWilsonGibbsCylinderObservable R J) :
    finiteWilsonAutomaticContinuumCylinderSchwingerValue R D J O =
      finiteWilsonGibbsCylinderSchwingerValue R J O := by
  change
    (∫ X, O X ∂(R.projectiveLimitMeasure.continuumMeasure.map J.restrict)) =
      ∫ X, O X ∂((W.system R.sourceScale).gibbsMeasure.map (R.observe J))
  rw [euclidean_yang_mills_projective_limit_recovers_marginal]
  rfl

/-- Connected correlation in the continuum marginal generated by arbitrary
automatic single-source OS-limit data. -/
noncomputable def finiteWilsonAutomaticContinuumCylinderConnectedCorrelation
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    (R : FiniteWilsonGibbsSingleSourceProjectiveRealization W)
    [∀ x, Fintype (R.fieldValue x)]
    [∀ x, Countable (R.fieldValue x)]
    [∀ x, DiscreteMeasurableSpace (R.fieldValue x)]
    (D : FiniteWilsonGibbsSingleSourceAutomaticOSLimitData R)
    (J : Finset EuclideanFourSpace)
    (O₁ O₂ : FiniteWilsonGibbsCylinderObservable R J) : ℝ :=
  finiteWilsonAutomaticContinuumCylinderSchwingerValue R D J
      (fun X => O₁ X * O₂ X) -
    finiteWilsonAutomaticContinuumCylinderSchwingerValue R D J O₁ *
      finiteWilsonAutomaticContinuumCylinderSchwingerValue R D J O₂

/-- Automatic OS-limit connected correlations are exactly the fixed-source
connected correlations. -/
theorem finite_wilson_automatic_continuum_cylinder_connected_eq_source
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    (R : FiniteWilsonGibbsSingleSourceProjectiveRealization W)
    [∀ x, Fintype (R.fieldValue x)]
    [∀ x, Countable (R.fieldValue x)]
    [∀ x, DiscreteMeasurableSpace (R.fieldValue x)]
    (D : FiniteWilsonGibbsSingleSourceAutomaticOSLimitData R)
    (J : Finset EuclideanFourSpace)
    (O₁ O₂ : FiniteWilsonGibbsCylinderObservable R J) :
    finiteWilsonAutomaticContinuumCylinderConnectedCorrelation R D J O₁ O₂ =
      finiteWilsonGibbsCylinderConnectedCorrelation R J O₁ O₂ := by
  unfold finiteWilsonAutomaticContinuumCylinderConnectedCorrelation
    finiteWilsonGibbsCylinderConnectedCorrelation
  rw [finite_wilson_automatic_continuum_cylinder_schwinger_eq_source R D J
      (fun X => O₁ X * O₂ X),
    finite_wilson_automatic_continuum_cylinder_schwinger_eq_source R D J O₁,
    finite_wilson_automatic_continuum_cylinder_schwinger_eq_source R D J O₂]

/-- Any finite-source interaction witness survives under arbitrary automatic
single-source OS-limit data. -/
theorem finite_wilson_automatic_cylinder_interaction_passes_to_continuum
    {W : FiniteWilsonOSAutomaticApproximationFamily}
    (R : FiniteWilsonGibbsSingleSourceProjectiveRealization W)
    [∀ x, Fintype (R.fieldValue x)]
    [∀ x, Countable (R.fieldValue x)]
    [∀ x, DiscreteMeasurableSpace (R.fieldValue x)]
    (D : FiniteWilsonGibbsSingleSourceAutomaticOSLimitData R)
    (I : FiniteWilsonGibbsCylinderInteractionWitness R) :
    finiteWilsonAutomaticContinuumCylinderConnectedCorrelation R D I.support
      I.leftObservable I.rightObservable ≠ 0 := by
  rw [finite_wilson_automatic_continuum_cylinder_connected_eq_source]
  exact I.finiteConnectedCorrelation_ne_zero

/-- The coercive transfer-orbit assembly makes the explicit canonical continuum
measure package OS/Wightman-ready. -/
theorem finite_wilson_explicit_canonical_gauge_coercive_os_limit_ready
    (W : FiniteWilsonOSAutomaticApproximationFamily)
    (s : W.index)
    (D : FiniteWilsonGibbsSingleSourceCoerciveTransferOrbitOSLimitData
      (finiteWilsonExplicitCanonicalGaugeRealization W s)) :
    ((finiteWilsonExplicitCanonicalGaugeRealization W s).explicitOSContinuumConstruction
      ((finiteWilsonExplicitCanonicalGaugeRealization W s).automaticOSLimitTransferData
        (finiteWilsonExplicitCanonicalGaugeCoerciveAutomaticOSLimitData W s D))).toMeasurePackage.ready := by
  exact finite_wilson_single_source_automatic_os_limit_ready
    (finiteWilsonExplicitCanonicalGaugeRealization W s)
    (finiteWilsonExplicitCanonicalGaugeCoerciveAutomaticOSLimitData W s D)

/-- The explicit canonical finite interaction survives in the continuum law
constructed by the existing coercive transfer-orbit assembly. -/
theorem finite_wilson_explicit_canonical_gauge_coercive_interaction_passes_to_continuum
    (W : FiniteWilsonOSAutomaticApproximationFamily)
    (s : W.index)
    [Nonempty (W.system s).Edge]
    (D : FiniteWilsonGibbsSingleSourceCoerciveTransferOrbitOSLimitData
      (finiteWilsonExplicitCanonicalGaugeRealization W s)) :
    finiteWilsonAutomaticContinuumCylinderConnectedCorrelation
        (finiteWilsonExplicitCanonicalGaugeRealization W s)
        (finiteWilsonExplicitCanonicalGaugeCoerciveAutomaticOSLimitData W s D)
        (finiteWilsonExplicitCanonicalGaugeInteractionWitness W s).support
        (finiteWilsonExplicitCanonicalGaugeInteractionWitness W s).leftObservable
        (finiteWilsonExplicitCanonicalGaugeInteractionWitness W s).rightObservable ≠ 0 := by
  exact finite_wilson_automatic_cylinder_interaction_passes_to_continuum
    (finiteWilsonExplicitCanonicalGaugeRealization W s)
    (finiteWilsonExplicitCanonicalGaugeCoerciveAutomaticOSLimitData W s D)
    (finiteWilsonExplicitCanonicalGaugeInteractionWitness W s)

end

end MathlibAnalytic
end MGAP4D
