    (D : EuclideanYangMillsR4HilbertReconstructionQuotientSectionRangeEquivDataClosure S K R4 A G H N F C I O Q P R U J V W X Y Z T E) :
    Nonempty (EuclideanYangMillsR4HilbertReconstructionQuotientSectionRangeEquivTransportModel S K R4 A G H N F C I O Q P R U J V W X Y Z T E D) :=
  ⟨ofSectionRangeEquivDataClosure S K R4 A G H N F C I O Q P R U J V W X Y Z T E D⟩

end EuclideanYangMillsR4HilbertReconstructionQuotientSectionRangeEquivTransportModel

