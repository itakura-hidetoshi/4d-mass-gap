import MGAP4D.MathlibAnalytic.WightmanOSVacuumStarProjectionStructure
import MGAP4D.MathlibAnalytic.WightmanOSVacuumOrthogonalHamiltonianInvariance

namespace MGAP4D
namespace MathlibAnalytic

noncomputable section

open scoped InnerProductSpace

/-- The rank-one operator generated by a vector in the domain of a partial
linear operator again determines a domain point. -/
def realRankOneLinearPMapDomainPoint
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (A : H →ₗ.[ℝ] H) (Ω : H) (hΩDomain : Ω ∈ A.domain)
    (x : A.domain) : A.domain :=
  ⟨InnerProductSpace.rankOne ℝ Ω Ω (x : H), by
    change inner ℝ Ω (x : H) • Ω ∈ A.domain
    exact A.domain.smul_mem _ hΩDomain⟩

/-- The complementary rank-one operator also preserves the domain. -/
def realOneSubRankOneLinearPMapDomainPoint
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (A : H →ₗ.[ℝ] H) (Ω : H) (hΩDomain : Ω ∈ A.domain)
    (x : A.domain) : A.domain :=
  ⟨((1 : H →L[ℝ] H) - InnerProductSpace.rankOne ℝ Ω Ω) (x : H), by
    change (x : H) - inner ℝ Ω (x : H) • Ω ∈ A.domain
    exact A.domain.sub_mem x.property (A.domain.smul_mem _ hΩDomain)⟩

/-- If `Ω` is a zero vector for `A`, applying `A` after its rank-one component
is zero. -/
theorem real_rankOne_linearPMap_apply_eq_zero
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (A : H →ₗ.[ℝ] H) (Ω : H) (hΩDomain : Ω ∈ A.domain)
    (hAΩ : A ⟨Ω, hΩDomain⟩ = 0) (x : A.domain) :
    A (realRankOneLinearPMapDomainPoint A Ω hΩDomain x) = 0 := by
  have hPoint :
      realRankOneLinearPMapDomainPoint A Ω hΩDomain x =
        inner ℝ Ω (x : H) • (⟨Ω, hΩDomain⟩ : A.domain) := by
    apply Subtype.ext
    rfl
  have hAΩ' : A.toFun (⟨Ω, hΩDomain⟩ : A.domain) = 0 := hAΩ
  change A.toFun (realRankOneLinearPMapDomainPoint A Ω hΩDomain x) = 0
  rw [hPoint, A.toFun.map_smul, hAΩ', smul_zero]

/-- Formal self-adjointness and `A Ω = 0` imply that the rank-one vacuum
component of `A x` vanishes. -/
theorem real_rankOne_apply_linearPMap_eq_zero
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (A : H →ₗ.[ℝ] H) (Ω : H) (hΩDomain : Ω ∈ A.domain)
    (hFormal : A.IsFormalAdjoint A)
    (hAΩ : A ⟨Ω, hΩDomain⟩ = 0) (x : A.domain) :
    InnerProductSpace.rankOne ℝ Ω Ω (A x) = 0 := by
  have hSymmetry := hFormal ⟨Ω, hΩDomain⟩ x
  have hInner : inner ℝ Ω (A x) = 0 := by
    rw [← hSymmetry, hAΩ]
    simp
  change inner ℝ Ω (A x) • Ω = 0
  rw [hInner, zero_smul]

/-- Removing the zero-mode rank-one component before applying `A` does not
change the result. -/
theorem real_one_sub_rankOne_linearPMap_apply
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (A : H →ₗ.[ℝ] H) (Ω : H) (hΩDomain : Ω ∈ A.domain)
    (hAΩ : A ⟨Ω, hΩDomain⟩ = 0) (x : A.domain) :
    A (realOneSubRankOneLinearPMapDomainPoint A Ω hΩDomain x) = A x := by
  have hPoint :
      realOneSubRankOneLinearPMapDomainPoint A Ω hΩDomain x =
        x - realRankOneLinearPMapDomainPoint A Ω hΩDomain x := by
    apply Subtype.ext
    rfl
  have hRankOneZero :
      A.toFun (realRankOneLinearPMapDomainPoint A Ω hΩDomain x) = 0 :=
    real_rankOne_linearPMap_apply_eq_zero A Ω hΩDomain hAΩ x
  change A.toFun (realOneSubRankOneLinearPMapDomainPoint A Ω hΩDomain x) =
    A.toFun x
  rw [hPoint, A.toFun.map_sub, hRankOneZero, sub_zero]

/-- The complementary projection fixes `A x` when the rank-one component of
`A x` vanishes. -/
theorem real_one_sub_rankOne_apply_linearPMap
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (A : H →ₗ.[ℝ] H) (Ω : H) (hΩDomain : Ω ∈ A.domain)
    (hFormal : A.IsFormalAdjoint A)
    (hAΩ : A ⟨Ω, hΩDomain⟩ = 0) (x : A.domain) :
    ((1 : H →L[ℝ] H) - InnerProductSpace.rankOne ℝ Ω Ω) (A x) = A x := by
  change A x - InnerProductSpace.rankOne ℝ Ω Ω (A x) = A x
  rw [real_rankOne_apply_linearPMap_eq_zero A Ω hΩDomain hFormal hAΩ x,
    sub_zero]

/-- The rank-one zero-mode projection commutes with a formally self-adjoint
partial operator on its domain. -/
theorem real_rankOne_linearPMap_commutes_on_domain
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (A : H →ₗ.[ℝ] H) (Ω : H) (hΩDomain : Ω ∈ A.domain)
    (hFormal : A.IsFormalAdjoint A)
    (hAΩ : A ⟨Ω, hΩDomain⟩ = 0) (x : A.domain) :
    A (realRankOneLinearPMapDomainPoint A Ω hΩDomain x) =
      InnerProductSpace.rankOne ℝ Ω Ω (A x) := by
  rw [real_rankOne_linearPMap_apply_eq_zero A Ω hΩDomain hAΩ x,
    real_rankOne_apply_linearPMap_eq_zero A Ω hΩDomain hFormal hAΩ x]

/-- The complementary projection commutes with a formally self-adjoint partial
operator on its domain. -/
theorem real_one_sub_rankOne_linearPMap_commutes_on_domain
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (A : H →ₗ.[ℝ] H) (Ω : H) (hΩDomain : Ω ∈ A.domain)
    (hFormal : A.IsFormalAdjoint A)
    (hAΩ : A ⟨Ω, hΩDomain⟩ = 0) (x : A.domain) :
    A (realOneSubRankOneLinearPMapDomainPoint A Ω hΩDomain x) =
      ((1 : H →L[ℝ] H) - InnerProductSpace.rankOne ℝ Ω Ω) (A x) := by
  rw [real_one_sub_rankOne_linearPMap_apply A Ω hΩDomain hAΩ x,
    real_one_sub_rankOne_apply_linearPMap A Ω hΩDomain hFormal hAΩ x]

/-- The actual vacuum-line projection preserves the Hamiltonian domain. -/
theorem explicit_wightman_os_vacuumLine_starProjection_mem_hamiltonianDomain
    (M : ExplicitWightmanOSReconstructedModel) (x : M.hamiltonian.domain) :
    M.vacuumLine.starProjection (x : M.H) ∈ M.hamiltonian.domain := by
  rw [explicit_wightman_os_vacuumLine_starProjection_eq_rankOne M]
  exact (realRankOneLinearPMapDomainPoint M.hamiltonian M.vacuum
    M.vacuum_mem_hamiltonianDomain x).property

/-- The actual vacuum-orthogonal projection preserves the Hamiltonian domain. -/
theorem explicit_wightman_os_vacuumOrthogonal_starProjection_mem_hamiltonianDomain
    (M : ExplicitWightmanOSReconstructedModel) (x : M.hamiltonian.domain) :
    M.vacuumOrthogonal.starProjection (x : M.H) ∈ M.hamiltonian.domain := by
  rw [explicit_wightman_os_vacuumOrthogonal_starProjection_eq_one_sub_rankOne M]
  exact (realOneSubRankOneLinearPMapDomainPoint M.hamiltonian M.vacuum
    M.vacuum_mem_hamiltonianDomain x).property

/-- A Hamiltonian-domain point obtained by projecting onto the vacuum line. -/
def ExplicitWightmanOSReconstructedModel.vacuumLineProjectionHamiltonianDomainPoint
    (M : ExplicitWightmanOSReconstructedModel) (x : M.hamiltonian.domain) :
    M.hamiltonian.domain :=
  ⟨M.vacuumLine.starProjection (x : M.H),
    explicit_wightman_os_vacuumLine_starProjection_mem_hamiltonianDomain M x⟩

/-- A Hamiltonian-domain point obtained by projecting onto the physical
vacuum-orthogonal sector. -/
def ExplicitWightmanOSReconstructedModel.vacuumOrthogonalProjectionHamiltonianDomainPoint
    (M : ExplicitWightmanOSReconstructedModel) (x : M.hamiltonian.domain) :
    M.hamiltonian.domain :=
  ⟨M.vacuumOrthogonal.starProjection (x : M.H),
    explicit_wightman_os_vacuumOrthogonal_starProjection_mem_hamiltonianDomain M x⟩

/-- The Hamiltonian kills the projected vacuum-line component of every domain
vector. -/
theorem explicit_wightman_os_hamiltonian_vacuumLineProjection_eq_zero
    (M : ExplicitWightmanOSReconstructedModel) (x : M.hamiltonian.domain) :
    M.hamiltonian (M.vacuumLineProjectionHamiltonianDomainPoint x) = 0 := by
  have hPoint :
      M.vacuumLineProjectionHamiltonianDomainPoint x =
        realRankOneLinearPMapDomainPoint M.hamiltonian M.vacuum
          M.vacuum_mem_hamiltonianDomain x := by
    apply Subtype.ext
    change M.vacuumLine.starProjection (x : M.H) =
      InnerProductSpace.rankOne ℝ M.vacuum M.vacuum (x : M.H)
    rw [explicit_wightman_os_vacuumLine_starProjection_eq_rankOne M]
  rw [hPoint]
  exact real_rankOne_linearPMap_apply_eq_zero M.hamiltonian M.vacuum
    M.vacuum_mem_hamiltonianDomain M.vacuumEnergyZero x

/-- The vacuum-line projection of a Hamiltonian image is zero. -/
theorem explicit_wightman_os_vacuumLine_starProjection_hamiltonian_eq_zero
    (M : ExplicitWightmanOSReconstructedModel) (x : M.hamiltonian.domain) :
    M.vacuumLine.starProjection (M.hamiltonian x) = 0 := by
  rw [explicit_wightman_os_vacuumLine_starProjection_eq_rankOne M]
  exact real_rankOne_apply_linearPMap_eq_zero M.hamiltonian M.vacuum
    M.vacuum_mem_hamiltonianDomain
    (explicit_wightman_os_hamiltonian_isFormalSelfAdjoint M)
    M.vacuumEnergyZero x

/-- Projecting a domain vector onto `Ω⊥` before applying the Hamiltonian leaves
its Hamiltonian image unchanged. -/
theorem explicit_wightman_os_hamiltonian_vacuumOrthogonalProjection
    (M : ExplicitWightmanOSReconstructedModel) (x : M.hamiltonian.domain) :
    M.hamiltonian (M.vacuumOrthogonalProjectionHamiltonianDomainPoint x) =
      M.hamiltonian x := by
  have hPoint :
      M.vacuumOrthogonalProjectionHamiltonianDomainPoint x =
        realOneSubRankOneLinearPMapDomainPoint M.hamiltonian M.vacuum
          M.vacuum_mem_hamiltonianDomain x := by
    apply Subtype.ext
    change M.vacuumOrthogonal.starProjection (x : M.H) =
      ((1 : M.H →L[ℝ] M.H) -
        InnerProductSpace.rankOne ℝ M.vacuum M.vacuum) (x : M.H)
    rw [explicit_wightman_os_vacuumOrthogonal_starProjection_eq_one_sub_rankOne M]
  rw [hPoint]
  exact real_one_sub_rankOne_linearPMap_apply M.hamiltonian M.vacuum
    M.vacuum_mem_hamiltonianDomain M.vacuumEnergyZero x

/-- The vacuum-orthogonal projection fixes every Hamiltonian image. -/
theorem explicit_wightman_os_vacuumOrthogonal_starProjection_hamiltonian
    (M : ExplicitWightmanOSReconstructedModel) (x : M.hamiltonian.domain) :
    M.vacuumOrthogonal.starProjection (M.hamiltonian x) = M.hamiltonian x := by
  rw [explicit_wightman_os_vacuumOrthogonal_starProjection_eq_one_sub_rankOne M]
  exact real_one_sub_rankOne_apply_linearPMap M.hamiltonian M.vacuum
    M.vacuum_mem_hamiltonianDomain
    (explicit_wightman_os_hamiltonian_isFormalSelfAdjoint M)
    M.vacuumEnergyZero x

/-- The vacuum-line projection commutes with the Hamiltonian on its domain. -/
theorem explicit_wightman_os_vacuumLine_starProjection_commutes_hamiltonian_on_domain
    (M : ExplicitWightmanOSReconstructedModel) (x : M.hamiltonian.domain) :
    M.hamiltonian (M.vacuumLineProjectionHamiltonianDomainPoint x) =
      M.vacuumLine.starProjection (M.hamiltonian x) := by
  rw [explicit_wightman_os_hamiltonian_vacuumLineProjection_eq_zero,
    explicit_wightman_os_vacuumLine_starProjection_hamiltonian_eq_zero]

/-- The vacuum-orthogonal projection commutes with the Hamiltonian on its
full domain. -/
theorem explicit_wightman_os_vacuumOrthogonal_starProjection_commutes_hamiltonian_on_domain
    (M : ExplicitWightmanOSReconstructedModel) (x : M.hamiltonian.domain) :
    M.hamiltonian (M.vacuumOrthogonalProjectionHamiltonianDomainPoint x) =
      M.vacuumOrthogonal.starProjection (M.hamiltonian x) := by
  rw [explicit_wightman_os_hamiltonian_vacuumOrthogonalProjection,
    explicit_wightman_os_vacuumOrthogonal_starProjection_hamiltonian]

/-- Structured receipt for the domain-level reducing action of the two vacuum
sector projections. -/
structure WightmanOSVacuumHamiltonianProjectionReductionReceipt : Prop where
  generic_rankOne_domain :
    ∀ {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
      (A : H →ₗ.[ℝ] H) (Ω : H) (hΩDomain : Ω ∈ A.domain)
      (x : A.domain),
      InnerProductSpace.rankOne ℝ Ω Ω (x : H) ∈ A.domain
  generic_complement_domain :
    ∀ {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
      (A : H →ₗ.[ℝ] H) (Ω : H) (hΩDomain : Ω ∈ A.domain)
      (x : A.domain),
      ((1 : H →L[ℝ] H) - InnerProductSpace.rankOne ℝ Ω Ω) (x : H) ∈ A.domain
  generic_rankOne_commutes :
    ∀ {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
      (A : H →ₗ.[ℝ] H) (Ω : H) (hΩDomain : Ω ∈ A.domain)
      (hFormal : A.IsFormalAdjoint A)
      (hAΩ : A ⟨Ω, hΩDomain⟩ = 0) (x : A.domain),
      A (realRankOneLinearPMapDomainPoint A Ω hΩDomain x) =
        InnerProductSpace.rankOne ℝ Ω Ω (A x)
  generic_complement_commutes :
    ∀ {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
      (A : H →ₗ.[ℝ] H) (Ω : H) (hΩDomain : Ω ∈ A.domain)
      (hFormal : A.IsFormalAdjoint A)
      (hAΩ : A ⟨Ω, hΩDomain⟩ = 0) (x : A.domain),
      A (realOneSubRankOneLinearPMapDomainPoint A Ω hΩDomain x) =
        ((1 : H →L[ℝ] H) - InnerProductSpace.rankOne ℝ Ω Ω) (A x)
  actual_line_domain :
    ∀ (M : ExplicitWightmanOSReconstructedModel) (x : M.hamiltonian.domain),
      M.vacuumLine.starProjection (x : M.H) ∈ M.hamiltonian.domain
  actual_orthogonal_domain :
    ∀ (M : ExplicitWightmanOSReconstructedModel) (x : M.hamiltonian.domain),
      M.vacuumOrthogonal.starProjection (x : M.H) ∈ M.hamiltonian.domain
  actual_line_commutes :
    ∀ (M : ExplicitWightmanOSReconstructedModel) (x : M.hamiltonian.domain),
      M.hamiltonian (M.vacuumLineProjectionHamiltonianDomainPoint x) =
        M.vacuumLine.starProjection (M.hamiltonian x)
  actual_orthogonal_commutes :
    ∀ (M : ExplicitWightmanOSReconstructedModel) (x : M.hamiltonian.domain),
      M.hamiltonian (M.vacuumOrthogonalProjectionHamiltonianDomainPoint x) =
        M.vacuumOrthogonal.starProjection (M.hamiltonian x)
  claim_boundary : True

/-- The Hamiltonian projection-reduction receipt is inhabited. -/
theorem wightmanOSVacuumHamiltonianProjectionReductionReceipt_proved :
    WightmanOSVacuumHamiltonianProjectionReductionReceipt := by
  exact
    { generic_rankOne_domain := fun A Ω hΩDomain x =>
        (realRankOneLinearPMapDomainPoint A Ω hΩDomain x).property
      generic_complement_domain := fun A Ω hΩDomain x =>
        (realOneSubRankOneLinearPMapDomainPoint A Ω hΩDomain x).property
      generic_rankOne_commutes := real_rankOne_linearPMap_commutes_on_domain
      generic_complement_commutes :=
        real_one_sub_rankOne_linearPMap_commutes_on_domain
      actual_line_domain :=
        explicit_wightman_os_vacuumLine_starProjection_mem_hamiltonianDomain
      actual_orthogonal_domain :=
        explicit_wightman_os_vacuumOrthogonal_starProjection_mem_hamiltonianDomain
      actual_line_commutes :=
        explicit_wightman_os_vacuumLine_starProjection_commutes_hamiltonian_on_domain
      actual_orthogonal_commutes :=
        explicit_wightman_os_vacuumOrthogonal_starProjection_commutes_hamiltonian_on_domain
      claim_boundary := trivial }

end
end MathlibAnalytic
end MGAP4D
