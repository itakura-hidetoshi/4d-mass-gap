import MGAP4D.MathlibAnalytic.RealLinearPMapSelfAdjointCommonCoreIntertwining
import MGAP4D.MathlibAnalytic.DenseLinearIsometryClosedSubspaceCorestriction
import Mathlib.Tactic

namespace MGAP4D
namespace MathlibAnalytic

open Function Set Topology
open scoped InnerProductSpace LinearPMap

noncomputable section

/-- Self-adjoint common-core data stated through stable ambient Hilbert carriers.

The actual operators live on closed physical subspaces `S` and `T`, but the two
realizations of the common algebraic core are supplied as ambient linear
isometries.  Corestriction is canonical.  In contrast to the older
`RealLinearPMapClosedSubspaceCommonCoreClosureIntertwining`, there is no
independent `pullback_hasCore` field and no separately supplied `source_mem`:
source-domain membership is generated by `source_hasCore`, while target closure
is generated by self-adjoint maximality. -/
structure RealLinearPMapClosedSubspaceSelfAdjointCommonCoreIntertwining
    {C E F : Type}
    [NormedAddCommGroup C] [NormedSpace ℝ C]
    [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    [NormedAddCommGroup F] [InnerProductSpace ℝ F] [CompleteSpace F]
    {S : Submodule ℝ E} {T : Submodule ℝ F}
    [CompleteSpace S] [CompleteSpace T]
    (A : S →ₗ.[ℝ] S) (B : T →ₗ.[ℝ] T) where
  source : RealHilbertClosedSubspaceDenseCoreRealization (C := C) S
  target : RealHilbertClosedSubspaceDenseCoreRealization (C := C) T
  source_selfAdjoint : IsSelfAdjoint A
  target_selfAdjoint : IsSelfAdjoint B
  source_hasCore :
    A.HasCore
      (LinearMap.range
        (RealHilbertClosedSubspaceDenseCoreRealization.corestrict source).toLinearMap)
  target_mem : ∀ c : C,
    RealHilbertClosedSubspaceDenseCoreRealization.corestrict target c ∈ B.domain
  core_intertwines : ∀ c : C,
    B ⟨RealHilbertClosedSubspaceDenseCoreRealization.corestrict target c,
        target_mem c⟩ =
      realHilbertDenseCoreLinearIsometryEquiv
        (RealHilbertClosedSubspaceDenseCoreRealization.corestrict source)
        (RealHilbertClosedSubspaceDenseCoreRealization.corestrict_denseRange source)
        (RealHilbertClosedSubspaceDenseCoreRealization.corestrict target)
        (RealHilbertClosedSubspaceDenseCoreRealization.corestrict_denseRange target)
        (A ⟨RealHilbertClosedSubspaceDenseCoreRealization.corestrict source c,
          source_hasCore.le_domain ⟨c, rfl⟩⟩)

/-- The ambient closed-subspace package is exactly an instance of the generic
self-adjoint common-core theorem after canonical corestriction. -/
noncomputable def
    RealLinearPMapClosedSubspaceSelfAdjointCommonCoreIntertwining.toSelfAdjointCommonCoreIntertwining
    {C E F : Type}
    [NormedAddCommGroup C] [NormedSpace ℝ C]
    [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    [NormedAddCommGroup F] [InnerProductSpace ℝ F] [CompleteSpace F]
    {S : Submodule ℝ E} {T : Submodule ℝ F}
    [CompleteSpace S] [CompleteSpace T]
    {A : S →ₗ.[ℝ] S} {B : T →ₗ.[ℝ] T}
    (D : RealLinearPMapClosedSubspaceSelfAdjointCommonCoreIntertwining
      (C := C) A B) :
    RealLinearPMapSelfAdjointCommonCoreIntertwining (C := C) A B where
  source := RealHilbertClosedSubspaceDenseCoreRealization.corestrict D.source
  target := RealHilbertClosedSubspaceDenseCoreRealization.corestrict D.target
  source_dense :=
    RealHilbertClosedSubspaceDenseCoreRealization.corestrict_denseRange D.source
  target_dense :=
    RealHilbertClosedSubspaceDenseCoreRealization.corestrict_denseRange D.target
  source_selfAdjoint := D.source_selfAdjoint
  target_selfAdjoint := D.target_selfAdjoint
  source_hasCore := D.source_hasCore
  target_mem := D.target_mem
  core_intertwines := D.core_intertwines

/-- Source-domain membership of every algebraic core vector is theorem-generated
from the single source `HasCore` receipt. -/
theorem RealLinearPMapClosedSubspaceSelfAdjointCommonCoreIntertwining.source_mem
    {C E F : Type}
    [NormedAddCommGroup C] [NormedSpace ℝ C]
    [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    [NormedAddCommGroup F] [InnerProductSpace ℝ F] [CompleteSpace F]
    {S : Submodule ℝ E} {T : Submodule ℝ F}
    [CompleteSpace S] [CompleteSpace T]
    {A : S →ₗ.[ℝ] S} {B : T →ₗ.[ℝ] T}
    (D : RealLinearPMapClosedSubspaceSelfAdjointCommonCoreIntertwining
      (C := C) A B)
    (c : C) :
    RealHilbertClosedSubspaceDenseCoreRealization.corestrict D.source c ∈ A.domain :=
  D.source_hasCore.le_domain ⟨c, rfl⟩

/-- Exact core action agreement already forces equality of the full source
operator with the unitary pullback of the target operator.  No target graph-core
hypothesis is present. -/
theorem RealLinearPMapClosedSubspaceSelfAdjointCommonCoreIntertwining.eq_pullback
    {C E F : Type}
    [NormedAddCommGroup C] [NormedSpace ℝ C]
    [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    [NormedAddCommGroup F] [InnerProductSpace ℝ F] [CompleteSpace F]
    {S : Submodule ℝ E} {T : Submodule ℝ F}
    [CompleteSpace S] [CompleteSpace T]
    {A : S →ₗ.[ℝ] S} {B : T →ₗ.[ℝ] T}
    (D : RealLinearPMapClosedSubspaceSelfAdjointCommonCoreIntertwining
      (C := C) A B) :
    A = realLinearPMapPullback
      (realHilbertDenseCoreLinearIsometryEquiv
        (RealHilbertClosedSubspaceDenseCoreRealization.corestrict D.source)
        (RealHilbertClosedSubspaceDenseCoreRealization.corestrict_denseRange D.source)
        (RealHilbertClosedSubspaceDenseCoreRealization.corestrict D.target)
        (RealHilbertClosedSubspaceDenseCoreRealization.corestrict_denseRange D.target)) B :=
  D.toSelfAdjointCommonCoreIntertwining.eq_pullback

/-- Stable ambient dense-core data on two closed physical subspaces generate the
full operator-level unitary intertwining certificate. -/
noncomputable def
    RealLinearPMapClosedSubspaceSelfAdjointCommonCoreIntertwining.toUnitaryIntertwining
    {C E F : Type}
    [NormedAddCommGroup C] [NormedSpace ℝ C]
    [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    [NormedAddCommGroup F] [InnerProductSpace ℝ F] [CompleteSpace F]
    {S : Submodule ℝ E} {T : Submodule ℝ F}
    [CompleteSpace S] [CompleteSpace T]
    {A : S →ₗ.[ℝ] S} {B : T →ₗ.[ℝ] T}
    (D : RealLinearPMapClosedSubspaceSelfAdjointCommonCoreIntertwining
      (C := C) A B) :
    RealLinearPMapUnitaryIntertwining A B :=
  D.toSelfAdjointCommonCoreIntertwining.toUnitaryIntertwining

/-- Hence the actual nonzero point-energy sets agree from one source `HasCore`,
self-adjointness on both completed physical sectors, and algebraic-core action
agreement. -/
theorem realLinearPMapPointEnergySet_eq_of_closedSubspaceSelfAdjointCommonCore
    {C E F : Type}
    [NormedAddCommGroup C] [NormedSpace ℝ C]
    [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    [NormedAddCommGroup F] [InnerProductSpace ℝ F] [CompleteSpace F]
    {S : Submodule ℝ E} {T : Submodule ℝ F}
    [CompleteSpace S] [CompleteSpace T]
    (A : S →ₗ.[ℝ] S) (B : T →ₗ.[ℝ] T)
    (D : RealLinearPMapClosedSubspaceSelfAdjointCommonCoreIntertwining
      (C := C) A B) :
    realLinearPMapPointEnergySet A = realLinearPMapPointEnergySet B :=
  realLinearPMapPointEnergySet_eq_of_unitaryIntertwining A B
    D.toUnitaryIntertwining

/-- Closedness of the ambient subspaces supplies exactly the completeness
instances required by the previous construction.  This wrapper is useful in
model-facing code, where `S` and `T` are typically a spectral support and a
vacuum-orthogonal subspace and their closedness is already canonical. -/
theorem realLinearPMapPointEnergySet_eq_of_closedSubspaceSelfAdjointCommonCore_of_isClosed
    {C E F : Type}
    [NormedAddCommGroup C] [NormedSpace ℝ C]
    [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    [NormedAddCommGroup F] [InnerProductSpace ℝ F] [CompleteSpace F]
    {S : Submodule ℝ E} {T : Submodule ℝ F}
    (hS : IsClosed (S : Set E))
    (hT : IsClosed (T : Set F))
    (A : S →ₗ.[ℝ] S) (B : T →ₗ.[ℝ] T)
    (build :
      letI : CompleteSpace S := hS.completeSpace_coe
      letI : CompleteSpace T := hT.completeSpace_coe
      RealLinearPMapClosedSubspaceSelfAdjointCommonCoreIntertwining
        (C := C) A B) :
    realLinearPMapPointEnergySet A = realLinearPMapPointEnergySet B := by
  letI : CompleteSpace S := hS.completeSpace_coe
  letI : CompleteSpace T := hT.completeSpace_coe
  exact realLinearPMapPointEnergySet_eq_of_closedSubspaceSelfAdjointCommonCore
    A B build

end

end MathlibAnalytic
end MGAP4D
