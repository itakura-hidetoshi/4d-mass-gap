/-- The `n`-th embedded even-periodic Wilson Gibbs state, together with its
actual finite-volume reflection positivity and reflection invariance, generates
an Osterwalder--Schrader pre-Hilbert datum on the physical positive-time
observable algebra.

Although the observable carrier is common across scales, its OS seminorm is the
one induced by the `n`-th finite Wilson Gibbs law.  Thus its separation quotient
and completion are genuinely scale-dependent finite-volume OS Hilbert spaces. -/
noncomputable def
    physical_yang_mills_evenPeriodicWilsonOS_approximating_preHilbertData
    (S : PhysicalFourDimensionalYangMillsSymmetryLimit)
    (D : PhysicalYangMillsGaugeInvariantOSReflectionData S)
    (halfExtent : ℕ → ℕ)
    (N : ℕ)
    (hN : 0 < N)
    [Nontrivial (Matrix.specialUnitaryGroup (Fin N) ℂ)]
    (beta : ℕ → ℝ)
    (hbeta : ∀ n, 0 ≤ beta n)
    (B : PhysicalYangMillsEvenPeriodicWilsonOSWeakStarBridge
      S D halfExtent N hN beta hbeta)
    (hInvariant : ∀ n,
      D.WeakStarReflectionInvariant
        (physicalYangMillsApproximatingGaugeInvariantWeakStarState S n))
    (n : ℕ) :
    D.OSPreHilbertData where
  omega := physicalYangMillsApproximatingGaugeInvariantWeakStarState S n
  reflectionInvariant := hInvariant n
  reflectionPositive :=
    physical_yang_mills_evenPeriodicWilsonOS_approximating_weakStarReflectionPositive
      S D halfExtent N hN beta hbeta B n

/-- Every approximating Wilson OS pre-Hilbert datum is normalized because the
underlying embedded finite-volume Gibbs law is a probability measure. -/
theorem
    physical_yang_mills_evenPeriodicWilsonOS_approximating_preHilbertData_isNormalized
    (S : PhysicalFourDimensionalYangMillsSymmetryLimit)
    (D : PhysicalYangMillsGaugeInvariantOSReflectionData S)
    (halfExtent : ℕ → ℕ)
    (N : ℕ)
    (hN : 0 < N)
    [Nontrivial (Matrix.specialUnitaryGroup (Fin N) ℂ)]
    (beta : ℕ → ℝ)
    (hbeta : ∀ n, 0 ≤ beta n)
    (B : PhysicalYangMillsEvenPeriodicWilsonOSWeakStarBridge
      S D halfExtent N hN beta hbeta)
    (hInvariant : ∀ n,
      D.WeakStarReflectionInvariant
        (physicalYangMillsApproximatingGaugeInvariantWeakStarState S n))
    (n : ℕ) :
    (physical_yang_mills_evenPeriodicWilsonOS_approximating_preHilbertData
      S D halfExtent N hN beta hbeta B hInvariant n).IsNormalized := by
  change physicalYangMillsApproximatingGaugeInvariantWeakStarState S n 1 = 1
  rw [physicalYangMillsApproximatingGaugeInvariantWeakStarState_apply]
  exact physicalYangMillsApproximatingGaugeInvariantExpectation_one S n

/-- The complete real OS Hilbert space generated by the `n`-th actual
finite-volume even-periodic Wilson Gibbs state. -/
abbrev PhysicalYangMillsEvenPeriodicWilsonOSApproximatingHilbert
    (S : PhysicalFourDimensionalYangMillsSymmetryLimit)
    (D : PhysicalYangMillsGaugeInvariantOSReflectionData S)
    (halfExtent : ℕ → ℕ)
    (N : ℕ)
    (hN : 0 < N)
    [Nontrivial (Matrix.specialUnitaryGroup (Fin N) ℂ)]
    (beta : ℕ → ℝ)
    (hbeta : ∀ n, 0 ≤ beta n)
    (B : PhysicalYangMillsEvenPeriodicWilsonOSWeakStarBridge
      S D halfExtent N hN beta hbeta)
    (hInvariant : ∀ n,
      D.WeakStarReflectionInvariant
        (physicalYangMillsApproximatingGaugeInvariantWeakStarState S n))
    (n : ℕ) : Type :=
  (physical_yang_mills_evenPeriodicWilsonOS_approximating_preHilbertData
    S D halfExtent N hN beta hbeta B hInvariant n).PhysicalHilbert

/-- Each finite-volume Wilson OS Hilbert carrier is complete by Mathlib's
separation quotient and uniform completion. -/
theorem physical_yang_mills_evenPeriodicWilsonOS_approximatingHilbert_complete
    (S : PhysicalFourDimensionalYangMillsSymmetryLimit)
    (D : PhysicalYangMillsGaugeInvariantOSReflectionData S)
    (halfExtent : ℕ → ℕ)
    (N : ℕ)
    (hN : 0 < N)
    [Nontrivial (Matrix.specialUnitaryGroup (Fin N) ℂ)]
    (beta : ℕ → ℝ)
    (hbeta : ∀ n, 0 ≤ beta n)
    (B : PhysicalYangMillsEvenPeriodicWilsonOSWeakStarBridge
      S D halfExtent N hN beta hbeta)
    (hInvariant : ∀ n,
      D.WeakStarReflectionInvariant
        (physicalYangMillsApproximatingGaugeInvariantWeakStarState S n))
    (n : ℕ) :
    CompleteSpace
      (PhysicalYangMillsEvenPeriodicWilsonOSApproximatingHilbert
        S D halfExtent N hN beta hbeta B hInvariant n) := by
  infer_instance

/-- The normalized OS vacuum in the `n`-th finite-volume Wilson Hilbert space. -/
noncomputable def physical_yang_mills_evenPeriodicWilsonOS_approximating_vacuum
    (S : PhysicalFourDimensionalYangMillsSymmetryLimit)
    (D : PhysicalYangMillsGaugeInvariantOSReflectionData S)
    (halfExtent : ℕ → ℕ)
    (N : ℕ)
    (hN : 0 < N)
    [Nontrivial (Matrix.specialUnitaryGroup (Fin N) ℂ)]
    (beta : ℕ → ℝ)
    (hbeta : ∀ n, 0 ≤ beta n)
    (B : PhysicalYangMillsEvenPeriodicWilsonOSWeakStarBridge
      S D halfExtent N hN beta hbeta)
    (hInvariant : ∀ n,
      D.WeakStarReflectionInvariant
        (physicalYangMillsApproximatingGaugeInvariantWeakStarState S n))
    (n : ℕ) :
    PhysicalYangMillsEvenPeriodicWilsonOSApproximatingHilbert
      S D halfExtent N hN beta hbeta B hInvariant n :=
  (physical_yang_mills_evenPeriodicWilsonOS_approximating_preHilbertData
    S D halfExtent N hN beta hbeta B hInvariant n).vacuum

@[simp]
theorem physical_yang_mills_evenPeriodicWilsonOS_approximating_vacuum_norm
    (S : PhysicalFourDimensionalYangMillsSymmetryLimit)
    (D : PhysicalYangMillsGaugeInvariantOSReflectionData S)
    (halfExtent : ℕ → ℕ)
    (N : ℕ)
    (hN : 0 < N)
    [Nontrivial (Matrix.specialUnitaryGroup (Fin N) ℂ)]
    (beta : ℕ → ℝ)
    (hbeta : ∀ n, 0 ≤ beta n)
    (B : PhysicalYangMillsEvenPeriodicWilsonOSWeakStarBridge
      S D halfExtent N hN beta hbeta)
    (hInvariant : ∀ n,
      D.WeakStarReflectionInvariant
        (physicalYangMillsApproximatingGaugeInvariantWeakStarState S n))
    (n : ℕ) :
    ‖physical_yang_mills_evenPeriodicWilsonOS_approximating_vacuum
      S D halfExtent N hN beta hbeta B hInvariant n‖ = 1 := by
  exact
    (physical_yang_mills_evenPeriodicWilsonOS_approximating_preHilbertData
      S D halfExtent N hN beta hbeta B hInvariant n).norm_vacuum
      (physical_yang_mills_evenPeriodicWilsonOS_approximating_preHilbertData_isNormalized
        S D halfExtent N hN beta hbeta B hInvariant n)

/-- A common positive-time observable translation family which is contractive
for every finite-volume Wilson OS seminorm.

This is the exact finite-side interface needed before proving a quantitative
vacuum-sector gap.  The algebraic translation is common across scales, while
contractivity is checked against each actual finite Wilson Gibbs state. -/
structure PhysicalYangMillsEvenPeriodicWilsonOSApproximatingSemigroupFamily
    (S : PhysicalFourDimensionalYangMillsSymmetryLimit)
    (D : PhysicalYangMillsGaugeInvariantOSReflectionData S)
    (halfExtent : ℕ → ℕ)
    (N : ℕ)
    (hN : 0 < N)
    [Nontrivial (Matrix.specialUnitaryGroup (Fin N) ℂ)]
    (beta : ℕ → ℝ)
    (hbeta : ∀ n, 0 ≤ beta n)
    (B : PhysicalYangMillsEvenPeriodicWilsonOSWeakStarBridge
      S D halfExtent N hN beta hbeta)
    (hInvariant : ∀ n,
      D.WeakStarReflectionInvariant
        (physicalYangMillsApproximatingGaugeInvariantWeakStarState S n)) where
  translate : NNReal →
    D.positiveTimeSubalgebra →ₐ[ℝ] D.positiveTimeSubalgebra
  translate_zero :
    translate 0 = AlgHom.id ℝ D.positiveTimeSubalgebra
  translate_add : ∀ s t,
    translate (s + t) = (translate s).comp (translate t)
  osQuadratic_translate_le :
    ∀ (n : ℕ) (t : NNReal)
      (F : (physical_yang_mills_evenPeriodicWilsonOS_approximating_preHilbertData
        S D halfExtent N hN beta hbeta B hInvariant n).Carrier),
      let P :=
        physical_yang_mills_evenPeriodicWilsonOS_approximating_preHilbertData
          S D halfExtent N hN beta hbeta B hInvariant n
      P.osQuadraticValue
          (P.translateCarrierByPositiveTimeAlgHom (translate t) F) ≤
        P.osQuadraticValue F

namespace PhysicalYangMillsEvenPeriodicWilsonOSApproximatingSemigroupFamily

variable
    {S : PhysicalFourDimensionalYangMillsSymmetryLimit}
    {D : PhysicalYangMillsGaugeInvariantOSReflectionData S}
    {halfExtent : ℕ → ℕ}
    {N : ℕ}
    {hN : 0 < N}
    [Nontrivial (Matrix.specialUnitaryGroup (Fin N) ℂ)]
    {beta : ℕ → ℝ}
    {hbeta : ∀ n, 0 ≤ beta n}
    {B : PhysicalYangMillsEvenPeriodicWilsonOSWeakStarBridge
      S D halfExtent N hN beta hbeta}
    {hInvariant : ∀ n,
      D.WeakStarReflectionInvariant
        (physicalYangMillsApproximatingGaugeInvariantWeakStarState S n)}

/-- At each scale, the common observable translation family descends to the
actual finite-volume Wilson OS seminormed carrier. -/
noncomputable def toPositiveTimeObservableContractionSemigroup
    (C : PhysicalYangMillsEvenPeriodicWilsonOSApproximatingSemigroupFamily
      S D halfExtent N hN beta hbeta B hInvariant)
    (n : ℕ) :
    PhysicalYangMillsGaugeInvariantOSReflectionData.OSPreHilbertData
      .PositiveTimeObservableContractionSemigroup
        (physical_yang_mills_evenPeriodicWilsonOS_approximating_preHilbertData
          S D halfExtent N hN beta hbeta B hInvariant n) where
  translate := C.translate
  translate_zero := C.translate_zero
  translate_add := C.translate_add
  osQuadratic_translate_le := C.osQuadratic_translate_le n

/-- The completed finite-volume transfer operator induced on the `n`-th Wilson
OS Hilbert space. -/
noncomputable def finiteOperator
    (C : PhysicalYangMillsEvenPeriodicWilsonOSApproximatingSemigroupFamily
      S D halfExtent N hN beta hbeta B hInvariant)
    (n : ℕ) (t : NNReal) :
    PhysicalYangMillsEvenPeriodicWilsonOSApproximatingHilbert
        S D halfExtent N hN beta hbeta B hInvariant n →L[ℝ]
      PhysicalYangMillsEvenPeriodicWilsonOSApproximatingHilbert
        S D halfExtent N hN beta hbeta B hInvariant n :=
  (C.toPositiveTimeObservableContractionSemigroup n)
    .toPhysicalSemigroup.operator t

@[simp]
theorem finiteOperator_zero
    (C : PhysicalYangMillsEvenPeriodicWilsonOSApproximatingSemigroupFamily
      S D halfExtent N hN beta hbeta B hInvariant)
    (n : ℕ) :
    C.finiteOperator n 0 =
      ContinuousLinearMap.id ℝ
        (PhysicalYangMillsEvenPeriodicWilsonOSApproximatingHilbert
          S D halfExtent N hN beta hbeta B hInvariant n) := by
  exact (C.toPositiveTimeObservableContractionSemigroup n)
    .toPhysicalSemigroup.operator_zero

@[simp]
theorem finiteOperator_add
    (C : PhysicalYangMillsEvenPeriodicWilsonOSApproximatingSemigroupFamily
      S D halfExtent N hN beta hbeta B hInvariant)
    (n : ℕ) (s t : NNReal) :
    C.finiteOperator n (s + t) =
      (C.finiteOperator n s).comp (C.finiteOperator n t) := by
  exact (C.toPositiveTimeObservableContractionSemigroup n)
    .toPhysicalSemigroup.operator_add s t

/-- Every completed finite-volume Wilson transfer operator is contractive. -/
theorem finiteOperator_opNorm_le
    (C : PhysicalYangMillsEvenPeriodicWilsonOSApproximatingSemigroupFamily
      S D halfExtent N hN beta hbeta B hInvariant)
    (n : ℕ) (t : NNReal) :
    ‖C.finiteOperator n t‖ ≤ 1 := by
  exact (C.toPositiveTimeObservableContractionSemigroup n)
    .toPhysicalSemigroup.opNorm_le t

/-- Every finite-volume Wilson transfer operator fixes its normalized OS
vacuum. -/
@[simp]
theorem finiteOperator_fixes_vacuum
    (C : PhysicalYangMillsEvenPeriodicWilsonOSApproximatingSemigroupFamily
      S D halfExtent N hN beta hbeta B hInvariant)
    (n : ℕ) (t : NNReal) :
    C.finiteOperator n t
        (physical_yang_mills_evenPeriodicWilsonOS_approximating_vacuum
          S D halfExtent N hN beta hbeta B hInvariant n) =
      physical_yang_mills_evenPeriodicWilsonOS_approximating_vacuum
        S D halfExtent N hN beta hbeta B hInvariant n := by
  exact (C.toPositiveTimeObservableContractionSemigroup n)
    .toPhysicalSemigroup.fixes_vacuum t

/-- On the dense family represented by positive-time observables, the completed
finite-volume transfer operator is exactly observable translation. -/
theorem finiteOperator_on_positiveTimeObservable
    (C : PhysicalYangMillsEvenPeriodicWilsonOSApproximatingSemigroupFamily
      S D halfExtent N hN beta hbeta B hInvariant)
    (n : ℕ) (t : NNReal) (F : D.positiveTimeSubalgebra) :
    let P :=
      physical_yang_mills_evenPeriodicWilsonOS_approximating_preHilbertData
        S D halfExtent N hN beta hbeta B hInvariant n
    C.finiteOperator n t (P.physicalState (P.carrierOfPositiveTime F)) =
      P.physicalState (P.carrierOfPositiveTime (C.translate t F)) := by
  exact (C.toPositiveTimeObservableContractionSemigroup n)
    .physicalOperator_on_positiveTimeObservable t F

end PhysicalYangMillsEvenPeriodicWilsonOSApproximatingSemigroupFamily

