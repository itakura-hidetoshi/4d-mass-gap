import MGAP4D.MathlibAnalytic.FinitePositiveWeightConditionalL1Telescoping
import MGAP4D.MathlibAnalytic.FinitePositiveWeightLocalTiltConditional
import MGAP4D.MathlibAnalytic.FinitePositiveWeightSingleSiteOverlapCoupling
import Mathlib.Tactic

namespace MGAP4D
namespace MathlibAnalytic

open scoped BigOperators

noncomputable section

/-- Real `L¹` distance between one-site conditional laws generated by two
possibly different positive weights and two possibly different environments. -/
def finitePositiveWeightsSingleSiteConditionalL1
    {ι G : Type}
    [DecidableEq ι]
    [Fintype G]
    (leftWeight rightWeight : (ι → G) → ℝ)
    (leftEnvironment rightEnvironment : ι → G)
    (target : ι) : ℝ :=
  ∑ g : G,
    |finitePositiveWeightSingleSiteProbability
        leftWeight leftEnvironment target g -
      finitePositiveWeightSingleSiteProbability
        rightWeight rightEnvironment target g|

/-- Cross-weight/cross-environment conditional `L¹` distance is nonnegative. -/
theorem finitePositiveWeightsSingleSiteConditionalL1_nonneg
    {ι G : Type}
    [DecidableEq ι]
    [Fintype G]
    (leftWeight rightWeight : (ι → G) → ℝ)
    (leftEnvironment rightEnvironment : ι → G)
    (target : ι) :
    0 ≤ finitePositiveWeightsSingleSiteConditionalL1
      leftWeight rightWeight leftEnvironment rightEnvironment target := by
  unfold finitePositiveWeightsSingleSiteConditionalL1
  exact Finset.sum_nonneg fun g _hg => abs_nonneg _

/-- With a common weight, the generalized conditional `L¹` distance is the
usual environment-change conditional distance. -/
theorem finitePositiveWeightsSingleSiteConditionalL1_sameWeight
    {ι G : Type}
    [DecidableEq ι]
    [Fintype G]
    (weight : (ι → G) → ℝ)
    (leftEnvironment rightEnvironment : ι → G)
    (target : ι) :
    finitePositiveWeightsSingleSiteConditionalL1
        weight weight leftEnvironment rightEnvironment target =
      finitePositiveWeightSingleSiteConditionalL1
        weight leftEnvironment rightEnvironment target := by
  rfl

/-- With a common environment, the generalized conditional `L¹` distance is
the existing cross-weight conditional distance. -/
theorem finitePositiveWeightsSingleSiteConditionalL1_sameEnvironment
    {ι G : Type}
    [DecidableEq ι]
    [Fintype G]
    (leftWeight rightWeight : (ι → G) → ℝ)
    (environment : ι → G)
    (target : ι) :
    finitePositiveWeightsSingleSiteConditionalL1
        leftWeight rightWeight environment environment target =
      finitePositiveWeightSingleSiteConditionalCrossL1
        leftWeight rightWeight environment target := by
  rfl

/-- The generalized conditional distance splits into an environment-change
term for the left weight and a cross-weight term at the right environment. -/
theorem finitePositiveWeightsSingleSiteConditionalL1_le_sameWeight_add_cross
    {ι G : Type}
    [DecidableEq ι]
    [Fintype G]
    (leftWeight rightWeight : (ι → G) → ℝ)
    (leftEnvironment rightEnvironment : ι → G)
    (target : ι) :
    finitePositiveWeightsSingleSiteConditionalL1
        leftWeight rightWeight leftEnvironment rightEnvironment target ≤
      finitePositiveWeightSingleSiteConditionalL1
          leftWeight leftEnvironment rightEnvironment target +
        finitePositiveWeightSingleSiteConditionalCrossL1
          leftWeight rightWeight rightEnvironment target := by
  unfold finitePositiveWeightsSingleSiteConditionalL1
    finitePositiveWeightSingleSiteConditionalL1
    finitePositiveWeightSingleSiteConditionalCrossL1
  calc
    (∑ g : G,
      |finitePositiveWeightSingleSiteProbability
          leftWeight leftEnvironment target g -
        finitePositiveWeightSingleSiteProbability
          rightWeight rightEnvironment target g|) ≤
        ∑ g : G,
          (|finitePositiveWeightSingleSiteProbability
              leftWeight leftEnvironment target g -
            finitePositiveWeightSingleSiteProbability
              leftWeight rightEnvironment target g| +
          |finitePositiveWeightSingleSiteProbability
              leftWeight rightEnvironment target g -
            finitePositiveWeightSingleSiteProbability
              rightWeight rightEnvironment target g|) := by
      apply Finset.sum_le_sum
      intro g _hg
      have hDecompose :
          finitePositiveWeightSingleSiteProbability
                leftWeight leftEnvironment target g -
              finitePositiveWeightSingleSiteProbability
                rightWeight rightEnvironment target g =
            (finitePositiveWeightSingleSiteProbability
                leftWeight leftEnvironment target g -
              finitePositiveWeightSingleSiteProbability
                leftWeight rightEnvironment target g) +
            (finitePositiveWeightSingleSiteProbability
                leftWeight rightEnvironment target g -
              finitePositiveWeightSingleSiteProbability
                rightWeight rightEnvironment target g) := by
        ring
      rw [hDecompose]
      exact abs_add_le _ _
    _ =
        (∑ g : G,
          |finitePositiveWeightSingleSiteProbability
              leftWeight leftEnvironment target g -
            finitePositiveWeightSingleSiteProbability
              leftWeight rightEnvironment target g|) +
        ∑ g : G,
          |finitePositiveWeightSingleSiteProbability
              leftWeight rightEnvironment target g -
            finitePositiveWeightSingleSiteProbability
              rightWeight rightEnvironment target g| :=
      Finset.sum_add_distrib

/-- Canonical exact-marginal overlap coupling of two one-site conditional laws
that may come from different positive weights and different environments. -/
noncomputable def finitePositiveWeightsSingleSiteOverlapCouplingData
    {ι G : Type}
    [DecidableEq ι]
    [DecidableEq G]
    [Fintype G]
    [Nonempty G]
    (leftWeight rightWeight : (ι → G) → ℝ)
    (hLeftWeight : ∀ configuration : ι → G, 0 < leftWeight configuration)
    (hRightWeight : ∀ configuration : ι → G, 0 < rightWeight configuration)
    (leftEnvironment rightEnvironment : ι → G)
    (target : ι) :
    FiniteRealCouplingData
      (finitePositiveWeightSingleSiteProbabilityData
        leftWeight hLeftWeight leftEnvironment target)
      (finitePositiveWeightSingleSiteProbabilityData
        rightWeight hRightWeight rightEnvironment target) :=
  (finitePositiveWeightSingleSiteProbabilityData
      leftWeight hLeftWeight leftEnvironment target).overlapCouplingData
    (finitePositiveWeightSingleSiteProbabilityData
      rightWeight hRightWeight rightEnvironment target)

/-- The left marginal of the generalized one-site overlap coupling is exact. -/
theorem finitePositiveWeightsSingleSiteOverlapCoupling_leftMarginal
    {ι G : Type}
    [DecidableEq ι]
    [DecidableEq G]
    [Fintype G]
    [Nonempty G]
    (leftWeight rightWeight : (ι → G) → ℝ)
    (hLeftWeight : ∀ configuration : ι → G, 0 < leftWeight configuration)
    (hRightWeight : ∀ configuration : ι → G, 0 < rightWeight configuration)
    (leftEnvironment rightEnvironment : ι → G)
    (target : ι)
    (g : G) :
    ∑ h : G,
      (finitePositiveWeightsSingleSiteOverlapCouplingData
        leftWeight rightWeight hLeftWeight hRightWeight
        leftEnvironment rightEnvironment target).joint g h =
      finitePositiveWeightSingleSiteProbability
        leftWeight leftEnvironment target g := by
  simpa [finitePositiveWeightsSingleSiteOverlapCouplingData,
    finitePositiveWeightSingleSiteProbabilityData] using
    (finitePositiveWeightsSingleSiteOverlapCouplingData
      leftWeight rightWeight hLeftWeight hRightWeight
      leftEnvironment rightEnvironment target).left_marginal g

/-- The right marginal of the generalized one-site overlap coupling is exact. -/
theorem finitePositiveWeightsSingleSiteOverlapCoupling_rightMarginal
    {ι G : Type}
    [DecidableEq ι]
    [DecidableEq G]
    [Fintype G]
    [Nonempty G]
    (leftWeight rightWeight : (ι → G) → ℝ)
    (hLeftWeight : ∀ configuration : ι → G, 0 < leftWeight configuration)
    (hRightWeight : ∀ configuration : ι → G, 0 < rightWeight configuration)
    (leftEnvironment rightEnvironment : ι → G)
    (target : ι)
    (h : G) :
    ∑ g : G,
      (finitePositiveWeightsSingleSiteOverlapCouplingData
        leftWeight rightWeight hLeftWeight hRightWeight
        leftEnvironment rightEnvironment target).joint g h =
      finitePositiveWeightSingleSiteProbability
        rightWeight rightEnvironment target h := by
  simpa [finitePositiveWeightsSingleSiteOverlapCouplingData,
    finitePositiveWeightSingleSiteProbabilityData] using
    (finitePositiveWeightsSingleSiteOverlapCouplingData
      leftWeight rightWeight hLeftWeight hRightWeight
      leftEnvironment rightEnvironment target).right_marginal h

/-- The disagreement probability of the generalized one-site overlap coupling
is exactly one half of the unhalved generalized conditional `L¹` distance. -/
theorem finitePositiveWeightsSingleSiteOverlapCoupling_disagreementMass_eq_half_mul
    {ι G : Type}
    [DecidableEq ι]
    [DecidableEq G]
    [Fintype G]
    [Nonempty G]
    (leftWeight rightWeight : (ι → G) → ℝ)
    (hLeftWeight : ∀ configuration : ι → G, 0 < leftWeight configuration)
    (hRightWeight : ∀ configuration : ι → G, 0 < rightWeight configuration)
    (leftEnvironment rightEnvironment : ι → G)
    (target : ι) :
    (finitePositiveWeightsSingleSiteOverlapCouplingData
        leftWeight rightWeight hLeftWeight hRightWeight
        leftEnvironment rightEnvironment target).disagreementMass =
      (2 : ℝ)⁻¹ *
        finitePositiveWeightsSingleSiteConditionalL1
          leftWeight rightWeight leftEnvironment rightEnvironment target := by
  let P := finitePositiveWeightSingleSiteProbabilityData
    leftWeight hLeftWeight leftEnvironment target
  let Q := finitePositiveWeightSingleSiteProbabilityData
    rightWeight hRightWeight rightEnvironment target
  have hDisagreement :=
    P.overlapCouplingData_disagreementMass_eq_half_mul_l1Distance Q
  simpa [finitePositiveWeightsSingleSiteOverlapCouplingData,
    finitePositiveWeightsSingleSiteConditionalL1,
    finitePositiveWeightSingleSiteProbabilityData, P, Q] using hDisagreement

/-- Environment influence plus a cross-weight source bound controls the
one-site coupling disagreement. -/
theorem finitePositiveWeightsSingleSiteOverlapCoupling_disagreementMass_le_half_mul_influence_add_source
    {ι G : Type}
    [DecidableEq ι]
    [DecidableEq G]
    [Fintype ι]
    [Fintype G]
    [Nonempty G]
    (leftWeight rightWeight : (ι → G) → ℝ)
    (hLeftWeight : ∀ configuration : ι → G, 0 < leftWeight configuration)
    (hRightWeight : ∀ configuration : ι → G, 0 < rightWeight configuration)
    (D : FinitePositiveWeightNonstrictL1MatrixData leftWeight)
    (sourceBound : ι → ℝ)
    (hCross :
      ∀ (environment : ι → G) (target : ι),
        finitePositiveWeightSingleSiteConditionalCrossL1
            leftWeight rightWeight environment target ≤
          sourceBound target)
    (leftEnvironment rightEnvironment : ι → G)
    (target : ι) :
    (finitePositiveWeightsSingleSiteOverlapCouplingData
        leftWeight rightWeight hLeftWeight hRightWeight
        leftEnvironment rightEnvironment target).disagreementMass ≤
      (2 : ℝ)⁻¹ *
        ((∑ source ∈
            finiteProductDisagreementFinset
              leftEnvironment rightEnvironment,
            D.influence target source) + sourceBound target) := by
  rw [finitePositiveWeightsSingleSiteOverlapCoupling_disagreementMass_eq_half_mul]
  apply mul_le_mul_of_nonneg_left _ (by positivity)
  exact le_trans
    (finitePositiveWeightsSingleSiteConditionalL1_le_sameWeight_add_cross
      leftWeight rightWeight leftEnvironment rightEnvironment target)
    (add_le_add
      (finitePositiveWeightNonstrict_conditionalL1_le_disagreementInfluenceSum
        D leftEnvironment rightEnvironment target)
      (hCross rightEnvironment target))

end

end MathlibAnalytic
end MGAP4D
