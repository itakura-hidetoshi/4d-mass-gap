import MGAP4D.MathlibAnalytic.ProjectiveLimitFiniteMarginalL2IsometricSystem
import MGAP4D.MathlibAnalytic.EuclideanYangMillsProjectiveContinuumMeasure

namespace MGAP4D
namespace MathlibAnalytic

open MeasureTheory
open scoped ENNReal

noncomputable section

namespace EuclideanYangMillsProjectiveLimitMeasure

variable
    {F : EuclideanYangMillsProjectiveCylinderFamily}
    (L : EuclideanYangMillsProjectiveLimitMeasure F)

/-- Canonical isometric embedding of one finite Euclidean Yang--Mills marginal
`L²` space into the `L²` space of the projective-limit continuum measure. -/
noncomputable def finiteMarginalL2Pullback
    (J : Finset EuclideanFourSpace) :
    Lp ℝ 2 (F.finiteMarginal J) →ₗᵢ[ℝ]
      Lp ℝ 2 L.continuumMeasure :=
  projectiveLimitFiniteMarginalL2Pullback
    L.continuumMeasure F.finiteMarginal L.projectiveLimit J

/-- Canonical isometric transition map from a smaller finite marginal `L²`
space to a larger one. -/
noncomputable def finiteMarginalL2Transition
    {I J : Finset EuclideanFourSpace}
    (hJI : J ⊆ I) :
    Lp ℝ 2 (F.finiteMarginal J) →ₗᵢ[ℝ]
      Lp ℝ 2 (F.finiteMarginal I) :=
  projectiveFamilyFiniteMarginalL2Pullback
    F.finiteMarginal F.projective hJI

@[simp] theorem finiteMarginalL2Pullback_norm
    (J : Finset EuclideanFourSpace)
    (f : Lp ℝ 2 (F.finiteMarginal J)) :
    ‖L.finiteMarginalL2Pullback J f‖ = ‖f‖ := by
  exact LinearIsometry.norm_map _ f

@[simp] theorem finiteMarginalL2Pullback_inner
    (J : Finset EuclideanFourSpace)
    (f g : Lp ℝ 2 (F.finiteMarginal J)) :
    inner ℝ (L.finiteMarginalL2Pullback J f)
        (L.finiteMarginalL2Pullback J g) =
      inner ℝ f g := by
  exact LinearIsometry.inner_map_map _ f g

/-- Every finite-marginal pullback is injective. -/
theorem finiteMarginalL2Pullback_injective
    (J : Finset EuclideanFourSpace) :
    Function.Injective (L.finiteMarginalL2Pullback J) :=
  (L.finiteMarginalL2Pullback J).injective

/-- Pulling a smaller marginal directly to continuum agrees with first
transitioning to any larger finite marginal and then pulling that marginal to
continuum. -/
theorem finiteMarginalL2Pullback_compatible
    {I J : Finset EuclideanFourSpace}
    (hJI : J ⊆ I)
    (f : Lp ℝ 2 (F.finiteMarginal J)) :
    L.finiteMarginalL2Pullback J f =
      L.finiteMarginalL2Pullback I
        (EuclideanYangMillsProjectiveLimitMeasure.finiteMarginalL2Transition
          (F := F) hJI f) := by
  exact projectiveLimitFiniteMarginalL2Pullback_compatible
    L.continuumMeasure F.finiteMarginal L.projectiveLimit F.projective hJI f

/-- The continuum `L²` subspace generated by functions depending only on a
finite set of Euclidean coordinates. -/
noncomputable def finiteMarginalL2CylinderSubspace
    (J : Finset EuclideanFourSpace) :
    Submodule ℝ (Lp ℝ 2 L.continuumMeasure) :=
  projectiveLimitFiniteMarginalL2CylinderSubspace
    L.continuumMeasure F.finiteMarginal L.projectiveLimit J

/-- Enlarging the finite coordinate set enlarges the corresponding continuum
cylinder subspace. -/
theorem finiteMarginalL2CylinderSubspace_mono
    {I J : Finset EuclideanFourSpace}
    (hJI : J ⊆ I) :
    L.finiteMarginalL2CylinderSubspace J ≤
      L.finiteMarginalL2CylinderSubspace I := by
  exact projectiveLimitFiniteMarginalL2CylinderSubspace_mono
    L.continuumMeasure F.finiteMarginal L.projectiveLimit F.projective hJI

end EuclideanYangMillsProjectiveLimitMeasure

/-- Complete directed isometric-system receipt for finite-dimensional cylinder
`L²` spaces inside one projective-limit Euclidean Yang--Mills `L²` carrier. -/
structure EuclideanYangMillsProjectiveLimitL2CylinderIsometricSystem
    (F : EuclideanYangMillsProjectiveCylinderFamily)
    (L : EuclideanYangMillsProjectiveLimitMeasure F) where
  finiteEmbed :
    ∀ J : Finset EuclideanFourSpace,
      Lp ℝ 2 (F.finiteMarginal J) →ₗᵢ[ℝ]
        Lp ℝ 2 L.continuumMeasure
  finiteTransition :
    ∀ {I J : Finset EuclideanFourSpace}, J ⊆ I →
      Lp ℝ 2 (F.finiteMarginal J) →ₗᵢ[ℝ]
        Lp ℝ 2 (F.finiteMarginal I)
  finiteEmbed_norm :
    ∀ (J : Finset EuclideanFourSpace)
      (f : Lp ℝ 2 (F.finiteMarginal J)),
      ‖finiteEmbed J f‖ = ‖f‖
  finiteEmbed_inner :
    ∀ (J : Finset EuclideanFourSpace)
      (f g : Lp ℝ 2 (F.finiteMarginal J)),
      inner ℝ (finiteEmbed J f) (finiteEmbed J g) = inner ℝ f g
  finiteEmbed_injective :
    ∀ J : Finset EuclideanFourSpace,
      Function.Injective (finiteEmbed J)
  finiteCompatibility :
    ∀ {I J : Finset EuclideanFourSpace}
      (hJI : J ⊆ I)
      (f : Lp ℝ 2 (F.finiteMarginal J)),
      finiteEmbed J f = finiteEmbed I (finiteTransition hJI f)
  cylinderSubspace :
    Finset EuclideanFourSpace →
      Submodule ℝ (Lp ℝ 2 L.continuumMeasure)
  cylinderSubspace_eq_range :
    ∀ J : Finset EuclideanFourSpace,
      cylinderSubspace J = LinearMap.range (finiteEmbed J).toLinearMap
  cylinderSubspace_mono :
    ∀ {I J : Finset EuclideanFourSpace}, J ⊆ I →
      cylinderSubspace J ≤ cylinderSubspace I

/-- Construct the complete directed cylinder-`L²` isometric system from the
projective-limit measure alone. -/
noncomputable def euclideanYangMillsProjectiveLimitL2CylinderIsometricSystem
    (F : EuclideanYangMillsProjectiveCylinderFamily)
    (L : EuclideanYangMillsProjectiveLimitMeasure F) :
    EuclideanYangMillsProjectiveLimitL2CylinderIsometricSystem F L where
  finiteEmbed := L.finiteMarginalL2Pullback
  finiteTransition := fun hJI =>
    EuclideanYangMillsProjectiveLimitMeasure.finiteMarginalL2Transition
      (F := F) hJI
  finiteEmbed_norm := L.finiteMarginalL2Pullback_norm
  finiteEmbed_inner := L.finiteMarginalL2Pullback_inner
  finiteEmbed_injective := L.finiteMarginalL2Pullback_injective
  finiteCompatibility := L.finiteMarginalL2Pullback_compatible
  cylinderSubspace := L.finiteMarginalL2CylinderSubspace
  cylinderSubspace_eq_range := fun _ => rfl
  cylinderSubspace_mono := L.finiteMarginalL2CylinderSubspace_mono

end

end MathlibAnalytic
end MGAP4D