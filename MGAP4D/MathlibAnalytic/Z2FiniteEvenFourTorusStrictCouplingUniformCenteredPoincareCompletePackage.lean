import MGAP4D.MathlibAnalytic.Z2FiniteEvenFourTorusStrictCouplingUniformCenteredRayleighPoincare
import MGAP4D.MathlibAnalytic.Z2FiniteEvenFourTorusStrictCouplingUniformGapCompletePackage

namespace MGAP4D
namespace MathlibAnalytic

noncomputable section

/-- Complete family-level package generated by one basis-free uniform
Poincare estimate for the actual strict-coupling `Z₂` transfer.  It contains
the equivalent centered Rayleigh contraction, common spectral cap, positive
uniform energy gap, and volume-independent natural-time decay. -/
structure Z2UnfixedGaugeStrictCouplingUniformCenteredPoincareCompletePackage
    (β energyIdentity energyNontrivial : ℝ)
    (hβ : 0 < β)
    (hEnergy : energyIdentity < energyNontrivial) where
  finiteVolumeFamily :
    Z2UnfixedGaugeStrictCouplingFiniteVolumeFamilyCompletePackage
      β energyIdentity energyNontrivial hβ hEnergy
  centeredPoincare :
    Z2UnfixedGaugeStrictCouplingUniformCenteredPoincareCertificate
      β energyIdentity energyNontrivial hβ hEnergy
  centeredRayleigh :
    Z2UnfixedGaugeStrictCouplingUniformCenteredRayleighCertificate
      β energyIdentity energyNontrivial hβ hEnergy
  spectralCap :
    Z2UnfixedGaugeStrictCouplingUniformSpectralCapCertificate
      β energyIdentity energyNontrivial hβ hEnergy
  uniformGapPackage :
    Z2UnfixedGaugeStrictCouplingUniformGapCompletePackage
      β energyIdentity energyNontrivial hβ hEnergy
  rate_eq_one_sub_coercivity :
    centeredRayleigh.rate = 1 - centeredPoincare.coercivity
  spectralCap_rate_eq_rayleigh_rate :
    spectralCap.rate = centeredRayleigh.rate
  uniformGap_eq_neg_log_one_sub_coercivity :
    uniformGapPackage.uniformGap =
      -Real.log (1 - centeredPoincare.coercivity)
  exp_neg_uniformGap_eq_one_sub_coercivity :
    Real.exp (-uniformGapPackage.uniformGap) =
      1 - centeredPoincare.coercivity
  centered_transfer_rayleigh :
    ∀ (H : ℕ)
      (x : FiniteEvenFourTorusZ2GaugeInvariantSliceHilbert H),
      finiteEvenFourTorusZ2UnfixedGaugeGroundCoordinates
          H β energyIdentity energyNontrivial hβ.le hEnergy.le x = 0 →
        inner ℝ
            (finiteEvenFourTorusZ2UnfixedGaugeInvariantOneSlabTransfer
              H β energyIdentity energyNontrivial hβ.le hEnergy.le x) x ≤
          centeredRayleigh.rate * ‖x‖ ^ 2
  centered_transfer_defect_coercivity :
    ∀ (H : ℕ)
      (x : FiniteEvenFourTorusZ2GaugeInvariantSliceHilbert H),
      finiteEvenFourTorusZ2UnfixedGaugeGroundCoordinates
          H β energyIdentity energyNontrivial hβ.le hEnergy.le x = 0 →
        centeredPoincare.coercivity * ‖x‖ ^ 2 ≤
          inner ℝ
            (x - finiteEvenFourTorusZ2UnfixedGaugeInvariantOneSlabTransfer
              H β energyIdentity energyNontrivial hβ.le hEnergy.le x) x
  uniformGap_pos : 0 < uniformGapPackage.uniformGap
  uniformGap_le_atVolume :
    ∀ H : ℕ,
      uniformGapPackage.uniformGap ≤
        finiteEvenFourTorusZ2UnfixedGaugeStrictExcitationGapAt
          H β energyIdentity energyNontrivial hβ hEnergy
  uniformGap_le_excitedEnergy :
    ∀ (H : ℕ)
      (i : FiniteEvenFourTorusZ2UnfixedGaugeExcitedSpectralIndex
        H β energyIdentity energyNontrivial hβ.le hEnergy.le),
      uniformGapPackage.uniformGap ≤
        finiteEvenFourTorusZ2UnfixedGaugePositiveSpectralEnergy
          H β energyIdentity energyNontrivial hβ.le hEnergy.le i.toPositive
  excited_coordinate_uniform_decay :
    ∀ (H n : ℕ)
      (x : FiniteEvenFourTorusZ2UnfixedGaugePositiveSpectralSpace
        H β energyIdentity energyNontrivial hβ.le hEnergy.le)
      (i : FiniteEvenFourTorusZ2UnfixedGaugeExcitedSpectralIndex
        H β energyIdentity energyNontrivial hβ.le hEnergy.le),
      |finiteEvenFourTorusZ2UnfixedGaugePositiveSpectralSemigroup
          H β energyIdentity energyNontrivial hβ.le hEnergy.le n x i.toPositive| ≤
        (Real.exp (-uniformGapPackage.uniformGap)) ^ n * |x i.toPositive|
  uniformGap_exists :
    Z2UnfixedGaugeStrictCouplingHasUniformGap
      β energyIdentity energyNontrivial hβ hEnergy

/-- Construct the complete package directly from a uniform centered Poincare
coercivity certificate. -/
noncomputable def
    finiteEvenFourTorusZ2UnfixedGaugeStrictCouplingUniformCenteredPoincareCompletePackage
    (β energyIdentity energyNontrivial : ℝ)
    (hβ : 0 < β)
    (hEnergy : energyIdentity < energyNontrivial)
    (P : Z2UnfixedGaugeStrictCouplingUniformCenteredPoincareCertificate
      β energyIdentity energyNontrivial hβ hEnergy) :
    Z2UnfixedGaugeStrictCouplingUniformCenteredPoincareCompletePackage
      β energyIdentity energyNontrivial hβ hEnergy := by
  let R := P.toCenteredRayleighCertificate
  let C := P.toSpectralCapCertificate
  let G :=
    finiteEvenFourTorusZ2UnfixedGaugeStrictCouplingUniformGapCompletePackage
      β energyIdentity energyNontrivial hβ hEnergy C
  exact
    { finiteVolumeFamily := G.finiteVolumeFamily
      centeredPoincare := P
      centeredRayleigh := R
      spectralCap := C
      uniformGapPackage := G
      rate_eq_one_sub_coercivity := rfl
      spectralCap_rate_eq_rayleigh_rate := rfl
      uniformGap_eq_neg_log_one_sub_coercivity := rfl
      exp_neg_uniformGap_eq_one_sub_coercivity := by
        simpa [R, C, G] using G.exp_neg_uniformGap_eq_rate
      centered_transfer_rayleigh := R.centeredRayleigh
      centered_transfer_defect_coercivity := P.centeredPoincare
      uniformGap_pos := G.uniformGap_pos
      uniformGap_le_atVolume := G.uniformGap_le_atVolume
      uniformGap_le_excitedEnergy := G.uniformGap_le_excitedEnergy
      excited_coordinate_uniform_decay := G.excited_coordinate_uniform_decay
      uniformGap_exists := G.uniformGap_exists }

/-- Construct the same complete package from the exactly equivalent centered
Rayleigh contraction. -/
noncomputable def
    finiteEvenFourTorusZ2UnfixedGaugeStrictCouplingUniformCenteredPoincareCompletePackageOfRayleigh
    (β energyIdentity energyNontrivial : ℝ)
    (hβ : 0 < β)
    (hEnergy : energyIdentity < energyNontrivial)
    (R : Z2UnfixedGaugeStrictCouplingUniformCenteredRayleighCertificate
      β energyIdentity energyNontrivial hβ hEnergy) :
    Z2UnfixedGaugeStrictCouplingUniformCenteredPoincareCompletePackage
      β energyIdentity energyNontrivial hβ hEnergy :=
  finiteEvenFourTorusZ2UnfixedGaugeStrictCouplingUniformCenteredPoincareCompletePackage
    β energyIdentity energyNontrivial hβ hEnergy
      R.toCenteredPoincareCertificate

/-- Construct the complete package from a common excited spectral cap. -/
noncomputable def
    finiteEvenFourTorusZ2UnfixedGaugeStrictCouplingUniformCenteredPoincareCompletePackageOfSpectralCap
    (β energyIdentity energyNontrivial : ℝ)
    (hβ : 0 < β)
    (hEnergy : energyIdentity < energyNontrivial)
    (C : Z2UnfixedGaugeStrictCouplingUniformSpectralCapCertificate
      β energyIdentity energyNontrivial hβ hEnergy) :
    Z2UnfixedGaugeStrictCouplingUniformCenteredPoincareCompletePackage
      β energyIdentity energyNontrivial hβ hEnergy :=
  finiteEvenFourTorusZ2UnfixedGaugeStrictCouplingUniformCenteredPoincareCompletePackage
    β energyIdentity energyNontrivial hβ hEnergy
      C.toCenteredPoincareCertificate

/-- The Poincare-based constructor retains the supplied coercivity constant
exactly. -/
theorem
    finiteEvenFourTorusZ2UnfixedGaugeStrictCouplingUniformCenteredPoincareCompletePackage_coercivity_eq
    (β energyIdentity energyNontrivial : ℝ)
    (hβ : 0 < β)
    (hEnergy : energyIdentity < energyNontrivial)
    (P : Z2UnfixedGaugeStrictCouplingUniformCenteredPoincareCertificate
      β energyIdentity energyNontrivial hβ hEnergy) :
    (finiteEvenFourTorusZ2UnfixedGaugeStrictCouplingUniformCenteredPoincareCompletePackage
      β energyIdentity energyNontrivial hβ hEnergy P).centeredPoincare.coercivity =
        P.coercivity :=
  rfl

/-- Existence of the complete centered-Poincare package is equivalent to the
previous common-spectral-cap frontier. -/
theorem z2UnfixedGaugeStrictCoupling_uniformCenteredPoincareCompletePackage_iff_spectralCap
    (β energyIdentity energyNontrivial : ℝ)
    (hβ : 0 < β)
    (hEnergy : energyIdentity < energyNontrivial) :
    Nonempty
        (Z2UnfixedGaugeStrictCouplingUniformCenteredPoincareCompletePackage
          β energyIdentity energyNontrivial hβ hEnergy) ↔
      Nonempty
        (Z2UnfixedGaugeStrictCouplingUniformSpectralCapCertificate
          β energyIdentity energyNontrivial hβ hEnergy) := by
  constructor
  · rintro ⟨P⟩
    exact ⟨P.spectralCap⟩
  · rintro ⟨C⟩
    exact ⟨
      finiteEvenFourTorusZ2UnfixedGaugeStrictCouplingUniformCenteredPoincareCompletePackageOfSpectralCap
        β energyIdentity energyNontrivial hβ hEnergy C⟩

end

end MathlibAnalytic
end MGAP4D
