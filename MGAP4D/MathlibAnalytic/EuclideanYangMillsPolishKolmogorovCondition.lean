import MGAP4D.MathlibAnalytic.EuclideanYangMillsKolmogorovExtensionTheorem
import MGAP4D.MathlibAnalytic.EuclideanYangMillsPolishKolmogorovExtension

namespace MGAP4D
namespace MathlibAnalytic

open Set MeasureTheory Filter
open scoped ENNReal Topology

noncomputable section

variable {F : EuclideanYangMillsProjectiveCylinderFamily}
  [∀ x, TopologicalSpace (F.fieldValue x)]
  [∀ x, BorelSpace (F.fieldValue x)]
  [∀ x, PolishSpace (F.fieldValue x)]

/-- Polish coordinate spaces and probability finite marginals imply continuity
from above at the empty set for the projective cylinder content.  Tightness is
supplied by inner regularity of finite measures on Polish spaces. -/
theorem euclidean_yang_mills_polish_cylinderContent_tendsto_zero
    {s : ℕ → Set F.Configuration}
    (hs : ∀ n, s n ∈ measurableCylinders F.fieldValue)
    (hsAnti : Antitone s)
    (hsInter : (⋂ n, s n) = ∅) :
    Tendsto (fun n => F.cylinderContent (s n)) atTop (𝓝 0) := by
  letI : ∀ J, IsProbabilityMeasure (F.finiteMarginal J) :=
    F.finiteMarginalProbability
  apply regular_addContent_tendsto_zero
    isSetRing_measurableCylinders
    F.cylinderContent
    hs hsAnti hsInter
    isCompactSystem_closedCompactCylinders
    (fun _ => mem_measurableCylinders_of_mem_closedCompactCylinders)
  intro A hA ε hε
  exact innerRegular_projectiveFamilyContent
    F.projective
    (fun J => innerRegular_isCompact_isClosed_measurableSet_of_finite
      (F.finiteMarginal J))
    hA ε hε

/-- Every Euclidean Yang--Mills projective family with Polish coordinate spaces
satisfies the abstract Kolmogorov extension condition. -/
noncomputable def euclideanYangMillsPolishKolmogorovExtensionCondition
    (F : EuclideanYangMillsProjectiveCylinderFamily)
    [∀ x, TopologicalSpace (F.fieldValue x)]
    [∀ x, BorelSpace (F.fieldValue x)]
    [∀ x, PolishSpace (F.fieldValue x)] :
    EuclideanYangMillsKolmogorovExtensionCondition F :=
  { cylinderContent_tendsto_zero := by
      intro s hs hsAnti hsInter
      exact euclidean_yang_mills_polish_cylinderContent_tendsto_zero
        hs hsAnti hsInter }

/-- The abstract continuity-condition construction and the direct Polish
Kolmogorov construction give the same continuum measure. -/
theorem euclidean_yang_mills_condition_measure_eq_polish_measure :
    euclideanYangMillsKolmogorovMeasure
        (euclideanYangMillsPolishKolmogorovExtensionCondition F) =
      euclideanYangMillsPolishKolmogorovMeasure F := by
  apply euclidean_yang_mills_polish_kolmogorov_unique
  exact euclidean_yang_mills_kolmogorovMeasure_isProjectiveLimit
    (euclideanYangMillsPolishKolmogorovExtensionCondition F)

/-- The general Kolmogorov projective-limit existence theorem can therefore be
recovered through the explicit continuity condition generated by Polish
tightness. -/
theorem euclidean_yang_mills_polish_condition_projective_limit_exists :
    ∃ μ : Measure F.Configuration,
      IsProjectiveLimit μ F.finiteMarginal :=
  euclidean_yang_mills_kolmogorov_projective_limit_exists
    (euclideanYangMillsPolishKolmogorovExtensionCondition F)

end

end MathlibAnalytic
end MGAP4D
