/-- Every operator-norm derivative of the vacuum-orthogonal real resolvent has
the factorial Cauchy-type bound generated by the transferred mass gap. -/
theorem FiniteVolumeVacuumGapTransfer.vacuumOrthogonalRealResolventOn_iteratedDeriv_norm_le
    (T : P.StronglyContinuousPhysicalSemigroup)
    (G : T.FiniteVolumeVacuumGapTransfer)
    (hP : P.IsNormalized)
    (hSelf : IsSelfAdjoint T.closedRightHamiltonian)
    (n : ℕ) {lambda : ℝ} (hlambda : lambda < G.mass) :
    ‖iteratedDeriv n
        (G.vacuumOrthogonalRealResolventOn T hP hSelf) lambda‖ ≤
      (n.factorial : ℝ) * ((G.mass - lambda)⁻¹) ^ (n + 1) := by
  rw [G.vacuumOrthogonalRealResolventOn_iteratedDeriv
    T hP hSelf n (lambda := lambda) hlambda]
  let Rlambda := G.vacuumOrthogonalRealResolvent T hP hSelf hlambda
  change ‖(n.factorial : ℝ) • Rlambda ^ (n + 1)‖ ≤
    (n.factorial : ℝ) * ((G.mass - lambda)⁻¹) ^ (n + 1)
  calc
    ‖(n.factorial : ℝ) • Rlambda ^ (n + 1)‖ =
        (n.factorial : ℝ) * ‖Rlambda ^ (n + 1)‖ := by
      rw [norm_smul, Real.norm_natCast]
    _ ≤ (n.factorial : ℝ) * ‖Rlambda‖ ^ (n + 1) :=
      mul_le_mul_of_nonneg_left
        (norm_pow_le Rlambda (n + 1)) (by positivity)
    _ ≤ (n.factorial : ℝ) * ((G.mass - lambda)⁻¹) ^ (n + 1) :=
      mul_le_mul_of_nonneg_left
        (pow_le_pow_left₀ (norm_nonneg Rlambda)
          (G.vacuumOrthogonalRealResolvent_norm_le T hP hSelf hlambda))
        (by positivity)

/-- Pointwise form of the factorial derivative bound on every excitation
vector. -/
theorem FiniteVolumeVacuumGapTransfer.vacuumOrthogonalRealResolventOn_iteratedDeriv_apply_norm_le
    (T : P.StronglyContinuousPhysicalSemigroup)
    (G : T.FiniteVolumeVacuumGapTransfer)
    (hP : P.IsNormalized)
    (hSelf : IsSelfAdjoint T.closedRightHamiltonian)
    (n : ℕ) {lambda : ℝ} (hlambda : lambda < G.mass)
    (y : P.VacuumOrthogonalHilbert) :
    ‖(iteratedDeriv n
        (G.vacuumOrthogonalRealResolventOn T hP hSelf) lambda) y‖ ≤
      ((n.factorial : ℝ) * ((G.mass - lambda)⁻¹) ^ (n + 1)) * ‖y‖ := by
  calc
    ‖(iteratedDeriv n
        (G.vacuumOrthogonalRealResolventOn T hP hSelf) lambda) y‖ ≤
        ‖iteratedDeriv n
          (G.vacuumOrthogonalRealResolventOn T hP hSelf) lambda‖ * ‖y‖ :=
      (iteratedDeriv n
        (G.vacuumOrthogonalRealResolventOn T hP hSelf) lambda).le_opNorm y
    _ ≤ ((n.factorial : ℝ) * ((G.mass - lambda)⁻¹) ^ (n + 1)) * ‖y‖ :=
      mul_le_mul_of_nonneg_right
        (G.vacuumOrthogonalRealResolventOn_iteratedDeriv_norm_le
          T hP hSelf n hlambda)
        (norm_nonneg y)

/-- Smoothness, exact all-order derivatives, and their factorial operator-norm
bounds below the transferred mass. -/
theorem FiniteVolumeVacuumGapTransfer.vacuumOrthogonalRealResolventFactorialDerivative_package
    (T : P.StronglyContinuousPhysicalSemigroup)
    (G : T.FiniteVolumeVacuumGapTransfer)
    (hP : P.IsNormalized)
    (hSelf : IsSelfAdjoint T.closedRightHamiltonian) :
    ContDiffOn ℝ ∞
        (G.vacuumOrthogonalRealResolventOn T hP hSelf)
        (Set.Iio G.mass) ∧
      (∀ (n : ℕ) {lambda : ℝ} (hlambda : lambda < G.mass),
        iteratedDeriv n
            (G.vacuumOrthogonalRealResolventOn T hP hSelf) lambda =
          (n.factorial : ℝ) •
            (G.vacuumOrthogonalRealResolvent T hP hSelf hlambda) ^ (n + 1)) ∧
      ∀ (n : ℕ) {lambda : ℝ} (hlambda : lambda < G.mass),
        ‖iteratedDeriv n
            (G.vacuumOrthogonalRealResolventOn T hP hSelf) lambda‖ ≤
          (n.factorial : ℝ) * ((G.mass - lambda)⁻¹) ^ (n + 1) := by
  refine ⟨G.vacuumOrthogonalRealResolventOn_contDiffOn_infty T hP hSelf, ?_, ?_⟩
  · intro n lambda hlambda
    exact G.vacuumOrthogonalRealResolventOn_iteratedDeriv
      T hP hSelf n (lambda := lambda) hlambda
  · intro n lambda hlambda
    exact G.vacuumOrthogonalRealResolventOn_iteratedDeriv_norm_le
      T hP hSelf n (lambda := lambda) hlambda

