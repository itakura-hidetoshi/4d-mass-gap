import MGAP4D.MathlibAnalytic.PhysicalYangMillsWilsonSU2ThreeModeKrylovAdjacentPairHaarLiteralTwoCoordinateFubiniCommutation
import Mathlib.MeasureTheory.Function.ConditionalExpectation.Unique
import Mathlib.MeasureTheory.Function.ConditionalExpectation.CondexpL2
import Mathlib.MeasureTheory.Integral.Prod
import Mathlib.Tactic

/-!
# P4-Q2-CV: literal product fiber Haar mean equals genuine L2 conditional expectation

CU established Fubini commutation of bounded strongly measurable concrete
independent Haar averages on the actual original left/right pair-Haar law.

Here we identify the literal fiber integral with the intrinsic Hilbert-L2
conditional expectation on a generic genuine product probability measure.
Given a pointwise bounded L2 representative f on (mu.prod nu), its actual
right-fiber integration agrees almost everywhere with the intrinsic
condExpL2 orthogonal projection to the sigma-algebra generated by the
first coordinate. Every smaller-sigma measurable set is a genuine inverse
image of a measurable first-factor set and Fubini gives the equality of
all set integrals. L2 uniqueness establishes the original equivalence.

Next: transport this generic identity along the physical joint pair-Haar
finite-coordinate measurable equivalence. This theorem alone does not
claim unconditional CR coordinate-projection commutation or Wilson gap.
-/

namespace MGAP4D
namespace MathlibAnalytic

open MeasureTheory
open scoped ENNReal

noncomputable section

set_option maxHeartbeats 1800000
set_option synthInstance.maxHeartbeats 850000

/-- The first-factor sigma algebra is a NAMED declaration rather than a
local let-binding of a typeclass. This prevents Lean from selecting the
coarser sigma algebra as the ambient MeasurableSpace instance in later
StronglyMeasurable and product-Fubini assertions. -/
private abbrev p4Q2CV_firstFactorSigma
    {α β : Type*} [MeasurableSpace α] [MeasurableSpace β] :
    MeasurableSpace (α × β) :=
  MeasurableSpace.comap (Prod.fst : α × β → α)
    (inferInstance : MeasurableSpace α)

theorem p4Q2CV_productProbability_condExpL2_ae_eq_fiberHaarMean
    {α β : Type*} [MeasurableSpace α] [MeasurableSpace β]
    (μ : Measure α) (ν : Measure β)
    [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    (f : Lp ℝ 2 (μ.prod ν))
    (M : ℝ) (hM : ∀ z : α × β, ‖f z‖ ≤ M) :
    (condExpL2 ℝ ℝ (measurable_fst.comap_le) f :
      Lp ℝ 2 (μ.prod ν)) =ᵐ[μ.prod ν]
      (fun z : α × β => ∫ b : β, f (z.1, b) ∂ν) := by
  classical
  have hm : p4Q2CV_firstFactorSigma (α := α) (β := β) ≤
      (inferInstance : MeasurableSpace (α × β)) := by
    change MeasurableSpace.comap (Prod.fst : α × β → α)
      (inferInstance : MeasurableSpace α) ≤
        (inferInstance : MeasurableSpace (α × β))
    exact measurable_fst.comap_le
  let h : α → ℝ := fun a => ∫ b : β, f (a, b) ∂ν
  have hfsm : StronglyMeasurable (f : α × β → ℝ) :=
    Lp.stronglyMeasurable f
  have hhsm : StronglyMeasurable h :=
    hfsm.integral_prod_right'
  have hBound : ∀ a : α, ‖h a‖ ≤ M := by
    intro a
    have hsecSm : StronglyMeasurable (fun b : β => f (a, b)) :=
      hfsm.comp_measurable (measurable_const.prodMk measurable_id)
    have hsecInt : Integrable (fun b : β => f (a, b)) ν :=
      Integrable.of_bound hsecSm.aestronglyMeasurable M
        (Filter.Eventually.of_forall fun b => hM (a, b))
    calc
      ‖h a‖ = ‖∫ b : β, f (a, b) ∂ν‖ := rfl
      _ ≤ ∫ b : β, ‖f (a, b)‖ ∂ν := norm_integral_le_integral_norm _
      _ ≤ ∫ _b : β, M ∂ν :=
        integral_mono_ae hsecInt.norm (integrable_const M)
          (Filter.Eventually.of_forall fun b => hM (a, b))
      _ = M := by simp
  have hMeanSm : StronglyMeasurable (fun z : α × β => h z.1) :=
    hhsm.comp_measurable measurable_fst
  letI : IsProbabilityMeasure (μ.prod ν) := by infer_instance
  have hMeanInt : Integrable (fun z : α × β => h z.1) (μ.prod ν) :=
    Integrable.of_bound hMeanSm.aestronglyMeasurable M
      (Filter.Eventually.of_forall fun z => hBound z.1)
  have hFInt : Integrable (f : α × β → ℝ) (μ.prod ν) :=
    Integrable.of_bound hfsm.aestronglyMeasurable M
      (Filter.Eventually.of_forall hM)
  have hMeanLp : MemLp (fun z : α × β => h z.1) 2 (μ.prod ν) :=
    MemLp.of_bound hMeanSm.aestronglyMeasurable M
      (Filter.Eventually.of_forall fun z => hBound z.1)
  let g : Lp ℝ 2 (μ.prod ν) :=
    hMeanLp.toLp (fun z : α × β => h z.1)
  have hsmall : AEStronglyMeasurable[p4Q2CV_firstFactorSigma (α := α) (β := β)]
      (g : α × β → ℝ) (μ.prod ν) := by
    have hm0 : StronglyMeasurable[p4Q2CV_firstFactorSigma (α := α) (β := β)] (fun z : α × β => h z.1) :=
      hhsm.comp_measurable (comap_measurable Prod.fst)
    exact hm0.aestronglyMeasurable.congr hMeanLp.coeFn_toLp.symm
  have hCondSm : AEStronglyMeasurable[p4Q2CV_firstFactorSigma (α := α) (β := β)]
      (condExpL2 ℝ ℝ hm f : Lp ℝ 2 (μ.prod ν)) (μ.prod ν) :=
    lpMeas.aestronglyMeasurable _
  have hSet : ∀ s : Set (α × β), MeasurableSet[p4Q2CV_firstFactorSigma (α := α) (β := β)] s →
      ∫ z in s, (g : Lp ℝ 2 (μ.prod ν)) z ∂(μ.prod ν) =
        ∫ z in s, (condExpL2 ℝ ℝ hm f : Lp ℝ 2 (μ.prod ν)) z ∂(μ.prod ν) := by
    intro s hs
    obtain ⟨t, ht, heq⟩ :=
      (MeasurableSpace.measurableSet_comap.mp hs)
    have hset' : s = t ×ˢ Set.univ := by
      rw [← heq]
      ext z
      simp
    have hsmall' : MeasurableSet (t ×ˢ Set.univ : Set (α × β)) :=
      ht.prod MeasurableSet.univ
    have hretained : MeasurableSet[p4Q2CV_firstFactorSigma (α := α) (β := β)] (t ×ˢ Set.univ : Set (α × β)) := by
      simpa [← hset'] using hs
    rw [hset']
    calc
      (∫ z in t ×ˢ Set.univ, (g : Lp ℝ 2 (μ.prod ν)) z ∂(μ.prod ν)) =
          ∫ z in t ×ˢ Set.univ, h z.1 ∂(μ.prod ν) :=
            setIntegral_congr_ae hsmall'
              (hMeanLp.coeFn_toLp.mono fun z hz _ => hz)
      _ = ∫ a in t, ∫ b in Set.univ, h a ∂ν ∂μ :=
        setIntegral_prod (fun z : α × β => h z.1) hMeanInt.integrableOn
      _ = ∫ a in t, h a ∂μ := by simp
      _ = ∫ a in t, ∫ b in Set.univ, f (a, b) ∂ν ∂μ := by simp [h]
      _ = ∫ z in t ×ˢ Set.univ, f z ∂(μ.prod ν) :=
        (setIntegral_prod (f : α × β → ℝ) hFInt.integrableOn).symm
      _ = ∫ z in t ×ˢ Set.univ,
          (condExpL2 ℝ ℝ hm f : Lp ℝ 2 (μ.prod ν)) z
          ∂(μ.prod ν) :=
        (integral_condExpL2_eq hm f hretained
          (measure_ne_top _ _)).symm
  have hEq : g =ᵐ[μ.prod ν]
      (condExpL2 ℝ ℝ hm f : Lp ℝ 2 (μ.prod ν)) := by
    apply Lp.ae_eq_of_forall_setIntegral_eq' ℝ hm
      g (condExpL2 ℝ ℝ hm f : Lp ℝ 2 (μ.prod ν))
      two_ne_zero ENNReal.coe_ne_top
    · intro s hs hfin
      exact integrableOn_Lp_of_measure_ne_top g
        fact_one_le_two_ennreal.elim hfin.ne
    · intro s hs hfin
      exact integrableOn_Lp_of_measure_ne_top
        (condExpL2 ℝ ℝ hm f : Lp ℝ 2 (μ.prod ν))
        fact_one_le_two_ennreal.elim hfin.ne
    · intro s hs hfin
      exact hSet s hs
    · exact hsmall
    · exact hCondSm
  exact hEq.symm.trans hMeanLp.coeFn_toLp

end
end MathlibAnalytic
end MGAP4D
