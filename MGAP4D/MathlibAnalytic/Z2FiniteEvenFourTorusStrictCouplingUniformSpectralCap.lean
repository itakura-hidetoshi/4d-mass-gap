import MGAP4D.MathlibAnalytic.Z2FiniteEvenFourTorusStrictCouplingFiniteVolumeFamilyCompletePackage
import Mathlib.Tactic

namespace MGAP4D
namespace MathlibAnalytic

noncomputable section

/-- A genuinely volume-independent quantitative input for the actual strict-
coupling unfixed-gauge `Z₂` transfer family.  The same number `rate < 1`
bounds every strictly excited transfer eigenvalue at every finite side
parameter. -/
structure Z2UnfixedGaugeStrictCouplingUniformSpectralCapCertificate
    (β energyIdentity energyNontrivial : ℝ)
    (hβ : 0 < β)
    (hEnergy : energyIdentity < energyNontrivial) where
  rate : ℝ
  rate_pos : 0 < rate
  rate_lt_one : rate < 1
  excitedEigenvalue_le_rate :
    ∀ (H : ℕ)
      (i : FiniteEvenFourTorusZ2UnfixedGaugeExcitedSpectralIndex
        H β energyIdentity energyNontrivial hβ.le hEnergy.le),
      (finiteEvenFourTorusZ2UnfixedGaugeInvariantSpectralData
        H β energyIdentity energyNontrivial hβ.le hEnergy.le).eigenvalue i.1 ≤ rate

namespace Z2UnfixedGaugeStrictCouplingUniformSpectralCapCertificate

variable
    {β energyIdentity energyNontrivial : ℝ}
    {hβ : 0 < β}
    {hEnergy : energyIdentity < energyNontrivial}
    (C : Z2UnfixedGaugeStrictCouplingUniformSpectralCapCertificate
      β energyIdentity energyNontrivial hβ hEnergy)

/-- The common energy floor generated by the common excited-transfer cap. -/
noncomputable def uniformExcitationGap : ℝ :=
  -Real.log C.rate

/-- The common energy floor is strictly positive because the common transfer
rate lies strictly between zero and one. -/
theorem uniformExcitationGap_pos :
    0 < C.uniformExcitationGap := by
  exact neg_pos.mpr (Real.log_neg C.rate_pos C.rate_lt_one)

/-- Exponentiating the negative common energy floor recovers the exact common
transfer rate. -/
theorem exp_neg_uniformExcitationGap :
    Real.exp (-C.uniformExcitationGap) = C.rate := by
  simp [uniformExcitationGap, Real.exp_log C.rate_pos]

/-- The common rate remains strictly contractive at every positive natural
time. -/
theorem rate_pow_lt_one
    {n : ℕ}
    (hn : 0 < n) :
    C.rate ^ n < 1 :=
  pow_lt_one₀ C.rate_pos.le C.rate_lt_one hn.ne'

/-- The exact finite-volume gap lies below every excited energy.  This theorem
makes the minimum-energy step explicit for the strict all-volume family. -/
theorem finiteEvenFourTorusZ2UnfixedGaugeStrictExcitationGapAt_le_excitedEnergy
    (H : ℕ)
    (i : FiniteEvenFourTorusZ2UnfixedGaugeExcitedSpectralIndex
      H β energyIdentity energyNontrivial hβ.le hEnergy.le) :
    finiteEvenFourTorusZ2UnfixedGaugeStrictExcitationGapAt
        H β energyIdentity energyNontrivial hβ hEnergy ≤
      finiteEvenFourTorusZ2UnfixedGaugePositiveSpectralEnergy
        H β energyIdentity energyNontrivial hβ.le hEnergy.le i.toPositive := by
  letI : Nonempty
      (FiniteEvenFourTorusZ2UnfixedGaugeExcitedSpectralIndex
        H β energyIdentity energyNontrivial hβ.le hEnergy.le) :=
    finiteEvenFourTorusZ2UnfixedGaugeExcitedSpectralIndex_allVolume_nonempty_strict
      H β energyIdentity energyNontrivial hβ hEnergy
  simpa [finiteEvenFourTorusZ2UnfixedGaugeStrictExcitationGapAt,
    finiteEvenFourTorusZ2UnfixedGaugeExcitationGap] using
      (finiteEvenFourTorusZ2UnfixedGaugeInvariantSpectralData
        H β energyIdentity energyNontrivial hβ.le hEnergy.le).excitationGap_le_energy i

/-- Every actual excited mode at every finite volume has energy at least the
common floor generated by the spectral cap. -/
theorem uniformExcitationGap_le_excitedEnergy
    (H : ℕ)
    (i : FiniteEvenFourTorusZ2UnfixedGaugeExcitedSpectralIndex
      H β energyIdentity energyNontrivial hβ.le hEnergy.le) :
    C.uniformExcitationGap ≤
      finiteEvenFourTorusZ2UnfixedGaugePositiveSpectralEnergy
        H β energyIdentity energyNontrivial hβ.le hEnergy.le i.toPositive := by
  change
    -Real.log C.rate ≤
      -Real.log
        ((finiteEvenFourTorusZ2UnfixedGaugeInvariantSpectralData
          H β energyIdentity energyNontrivial hβ.le hEnergy.le).eigenvalue i.1)
  apply neg_le_neg
  exact Real.strictMonoOn_log.monotoneOn
    i.2.1 C.rate_pos (C.excitedEigenvalue_le_rate H i)

/-- The common energy floor is a lower bound for the exact excitation gap at
every finite side parameter. -/
theorem uniformExcitationGap_le_strictExcitationGapAt
    (H : ℕ) :
    C.uniformExcitationGap ≤
      finiteEvenFourTorusZ2UnfixedGaugeStrictExcitationGapAt
        H β energyIdentity energyNontrivial hβ hEnergy := by
  letI : Nonempty
      (FiniteEvenFourTorusZ2UnfixedGaugeExcitedSpectralIndex
        H β energyIdentity energyNontrivial hβ.le hEnergy.le) :=
    finiteEvenFourTorusZ2UnfixedGaugeExcitedSpectralIndex_allVolume_nonempty_strict
      H β energyIdentity energyNontrivial hβ hEnergy
  let D := finiteEvenFourTorusZ2UnfixedGaugeInvariantSpectralData
    H β energyIdentity energyNontrivial hβ.le hEnergy.le
  have hmem : D.excitationGap ∈ D.excitedEnergyValues := by
    unfold FiniteDimensionalSymmetricPositiveContractionData.excitationGap
    exact Finset.min'_mem _ _
  rcases Finset.mem_image.mp hmem with ⟨i, _hi, hi⟩
  have hfloor : C.uniformExcitationGap ≤ D.excitationGap := by
    rw [← hi]
    exact C.uniformExcitationGap_le_excitedEnergy H i
  simpa [D, finiteEvenFourTorusZ2UnfixedGaugeStrictExcitationGapAt,
    finiteEvenFourTorusZ2UnfixedGaugeExcitationGap] using hfloor

/-- The spectral cap therefore closes the precise family-level existential
uniform-gap statement. -/
theorem exists_uniformExcitationGap
    (C : Z2UnfixedGaugeStrictCouplingUniformSpectralCapCertificate
      β energyIdentity energyNontrivial hβ hEnergy) :
    ∃ Δstar : ℝ,
      0 < Δstar ∧
      ∀ H : ℕ,
        Δstar ≤
          finiteEvenFourTorusZ2UnfixedGaugeStrictExcitationGapAt
            H β energyIdentity energyNontrivial hβ hEnergy :=
  ⟨C.uniformExcitationGap, C.uniformExcitationGap_pos,
    C.uniformExcitationGap_le_strictExcitationGapAt⟩

/-- Every strictly excited coordinate at every finite volume decays with the
same volume-independent transfer rate. -/
theorem excitedSemigroup_coordinate_abs_le_rate
    (H : ℕ)
    (n : ℕ)
    (x : FiniteEvenFourTorusZ2UnfixedGaugePositiveSpectralSpace
      H β energyIdentity energyNontrivial hβ.le hEnergy.le)
    (i : FiniteEvenFourTorusZ2UnfixedGaugeExcitedSpectralIndex
      H β energyIdentity energyNontrivial hβ.le hEnergy.le) :
    |finiteEvenFourTorusZ2UnfixedGaugePositiveSpectralSemigroup
        H β energyIdentity energyNontrivial hβ.le hEnergy.le n x i.toPositive| ≤
      C.rate ^ n * |x i.toPositive| := by
  let D := finiteEvenFourTorusZ2UnfixedGaugeInvariantSpectralData
    H β energyIdentity energyNontrivial hβ.le hEnergy.le
  change
    |D.positiveSpectralSemigroup n x i.toPositive| ≤
      C.rate ^ n * |x i.toPositive|
  rw [D.positiveSpectralSemigroup_apply, abs_mul, abs_pow]
  have hpos : 0 < D.positiveEigenvalue i.toPositive := by
    exact i.2.1
  rw [abs_of_pos hpos]
  have hcap : D.positiveEigenvalue i.toPositive ≤ C.rate := by
    simpa [D,
      FiniteDimensionalSymmetricPositiveContractionData.positiveEigenvalue] using
        C.excitedEigenvalue_le_rate H i
  exact mul_le_mul_of_nonneg_right
    (pow_le_pow_left₀ hpos.le hcap n)
    (abs_nonneg _)

/-- Equivalent common-gap notation for the uniform coordinate decay. -/
theorem excitedSemigroup_coordinate_abs_le_uniformGap
    (H : ℕ)
    (n : ℕ)
    (x : FiniteEvenFourTorusZ2UnfixedGaugePositiveSpectralSpace
      H β energyIdentity energyNontrivial hβ.le hEnergy.le)
    (i : FiniteEvenFourTorusZ2UnfixedGaugeExcitedSpectralIndex
      H β energyIdentity energyNontrivial hβ.le hEnergy.le) :
    |finiteEvenFourTorusZ2UnfixedGaugePositiveSpectralSemigroup
        H β energyIdentity energyNontrivial hβ.le hEnergy.le n x i.toPositive| ≤
      (Real.exp (-C.uniformExcitationGap)) ^ n * |x i.toPositive| := by
  rw [C.exp_neg_uniformExcitationGap]
  exact C.excitedSemigroup_coordinate_abs_le_rate H n x i

end Z2UnfixedGaugeStrictCouplingUniformSpectralCapCertificate

end

end MathlibAnalytic
end MGAP4D
