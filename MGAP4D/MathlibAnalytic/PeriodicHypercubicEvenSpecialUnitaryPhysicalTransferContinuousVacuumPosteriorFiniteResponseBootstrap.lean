import MGAP4D.MathlibAnalytic.PeriodicHypercubicEvenSpecialUnitaryPhysicalTransferContinuousVacuumPosteriorLocalCovarianceFiniteTelescope
import Mathlib.Tactic

/-!
# Finite posterior remote-response bootstrap

PR #5166 identifies the source-tilted target expectation response with a
posterior covariance divided by the positive source-factor mean.  PR #5168
controls the finite random-scan covariance telescope by the non-strict finite
resolvent profile, leaving only one explicit terminal covariance remainder.

This file combines those two statements.

For a target-local factor F_t, a source-local factor L_s, and the exact
posterior random-scan operator R, write

  w_M(s)

for the finite resolvent profile generated from the one-coordinate variation
of F_t.  If the terminal covariance after M random-scan steps is bounded by
tau,

  |Cov(L_s, R^M F_t)| <= tau,

then

  |Cov(F_t,L_s)|
    <= (width(beta)/2) * w_M(s) + tau,

where

  width(beta) = exp(8 beta) - exp(-8 beta).

Using the exact source-tilt covariance identity and the lower source-factor
mean exp(-8 beta), the ordinary posterior expectation response is bounded by

  epsilon_M
    = ((width(beta)/2) * w_M(s) + tau) / exp(-8 beta).

This theorem is finite in the random-scan update count and does not assume a
strict Dobrushin row sum.  It isolates the remaining obstruction entirely in
the terminal covariance envelope tau.

No terminal-remainder limit, infinite resolvent, geometric decay,
heat-bath-time / Euclidean-time identification, H1-D5 exact descent, or
complete Yang--Mills mass-gap claim is introduced.
-/

namespace MGAP4D
namespace MathlibAnalytic

noncomputable section

local instance posteriorFiniteResponseBootstrapSpatialLinkFintype
    (H : ℕ) :
    Fintype (PeriodicHypercubicEvenSpatialSliceLink H) :=
  Fintype.ofFinite _

/-- Finite covariance radius generated by the non-strict resolvent plus an
explicit terminal covariance envelope. -/
noncomputable def
    periodicHypercubicEvenSpecialUnitaryContinuousVacuumPosteriorFiniteBootstrapCovarianceRadius
    {H N : ℕ}
    {hN : 0 < N}
    {beta : ℝ}
    {hbeta : 0 ≤ beta}
    {B : PeriodicHypercubicEvenSpecialUnitarySpatialSliceConfiguration H N}
    (D :
      PeriodicHypercubicEvenSpecialUnitaryContinuousVacuumPosteriorNonstrictInfluenceData
        H N hN beta hbeta B)
    (target source : PeriodicHypercubicEvenSpatialSliceLink H)
    (M : ℕ)
    (terminal : ℝ) : ℝ :=
  (periodicHypercubicEvenSpecialUnitaryTemporalGaugeOneSlabRightTargetLocalFactorVariationWidth
      beta / 2) *
    periodicHypercubicEvenSpecialUnitaryContinuousVacuumPosteriorRandomScanFiniteResolventProfile
      D
      (periodicHypercubicEvenSpecialUnitaryTemporalGaugeOneSlabRightTargetLocalFactorVariation
        beta target)
      M source +
    terminal

/-- Corresponding finite ordinary expectation-response radius after dividing
by the uniform source-factor lower floor exp(-8 beta). -/
noncomputable def
    periodicHypercubicEvenSpecialUnitaryContinuousVacuumPosteriorFiniteBootstrapResponseRadius
    {H N : ℕ}
    {hN : 0 < N}
    {beta : ℝ}
    {hbeta : 0 ≤ beta}
    {B : PeriodicHypercubicEvenSpecialUnitarySpatialSliceConfiguration H N}
    (D :
      PeriodicHypercubicEvenSpecialUnitaryContinuousVacuumPosteriorNonstrictInfluenceData
        H N hN beta hbeta B)
    (target source : PeriodicHypercubicEvenSpatialSliceLink H)
    (M : ℕ)
    (terminal : ℝ) : ℝ :=
  periodicHypercubicEvenSpecialUnitaryContinuousVacuumPosteriorFiniteBootstrapCovarianceRadius
      D target source M terminal /
    Real.exp (-8 * beta)

/-- The finite bootstrap covariance radius is nonnegative whenever the
terminal envelope is nonnegative. -/
theorem
    periodicHypercubicEvenSpecialUnitaryContinuousVacuumPosteriorFiniteBootstrapCovarianceRadius_nonneg
    {H N : ℕ}
    {hN : 0 < N}
    {beta : ℝ}
    {hbeta : 0 ≤ beta}
    {B : PeriodicHypercubicEvenSpecialUnitarySpatialSliceConfiguration H N}
    (D :
      PeriodicHypercubicEvenSpecialUnitaryContinuousVacuumPosteriorNonstrictInfluenceData
        H N hN beta hbeta B)
    (target source : PeriodicHypercubicEvenSpatialSliceLink H)
    (M : ℕ)
    (terminal : ℝ)
    (hterminal : 0 ≤ terminal) :
    0 ≤
      periodicHypercubicEvenSpecialUnitaryContinuousVacuumPosteriorFiniteBootstrapCovarianceRadius
        D target source M terminal := by
  have hWidth :
      0 ≤
        periodicHypercubicEvenSpecialUnitaryTemporalGaugeOneSlabRightTargetLocalFactorVariationWidth
          beta / 2 := by
    exact div_nonneg
      (periodicHypercubicEvenSpecialUnitaryTemporalGaugeOneSlabRightTargetLocalFactorVariationWidth_nonneg
        beta hbeta)
      (by norm_num)
  have hVariation :
      ∀ e : PeriodicHypercubicEvenSpatialSliceLink H,
        0 ≤
          periodicHypercubicEvenSpecialUnitaryTemporalGaugeOneSlabRightTargetLocalFactorVariation
            beta target e := by
    intro e
    exact
      periodicHypercubicEvenSpecialUnitaryTemporalGaugeOneSlabRightTargetLocalFactorVariation_nonneg
        beta hbeta target e
  have hResolvent :
      0 ≤
        periodicHypercubicEvenSpecialUnitaryContinuousVacuumPosteriorRandomScanFiniteResolventProfile
          D
          (periodicHypercubicEvenSpecialUnitaryTemporalGaugeOneSlabRightTargetLocalFactorVariation
            beta target)
          M source :=
    periodicHypercubicEvenSpecialUnitaryContinuousVacuumPosteriorRandomScanFiniteResolventProfile_nonneg
      D
      (periodicHypercubicEvenSpecialUnitaryTemporalGaugeOneSlabRightTargetLocalFactorVariation
        beta target)
      hVariation M source
  unfold
    periodicHypercubicEvenSpecialUnitaryContinuousVacuumPosteriorFiniteBootstrapCovarianceRadius
  exact add_nonneg (mul_nonneg hWidth hResolvent) hterminal

/-- The finite bootstrap response radius is nonnegative whenever the terminal
covariance envelope is nonnegative. -/
theorem
    periodicHypercubicEvenSpecialUnitaryContinuousVacuumPosteriorFiniteBootstrapResponseRadius_nonneg
    {H N : ℕ}
    {hN : 0 < N}
    {beta : ℝ}
    {hbeta : 0 ≤ beta}
    {B : PeriodicHypercubicEvenSpecialUnitarySpatialSliceConfiguration H N}
    (D :
      PeriodicHypercubicEvenSpecialUnitaryContinuousVacuumPosteriorNonstrictInfluenceData
        H N hN beta hbeta B)
    (target source : PeriodicHypercubicEvenSpatialSliceLink H)
    (M : ℕ)
    (terminal : ℝ)
    (hterminal : 0 ≤ terminal) :
    0 ≤
      periodicHypercubicEvenSpecialUnitaryContinuousVacuumPosteriorFiniteBootstrapResponseRadius
        D target source M terminal := by
  unfold
    periodicHypercubicEvenSpecialUnitaryContinuousVacuumPosteriorFiniteBootstrapResponseRadius
  exact div_nonneg
    (periodicHypercubicEvenSpecialUnitaryContinuousVacuumPosteriorFiniteBootstrapCovarianceRadius_nonneg
      D target source M terminal hterminal)
    (Real.exp_pos _).le

/-- A uniform terminal covariance envelope for the actual M-step posterior
random-scan orbit gives a finite ordinary target/source expectation-response
bound. -/
theorem
    periodicHypercubicEvenSpecialUnitaryContinuousVacuumPosteriorTargetExpectationResponseBound_of_finiteRandomScanTerminalCovariance
    {H N : ℕ}
    {hN : 0 < N}
    {beta : ℝ}
    {hbeta : 0 ≤ beta}
    {B : PeriodicHypercubicEvenSpecialUnitarySpatialSliceConfiguration H N}
    (D :
      PeriodicHypercubicEvenSpecialUnitaryContinuousVacuumPosteriorNonstrictInfluenceData
        H N hN beta hbeta B)
    (target source : PeriodicHypercubicEvenSpatialSliceLink H)
    (sourceValue : Matrix.specialUnitaryGroup (Fin N) ℂ)
    (hEdge : 0 < Fintype.card (PeriodicHypercubicEvenSpatialSliceLink H))
    (M : ℕ)
    (terminal : ℝ)
    (hterminal : 0 ≤ terminal)
    (hTerminal :
      ∀ g : Matrix.specialUnitaryGroup (Fin N) ℂ,
        let F :=
          periodicHypercubicEvenSpecialUnitaryTemporalGaugeOneSlabRightTargetLocalFactorBCF
            H N beta B target g
        let V :=
          periodicHypercubicEvenSpecialUnitaryTemporalGaugeOneSlabRightTargetLocalFactorVariationBound
            H N hN beta hbeta B target g
        let P := V.toCenteredVariationProfile
        let L :=
          periodicHypercubicEvenSpecialUnitaryTemporalGaugeOneSlabRightTargetLocalFactorBCF
            H N beta B source sourceValue
        |periodicHypercubicEvenSpecialUnitaryContinuousVacuumPosteriorCovariance
            H N hN beta hbeta B L
            (((P.toRandomScanCenteredState).randomScanIterate D M).observable)| ≤
          terminal) :
    PeriodicHypercubicEvenSpecialUnitaryContinuousVacuumPosteriorTargetExpectationResponseBound
      H N hN beta hbeta B target source sourceValue
      (periodicHypercubicEvenSpecialUnitaryContinuousVacuumPosteriorFiniteBootstrapResponseRadius
        D target source M terminal) := by
  let K :=
    periodicHypercubicEvenSpecialUnitaryContinuousVacuumPosteriorFiniteBootstrapCovarianceRadius
      D target source M terminal
  have hK : 0 ≤ K :=
    periodicHypercubicEvenSpecialUnitaryContinuousVacuumPosteriorFiniteBootstrapCovarianceRadius_nonneg
      D target source M terminal hterminal
  apply
    periodicHypercubicEvenSpecialUnitaryContinuousVacuumPosteriorTargetExpectationResponseBound_of_covariance
      H N hN beta hbeta B target source sourceValue K hK
  intro g
  let F :=
    periodicHypercubicEvenSpecialUnitaryTemporalGaugeOneSlabRightTargetLocalFactorBCF
      H N beta B target g
  let V :=
    periodicHypercubicEvenSpecialUnitaryTemporalGaugeOneSlabRightTargetLocalFactorVariationBound
      H N hN beta hbeta B target g
  let P := V.toCenteredVariationProfile
  let L :=
    periodicHypercubicEvenSpecialUnitaryTemporalGaugeOneSlabRightTargetLocalFactorBCF
      H N beta B source sourceValue
  let terminalObservable :=
    ((P.toRandomScanCenteredState).randomScanIterate D M).observable
  let w :=
    periodicHypercubicEvenSpecialUnitaryContinuousVacuumPosteriorRandomScanFiniteResolventProfile
      D
      (periodicHypercubicEvenSpecialUnitaryTemporalGaugeOneSlabRightTargetLocalFactorVariation
        beta target)
      M source
  have hPVariation :
      P.variation =
        periodicHypercubicEvenSpecialUnitaryTemporalGaugeOneSlabRightTargetLocalFactorVariation
          beta target := by
    rfl
  have hTelescopeRaw :=
    periodicHypercubicEvenSpecialUnitaryContinuousVacuumPosterior_localFactor_randomScanCenteredState_partial_telescope_abs_le_finiteResolventProfile
      source sourceValue P D hEdge M
  have hTelescope :
      |periodicHypercubicEvenSpecialUnitaryContinuousVacuumPosteriorCovariance
          H N hN beta hbeta B L F -
        periodicHypercubicEvenSpecialUnitaryContinuousVacuumPosteriorCovariance
          H N hN beta hbeta B L terminalObservable| ≤
        (periodicHypercubicEvenSpecialUnitaryTemporalGaugeOneSlabRightTargetLocalFactorVariationWidth
            beta / 2) * w := by
    simpa [F, V, P, L, terminalObservable, w, hPVariation] using hTelescopeRaw
  have hTerminalG :
      |periodicHypercubicEvenSpecialUnitaryContinuousVacuumPosteriorCovariance
          H N hN beta hbeta B L terminalObservable| ≤ terminal := by
    simpa [F, V, P, L, terminalObservable] using hTerminal g
  have hCovLF :
      |periodicHypercubicEvenSpecialUnitaryContinuousVacuumPosteriorCovariance
          H N hN beta hbeta B L F| ≤ K := by
    change
      |periodicHypercubicEvenSpecialUnitaryContinuousVacuumPosteriorCovariance
          H N hN beta hbeta B L F| ≤
        (periodicHypercubicEvenSpecialUnitaryTemporalGaugeOneSlabRightTargetLocalFactorVariationWidth
            beta / 2) * w + terminal
    calc
      |periodicHypercubicEvenSpecialUnitaryContinuousVacuumPosteriorCovariance
          H N hN beta hbeta B L F| =
        |(periodicHypercubicEvenSpecialUnitaryContinuousVacuumPosteriorCovariance
            H N hN beta hbeta B L F -
          periodicHypercubicEvenSpecialUnitaryContinuousVacuumPosteriorCovariance
            H N hN beta hbeta B L terminalObservable) +
          periodicHypercubicEvenSpecialUnitaryContinuousVacuumPosteriorCovariance
            H N hN beta hbeta B L terminalObservable| := by
        congr 1
        ring
      _ ≤
        |periodicHypercubicEvenSpecialUnitaryContinuousVacuumPosteriorCovariance
            H N hN beta hbeta B L F -
          periodicHypercubicEvenSpecialUnitaryContinuousVacuumPosteriorCovariance
            H N hN beta hbeta B L terminalObservable| +
        |periodicHypercubicEvenSpecialUnitaryContinuousVacuumPosteriorCovariance
            H N hN beta hbeta B L terminalObservable| :=
        abs_add_le _ _
      _ ≤
        (periodicHypercubicEvenSpecialUnitaryTemporalGaugeOneSlabRightTargetLocalFactorVariationWidth
            beta / 2) * w + terminal :=
        add_le_add hTelescope hTerminalG
  rw [
    periodicHypercubicEvenSpecialUnitaryContinuousVacuumPosteriorCovariance_comm
      H N hN beta hbeta B F L]
  simpa [K, F, L, w,
    periodicHypercubicEvenSpecialUnitaryContinuousVacuumPosteriorFiniteBootstrapCovarianceRadius] using
    hCovLF

end

end MathlibAnalytic
end MGAP4D
