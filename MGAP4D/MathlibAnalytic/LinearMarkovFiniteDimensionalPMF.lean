import Mathlib.Probability.ProbabilityMassFunction.Constructions
import Mathlib.Tactic

namespace MGAP4D
namespace MathlibAnalytic

noncomputable section

/-- The one-step joint probability mass function generated by an initial law and
an honest Markov transition probability mass function. -/
def linearMarkovPairPMF
    {Ω : Type*}
    (initial : PMF Ω)
    (transition : Ω → PMF Ω) : PMF (Ω × Ω) :=
  initial.bind fun x =>
    (transition x).map fun y => (x, y)

/-- The two-step joint probability mass function generated by an initial law and
an honest Markov transition probability mass function. -/
def linearMarkovTriplePMF
    {Ω : Type*}
    (initial : PMF Ω)
    (transition : Ω → PMF Ω) : PMF (Ω × Ω × Ω) :=
  initial.bind fun x =>
    (transition x).bind fun y =>
      (transition y).map fun z => (x, y, z)

/-- Delete the unobserved terminal coordinate of a three-coordinate path. -/
def linearMarkovTripleDropLast
    {Ω : Type*} : Ω × Ω × Ω → Ω × Ω :=
  fun xyz => (xyz.1, xyz.2.1)

/-- The first marginal of the one-step joint law is exactly the initial law. -/
theorem linearMarkovPairPMF_map_fst
    {Ω : Type*}
    (initial : PMF Ω)
    (transition : Ω → PMF Ω) :
    (linearMarkovPairPMF initial transition).map Prod.fst = initial := by
  unfold linearMarkovPairPMF
  rw [PMF.map_bind]
  have hKernel :
      (fun x => ((transition x).map fun y => (x, y)).map Prod.fst) =
        PMF.pure := by
    funext x
    rw [PMF.map_comp]
    change (transition x).map (Function.const Ω x) = PMF.pure x
    exact PMF.map_const (p := transition x) (b := x)
  rw [hKernel, PMF.bind_pure]

/-- Deleting the unobserved terminal coordinate of the two-step law recovers the
one-step joint law. This is the first nontrivial finite-dimensional projective
consistency identity. -/
theorem linearMarkovTriplePMF_map_dropLast
    {Ω : Type*}
    (initial : PMF Ω)
    (transition : Ω → PMF Ω) :
    (linearMarkovTriplePMF initial transition).map
        linearMarkovTripleDropLast =
      linearMarkovPairPMF initial transition := by
  unfold linearMarkovTriplePMF linearMarkovPairPMF
  rw [PMF.map_bind]
  apply congrArg (fun k => initial.bind k)
  funext x
  rw [PMF.map_bind]
  change
    (transition x).bind
        (fun y =>
          ((transition y).map fun z => (x, y, z)).map
            linearMarkovTripleDropLast) =
      (transition x).bind (fun y => PMF.pure (x, y))
  apply congrArg (fun k => (transition x).bind k)
  funext y
  rw [PMF.map_comp]
  change
    (transition y).map (Function.const Ω (x, y)) =
      PMF.pure (x, y)
  exact PMF.map_const (p := transition y) (b := (x, y))

/-- Every point probability of the one-step Markov joint law is nonnegative. -/
theorem linearMarkovPairPMF_nonneg
    {Ω : Type*}
    (initial : PMF Ω)
    (transition : Ω → PMF Ω)
    (xy : Ω × Ω) :
    0 ≤ linearMarkovPairPMF initial transition xy :=
  bot_le

/-- Every point probability of the two-step Markov joint law is nonnegative. -/
theorem linearMarkovTriplePMF_nonneg
    {Ω : Type*}
    (initial : PMF Ω)
    (transition : Ω → PMF Ω)
    (xyz : Ω × Ω × Ω) :
    0 ≤ linearMarkovTriplePMF initial transition xyz :=
  bot_le

end

end MathlibAnalytic
end MGAP4D
