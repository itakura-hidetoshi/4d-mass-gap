import MGAP4D.MathlibAnalytic.PhysicalYangMillsWilsonSU2ThreeModeKrylovAdjacentPairHaarOriginalRealEightGaussianPairGramV5_NN
import Mathlib.Topology.ContinuousMap.StoneWeierstrass
import Mathlib.Tactic

/-!
# P4-Q2-NO — genuine SU(2) Wilson Gaussian, coordinate and section Stone–Weierstrass

At every fixed beta > 0, the original SU(2) Wilson temporal sections
separate points.  Consequently the REAL SUBALGEBRA generated by those
sections is uniformly dense in C(SU(2), R).

Separately, the eight REAL COORDINATES of the already-verified actual SU(2)
matrix embedding J separate points and their polynomial subalgebra is
uniformly dense as well. This is the exact polynomial Stone–Weierstrass
target for the remaining signed tensor-moment argument.

CRITICAL DISTINCTION: density of the algebra generated by kernel sections
is NOT density of their fixed-beta REAL LINEAR SPAN. The latter requires
a genuinely strictly positive all-order Gaussian/Fock moment theorem;
neither finite Gram rank two nor algebra density is substituted for it.

The original interacting Wilson posteriors, Gauss-law physical source,
Perron half-density and spatial Wilson factors are unchanged.  No new
axiom, Dobrushin, sorry or admit is used.
-/

namespace MGAP4D
namespace MathlibAnalytic

open MeasureTheory
open scoped ENNReal Topology InnerProductSpace BigOperators
noncomputable section
set_option maxHeartbeats 3900000
set_option synthInstance.maxHeartbeats 1050000

local instance p4Q2NO_topologicalGroup :
    IsTopologicalGroup (Matrix.specialUnitaryGroup (Fin 2) ℂ) :=
  specialUnitaryGroupIsTopologicalGroup 2
local instance p4Q2NO_compactSpace :
    CompactSpace (Matrix.specialUnitaryGroup (Fin 2) ℂ) :=
  specialUnitaryGroupCompactSpace 2
local instance p4Q2NO_secondCountable :
    SecondCountableTopology (Matrix.specialUnitaryGroup (Fin 2) ℂ) :=
  specialUnitaryGroupSecondCountableTopology 2
local instance p4Q2NO_measurableSpace :
    MeasurableSpace (Matrix.specialUnitaryGroup (Fin 2) ℂ) :=
  specialUnitaryGroupMeasurableSpace 2
local instance p4Q2NO_borelSpace :
    BorelSpace (Matrix.specialUnitaryGroup (Fin 2) ℂ) :=
  specialUnitaryGroupBorelSpace 2

namespace GroundStatePosteriorJoint

local notation "Gauge" => Matrix.specialUnitaryGroup (Fin 2) ℂ
local notation "J" => specialUnitaryMatrixRealFeature 2
local notation "k" => p4Q2NJ_originalSU2WilsonTemporalSection

/-- The *algebra* generated by authentic fixed-beta Wilson temporal sections.
This is explicitly not their linear span. -/
noncomputable def p4Q2NO_originalSU2WilsonSectionAlgebra (b : ℝ) :
    Subalgebra ℝ C(Gauge, ℝ) :=
  Algebra.adjoin ℝ (Set.range (k b))

/-- The actual fixed-positive-coupling Wilson sections separate every two
distinct SU(2) holonomies by the strictly smaller Gaussian off-diagonal. -/
theorem p4Q2NO_originalSU2WilsonSectionAlgebra_separatesPoints
    (b : ℝ) (hb : 0 < b) :
    (p4Q2NO_originalSU2WilsonSectionAlgebra b).SeparatesPoints := by
  intro x y hxy
  refine ⟨(k b x : Gauge → ℝ), ⟨k b x, ?_, rfl⟩, ?_⟩
  · exact Algebra.subset_adjoin (Set.mem_range_self x)
  · change k b x x ≠ k b x y
    rw [p4Q2NN_originalSU2TemporalWilsonSection_self]
    exact ne_of_gt
      (p4Q2NM_originalSU2TemporalWilsonSection_strict_off_diagonal
        b hb x y hxy)

/-- Concrete, unconditional Stone–Weierstrass DENSITY OF THE ALGEBRA of
true Wilson temporal Gaussian sections, at each fixed positive coupling.
This does NOT establish density of the *linear span* of those sections. -/
theorem p4Q2NO_originalSU2WilsonSectionAlgebra_closure_eq_top
    (b : ℝ) (hb : 0 < b) :
    (p4Q2NO_originalSU2WilsonSectionAlgebra b).topologicalClosure = ⊤ :=
  ContinuousMap.subalgebra_topologicalClosure_eq_top_of_separatesPoints
    (p4Q2NO_originalSU2WilsonSectionAlgebra b)
    (p4Q2NO_originalSU2WilsonSectionAlgebra_separatesPoints b hb)

/-- A coordinate of the previously proved ACTUAL real-eight SU(2)
matrix feature, bundled as a real continuous function on the group. -/
noncomputable def p4Q2NO_originalSU2RealEightCoordinate
    (q : (Fin 2 × Fin 2) × Bool) : C(Gauge, ℝ) :=
  ⟨fun g => (J g) q,
    (PiLp.continuous_apply 2
      (fun _ : (Fin 2 × Fin 2) × Bool => ℝ) q).comp
      p4Q2NN_originalSU2RealEightFeature_continuous⟩

/-- The real polynomial coordinate algebra of the original eight-dimensional
SU(2) feature. A genuine algebra of continuous functions, not an assumed
family of character-polynomial moments. -/
noncomputable def p4Q2NO_originalSU2RealEightPolynomialAlgebra :
    Subalgebra ℝ C(Gauge, ℝ) :=
  Algebra.adjoin ℝ (Set.range p4Q2NO_originalSU2RealEightCoordinate)

/-- The existing genuine real-eight SU(2) feature has an inverse linear map,
so its real scalar coordinate functions jointly separate every pair. -/
theorem p4Q2NO_originalSU2RealEightPolynomialAlgebra_separatesPoints :
    p4Q2NO_originalSU2RealEightPolynomialAlgebra.SeparatesPoints := by
  intro x y hxy
  have hq :
      ∃ q : (Fin 2 × Fin 2) × Bool,
        p4Q2NO_originalSU2RealEightCoordinate q x ≠
          p4Q2NO_originalSU2RealEightCoordinate q y := by
    by_contra h
    push Not at h
    apply hxy
    apply p4Q2NM_originalSU2RealEightFeature_injective
    apply PiLp.ext
    intro q
    exact h q
  obtain ⟨q, hq⟩ := hq
  exact ⟨(p4Q2NO_originalSU2RealEightCoordinate q : Gauge → ℝ),
    ⟨p4Q2NO_originalSU2RealEightCoordinate q,
      Algebra.subset_adjoin (Set.mem_range_self q), rfl⟩, hq⟩

/-- Stone–Weierstrass: finite real-coordinate polynomials in the ACTUAL SU(2)
real-eight matrix feature are uniformly dense in all continuous observables.
The next Gaussian tensor-moment step must connect those polynomials to the
closure of the original fixed-beta kernel *linear span*. -/
theorem p4Q2NO_originalSU2RealEightPolynomialAlgebra_closure_eq_top :
    p4Q2NO_originalSU2RealEightPolynomialAlgebra.topologicalClosure = ⊤ :=
  ContinuousMap.subalgebra_topologicalClosure_eq_top_of_separatesPoints
    p4Q2NO_originalSU2RealEightPolynomialAlgebra
    p4Q2NO_originalSU2RealEightPolynomialAlgebra_separatesPoints

end GroundStatePosteriorJoint
end
end MathlibAnalytic
end MGAP4D

