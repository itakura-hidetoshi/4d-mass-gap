import MGAP4D.MathlibAnalytic.ContinuousCompactOrientedGaugeWilsonFiniteHeatBathVariationPropagation
import Mathlib.Tactic

/-!
# Exact schedule influence kernel for finite current heat-bath updates

The current bounded-continuous heat-bath action and its centered variation
profile are now closed under an arbitrary finite ordered list of physical-link
updates.  This file isolates the exact finite influence kernel carried by that
specific update schedule.

For a list `target :: targets`, the tail acts first on observables and on the
variation profile.  The final update at `target` kills the target variation and,
for every other source, adds the current influence coefficient from `target` to
`source` times the tail variation at `target`.  The schedule kernel mirrors this
recursion exactly.

We prove that the recursively updated variation is precisely the finite linear
action of this schedule kernel on the initial variation profile.  Consequently
the actual finite heat-bath centered profile from the current Feller layer has
the same exact representation.

This is finite-volume heat-bath/Dobrushin algebra only.  No comparison with the
full unrestricted influence-walk kernel is claimed in this file; that requires
a separate path-subset argument.  Update count is not Euclidean time, and no
covariance decay, continuum clustering, positive physical mass, OS Hamiltonian
gap, or uniform continuum Dobrushin threshold is asserted here.
-/

namespace MGAP4D
namespace MathlibAnalytic

open scoped BigOperators

noncomputable section

/-- Exact influence kernel generated by one prescribed finite ordered list of
single-link heat-bath updates.  `initial` indexes the input variation and
`source` the output variation. -/
noncomputable def finiteHeatBathScheduleInfluenceKernel
    {α : Type*}
    [DecidableEq α]
    (influence : α → α → ℝ) :
    List α → α → α → ℝ
  | [], initial, source => if initial = source then 1 else 0
  | target :: targets, initial, source =>
      if source = target then 0
      else
        finiteHeatBathScheduleInfluenceKernel influence targets initial source +
          influence target source *
            finiteHeatBathScheduleInfluenceKernel influence targets initial target

@[simp] theorem finiteHeatBathScheduleInfluenceKernel_nil
    {α : Type*}
    [DecidableEq α]
    (influence : α → α → ℝ)
    (initial source : α) :
    finiteHeatBathScheduleInfluenceKernel influence [] initial source =
      if initial = source then 1 else 0 := by
  rfl

@[simp] theorem finiteHeatBathScheduleInfluenceKernel_cons
    {α : Type*}
    [DecidableEq α]
    (influence : α → α → ℝ)
    (target : α)
    (targets : List α)
    (initial source : α) :
    finiteHeatBathScheduleInfluenceKernel influence (target :: targets)
        initial source =
      if source = target then 0
      else
        finiteHeatBathScheduleInfluenceKernel influence targets initial source +
          influence target source *
            finiteHeatBathScheduleInfluenceKernel influence targets initial target := by
  rfl

/-- Nonnegative influence entries give a nonnegative exact schedule kernel. -/
theorem finiteHeatBathScheduleInfluenceKernel_nonneg
    {α : Type*}
    [DecidableEq α]
    (influence : α → α → ℝ)
    (hInfluence : ∀ target source : α, 0 ≤ influence target source) :
    ∀ (targets : List α) (initial source : α),
      0 ≤ finiteHeatBathScheduleInfluenceKernel influence targets initial source := by
  intro targets
  induction targets with
  | nil =>
      intro initial source
      simp [finiteHeatBathScheduleInfluenceKernel]
  | cons target targets ih =>
      intro initial source
      rw [finiteHeatBathScheduleInfluenceKernel_cons]
      by_cases h : source = target
      · simp [h]
      · simp only [h, if_false]
        exact
          add_nonneg
            (ih initial source)
            (mul_nonneg (hInfluence target source) (ih initial target))

/-- The recursively propagated current variation is exactly the finite linear
action of the prescribed schedule influence kernel on the initial variation. -/
theorem continuous_compact_oriented_finiteUpdatedVariation_eq_sum_scheduleInfluenceKernel
    (C : ContinuousCompactOrientedGaugeWilsonSystem)
    (D : ContinuousCompactOrientedGaugeWilsonDobrushinMatrixData C)
    (variation : C.base.geometry.Edge → ℝ)
    (targets : List C.base.geometry.Edge)
    (source : C.base.geometry.Edge) :
    continuousCompactOrientedGaugeWilsonFiniteUpdatedVariation
        D variation targets source =
      ∑ initial : C.base.geometry.Edge,
        finiteHeatBathScheduleInfluenceKernel
            D.influence targets initial source * variation initial := by
  classical
  induction targets generalizing source with
  | nil =>
      simp [continuousCompactOrientedGaugeWilsonFiniteUpdatedVariation,
        finiteHeatBathScheduleInfluenceKernel]
  | cons target targets ih =>
      rw [continuous_compact_oriented_finiteUpdatedVariation_cons]
      unfold continuousCompactOrientedGaugeWilsonDobrushinUpdatedVariation
      by_cases h : source = target
      · subst source
        simp [finiteHeatBathScheduleInfluenceKernel]
      · simp only [h, if_false]
        rw [ih source, ih target]
        simp only [finiteHeatBathScheduleInfluenceKernel_cons, h, if_false]
        rw [Finset.mul_sum]
        rw [← Finset.sum_add_distrib]
        apply Finset.sum_congr rfl
        intro initial _
        ring

/-- Therefore the actual finite heat-bath centered variation profile produced by
the current Feller closure has the same exact schedule-kernel representation,
with no recentering loss. -/
theorem continuous_compact_oriented_finiteHeatBathCenteredVariationProfile_variation_eq_sum_scheduleInfluenceKernel
    (C : ContinuousCompactOrientedGaugeWilsonSystem)
    (O : BoundedContinuousFunction C.base.Configuration ℝ)
    (P : ContinuousCompactOrientedGaugeWilsonCenteredVariationProfile C O)
    (D : ContinuousCompactOrientedGaugeWilsonDobrushinMatrixData C)
    (targets : List C.base.geometry.Edge)
    (source : C.base.geometry.Edge) :
    (P.finiteHeatBathCenteredVariationProfile D targets).variation source =
      ∑ initial : C.base.geometry.Edge,
        finiteHeatBathScheduleInfluenceKernel
            D.influence targets initial source * P.variation initial := by
  rw [continuous_compact_oriented_finiteHeatBathCenteredVariationProfile_variation]
  exact
    continuous_compact_oriented_finiteUpdatedVariation_eq_sum_scheduleInfluenceKernel
      C D P.variation targets source

end

end MathlibAnalytic
end MGAP4D
