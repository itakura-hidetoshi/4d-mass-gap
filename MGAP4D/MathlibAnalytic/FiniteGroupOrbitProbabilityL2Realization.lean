open scoped BigOperators InnerProduct

noncomputable section

/-- Orbit equivalence relation generated by a group action. -/
def finiteGroupOrbitSetoid
    (G α : Type)
    [Group G]
    [MulAction G α] : Setoid α where
  r x y := ∃ g : G, g • x = y
  iseqv := by
    constructor
    · intro x
      exact ⟨1, one_smul G x⟩
    · intro x y hxy
      rcases hxy with ⟨g, hg⟩
      refine ⟨g⁻¹, ?_⟩
      rw [← hg]
      simp
    · intro x y z hxy hyz
      rcases hxy with ⟨g, hg⟩
      rcases hyz with ⟨h, hh⟩
      refine ⟨h * g, ?_⟩
      rw [mul_smul, hg, hh]

/-- Quotient of a finite configuration type by the actual group action. -/
abbrev FiniteGroupOrbitQuotient
    (G α : Type)
    [Group G]
    [MulAction G α] : Type :=
  Quotient (finiteGroupOrbitSetoid G α)

noncomputable instance finiteGroupOrbitQuotientFintype
    (G α : Type)
    [Group G]
    [Fintype α]
    [MulAction G α] :
    Fintype (FiniteGroupOrbitQuotient G α) :=
  Fintype.ofFinite _

noncomputable instance finiteGroupOrbitQuotientDecidableEq
    (G α : Type)
    [Group G]
    [MulAction G α] :
    DecidableEq (FiniteGroupOrbitQuotient G α) :=
  Classical.decEq _

/-- Canonical orbit class of one configuration. -/
def finiteGroupOrbitClass
    (G α : Type)
    [Group G]
    [MulAction G α]
    (x : α) : FiniteGroupOrbitQuotient G α :=
  Quotient.mk _ x

/-- A chosen representative of one orbit class. -/
noncomputable def finiteGroupOrbitRepresentative
    (G α : Type)
    [Group G]
    [MulAction G α]
    (q : FiniteGroupOrbitQuotient G α) : α :=
  Quotient.out q

@[simp] theorem finiteGroupOrbitClass_representative
    (G α : Type)
    [Group G]
    [MulAction G α]
    (q : FiniteGroupOrbitQuotient G α) :
    finiteGroupOrbitClass G α
        (finiteGroupOrbitRepresentative G α q) = q :=
  Quotient.out_eq q

/-- Two configurations have the same quotient class exactly when one is sent
into the other by an element of the acting group. -/
theorem finiteGroupOrbitClass_eq_iff
    (G α : Type)
    [Group G]
    [MulAction G α]
    (x y : α) :
    finiteGroupOrbitClass G α x = finiteGroupOrbitClass G α y ↔
      ∃ g : G, g • x = y := by
  constructor
  · exact Quotient.exact
  · intro hxy
    change Quotient.mk (finiteGroupOrbitSetoid G α) x =
      Quotient.mk (finiteGroupOrbitSetoid G α) y
    exact Quotient.sound hxy

/-- The real counting mass of one orbit fiber.  This definition is phrased as
a finite pushforward sum, so no choice of a representative enters the mass. -/
noncomputable def finiteGroupOrbitMass
    (G α : Type)
    [Group G]
    [Fintype α]
    [MulAction G α]
    (q : FiniteGroupOrbitQuotient G α) : ℝ :=
  ∑ x : α, if q = finiteGroupOrbitClass G α x then 1 else 0

/-- Every orbit fiber has strictly positive counting mass. -/
theorem finiteGroupOrbitMass_pos
    (G α : Type)
    [Group G]
    [Fintype α]
    [Nonempty α]
    [MulAction G α]
    (q : FiniteGroupOrbitQuotient G α) :
    0 < finiteGroupOrbitMass G α q := by
  classical
  unfold finiteGroupOrbitMass
  apply (Finset.sum_pos_iff_of_nonneg ?_).2
  · refine ⟨finiteGroupOrbitRepresentative G α q, Finset.mem_univ _, ?_⟩
    simp
  · intro x _hx
    by_cases hq : q = finiteGroupOrbitClass G α x
    · simp [hq]
    · simp [hq]

/-- Orbit masses partition the whole finite configuration type. -/
theorem finiteGroupOrbitMass_sum
    (G α : Type)
    [Group G]
    [Fintype α]
    [MulAction G α] :
    ∑ q : FiniteGroupOrbitQuotient G α,
        finiteGroupOrbitMass G α q =
      (Fintype.card α : ℝ) := by
  classical
  calc
    ∑ q : FiniteGroupOrbitQuotient G α,
        finiteGroupOrbitMass G α q =
      ∑ q : FiniteGroupOrbitQuotient G α,
        ∑ x : α,
          if q = finiteGroupOrbitClass G α x then 1 else 0 := by
      simp only [finiteGroupOrbitMass]
    _ = ∑ x : α,
        ∑ q : FiniteGroupOrbitQuotient G α,
          if q = finiteGroupOrbitClass G α x then 1 else 0 := by
      rw [Finset.sum_comm]
    _ = ∑ _x : α, (1 : ℝ) := by
      apply Finset.sum_congr rfl
      intro x _hx
      simp
    _ = (Fintype.card α : ℝ) := by simp

/-- Strict orbit probability obtained by pushing the uniform counting law on
configurations through the quotient map. -/
noncomputable def finiteGroupOrbitProbabilityL2Data
    (G α : Type)
    [Group G]
    [Fintype α]
    [Nonempty α]
    [MulAction G α] :
    FiniteStrictProbabilityL2Data
      (FiniteGroupOrbitQuotient G α) where
  weight := fun q =>
    finiteGroupOrbitMass G α q * (Fintype.card α : ℝ)⁻¹
  weight_pos := by
    intro q
    exact mul_pos
      (finiteGroupOrbitMass_pos G α q)
      (inv_pos.mpr (by exact_mod_cast Fintype.card_pos))
  weight_sum := by
    classical
    have hcard : (Fintype.card α : ℝ) ≠ 0 := by
      exact_mod_cast Fintype.card_ne_zero
    change
      (∑ q : FiniteGroupOrbitQuotient G α,
        finiteGroupOrbitMass G α q *
          (Fintype.card α : ℝ)⁻¹) = 1
    rw [← Finset.sum_mul, finiteGroupOrbitMass_sum]
    exact mul_inv_cancel₀ hcard

/-- The quotient probability weight is literally the pushforward of the
uniform finite configuration probability. -/
theorem finiteGroupOrbitProbabilityL2Data_weight_eq_pushforward
    (G α : Type)
    [Group G]
    [Fintype α]
    [Nonempty α]
    [MulAction G α]
    (q : FiniteGroupOrbitQuotient G α) :
    (finiteGroupOrbitProbabilityL2Data G α).weight q =
      ∑ x : α,
        if q = finiteGroupOrbitClass G α x then
          (Fintype.card α : ℝ)⁻¹
        else 0 := by
  classical
  change
    finiteGroupOrbitMass G α q * (Fintype.card α : ℝ)⁻¹ =
      ∑ x : α,
        if q = finiteGroupOrbitClass G α x then
          (Fintype.card α : ℝ)⁻¹
        else 0
  unfold finiteGroupOrbitMass
  rw [Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro x _hx
  by_cases hq : q = finiteGroupOrbitClass G α x
  · simp [hq]
  · simp [hq]

/-- An invariant function takes the representative value on every member of
that representative's orbit. -/
theorem finiteGroupInvariant_value_eq_representative
    (G α : Type)
    [Group G]
    [Fintype α]
    [MulAction G α]
    (f : finiteGroupInvariantSubmodule G α)
    (q : FiniteGroupOrbitQuotient G α)
    (x : α)
    (hqx : q = finiteGroupOrbitClass G α x) :
    f.1 (finiteGroupOrbitRepresentative G α q) = f.1 x := by
  have hclass :
      finiteGroupOrbitClass G α
          (finiteGroupOrbitRepresentative G α q) =
        finiteGroupOrbitClass G α x := by
    exact (finiteGroupOrbitClass_representative G α q).trans hqx
  rcases (finiteGroupOrbitClass_eq_iff G α _ _).mp hclass with ⟨g, hg⟩
  calc
    f.1 (finiteGroupOrbitRepresentative G α q) =
        f.1 (g • finiteGroupOrbitRepresentative G α q) :=
      (f.2 g _).symm
    _ = f.1 x := by rw [hg]

/-- Square-root-orbit-mass coordinates of an invariant finite configuration
wavefunction. -/
noncomputable def finiteGroupInvariantToOrbitCoordinatesLinearMap
    (G α : Type)
    [Group G]
    [Fintype α]
    [Nonempty α]
    [MulAction G α] :
    finiteGroupInvariantSubmodule G α →ₗ[ℝ]
      FiniteProbabilityL2Carrier (FiniteGroupOrbitQuotient G α) where
  toFun f := WithLp.toLp 2 fun q : FiniteGroupOrbitQuotient G α =>
    Real.sqrt (finiteGroupOrbitMass G α q) *
      f.1 (finiteGroupOrbitRepresentative G α q)
  map_add' f h := by
    ext q
    change
      Real.sqrt (finiteGroupOrbitMass G α q) *
          (f.1 (finiteGroupOrbitRepresentative G α q) +
            h.1 (finiteGroupOrbitRepresentative G α q)) =
        Real.sqrt (finiteGroupOrbitMass G α q) *
            f.1 (finiteGroupOrbitRepresentative G α q) +
          Real.sqrt (finiteGroupOrbitMass G α q) *
            h.1 (finiteGroupOrbitRepresentative G α q)
    ring
  map_smul' c f := by
    ext q
    change
      Real.sqrt (finiteGroupOrbitMass G α q) *
          (c * f.1 (finiteGroupOrbitRepresentative G α q)) =
        c *
          (Real.sqrt (finiteGroupOrbitMass G α q) *
            f.1 (finiteGroupOrbitRepresentative G α q))
    ring

@[simp] theorem finiteGroupInvariantToOrbitCoordinatesLinearMap_apply
    (G α : Type)
    [Group G]
    [Fintype α]
    [Nonempty α]
    [MulAction G α]
    (f : finiteGroupInvariantSubmodule G α)
    (q : FiniteGroupOrbitQuotient G α) :
    finiteGroupInvariantToOrbitCoordinatesLinearMap G α f q =
      Real.sqrt (finiteGroupOrbitMass G α q) *
        f.1 (finiteGroupOrbitRepresentative G α q) :=
  rfl

/-- Recover an invariant configuration wavefunction from orbit coordinates. -/
noncomputable def finiteGroupOrbitCoordinatesToInvariantLinearMap
    (G α : Type)
    [Group G]
    [Fintype α]
    [Nonempty α]
    [MulAction G α] :
    FiniteProbabilityL2Carrier (FiniteGroupOrbitQuotient G α) →ₗ[ℝ]
      finiteGroupInvariantSubmodule G α where
  toFun y :=
    ⟨WithLp.toLp 2 fun x : α =>
        y (finiteGroupOrbitClass G α x) /
          Real.sqrt
            (finiteGroupOrbitMass G α
              (finiteGroupOrbitClass G α x)),
      by
        intro g x
        have hclass :
            finiteGroupOrbitClass G α (g • x) =
              finiteGroupOrbitClass G α x := by
          exact ((finiteGroupOrbitClass_eq_iff G α x (g • x)).2
            ⟨g, rfl⟩).symm
        change
          y (finiteGroupOrbitClass G α (g • x)) /
              Real.sqrt
                (finiteGroupOrbitMass G α
                  (finiteGroupOrbitClass G α (g • x))) =
            y (finiteGroupOrbitClass G α x) /
              Real.sqrt
                (finiteGroupOrbitMass G α
                  (finiteGroupOrbitClass G α x))
        rw [hclass]⟩
  map_add' y z := by
    apply Subtype.ext
    ext x
    change
      (y (finiteGroupOrbitClass G α x) +
          z (finiteGroupOrbitClass G α x)) /
          Real.sqrt
            (finiteGroupOrbitMass G α
              (finiteGroupOrbitClass G α x)) =
        y (finiteGroupOrbitClass G α x) /
            Real.sqrt
              (finiteGroupOrbitMass G α
                (finiteGroupOrbitClass G α x)) +
          z (finiteGroupOrbitClass G α x) /
            Real.sqrt
              (finiteGroupOrbitMass G α
                (finiteGroupOrbitClass G α x))
    ring
  map_smul' c y := by
    apply Subtype.ext
    ext x
    change
      (c * y (finiteGroupOrbitClass G α x)) /
          Real.sqrt
            (finiteGroupOrbitMass G α
              (finiteGroupOrbitClass G α x)) =
        c *
          (y (finiteGroupOrbitClass G α x) /
            Real.sqrt
              (finiteGroupOrbitMass G α
                (finiteGroupOrbitClass G α x)))
    ring

@[simp] theorem finiteGroupOrbitCoordinatesToInvariantLinearMap_apply
    (G α : Type)
    [Group G]
    [Fintype α]
    [Nonempty α]
    [MulAction G α]
    (y : FiniteProbabilityL2Carrier (FiniteGroupOrbitQuotient G α))
    (x : α) :
    (finiteGroupOrbitCoordinatesToInvariantLinearMap G α y).1 x =
      y (finiteGroupOrbitClass G α x) /
        Real.sqrt
          (finiteGroupOrbitMass G α
            (finiteGroupOrbitClass G α x)) :=
  rfl

/-- Orbit reconstruction followed by orbit coordinates is exactly the
identity. -/
theorem finiteGroupInvariantToOrbitCoordinates_leftInverse
    (G α : Type)
    [Group G]
    [Fintype α]
    [Nonempty α]
    [MulAction G α]
    (y : FiniteProbabilityL2Carrier (FiniteGroupOrbitQuotient G α)) :
    finiteGroupInvariantToOrbitCoordinatesLinearMap G α
        (finiteGroupOrbitCoordinatesToInvariantLinearMap G α y) = y := by
  ext q
  change
    Real.sqrt (finiteGroupOrbitMass G α q) *
        (y (finiteGroupOrbitClass G α
            (finiteGroupOrbitRepresentative G α q)) /
          Real.sqrt
            (finiteGroupOrbitMass G α
              (finiteGroupOrbitClass G α
                (finiteGroupOrbitRepresentative G α q)))) =
      y q
  rw [finiteGroupOrbitClass_representative]
  field_simp [ne_of_gt
    (Real.sqrt_pos.2 (finiteGroupOrbitMass_pos G α q))]

/-- Orbit coordinates followed by reconstruction is exactly the original
invariant wavefunction. -/
theorem finiteGroupInvariantToOrbitCoordinates_rightInverse
    (G α : Type)
    [Group G]
    [Fintype α]
    [Nonempty α]
    [MulAction G α]
    (f : finiteGroupInvariantSubmodule G α) :
    finiteGroupOrbitCoordinatesToInvariantLinearMap G α
        (finiteGroupInvariantToOrbitCoordinatesLinearMap G α f) = f := by
  apply Subtype.ext
  ext x
  change
    (Real.sqrt
          (finiteGroupOrbitMass G α
            (finiteGroupOrbitClass G α x)) *
        f.1 (finiteGroupOrbitRepresentative G α
          (finiteGroupOrbitClass G α x))) /
      Real.sqrt
        (finiteGroupOrbitMass G α
          (finiteGroupOrbitClass G α x)) =
      f.1 x
  rw [finiteGroupInvariant_value_eq_representative
    G α f (finiteGroupOrbitClass G α x) x rfl]
  field_simp [ne_of_gt
    (Real.sqrt_pos.2
      (finiteGroupOrbitMass_pos G α
        (finiteGroupOrbitClass G α x)))]

/-- The orbit coordinate map preserves the real Hilbert inner product. -/
theorem finiteGroupInvariantToOrbitCoordinates_inner
    (G α : Type)
    [Group G]
    [Fintype α]
    [Nonempty α]
    [MulAction G α]
    (f h : finiteGroupInvariantSubmodule G α) :
    inner ℝ
        (finiteGroupInvariantToOrbitCoordinatesLinearMap G α f)
        (finiteGroupInvariantToOrbitCoordinatesLinearMap G α h) =
      inner ℝ f h := by
  classical
  change
    (∑ q : FiniteGroupOrbitQuotient G α,
      (Real.sqrt (finiteGroupOrbitMass G α q) *
          h.1 (finiteGroupOrbitRepresentative G α q)) *
        (Real.sqrt (finiteGroupOrbitMass G α q) *
          f.1 (finiteGroupOrbitRepresentative G α q))) =
      ∑ x : α, h.1 x * f.1 x
  calc
    (∑ q : FiniteGroupOrbitQuotient G α,
      (Real.sqrt (finiteGroupOrbitMass G α q) *
          h.1 (finiteGroupOrbitRepresentative G α q)) *
        (Real.sqrt (finiteGroupOrbitMass G α q) *
          f.1 (finiteGroupOrbitRepresentative G α q))) =
      ∑ q : FiniteGroupOrbitQuotient G α,
        finiteGroupOrbitMass G α q *
          (h.1 (finiteGroupOrbitRepresentative G α q) *
            f.1 (finiteGroupOrbitRepresentative G α q)) := by
      apply Finset.sum_congr rfl
      intro q _hq
      calc
        (Real.sqrt (finiteGroupOrbitMass G α q) *
            h.1 (finiteGroupOrbitRepresentative G α q)) *
          (Real.sqrt (finiteGroupOrbitMass G α q) *
            f.1 (finiteGroupOrbitRepresentative G α q)) =
          (Real.sqrt (finiteGroupOrbitMass G α q)) ^ 2 *
            (h.1 (finiteGroupOrbitRepresentative G α q) *
              f.1 (finiteGroupOrbitRepresentative G α q)) := by ring
        _ = finiteGroupOrbitMass G α q *
            (h.1 (finiteGroupOrbitRepresentative G α q) *
              f.1 (finiteGroupOrbitRepresentative G α q)) := by
          rw [Real.sq_sqrt
            (le_of_lt (finiteGroupOrbitMass_pos G α q))]
    _ = ∑ q : FiniteGroupOrbitQuotient G α,
        ∑ x : α,
          if q = finiteGroupOrbitClass G α x then
            h.1 x * f.1 x
          else 0 := by
      apply Finset.sum_congr rfl
      intro q _hq
      unfold finiteGroupOrbitMass
      rw [Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro x _hx
      by_cases hqx : q = finiteGroupOrbitClass G α x
      · have hf := finiteGroupInvariant_value_eq_representative
          G α f q x hqx
        have hh := finiteGroupInvariant_value_eq_representative
          G α h q x hqx
        simp [hqx, hf, hh]
      · simp [hqx]
    _ = ∑ x : α,
        ∑ q : FiniteGroupOrbitQuotient G α,
          if q = finiteGroupOrbitClass G α x then
            h.1 x * f.1 x
          else 0 := by
      rw [Finset.sum_comm]
    _ = ∑ x : α, h.1 x * f.1 x := by
      apply Finset.sum_congr rfl
      intro x _hx
      simp

/-- Linear isometry from invariant configuration wavefunctions to the orbit
probability `L²` carrier. -/
noncomputable def finiteGroupInvariantToOrbitCoordinatesLinearIsometry
    (G α : Type)
    [Group G]
    [Fintype α]
    [Nonempty α]
    [MulAction G α] :
    finiteGroupInvariantSubmodule G α →ₗᵢ[ℝ]
      FiniteProbabilityL2Carrier (FiniteGroupOrbitQuotient G α) where
  toLinearMap := finiteGroupInvariantToOrbitCoordinatesLinearMap G α
  norm_map' := by
    intro f
    have hsquare :
        ‖finiteGroupInvariantToOrbitCoordinatesLinearMap G α f‖ ^ 2 =
          ‖f‖ ^ 2 := by
      simpa [real_inner_self_eq_norm_sq] using
        finiteGroupInvariantToOrbitCoordinates_inner G α f f
    exact (sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)).mp hsquare

/-- Inverse linear isometry from orbit coordinates back to the invariant
configuration Hilbert space. -/
noncomputable def finiteGroupOrbitCoordinatesToInvariantLinearIsometry
    (G α : Type)
    [Group G]
    [Fintype α]
    [Nonempty α]
    [MulAction G α] :
    FiniteProbabilityL2Carrier (FiniteGroupOrbitQuotient G α) →ₗᵢ[ℝ]
      finiteGroupInvariantSubmodule G α where
  toLinearMap := finiteGroupOrbitCoordinatesToInvariantLinearMap G α
  norm_map' := by
    intro y
    calc
      ‖finiteGroupOrbitCoordinatesToInvariantLinearMap G α y‖ =
          ‖finiteGroupInvariantToOrbitCoordinatesLinearMap G α
            (finiteGroupOrbitCoordinatesToInvariantLinearMap G α y)‖ := by
        symm
        exact
          (finiteGroupInvariantToOrbitCoordinatesLinearIsometry G α).norm_map _
      _ = ‖y‖ := by
        rw [finiteGroupInvariantToOrbitCoordinates_leftInverse]

/-- Canonical real-Hilbert isometric identification of invariant finite
configuration wavefunctions with the actual orbit quotient probability
`L²` carrier. -/
noncomputable def finiteGroupInvariantOrbitProbabilityL2Identification
    (G α : Type)
    [Group G]
    [Fintype α]
    [Nonempty α]
    [MulAction G α] :
    RealHilbertLinearIsometricIdentification
      (finiteGroupInvariantSubmodule G α)
      (FiniteProbabilityL2Carrier (FiniteGroupOrbitQuotient G α)) where
  forward := finiteGroupInvariantToOrbitCoordinatesLinearIsometry G α
  inverse := finiteGroupOrbitCoordinatesToInvariantLinearIsometry G α
  forward_inverse := finiteGroupInvariantToOrbitCoordinates_leftInverse G α
  inverse_forward := finiteGroupInvariantToOrbitCoordinates_rightInverse G α

/-- Audit-visible finite group orbit probability realization. -/
structure FiniteGroupOrbitProbabilityL2RealizationPackage
    (G α : Type)
    [Group G]
    [Fintype α]
    [Nonempty α]
    [MulAction G α] where
  probability :
    FiniteStrictProbabilityL2Data (FiniteGroupOrbitQuotient G α)
  probability_eq_pushforward :
    probability = finiteGroupOrbitProbabilityL2Data G α
  identification :
    RealHilbertLinearIsometricIdentification
      (finiteGroupInvariantSubmodule G α)
      (FiniteProbabilityL2Carrier (FiniteGroupOrbitQuotient G α))
  identification_eq_canonical :
    identification = finiteGroupInvariantOrbitProbabilityL2Identification G α
  exactForward :
    ∀ f : finiteGroupInvariantSubmodule G α,
      ∀ q : FiniteGroupOrbitQuotient G α,
        identification.forward f q =
          Real.sqrt (finiteGroupOrbitMass G α q) *
            f.1 (finiteGroupOrbitRepresentative G α q)
  exactInverse :
    ∀ y : FiniteProbabilityL2Carrier (FiniteGroupOrbitQuotient G α),
      ∀ x : α,
        (identification.inverse y).1 x =
          y (finiteGroupOrbitClass G α x) /
            Real.sqrt
              (finiteGroupOrbitMass G α
                (finiteGroupOrbitClass G α x))

/-- Construct the complete generic orbit probability realization package. -/
noncomputable def finiteGroupOrbitProbabilityL2RealizationPackage
    (G α : Type)
    [Group G]
    [Fintype α]
    [Nonempty α]
    [MulAction G α] :
    FiniteGroupOrbitProbabilityL2RealizationPackage G α where
  probability := finiteGroupOrbitProbabilityL2Data G α
  probability_eq_pushforward := rfl
  identification := finiteGroupInvariantOrbitProbabilityL2Identification G α
  identification_eq_canonical := rfl
  exactForward := by
    intro f q
    rfl
  exactInverse := by
    intro y x
    rfl

end

