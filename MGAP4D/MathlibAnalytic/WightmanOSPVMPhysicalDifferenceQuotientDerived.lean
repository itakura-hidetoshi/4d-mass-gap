import MGAP4D.MathlibAnalytic.WightmanOSPVMPositiveSemigroupOperatorIdentification
import Mathlib.Tactic

namespace MGAP4D
namespace MathlibAnalytic

open Set Filter Topology MeasureTheory
open scoped BigOperators InnerProductSpace

noncomputable section

/-- The algebraic multiplier obtained by subtracting the positive PVM exponential
from the positive-energy identity and dividing by positive time is exactly the
bounded positive semigroup difference-quotient multiplier used by the strong
limit theorem. -/
theorem pvmPositiveSemigroupDifferenceQuotientMultiplier_eq_smul_sub_exp_mul
    {t : ℝ} (ht : 0 < t)
    (f h : PVMBoundedBorelRealFunction)
    (hCoordinate : ∀ energy : ℝ,
      h.toFun energy = energy * f.toFun energy) :
    pvmPositiveSemigroupDifferenceQuotientMultiplier t f h hCoordinate =
      pvmBoundedBorelSMul t⁻¹
        (pvmBoundedBorelSub
          (pvmPositiveEnergyRestrict f)
          (pvmBoundedBorelMul
            (pvmPositiveEuclideanSemigroupMultiplier t ht.le)
            (pvmPositiveEnergyRestrict f))) := by
  apply PVMBoundedBorelRealFunction.ext
  funext energy
  by_cases henergy : 0 ≤ energy
  · rw [pvmPositiveSemigroupDifferenceQuotientMultiplier_apply_of_pos
      ht f h hCoordinate henergy]
    simp [pvmBoundedBorelSMul, pvmBoundedBorelSub, pvmBoundedBorelMul,
      pvmPositiveEnergyRestrict, pvmBoundedBorelRestrict,
      pvmPositiveEuclideanSemigroupMultiplier, henergy,
      pvmSemigroupDifferenceQuotientScalar]
  · have henergyNeg : energy < 0 := lt_of_not_ge henergy
    rw [pvmPositiveSemigroupDifferenceQuotientMultiplier_apply_of_neg
      ht f h hCoordinate henergyNeg]
    simp [pvmBoundedBorelSMul, pvmBoundedBorelSub, pvmBoundedBorelMul,
      pvmPositiveEnergyRestrict, pvmBoundedBorelRestrict,
      pvmPositiveEuclideanSemigroupMultiplier, henergy]

/-- At the operator level, the positive-time difference quotient is obtained by
subtracting the PVM exponential action from the positive-energy identity action
and dividing by time. -/
theorem pvmPositiveSemigroupDifferenceQuotientOperator_eq
    {H : Type}
    [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (P : OrthogonalProjectionValuedSetFunction H)
    {t : ℝ} (ht : 0 < t)
    (f h : PVMBoundedBorelRealFunction)
    (hCoordinate : ∀ energy : ℝ,
      h.toFun energy = energy * f.toFun energy) :
    t⁻¹ •
        (pvmBoundedBorelSpectralIntegralOperator P
            (pvmPositiveEnergyRestrict f) -
          (pvmBoundedBorelSpectralIntegralOperator P
              (pvmPositiveEuclideanSemigroupMultiplier t ht.le)).comp
            (pvmBoundedBorelSpectralIntegralOperator P
              (pvmPositiveEnergyRestrict f))) =
      pvmBoundedBorelSpectralIntegralOperator P
        (pvmPositiveSemigroupDifferenceQuotientMultiplier
          t f h hCoordinate) := by
  rw [pvmPositiveSemigroupDifferenceQuotientMultiplier_eq_smul_sub_exp_mul
    ht f h hCoordinate]
  rw [pvmBoundedBorelSpectralIntegralOperator_smul]
  rw [pvmBoundedBorelSpectralIntegralOperator_sub]
  rw [pvmBoundedBorelSpectralIntegralOperator_mul]

/-- The physical right Hamiltonian difference quotient is generated by the
actual PVM semigroup multiplier.  This discharges the last physical field left
open by PR #814 from the scalar Laplace formula, positive support, semigroup
symmetry, and completed PVM multiplicativity. -/
theorem EuclideanYangMillsOSPhysicalTimeTranslation.rightDifferenceQuotient_eq_ambientSpectralIntegral_of_laplace
    {S : EuclideanYangMillsContinuumMeasureConstructionSpine}
    {M : EuclideanYangMillsOSPhysicalHilbertReconstructedModel S}
    (T : EuclideanYangMillsOSPhysicalTimeTranslation M)
    (A : ExplicitWightmanOSQuadraticPVMCountableAdditivity M.toExplicitModel)
    (P : ExplicitWightmanOSPositiveSpectralSupport M.toExplicitModel)
    (L : ExplicitWightmanOSSpectralSemigroupLaplaceFormula
      M.toExplicitModel A.toScalarSpectralRealization T.toEuclideanTimeSemigroup)
    (hSymmetric : T.IsRightInnerSymmetric)
    (t : ℝ) (ht : 0 < t)
    (f h : PVMBoundedBorelRealFunction)
    (hCoordinate : ∀ energy : ℝ,
      h.toFun energy = energy * f.toFun energy)
    (ψ : M.toExplicitModel.VacuumOrthogonalHilbert) :
    T.rightHamiltonianDifferenceQuotient
        (((M.toExplicitModel.canonicalVacuumOrthogonalBoundedBorelSpectralIntegral
            f ψ : M.toExplicitModel.VacuumOrthogonalHilbert) :
          M.toExplicitModel.H)) t =
      pvmBoundedBorelSpectralIntegralOperator
        M.toExplicitModel.spectralPVM
        (pvmPositiveSemigroupDifferenceQuotientMultiplier
          t f h hCoordinate)
        (ψ : M.toExplicitModel.H) := by
  let fPos := pvmPositiveEnergyRestrict f
  let e := pvmPositiveEuclideanSemigroupMultiplier t ht.le
  have hx :
      (((M.toExplicitModel.canonicalVacuumOrthogonalBoundedBorelSpectralIntegral
          f ψ : M.toExplicitModel.VacuumOrthogonalHilbert) :
        M.toExplicitModel.H)) =
        pvmBoundedBorelSpectralIntegralOperator
          M.toExplicitModel.spectralPVM fPos
          (ψ : M.toExplicitModel.H) := by
    calc
      (((M.toExplicitModel.canonicalVacuumOrthogonalBoundedBorelSpectralIntegral
          f ψ : M.toExplicitModel.VacuumOrthogonalHilbert) :
        M.toExplicitModel.H)) =
          pvmBoundedBorelSpectralIntegralOperator
            M.toExplicitModel.spectralPVM f
            (ψ : M.toExplicitModel.H) :=
        M.toExplicitModel.canonicalVacuumOrthogonalBoundedBorelSpectralIntegral_coe
          f ψ
      _ = pvmBoundedBorelSpectralIntegralOperator
            M.toExplicitModel.spectralPVM fPos
            (ψ : M.toExplicitModel.H) :=
        (P.ambientIntegral_positiveEnergyRestrict_apply
          f (ψ : M.toExplicitModel.H)).symm
  have hSemigroup :
      T.operator t =
        pvmBoundedBorelSpectralIntegralOperator
          M.toExplicitModel.spectralPVM e := by
    simpa [e] using
      T.operator_eq_pvmPositiveMultiplier A P L hSymmetric t ht.le
  have hOperator :=
    pvmPositiveSemigroupDifferenceQuotientOperator_eq
      M.toExplicitModel.spectralPVM ht f h hCoordinate
  unfold EuclideanYangMillsOSPhysicalTimeTranslation.rightHamiltonianDifferenceQuotient
  rw [hx, hSemigroup]
  have hApply := congrArg
    (fun op : M.toExplicitModel.H →L[ℝ] M.toExplicitModel.H =>
      op (ψ : M.toExplicitModel.H)) hOperator
  simpa [fPos, e, ContinuousLinearMap.comp_apply] using hApply

/-- The scalar Laplace formula and right-time symmetry construct the complete
positive-semigroup spectral-action package; no independent quotient action
field remains. -/
noncomputable def EuclideanYangMillsOSPhysicalTimeTranslation.toPositiveSemigroupSpectralActionOfLaplace
    {S : EuclideanYangMillsContinuumMeasureConstructionSpine}
    {M : EuclideanYangMillsOSPhysicalHilbertReconstructedModel S}
    (T : EuclideanYangMillsOSPhysicalTimeTranslation M)
    (A : ExplicitWightmanOSQuadraticPVMCountableAdditivity M.toExplicitModel)
    (P : ExplicitWightmanOSPositiveSpectralSupport M.toExplicitModel)
    (L : ExplicitWightmanOSSpectralSemigroupLaplaceFormula
      M.toExplicitModel A.toScalarSpectralRealization T.toEuclideanTimeSemigroup)
    (hSymmetric : T.IsRightInnerSymmetric) :
    EuclideanYangMillsOSPhysicalPositiveSemigroupSpectralAction T where
  quadraticPVMCountableAdditivity := A
  positiveSpectralSupport := P
  rightDifferenceQuotient_eq_ambientSpectralIntegral := by
    intro t ht f h hCoordinate ψ
    exact T.rightDifferenceQuotient_eq_ambientSpectralIntegral_of_laplace
      A P L hSymmetric t ht f h hCoordinate ψ

/-- The measure-level OS exchange identity supplies symmetry and therefore
constructs the full positive-semigroup spectral action from the Laplace formula. -/
noncomputable def EuclideanYangMillsOSPhysicalTimeTranslation.toPositiveSemigroupSpectralActionOfLaplaceAndExchange
    {S : EuclideanYangMillsContinuumMeasureConstructionSpine}
    {M : EuclideanYangMillsOSPhysicalHilbertReconstructedModel S}
    (T : EuclideanYangMillsOSPhysicalTimeTranslation M)
    (A : ExplicitWightmanOSQuadraticPVMCountableAdditivity M.toExplicitModel)
    (P : ExplicitWightmanOSPositiveSpectralSupport M.toExplicitModel)
    (L : ExplicitWightmanOSSpectralSemigroupLaplaceFormula
      M.toExplicitModel A.toScalarSpectralRealization T.toEuclideanTimeSemigroup)
    (hExchange : T.ReflectionTimeTranslationExchange) :
    EuclideanYangMillsOSPhysicalPositiveSemigroupSpectralAction T :=
  T.toPositiveSemigroupSpectralActionOfLaplace
    A P L hExchange.toIsRightInnerSymmetric

/-- The Laplace formula, positive spectral support, physical generator, and OS
exchange now construct the actual canonical PVM coordinate graph end to end. -/
noncomputable def EuclideanYangMillsOSPhysicalTimeTranslation.toCanonicalPVMCoordinateGraphOfLaplaceAndExchange
    {S : EuclideanYangMillsContinuumMeasureConstructionSpine}
    {M : EuclideanYangMillsOSPhysicalHilbertReconstructedModel S}
    (T : EuclideanYangMillsOSPhysicalTimeTranslation M)
    (A : ExplicitWightmanOSQuadraticPVMCountableAdditivity M.toExplicitModel)
    (P : ExplicitWightmanOSPositiveSpectralSupport M.toExplicitModel)
    (L : ExplicitWightmanOSSpectralSemigroupLaplaceFormula
      M.toExplicitModel A.toScalarSpectralRealization T.toEuclideanTimeSemigroup)
    (G : EuclideanYangMillsOSPhysicalHamiltonianGenerator T)
    (hExchange : T.ReflectionTimeTranslationExchange) :
    ExplicitWightmanOSCanonicalRestrictedPVMCoordinateGraph M.toExplicitModel :=
  (T.toPositiveSemigroupSpectralActionOfLaplaceAndExchange A P L hExchange)
    |>.toCoordinateGraph G hExchange

end

end MathlibAnalytic
end MGAP4D
