import MGAP4D.MathlibAnalytic.StandardRealHilbertSelfAdjointBoundedTransformInverseSquareRootFromContinuousFunctionalCalculus
import MGAP4D.MathlibAnalytic.StandardRealHilbertSelfAdjointBoundedTransformOperatorData
import Mathlib.Tactic

namespace MGAP4D
namespace MathlibAnalytic

noncomputable section

open scoped InnerProductSpace

/-- The everywhere-defined algebraic action `x ↦ A (R x)` generated by the natural-domain
inverse square root.  No independent domain-action certificate is needed once
`R(H) ⊆ D(A)` has been proved. -/
def StandardRealHilbertSelfAdjointCanonicalPositiveShiftedSquareBoundedInverseNaturalDomainSquareRootData.canonicalDomainAction
    {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    {A : H →ₗ.[ℝ] H}
    {K : StandardRealHilbertSelfAdjointCanonicalPositiveShiftedSquareBoundedInverseData A}
    (R : StandardRealHilbertSelfAdjointCanonicalPositiveShiftedSquareBoundedInverseNaturalDomainSquareRootData K) :
    H →ₗ[ℝ] H :=
  A.toFun.comp
    (R.squareRoot.toLinearMap.codRestrict A.domain
      (fun x => R.range_mem_original_domain x))

@[simp]
theorem StandardRealHilbertSelfAdjointCanonicalPositiveShiftedSquareBoundedInverseNaturalDomainSquareRootData.canonicalDomainAction_apply
    {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    {A : H →ₗ.[ℝ] H}
    {K : StandardRealHilbertSelfAdjointCanonicalPositiveShiftedSquareBoundedInverseData A}
    (R : StandardRealHilbertSelfAdjointCanonicalPositiveShiftedSquareBoundedInverseNaturalDomainSquareRootData K)
    (x : H) :
    R.canonicalDomainAction x =
      A ⟨R.squareRoot x, R.range_mem_original_domain x⟩ :=
  rfl

/-- A continuous realization of the canonical natural-domain action. -/
structure StandardRealHilbertSelfAdjointNaturalDomainBoundedTransformBoundedExtensionData
    {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    {A : H →ₗ.[ℝ] H}
    {K : StandardRealHilbertSelfAdjointCanonicalPositiveShiftedSquareBoundedInverseData A}
    (R : StandardRealHilbertSelfAdjointCanonicalPositiveShiftedSquareBoundedInverseNaturalDomainSquareRootData K) where
  boundedOperator : H →L[ℝ] H
  agrees_with_canonicalDomainAction :
    ∀ x : H, boundedOperator x = R.canonicalDomainAction x

/-- Only self-adjointness and the contraction estimate remain as analytic properties of the
bounded extension.  Eigenvector evaluation is generated below from the positive square root. -/
structure StandardRealHilbertSelfAdjointNaturalDomainBoundedTransformAnalyticCoreData
    {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    {A : H →ₗ.[ℝ] H}
    {K : StandardRealHilbertSelfAdjointCanonicalPositiveShiftedSquareBoundedInverseData A}
    {R : StandardRealHilbertSelfAdjointCanonicalPositiveShiftedSquareBoundedInverseNaturalDomainSquareRootData K}
    (B : StandardRealHilbertSelfAdjointNaturalDomainBoundedTransformBoundedExtensionData R) where
  selfAdjoint : IsSelfAdjoint B.boundedOperator
  norm_le_one : ‖B.boundedOperator‖ ≤ 1

/-- The canonical action and the positive-root eigenvector formula generate the bounded-transform
eigenvector evaluation. -/
theorem StandardRealHilbertSelfAdjointNaturalDomainBoundedTransformBoundedExtensionData.eigenvector_evaluation
    {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    {A : H →ₗ.[ℝ] H}
    {K : StandardRealHilbertSelfAdjointCanonicalPositiveShiftedSquareBoundedInverseData A}
    {R : StandardRealHilbertSelfAdjointCanonicalPositiveShiftedSquareBoundedInverseNaturalDomainSquareRootData K}
    (B : StandardRealHilbertSelfAdjointNaturalDomainBoundedTransformBoundedExtensionData R)
    (core : RealHilbertSelfAdjointCore A)
    {E : ℝ} (x : A.domain)
    (hE : A x = E • (x : H)) :
    B.boundedOperator (x : H) =
      standardRealHilbertBoundedTransformSpectralCoordinate E • (x : H) := by
  rw [B.agrees_with_canonicalDomainAction,
    R.canonicalDomainAction_apply]
  have hDomain :
      (⟨R.squareRoot (x : H), R.range_mem_original_domain (x : H)⟩ : A.domain) =
        (1 / Real.sqrt (1 + E ^ 2)) • x := by
    apply Subtype.ext
    exact R.eigenvector_evaluation core x hE
  rw [hDomain]
  change
    A.toFun ((1 / Real.sqrt (1 + E ^ 2)) • x) =
      standardRealHilbertBoundedTransformSpectralCoordinate E • (x : H)
  change A.toFun x = E • (x : H) at hE
  rw [A.toFun.map_smul, hE,
    standardRealHilbertBoundedTransformSpectralCoordinate_eq_div_sqrt]
  simp [smul_smul, div_eq_mul_inv, mul_comm]

/-- Collapse the generated canonical action and the reduced analytic core to the unchanged
bounded-transform operator-data boundary. -/
def StandardRealHilbertSelfAdjointNaturalDomainBoundedTransformBoundedExtensionData.toOperatorData
    {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    {A : H →ₗ.[ℝ] H}
    {K : StandardRealHilbertSelfAdjointCanonicalPositiveShiftedSquareBoundedInverseData A}
    {R : StandardRealHilbertSelfAdjointCanonicalPositiveShiftedSquareBoundedInverseNaturalDomainSquareRootData K}
    (B : StandardRealHilbertSelfAdjointNaturalDomainBoundedTransformBoundedExtensionData R)
    (Q : StandardRealHilbertSelfAdjointNaturalDomainBoundedTransformAnalyticCoreData B)
    (core : RealHilbertSelfAdjointCore A) :
    StandardRealHilbertSelfAdjointBoundedTransformOperatorData A where
  boundedOperator := B.boundedOperator
  boundedSelfAdjoint := Q.selfAdjoint
  boundedOperator_norm_le_one := Q.norm_le_one
  eigenvector_forward := fun x hE => B.eigenvector_evaluation core x hE

/-- Uniform continuous extension of the generated natural-domain action. -/
structure StandardRealHilbertSelfAdjointNaturalDomainBoundedTransformBoundedExtensionDataConstructor where
  construct :
    ∀ {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
      (A : H →ₗ.[ℝ] H)
      (_core : RealHilbertSelfAdjointCore A)
      (K : StandardRealHilbertSelfAdjointCanonicalPositiveShiftedSquareBoundedInverseData A)
      (R : StandardRealHilbertSelfAdjointCanonicalPositiveShiftedSquareBoundedInverseNaturalDomainSquareRootData K),
        StandardRealHilbertSelfAdjointNaturalDomainBoundedTransformBoundedExtensionData R

/-- Uniform self-adjointness and contraction proof for the bounded extension. -/
structure StandardRealHilbertSelfAdjointNaturalDomainBoundedTransformAnalyticCoreDataConstructor where
  construct :
    ∀ {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
      (A : H →ₗ.[ℝ] H)
      (_core : RealHilbertSelfAdjointCore A)
      (K : StandardRealHilbertSelfAdjointCanonicalPositiveShiftedSquareBoundedInverseData A)
      (R : StandardRealHilbertSelfAdjointCanonicalPositiveShiftedSquareBoundedInverseNaturalDomainSquareRootData K)
      (B : StandardRealHilbertSelfAdjointNaturalDomainBoundedTransformBoundedExtensionData R),
        StandardRealHilbertSelfAdjointNaturalDomainBoundedTransformAnalyticCoreData B

/-- The natural-domain bounded-transform route with the algebraic domain action and eigenvector
formula generated rather than supplied independently. -/
structure NaturalDomainCanonicalActionStandardRealHilbertSelfAdjointBoundedTransformOperatorConstructionPipelineConstructor where
  boundedInverse :
    StandardRealHilbertSelfAdjointCanonicalPositiveShiftedSquareBoundedInverseDataConstructor
  positiveSquareRoot :
    StandardRealHilbertSelfAdjointCanonicalPositiveShiftedSquareBoundedInverseNaturalDomainSquareRootDataConstructor
  boundedExtension :
    StandardRealHilbertSelfAdjointNaturalDomainBoundedTransformBoundedExtensionDataConstructor
  analyticCore :
    StandardRealHilbertSelfAdjointNaturalDomainBoundedTransformAnalyticCoreDataConstructor

/-- The reduced natural-domain route supplies the unchanged bounded-transform operator data. -/
def NaturalDomainCanonicalActionStandardRealHilbertSelfAdjointBoundedTransformOperatorConstructionPipelineConstructor.toOperatorDataConstructor
    (P : NaturalDomainCanonicalActionStandardRealHilbertSelfAdjointBoundedTransformOperatorConstructionPipelineConstructor) :
    StandardRealHilbertSelfAdjointBoundedTransformOperatorDataConstructor where
  construct := fun A core =>
    let K := P.boundedInverse.construct A core
    let R := P.positiveSquareRoot.construct A core K
    let B := P.boundedExtension.construct A core K R
    let Q := P.analyticCore.construct A core K R B
    B.toOperatorData Q core

/-- The graph-Riesz inverse, a generic real self-adjoint CFC, and the generated canonical action
leave only bounded extension, self-adjointness, and contraction as operator-construction stages. -/
structure ContinuousFunctionalCalculusNaturalDomainCanonicalActionStandardRealHilbertSelfAdjointBoundedTransformOperatorConstructionPipelineConstructor where
  boundedInverse :
    StandardRealHilbertSelfAdjointCanonicalPositiveShiftedSquareBoundedInverseDataConstructor
  continuousFunctionalCalculus :
    RealHilbertBoundedSelfAdjointContinuousFunctionalCalculusDataConstructor
  boundedExtension :
    StandardRealHilbertSelfAdjointNaturalDomainBoundedTransformBoundedExtensionDataConstructor
  analyticCore :
    StandardRealHilbertSelfAdjointNaturalDomainBoundedTransformAnalyticCoreDataConstructor

/-- Forget the CFC factorization and expose the generated natural-domain square-root constructor. -/
def ContinuousFunctionalCalculusNaturalDomainCanonicalActionStandardRealHilbertSelfAdjointBoundedTransformOperatorConstructionPipelineConstructor.toNaturalDomainCanonicalAction
    (P : ContinuousFunctionalCalculusNaturalDomainCanonicalActionStandardRealHilbertSelfAdjointBoundedTransformOperatorConstructionPipelineConstructor) :
    NaturalDomainCanonicalActionStandardRealHilbertSelfAdjointBoundedTransformOperatorConstructionPipelineConstructor where
  boundedInverse := P.boundedInverse
  positiveSquareRoot :=
    StandardRealHilbertSelfAdjointCanonicalPositiveShiftedSquareBoundedInverseAlgebraicSquareRootDataConstructor.toNaturalDomainSquareRootDataConstructor
      P.continuousFunctionalCalculus.toAlgebraicSquareRootDataConstructor
  boundedExtension := P.boundedExtension
  analyticCore := P.analyticCore

/-- The CFC-factored generated-action route supplies the unchanged operator-data constructor. -/
def ContinuousFunctionalCalculusNaturalDomainCanonicalActionStandardRealHilbertSelfAdjointBoundedTransformOperatorConstructionPipelineConstructor.toOperatorDataConstructor
    (P : ContinuousFunctionalCalculusNaturalDomainCanonicalActionStandardRealHilbertSelfAdjointBoundedTransformOperatorConstructionPipelineConstructor) :
    StandardRealHilbertSelfAdjointBoundedTransformOperatorDataConstructor :=
  P.toNaturalDomainCanonicalAction.toOperatorDataConstructor

/-- The reduced operator construction followed by the unchanged spectral pullback and bounded
Borel spectral theorem. -/
structure ContinuousFunctionalCalculusNaturalDomainCanonicalActionStandardRealHilbertSelfAdjointBoundedTransformBorelPipeline where
  operatorConstruction :
    ContinuousFunctionalCalculusNaturalDomainCanonicalActionStandardRealHilbertSelfAdjointBoundedTransformOperatorConstructionPipelineConstructor
  spectralPullback :
    StandardRealHilbertSelfAdjointBoundedTransformSpectralPullbackConstructor
  boundedBorelResolution :
    RealHilbertBoundedSelfAdjointBorelSpectralResolutionConstructor

/-- Collapse the generated-action route to the unchanged factored standard pipeline. -/
def ContinuousFunctionalCalculusNaturalDomainCanonicalActionStandardRealHilbertSelfAdjointBoundedTransformBorelPipeline.toFactored
    (P : ContinuousFunctionalCalculusNaturalDomainCanonicalActionStandardRealHilbertSelfAdjointBoundedTransformBorelPipeline) :
    FactoredStandardRealHilbertSelfAdjointBoundedTransformBorelPipeline where
  boundedTransformOperator := P.operatorConstruction.toOperatorDataConstructor
  spectralPullback := P.spectralPullback
  boundedBorelResolution := P.boundedBorelResolution

/-- The generated-action route yields the unchanged generic real-Hilbert spectral-resolution
constructor. -/
def ContinuousFunctionalCalculusNaturalDomainCanonicalActionStandardRealHilbertSelfAdjointBoundedTransformBorelPipeline.toConstructor
    (P : ContinuousFunctionalCalculusNaturalDomainCanonicalActionStandardRealHilbertSelfAdjointBoundedTransformBorelPipeline) :
    RealHilbertSelfAdjointSpectralResolutionConstructor :=
  P.toFactored.toConstructor

/-- The same route specializes to the unchanged reconstructed Wightman OS interface. -/
def ContinuousFunctionalCalculusNaturalDomainCanonicalActionStandardRealHilbertSelfAdjointBoundedTransformBorelPipeline.toExplicitWightmanOSConstructor
    (P : ContinuousFunctionalCalculusNaturalDomainCanonicalActionStandardRealHilbertSelfAdjointBoundedTransformBorelPipeline) :
    ExplicitWightmanOSSelfAdjointSpectralResolutionConstructor :=
  P.toFactored.toExplicitWightmanOSConstructor

end

end MathlibAnalytic
end MGAP4D
