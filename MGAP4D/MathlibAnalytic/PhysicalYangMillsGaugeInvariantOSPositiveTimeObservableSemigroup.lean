import MGAP4D.MathlibAnalytic.PhysicalYangMillsGaugeInvariantOSPositiveTimeContraction

namespace MGAP4D
namespace MathlibAnalytic

noncomputable section

namespace PhysicalYangMillsGaugeInvariantOSReflectionData.OSPreHilbertData

variable {S : PhysicalFourDimensionalYangMillsSymmetryLimit}
variable {D : PhysicalYangMillsGaugeInvariantOSReflectionData S}

/-- Regard an opaque OS carrier vector as its original positive-time observable. -/
def positiveTimeElement (P : D.OSPreHilbertData) (F : P.Carrier) :
    D.positiveTimeSubalgebra :=
  ⟨F.toGaugeInvariant, F.positiveTime⟩

/-- Repackage a positive-time observable in the opaque OS carrier carrying the
seminorm generated by the reflected continuum state. -/
def carrierOfPositiveTime (P : D.OSPreHilbertData)
    (F : D.positiveTimeSubalgebra) : P.Carrier where
  observable := F.1.1
  gaugeInvariant := F.1.2
  positiveTime := F.2

@[simp] theorem positiveTimeElement_carrierOfPositiveTime
    (P : D.OSPreHilbertData) (F : D.positiveTimeSubalgebra) :
    P.positiveTimeElement (P.carrierOfPositiveTime F) = F := by
  apply Subtype.ext
  apply Subtype.ext
  rfl

@[simp] theorem carrierOfPositiveTime_positiveTimeElement
    (P : D.OSPreHilbertData) (F : P.Carrier) :
    P.carrierOfPositiveTime (P.positiveTimeElement F) = F := by
  apply Carrier.observable_injective P
  rfl

@[simp] theorem carrierOfPositiveTime_one
    (P : D.OSPreHilbertData) :
    P.carrierOfPositiveTime (1 : D.positiveTimeSubalgebra) =
      P.vacuumObservable := by
  apply Carrier.observable_injective P
  rfl

/-- Transport a real-algebra endomorphism of positive-time observables to a
real-linear endomorphism of the OS seminormed carrier.  Additivity and scalar
linearity are routed through the explicit positive-time submodule to avoid
nested-subtype typeclass search. -/
noncomputable def translateCarrierByPositiveTimeAlgHom
    (P : D.OSPreHilbertData)
    (tau : D.positiveTimeSubalgebra →ₐ[ℝ] D.positiveTimeSubalgebra) :
    P.Carrier →ₗ[ℝ] P.Carrier where
  toFun := fun F =>
    P.carrierOfPositiveTime (tau (P.positiveTimeElement F))
  map_add' := by
    intro F G
    apply Carrier.observable_injective P
    change
      (tau (P.toPositiveTime (F + G))).1.1 =
        (tau (P.toPositiveTime F)).1.1 +
          (tau (P.toPositiveTime G)).1.1
    rw [P.toPositiveTime_add]
    exact congrArg (fun H : D.positiveTimeSubalgebra => H.1.1)
      (tau.map_add (P.toPositiveTime F) (P.toPositiveTime G))
  map_smul' := by
    intro r F
    apply Carrier.observable_injective P
    change
      (tau (P.toPositiveTime (r • F))).1.1 =
        r • (tau (P.toPositiveTime F)).1.1
    rw [P.toPositiveTime_smul]
    exact congrArg (fun H : D.positiveTimeSubalgebra => H.1.1)
      (tau.toLinearMap.map_smul r (P.toPositiveTime F))

@[simp] theorem translateCarrierByPositiveTimeAlgHom_apply
    (P : D.OSPreHilbertData)
    (tau : D.positiveTimeSubalgebra →ₐ[ℝ] D.positiveTimeSubalgebra)
    (F : P.Carrier) :
    P.translateCarrierByPositiveTimeAlgHom tau F =
      P.carrierOfPositiveTime (tau (P.positiveTimeElement F)) :=
  rfl

/-- The reflected quadratic expectation underlying the OS seminorm. -/
def osQuadraticValue (P : D.OSPreHilbertData) (F : P.Carrier) : ℝ :=
  D.osBilinForm P.omega (P.toPositiveTime F) (P.toPositiveTime F)

@[simp] theorem osQuadraticValue_eq_norm_sq
    (P : D.OSPreHilbertData) (F : P.Carrier) :
    P.osQuadraticValue F = ‖F‖ ^ 2 := by
  calc
    P.osQuadraticValue F = inner ℝ F F :=
      (P.inner_eq_osBilinForm F F).symm
    _ = ‖F‖ ^ 2 := real_inner_self_eq_norm_sq F

/-- Positive-time translations expressed on the actual positive-time observable
algebra.  Preservation of positive time and of the unit are built into the
algebra endomorphisms.  The sole analytic input is contraction of the reflected
quadratic expectation. -/
structure PositiveTimeObservableContractionSemigroup
    (P : D.OSPreHilbertData) where
  translate : NNReal →
    D.positiveTimeSubalgebra →ₐ[ℝ] D.positiveTimeSubalgebra
  translate_zero :
    translate 0 = AlgHom.id ℝ D.positiveTimeSubalgebra
  translate_add : ∀ s t,
    translate (s + t) = (translate s).comp (translate t)
  osQuadratic_translate_le : ∀ t F,
    P.osQuadraticValue
        (P.translateCarrierByPositiveTimeAlgHom (translate t) F) ≤
      P.osQuadraticValue F

namespace PositiveTimeObservableContractionSemigroup

variable {P : D.OSPreHilbertData}

/-- The observable-algebra translation acting on the OS carrier. -/
noncomputable def carrierTranslation
    (T : P.PositiveTimeObservableContractionSemigroup) (t : NNReal) :
    P.Carrier →ₗ[ℝ] P.Carrier :=
  P.translateCarrierByPositiveTimeAlgHom (T.translate t)

@[simp] theorem carrierTranslation_apply
    (T : P.PositiveTimeObservableContractionSemigroup)
    (t : NNReal) (F : P.Carrier) :
    T.carrierTranslation t F =
      P.carrierOfPositiveTime (T.translate t (P.positiveTimeElement F)) :=
  rfl

@[simp] theorem carrierTranslation_carrierOfPositiveTime
    (T : P.PositiveTimeObservableContractionSemigroup)
    (t : NNReal) (F : D.positiveTimeSubalgebra) :
    T.carrierTranslation t (P.carrierOfPositiveTime F) =
      P.carrierOfPositiveTime (T.translate t F) := by
  rw [T.carrierTranslation_apply,
    P.positiveTimeElement_carrierOfPositiveTime]

/-- Contraction of the OS quadratic expectation gives contraction of the OS
seminorm. -/
theorem carrierTranslation_norm_le
    (T : P.PositiveTimeObservableContractionSemigroup)
    (t : NNReal) (F : P.Carrier) :
    ‖T.carrierTranslation t F‖ ≤ ‖F‖ := by
  have hsq : ‖T.carrierTranslation t F‖ ^ 2 ≤ ‖F‖ ^ 2 := by
    simpa only [osQuadraticValue_eq_norm_sq] using
      T.osQuadratic_translate_le t F
  nlinarith [norm_nonneg (T.carrierTranslation t F), norm_nonneg F]

/-- Time zero acts identically on the OS carrier. -/
theorem carrierTranslation_zero
    (T : P.PositiveTimeObservableContractionSemigroup) (F : P.Carrier) :
    T.carrierTranslation 0 F = F := by
  rw [T.carrierTranslation_apply, T.translate_zero]
  exact P.carrierOfPositiveTime_positiveTimeElement F

/-- The additive semigroup law descends from the positive-time observable
algebra to the OS carrier. -/
theorem carrierTranslation_add
    (T : P.PositiveTimeObservableContractionSemigroup)
    (s t : NNReal) (F : P.Carrier) :
    T.carrierTranslation (s + t) F =
      T.carrierTranslation s (T.carrierTranslation t F) := by
  rw [T.carrierTranslation_apply, T.translate_add]
  simp only [AlgHom.comp_apply, T.carrierTranslation_apply,
    P.positiveTimeElement_carrierOfPositiveTime]

/-- Algebra endomorphisms preserve the unit, hence observable translation fixes
the OS vacuum representative without an additional assumption. -/
theorem carrierTranslation_vacuumObservable
    (T : P.PositiveTimeObservableContractionSemigroup) (t : NNReal) :
    T.carrierTranslation t P.vacuumObservable = P.vacuumObservable := by
  rw [T.carrierTranslation_apply]
  change P.carrierOfPositiveTime (T.translate t 1) = P.vacuumObservable
  rw [map_one, P.carrierOfPositiveTime_one]

/-- Forget the multiplicative observable structure and obtain exactly the
carrier-side contraction semigroup required by OS Hilbert completion. -/
noncomputable def toCarrierSemigroup
    (T : P.PositiveTimeObservableContractionSemigroup) :
    P.PositiveTimeContractionSemigroup where
  translate := T.carrierTranslation
  translate_zero := T.carrierTranslation_zero
  translate_add := T.carrierTranslation_add
  norm_translate_le := T.carrierTranslation_norm_le
  vacuumObservable_fixed := T.carrierTranslation_vacuumObservable

/-- Canonical completed physical contraction semigroup generated directly from
positive-time observable-algebra translations. -/
noncomputable def toPhysicalSemigroup
    (T : P.PositiveTimeObservableContractionSemigroup) :
    P.PhysicalSemigroup :=
  T.toCarrierSemigroup.toPhysicalSemigroup

/-- On a represented positive-time observable, the completed operator agrees
with the original observable-algebra translation. -/
theorem physicalOperator_on_positiveTimeObservable
    (T : P.PositiveTimeObservableContractionSemigroup)
    (t : NNReal) (F : D.positiveTimeSubalgebra) :
    T.toPhysicalSemigroup.operator t
        (P.physicalState (P.carrierOfPositiveTime F)) =
      P.physicalState (P.carrierOfPositiveTime (T.translate t F)) := by
  change T.toCarrierSemigroup.physicalOperator t
      (P.physicalState (P.carrierOfPositiveTime F)) =
    P.physicalState (P.carrierOfPositiveTime (T.translate t F))
  rw [T.toCarrierSemigroup.physicalOperator_on_physicalState]
  change P.physicalState
      (T.carrierTranslation t (P.carrierOfPositiveTime F)) =
    P.physicalState (P.carrierOfPositiveTime (T.translate t F))
  rw [T.carrierTranslation_carrierOfPositiveTime]

end PositiveTimeObservableContractionSemigroup

end PhysicalYangMillsGaugeInvariantOSReflectionData.OSPreHilbertData

end

end MathlibAnalytic
end MGAP4D
