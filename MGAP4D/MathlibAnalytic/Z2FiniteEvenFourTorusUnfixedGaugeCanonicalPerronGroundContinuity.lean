import MGAP4D.MathlibAnalytic.FiniteContinuousCanonicalPerronGround
import MGAP4D.MathlibAnalytic.Z2FiniteEvenFourTorusUnfixedGaugeGroundStateDoobTransform
import MGAP4D.MathlibAnalytic.Z2FiniteEvenFourTorusUnfixedGaugePerronKernelContinuity
import Mathlib.Tactic

namespace MGAP4D
namespace MathlibAnalytic

open scoped BigOperators

noncomputable section

/-- The actual finite-volume unfixed-gauge Perron ground with its scale fixed
canonically by total coordinate mass one.  The coupling is carried in the
closed nonnegative half-line, so no proof argument enters the definition. -/
noncomputable def finiteEvenFourTorusZ2UnfixedGaugeCanonicalPerronGround
    (H : ℕ)
    (energyIdentity energyNontrivial : ℝ)
    (β : Set.Ici (0 : ℝ)) :
    FiniteEvenFourTorusZ2SliceHilbert H :=
  finiteKernelCanonicalPerronGround
    (finiteEvenFourTorusZ2UnfixedGaugeOneSlabKernelCouplingFamily
      H energyIdentity energyNontrivial β.1)

/-- At every nonnegative coupling, the proof-independent normalized transfer
is symmetric. -/
theorem finiteEvenFourTorusZ2UnfixedGaugeOneSlabTransferCouplingFamily_isSymmetric
    (H : ℕ)
    (energyIdentity energyNontrivial : ℝ)
    (hEnergy : energyIdentity ≤ energyNontrivial)
    (β : Set.Ici (0 : ℝ)) :
    (finiteKernelNormalizedOperator
      (finiteEvenFourTorusZ2UnfixedGaugeOneSlabKernelCouplingFamily
        H energyIdentity energyNontrivial β.1)).toLinearMap.IsSymmetric := by
  change
    (finiteEvenFourTorusZ2UnfixedGaugeOneSlabTransfer
      H β.1 energyIdentity energyNontrivial β.2 hEnergy).toLinearMap.IsSymmetric
  exact
    finiteEvenFourTorusZ2UnfixedGaugeOneSlabTransfer_isSymmetric
      H β.1 energyIdentity energyNontrivial β.2 hEnergy

/-- The existing chosen positive ground is fixed by the proof-independent
coupling-family transfer on the physical nonnegative domain. -/
theorem finiteEvenFourTorusZ2UnfixedGaugeAmbientPositiveGround_fixed_couplingFamily
    (H : ℕ)
    (energyIdentity energyNontrivial : ℝ)
    (hEnergy : energyIdentity ≤ energyNontrivial)
    (β : Set.Ici (0 : ℝ)) :
    finiteKernelNormalizedOperator
        (finiteEvenFourTorusZ2UnfixedGaugeOneSlabKernelCouplingFamily
          H energyIdentity energyNontrivial β.1)
        (finiteEvenFourTorusZ2UnfixedGaugeAmbientPositiveGround
          H β.1 energyIdentity energyNontrivial β.2 hEnergy) =
      finiteEvenFourTorusZ2UnfixedGaugeAmbientPositiveGround
        H β.1 energyIdentity energyNontrivial β.2 hEnergy := by
  change
    finiteEvenFourTorusZ2UnfixedGaugeOneSlabTransfer
        H β.1 energyIdentity energyNontrivial β.2 hEnergy
        (finiteEvenFourTorusZ2UnfixedGaugeAmbientPositiveGround
          H β.1 energyIdentity energyNontrivial β.2 hEnergy) =
      finiteEvenFourTorusZ2UnfixedGaugeAmbientPositiveGround
        H β.1 energyIdentity energyNontrivial β.2 hEnergy
  exact
    finiteEvenFourTorusZ2UnfixedGaugeAmbientPositiveGround_fixed
      H β.1 energyIdentity energyNontrivial β.2 hEnergy

/-- The proof-independent coupling-family fixed space is the line generated by
the existing chosen strictly-positive Perron ground. -/
theorem finiteEvenFourTorusZ2UnfixedGaugeCouplingFamily_fixed_eq_smul_chosenGround
    (H : ℕ)
    (energyIdentity energyNontrivial : ℝ)
    (hEnergy : energyIdentity ≤ energyNontrivial)
    (β : Set.Ici (0 : ℝ))
    (g : FiniteEvenFourTorusZ2SliceHilbert H)
    (hg :
      finiteKernelNormalizedOperator
          (finiteEvenFourTorusZ2UnfixedGaugeOneSlabKernelCouplingFamily
            H energyIdentity energyNontrivial β.1) g = g) :
    ∃ c : ℝ,
      g = c •
        finiteEvenFourTorusZ2UnfixedGaugeAmbientPositiveGround
          H β.1 energyIdentity energyNontrivial β.2 hEnergy := by
  have hgActual :
      finiteEvenFourTorusZ2UnfixedGaugeOneSlabTransfer
        H β.1 energyIdentity energyNontrivial β.2 hEnergy g = g := by
    exact hg
  exact
    (Classical.choose_spec
      (finiteEvenFourTorusZ2UnfixedGaugeAmbient_fixed_space_generated_by_positiveGround
        H β.1 energyIdentity energyNontrivial β.2 hEnergy)).2.2.2 g hgActual

/-- The actual canonical ground is pointwise positive, fixed by the normalized
one-slab transfer, and has total coordinate mass exactly one. -/
theorem finiteEvenFourTorusZ2UnfixedGaugeCanonicalPerronGround_spec
    (H : ℕ)
    (energyIdentity energyNontrivial : ℝ)
    (hEnergy : energyIdentity ≤ energyNontrivial)
    (β : Set.Ici (0 : ℝ)) :
    (∑ A : FiniteEvenFourTorusZ2SliceConfiguration H,
        finiteEvenFourTorusZ2UnfixedGaugeCanonicalPerronGround
          H energyIdentity energyNontrivial β A = 1) ∧
    FiniteBoundaryPointwisePositive
      (finiteEvenFourTorusZ2UnfixedGaugeCanonicalPerronGround
        H energyIdentity energyNontrivial β) ∧
    finiteKernelNormalizedOperator
        (finiteEvenFourTorusZ2UnfixedGaugeOneSlabKernelCouplingFamily
          H energyIdentity energyNontrivial β.1)
        (finiteEvenFourTorusZ2UnfixedGaugeCanonicalPerronGround
          H energyIdentity energyNontrivial β) =
      finiteEvenFourTorusZ2UnfixedGaugeCanonicalPerronGround
        H energyIdentity energyNontrivial β := by
  simpa [finiteEvenFourTorusZ2UnfixedGaugeCanonicalPerronGround] using
    finiteKernelCanonicalPerronGround_spec
      (finiteEvenFourTorusZ2UnfixedGaugeOneSlabKernelCouplingFamily
        H energyIdentity energyNontrivial β.1)
      (finiteEvenFourTorusZ2UnfixedGaugeOneSlabTransferCouplingFamily_isSymmetric
        H energyIdentity energyNontrivial hEnergy β)
      (finiteEvenFourTorusZ2UnfixedGaugeAmbientPositiveGround
        H β.1 energyIdentity energyNontrivial β.2 hEnergy)
      (finiteEvenFourTorusZ2UnfixedGaugeAmbientPositiveGround_pos
        H β.1 energyIdentity energyNontrivial β.2 hEnergy)
      (finiteEvenFourTorusZ2UnfixedGaugeAmbientPositiveGround_fixed_couplingFamily
        H energyIdentity energyNontrivial hEnergy β)
      (finiteEvenFourTorusZ2UnfixedGaugeCouplingFamily_fixed_eq_smul_chosenGround
        H energyIdentity energyNontrivial hEnergy β)

/-- Coupling continuity of the canonically normalized actual Perron ground on
the complete nonnegative coupling half-line. -/
theorem continuous_finiteEvenFourTorusZ2UnfixedGaugeCanonicalPerronGround
    (H : ℕ)
    (energyIdentity energyNontrivial : ℝ)
    (hEnergy : energyIdentity ≤ energyNontrivial) :
    Continuous (fun β : Set.Ici (0 : ℝ) =>
      finiteEvenFourTorusZ2UnfixedGaugeCanonicalPerronGround
        H energyIdentity energyNontrivial β) := by
  simpa [finiteEvenFourTorusZ2UnfixedGaugeCanonicalPerronGround] using
    continuous_finiteKernelCanonicalPerronGround
      (fun β : Set.Ici (0 : ℝ) =>
        finiteEvenFourTorusZ2UnfixedGaugeOneSlabKernelCouplingFamily
          H energyIdentity energyNontrivial β.1)
      (fun A B =>
        (continuous_finiteEvenFourTorusZ2UnfixedGaugeOneSlabKernelCouplingFamily
          H energyIdentity energyNontrivial A B).comp continuous_subtype_val)
      (fun β =>
        finiteEvenFourTorusZ2UnfixedGaugeOneSlabKernelCouplingFamily_raw_ne_zero
          H energyIdentity energyNontrivial β.1)
      (fun β =>
        finiteEvenFourTorusZ2UnfixedGaugeAmbientPositiveGround
          H β.1 energyIdentity energyNontrivial β.2 hEnergy)
      (finiteEvenFourTorusZ2UnfixedGaugeOneSlabTransferCouplingFamily_isSymmetric
        H energyIdentity energyNontrivial hEnergy)
      (fun β =>
        finiteEvenFourTorusZ2UnfixedGaugeAmbientPositiveGround_pos
          H β.1 energyIdentity energyNontrivial β.2 hEnergy)
      (finiteEvenFourTorusZ2UnfixedGaugeAmbientPositiveGround_fixed_couplingFamily
        H energyIdentity energyNontrivial hEnergy)
      (finiteEvenFourTorusZ2UnfixedGaugeCouplingFamily_fixed_eq_smul_chosenGround
        H energyIdentity energyNontrivial hEnergy)

/-- The canonical ground lies on the existing positive Perron ray with a
strictly positive scalar.  Consequently all projective posterior quantities
may replace the old chosen ground by this continuous representative. -/
theorem finiteEvenFourTorusZ2UnfixedGaugeCanonicalPerronGround_eq_pos_smul_chosenGround
    (H : ℕ)
    (energyIdentity energyNontrivial : ℝ)
    (hEnergy : energyIdentity ≤ energyNontrivial)
    (β : Set.Ici (0 : ℝ)) :
    ∃ c : ℝ,
      0 < c ∧
      finiteEvenFourTorusZ2UnfixedGaugeCanonicalPerronGround
          H energyIdentity energyNontrivial β =
        c • finiteEvenFourTorusZ2UnfixedGaugeAmbientPositiveGround
          H β.1 energyIdentity energyNontrivial β.2 hEnergy := by
  have hspec :=
    finiteEvenFourTorusZ2UnfixedGaugeCanonicalPerronGround_spec
      H energyIdentity energyNontrivial hEnergy β
  obtain ⟨c, hc⟩ :=
    finiteEvenFourTorusZ2UnfixedGaugeCouplingFamily_fixed_eq_smul_chosenGround
      H energyIdentity energyNontrivial hEnergy β
      (finiteEvenFourTorusZ2UnfixedGaugeCanonicalPerronGround
        H energyIdentity energyNontrivial β) hspec.2.2
  let A : FiniteEvenFourTorusZ2SliceConfiguration H := fun _ => 1
  have hCanonicalPos := hspec.2.1 A
  have hChosenPos :=
    finiteEvenFourTorusZ2UnfixedGaugeAmbientPositiveGround_pos
      H β.1 energyIdentity energyNontrivial β.2 hEnergy A
  have hcPos : 0 < c := by
    rw [hc] at hCanonicalPos
    change 0 < c *
      finiteEvenFourTorusZ2UnfixedGaugeAmbientPositiveGround
        H β.1 energyIdentity energyNontrivial β.2 hEnergy A at hCanonicalPos
    nlinarith
  exact ⟨c, hcPos, hc⟩

end

end MathlibAnalytic
end MGAP4D
