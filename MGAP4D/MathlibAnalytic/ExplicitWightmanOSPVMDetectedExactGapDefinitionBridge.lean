import MGAP4D.MathlibAnalytic.ExplicitWightmanOSExactGapSpectralCore
import MGAP4D.MathlibAnalytic.FiniteWilsonGibbsExplicitCanonicalGaugeExactGapDefinitionBridge

namespace MGAP4D
namespace MathlibAnalytic

noncomputable section

/-!
Construct the reduced exact-gap definition bridge from the fully typed explicit
Wightman/OS model and genuine nonzero singleton projections of its bounded PVM.

The legacy definition bridge only requests a vector in each set-valued spectral
carrier.  Here that vector is not chosen arbitrarily: it is the image of a
nonzero physical PVM projection.  Projection idempotence then proves that this
image is a fixed point of the corresponding spectral projection.
-/

/-- Physical singleton-energy detection by the actual bounded PVM.

For every displayed Hamiltonian spectral value, some Hilbert vector has a
nonzero projection onto the corresponding singleton energy set. -/
structure ExplicitWightmanOSSpectralPVMDetection
    (M : ExplicitWightmanOSReconstructedModel) where
  detects :
    ∀ energy : ℝ, energy ∈ M.hamiltonianEnergySpectrum →
      ∃ φ : M.H,
        M.spectralPVM.projection ({energy} : Set ℝ) φ ≠ 0

/-- A nonzero physical singleton projection produces a nonzero fixed point of
that projection. -/
theorem ExplicitWightmanOSSpectralPVMDetection.nonzeroFixedPoint
    {M : ExplicitWightmanOSReconstructedModel}
    (D : ExplicitWightmanOSSpectralPVMDetection M)
    (energy : ℝ) (hEnergy : energy ∈ M.hamiltonianEnergySpectrum) :
    ∃ ψ : M.H,
      ψ ≠ 0 ∧
        M.spectralPVM.projection ({energy} : Set ℝ) ψ = ψ := by
  obtain ⟨φ, hφ⟩ := D.detects energy hEnergy
  refine ⟨M.spectralPVM.projection ({energy} : Set ℝ) φ, hφ, ?_⟩
  exact M.spectralPVM.idempotent ({energy} : Set ℝ) φ

/-- Actual bounded-PVM detection supplies the set-valued spectral witness needed
by the reduced exact-gap core generated from the explicit model. -/
theorem ExplicitWightmanOSSpectralPVMDetection.detectsExactGapCore
    {M : ExplicitWightmanOSReconstructedModel}
    (D : ExplicitWightmanOSSpectralPVMDetection M)
    (hGap :
      HasHamiltonianMassGap M.hamiltonianEnergySpectrum exactGapValueReal)
    (hExactSpectrum :
      exactGapValueReal ∈ M.hamiltonianEnergySpectrum) :
    ∀ energy : ℝ,
      energy ∈ (M.toExactGapSpectralCore hGap hExactSpectrum).energySpectrum →
        ∃ ψ : (M.toExactGapSpectralCore hGap hExactSpectrum).H,
          ψ ∈ (M.toExactGapSpectralCore hGap hExactSpectrum).spectralPVM
            ({energy} : Set ℝ) := by
  intro energy hEnergy
  obtain ⟨ψ, _hψNonzero, hψFixed⟩ := D.nonzeroFixedPoint energy hEnergy
  exact ⟨ψ, hψFixed⟩

/-- Stronger exact-gap endpoint: the attained threshold is represented by a
nonzero fixed point of the actual singleton PVM projection. -/
theorem ExplicitWightmanOSSpectralPVMDetection.exactGapNonzeroFixedPoint
    {M : ExplicitWightmanOSReconstructedModel}
    (D : ExplicitWightmanOSSpectralPVMDetection M)
    (hExactSpectrum :
      exactGapValueReal ∈ M.hamiltonianEnergySpectrum) :
    ∃ ψ : M.H,
      ψ ≠ 0 ∧
        M.spectralPVM.projection ({exactGapValueReal} : Set ℝ) ψ = ψ :=
  D.nonzeroFixedPoint exactGapValueReal hExactSpectrum

/-- A ready Euclidean measure bridge, explicit Wightman model, exact Hamiltonian
gap, threshold attainment, and physical PVM detection construct the reduced
exact-gap definition bridge.

The spectral core, Hamiltonian self-adjointness proof, set-valued PVM detection,
and vacuum spectral point are all generated by existing constructors. -/
def euclideanYangMillsMeasureExplicitWightmanExactGapDefinitionBridge
    (E : EuclideanYangMillsMeasureToOSWightmanBridge)
    (hMeasure : E.measure.ready)
    (M : ExplicitWightmanOSReconstructedModel)
    (hGap :
      HasHamiltonianMassGap M.hamiltonianEnergySpectrum exactGapValueReal)
    (hExactSpectrum :
      exactGapValueReal ∈ M.hamiltonianEnergySpectrum)
    (model_uses_measure_axioms : M.axioms.toLegacy = E.axioms)
    (D : ExplicitWightmanOSSpectralPVMDetection M) :
    OSWightmanExactGapDefinitionBridge :=
  euclideanYangMillsMeasureExactGapDefinitionBridge
    E hMeasure
    (M.toExactGapSpectralCore hGap hExactSpectrum)
    model_uses_measure_axioms
    (M.toExactGapSpectralCore_selfAdjoint hGap hExactSpectrum)
    (D.detectsExactGapCore hGap hExactSpectrum)
    (M.toExactGapSpectralCore_vacuumSpectralPoint hGap hExactSpectrum)

@[simp]
theorem euclideanYangMillsMeasureExplicitWightmanExactGapDefinitionBridge_model
    (E : EuclideanYangMillsMeasureToOSWightmanBridge)
    (hMeasure : E.measure.ready)
    (M : ExplicitWightmanOSReconstructedModel)
    (hGap :
      HasHamiltonianMassGap M.hamiltonianEnergySpectrum exactGapValueReal)
    (hExactSpectrum :
      exactGapValueReal ∈ M.hamiltonianEnergySpectrum)
    (model_uses_measure_axioms : M.axioms.toLegacy = E.axioms)
    (D : ExplicitWightmanOSSpectralPVMDetection M) :
    (euclideanYangMillsMeasureExplicitWightmanExactGapDefinitionBridge
      E hMeasure M hGap hExactSpectrum model_uses_measure_axioms D).spine.spectralCore =
        M.toExactGapSpectralCore hGap hExactSpectrum :=
  rfl

/-- Compact theorem endpoint for the explicit-model/PVM-detected reconstruction
route. -/
abbrev EuclideanYangMillsMeasureExplicitWightmanExactGapProp
    (E : EuclideanYangMillsMeasureToOSWightmanBridge)
    (hMeasure : E.measure.ready)
    (M : ExplicitWightmanOSReconstructedModel)
    (hGap :
      HasHamiltonianMassGap M.hamiltonianEnergySpectrum exactGapValueReal)
    (hExactSpectrum :
      exactGapValueReal ∈ M.hamiltonianEnergySpectrum)
    (model_uses_measure_axioms : M.axioms.toLegacy = E.axioms)
    (D : ExplicitWightmanOSSpectralPVMDetection M) : Prop :=
  let B := euclideanYangMillsMeasureExplicitWightmanExactGapDefinitionBridge
    E hMeasure M hGap hExactSpectrum model_uses_measure_axioms D
  B.toDefinitionBridge.spine.model.hasMassGap ∧
    0 < exactGapValueReal ∧
    exactGapValueReal =
      sInf (B.toDefinitionBridge.spine.model.energySpectrum \ ({0} : Set ℝ)) ∧
    ∃ ψ : M.H,
      ψ ≠ 0 ∧
        M.spectralPVM.projection ({exactGapValueReal} : Set ℝ) ψ = ψ

/-- The generated exact-gap definition bridge reaches the model-level mass-gap
and exact spectral-threshold theorems while retaining a nonzero physical PVM
witness at the attained gap. -/
theorem euclidean_yang_mills_measure_explicit_wightman_exact_gap
    (E : EuclideanYangMillsMeasureToOSWightmanBridge)
    (hMeasure : E.measure.ready)
    (M : ExplicitWightmanOSReconstructedModel)
    (hGap :
      HasHamiltonianMassGap M.hamiltonianEnergySpectrum exactGapValueReal)
    (hExactSpectrum :
      exactGapValueReal ∈ M.hamiltonianEnergySpectrum)
    (model_uses_measure_axioms : M.axioms.toLegacy = E.axioms)
    (D : ExplicitWightmanOSSpectralPVMDetection M) :
    EuclideanYangMillsMeasureExplicitWightmanExactGapProp
      E hMeasure M hGap hExactSpectrum model_uses_measure_axioms D := by
  let B := euclideanYangMillsMeasureExplicitWightmanExactGapDefinitionBridge
    E hMeasure M hGap hExactSpectrum model_uses_measure_axioms D
  exact ⟨
    B.hasMassGap,
    B.exactGapPositive,
    B.exactGapThreshold,
    D.exactGapNonzeroFixedPoint hExactSpectrum⟩

end

end MathlibAnalytic
end MGAP4D
